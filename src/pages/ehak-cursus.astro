      },
    ],
    image: 'https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&fit=crop&q=80&w=600',
    requestUrl: '/persoonlijk-advies?course=ehak',
    incompanyUrl: '/persoonlijk-advies?type=zakelijk&course=ehak&mode=incompany',
  },
  {
    id: 'baby-kinderreanimatie-pbls',
    title: 'Baby- & Kinderreanimatie (NRR PBLS)',
    shortTitle: 'Kinderreanimatie (PBLS)',
    tagline: 'Gespecialiseerde NRR-training voor circulatiestilstand en verstikking bij kinderen',
    price: '€ 95,00',
    duration: '1 dagdeel (3,5 uur)',
    target:
      'Voor ouders, grootouders, kraamverzorgenden, oppassers en sportcoaches die gericht baby- en kinderreanimatie willen leren.',
    requirements: 'Geen voorkennis vereist.',
    exam: 'Praktische vaardigheidstoetsing conform richtlijnen Nederlandse Reanimatie Raad (NRR).',
    certification: 'Officieel NRR PBLS-certificaat Baby- & Kinderreanimatie (2 jaar geldig).',
    inclusions: [
      'Praktijk op baby-/kindpoppen',
      'Oefenen met kinderelektroden',
      'Officieel NRR-certificaat',
      'Koffie, thee & lesboekje',
    ],
    modules: [
      {
        name: 'Herkenning ademhalings- en circulatiestilstand',
        description: 'Snel controleren van bewustzijn en ademhaling bij zuigelingen en kinderen.',
      },
      {
        name: '5 initiële beademingen & 15:2 borstcompressies',
        description: 'Correcte twee-vinger- en één-handtechniek oefenen met realtime digitale feedback.',
      },
      {
        name: 'AED-inzet met kindersleutel of kinderelektroden',
        description: 'Veilig plaatsen van elektroden bij kleine kinderen en opheffen van luchtwegobstructies.',
      },
    ],
    image: 'https://images.unsplash.com/photo-1505751172876-fa1923c5c528?auto=format&fit=crop&q=80&w=600',
    requestUrl: '/persoonlijk-advies?course=ehak',
    incompanyUrl: '/persoonlijk-advies?type=zakelijk&course=ehak&mode=incompany',
  },
];

const faqs = [
  {
    q: 'Voldoet deze EHBO bij kinderen (EHAK) cursus aan de Wet IKK en de GGD?',
    a: 'Ja, 100%. Ons certificaat Eerste Hulp aan Kinderen voldoet volledig aan de wettelijke eisen van de Wet Innovatie en Kwaliteit Kinderopvang (Wet IKK) en het Landelijk Register Kinderopvang (LRK). Daarmee bent u aantoonbaar gecertificeerd voor GGD-inspecties.',
  },
  {
    q: 'Wordt een cursus EHBO bij kinderen vergoed door de zorgverzekering?',
    a: 'Ja, veel Nederlandse zorgverzekeraars vergoeden een erkende cursus Eerste Hulp aan Kinderen tot 100% vanuit de aanvullende zorgverzekering (zonder aantasting van het eigen risico). U kunt de officiële factuur van Edusafe direct declareren.',
  },
  {
    q: 'Hoe werkt de combinatie van online E-learning en praktijkles?',
    a: 'Na aanmelding ontvangt u direct toegang tot onze online E-learning (beschikbaar in NL & ENG, circa 2 tot 3 uur op eigen tempo). Vervolgens oefent u tijdens een compacte praktijksessie intensief op baby- en kinderreanimatiepoppen.',
  },
  {
    q: 'Verzorgen jullie EHAK ook Incompany op een kinderdagverblijf of basisschool?',
    a: 'Zeker. Vanaf 6 deelnemers verzorgen wij de praktijktraining op uw eigen opvanglocatie of school — overdag, tijdens een studiedag of in de avonduren, zodat uw groepsbezetting niet in het gedrang komt.',
  },
];
---

<CourseCategoryHub
  lang="nl"
  category="EHBO"
  seoTitle="EHBO bij Kinderen Cursus (EHAK / Wet IKK Erkend) | Edusafe"
  seoDescription="Officiële cursus Eerste Hulp aan Kinderen (EHAK) conform Wet IKK, LRK en GGD-eisen. Inclusief E-learning, baby- & kinderreanimatie en vergoeding via zorgverzekering."
  breadcrumbLabel="EHBO aan Kinderen (EHAK)"
  heroTitle="Eerste Hulp aan Kinderen (EHAK)"
  heroSubtitle="100% Wet IKK- en GGD-erkende kinder-EHBO opleidingen voor kinderdagverblijven, BSO's, gastouders, basisscholen en ouders."
  heroImage="https://images.unsplash.com/photo-1588072432836-e10032774350?auto=format&fit=crop&q=80&w=1600"
  heroBullets={[
    'E-learning + 1 dagdeel praktijk',
    '100% Wet IKK & GGD erkend',
    'Vergoeding zorgverzekeraar',
    'Den Haag of op uw opvang',
  ]}
  primaryCtaUrl="/persoonlijk-advies?course=ehak"
  courses={ehakCourses}
  coursesHeading="Alle Kinder-EHBO (EHAK) & PBLS opleidingen"
  faqTitle="EHBO aan Kinderen & Wet IKK"
  customFaqs={faqs}
  advisorText="Persoonlijk advies voor uw kinderopvangteam?"
  contactCourseSlug="ehak"
/>
