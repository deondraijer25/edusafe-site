---
import CourseCategoryHub, { type HubCourseItem } from '../components/CourseCategoryHub.astro';
import { courseCatalog } from '../data/catalog';

const catalogEhak = courseCatalog.find((c) => c.slug === 'ehak');

const ehakCourses: HubCourseItem[] = [
  ...(catalogEhak
    ? [
        {
          id: catalogEhak.slug,
          slug: catalogEhak.slug,
          title: catalogEhak.title,
          shortTitle: catalogEhak.shortTitle,
          tagline: catalogEhak.tagline,
          price: catalogEhak.price,
          duration: catalogEhak.duration,
          target: catalogEhak.target,
          suitableForHtml: catalogEhak.suitableForHtml,
          requirements: catalogEhak.requirements,
          exam: catalogEhak.exam,
          certification: catalogEhak.certification,
          inclusions: catalogEhak.inclusions,
          modules: catalogEhak.modules,
          image: catalogEhak.image,
        },
      ]
    : []),
  {
    id: 'ehak-herhaling',
    title: 'EHBO aan Kinderen Herhaling (Wet IKK)',
    shortTitle: 'EHAK Herhaling',
    tagline: 'Behoud uw geldige IKK-certificering voor de GGD-inspectie in 1 dagdeel',
    price: '€ 85,00',
    duration: '1 dagdeel (4 uur)',
    target:
      'Voor gecertificeerde pedagogisch medewerkers, leerkrachten en gastouders die hun 2-jaarlijkse kinder-EHBO herhaling moeten aantonen voor de GGD.',
    suitableForHtml: [
      'Speciaal ontwikkeld voor <strong>pedagogisch medewerkers in KDV en BSO, gastouders en basisschoolleerkrachten</strong> die reeds over een geldig EHAK-certificaat beschikken.',
      'Tijdens dit praktijkgerichte dagdeel frist u baby- en kinderreanimatie (PBLS), ernstige verslikking en actuele IKK/GGD-casuïstiek intensief op.',
    ],
    requirements: 'In het bezit van een geldig of recent verlopen EHAK-basiscertificaat.',
    exam: 'Praktische vaardigheidstoetsing op baby- en kinderreanimatiepoppen.',
    certification: 'Officiële verlenging van uw IKK-geregistreerde EHAK-certificaat (2 jaar geldig).',
    inclusions: [
      'Praktijktraining scenario’s',
      'IKK-certificaatverlenging',
      'GGD-compliance registratie',
      'Koffie, thee & parkeren',
    ],
    modules: [
      {
        name: 'Opfrissen baby- en kinderreanimatie (PBLS + AED)',
        description: 'Direct oefenen van de 5 initiële beademingen, 15:2 borstcompressies en kinderelektroden.',
      },
      {
        name: 'Handelen bij ernstige verslikking & verstikking',
        description: 'Rugslagen en borst-/buikstoten bij zuigelingen en oudere kinderen veilig toepassen.',
      },
      {
        name: 'Praktijkcasussen kinderopvang & basisschool',
        description: 'Koortsstuipen, allergische reacties (EpiPen), val van hoogte en brandwonden behandelen.',
      },
    ],
    image: 'https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?auto=format&fit=crop&q=80&w=600',
    requestUrl: '/persoonlijk-advies?course=ehak',
    incompanyUrl: '/persoonlijk-advies?type=zakelijk&course=ehak&mode=incompany',
  },
  {
    id: 'gastouder-ehbo',
    title: 'Gastouder EHBO Certificering (LRK Erkend)',
    shortTitle: 'Gastouder EHBO (LRK)',
    tagline: 'Landelijk geregistreerd certificaat voor het Landelijk Register Kinderopvang',
    price: '€ 125,00',
    duration: 'E-learning + 1 dagdeel (3,5 uur)',
    target:
      'Voor startende en ervaren gastouders die moeten voldoen aan de verplichte EHBO-inschrijfeisen van het Landelijk Register Kinderopvang (LRK).',
    requirements: 'Geen vooropleiding vereist.',
    exam: 'Online theorie + praktijktoetsing kinderreanimatie en acute kinder-EHBO.',
    certification: 'Officieel LRK- & Wet IKK-geregistreerd gastoudercertificaat (2 jaar geldig).',
    inclusions: [
      'Online E-learning module',
      '1 praktijksessie (3,5 uur)',
      'Officieel LRK-certificaat',
      'Koffie, thee & parkeren',
    ],
    modules: [
      {
        name: 'Reanimatie van baby’s (0–1 jaar) en kinderen',
        description: 'Levensreddend handelen en AED-gebruik afgestemd op de thuissituatie van de gastouder.',
      },
      {
        name: 'Vergiftiging, verslikking & ongevallen in huis',
        description: 'Adequaat reageren bij inname van schoonmaakmiddelen, planten, hete vloeistoffen of valpartijen.',
      },
      {
        name: 'Overdracht aan 112, huisartsenpost en ouders',
