---
import Layout from '../layouts/Layout.astro';
import PageHeroBackdrop from '../components/PageHeroBackdrop.astro';
import MobileCourseBottomBar from '../components/MobileCourseBottomBar.astro';

const services = [
  {
    id: "rie-compleet",
    title: "Complete RI&E Uitvoering & Toetsing",
    tagline: "Volledige risico-inventarisatie getoetst door gecertificeerd kerndeskundige",
    price: "Offerte op maat",
    spotsText: "Wettelijk verplicht",
    duration: "Doorlooptijd ca. 1-3 weken",
    target: "Voor alle werkgevers met personeel die willen voldoen aan de Arbowet en de eisen van verzekeraars en Inspectie SZW.",
    requirements: "Toegang tot de werkvloer voor inspectie en beschikbaarheid van preventiemedewerker / management.",
    exam: "Volledige toetsing en goedkeuring door een gecertificeerde kerndeskundige (HVK / A&O).",
    certification: "Officieel goedgekeurde RI&E + gevalideerd Plan van Aanpak met wettelijke status.",
    inclusions: [
      "Locatie-inspectie op de werkvloer door Arbo-specialist",
      "Vragenlijstonderzoek & inventarisatie fysieke en psychosociale risico's (PSA)",
      "Opstellen van het wettelijk verplichte Plan van Aanpak",
      "Toetsing door gecertificeerde kerndeskundige (indien vereist >25 mw)"
    ],
    modules: [
      { name: "Fysieke veiligheid: machines, gereedschap, valgevaar en brandveiligheid" },
      { name: "Fysieke belasting: tillen, beeldschermwerk en ergonomie" },
      { name: "Gevaarlijke stoffen, biologische agentia en blootstellingsrisico's" },
      { name: "Psychosociale arbeidsbelasting (werkdruk, ongewenst gedrag) & BHV-organisatie" }
    ],
    image: "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&q=80&w=800",
    registerLink: "/persoonlijk-advies?type=zakelijk&service=rie-advies"
  },
  {
    id: "rie-actualisatie",
    title: "Periodieke RI&E Actualisatie",
    tagline: "Up-to-date houden van uw bestaande RI&E bij verbouwing of proceswijziging",
    price: "Vanaf € 450,-",
    spotsText: "Jaarlijkse update",
    duration: "1 dag inspectie + rapportage",
    target: "Voor bedrijven die reeds een RI&E hebben maar te maken hebben met gewijzigde werkomstandigheden, nieuwe machines of nieuwbouw.",
    requirements: "Bestaande RI&E en het actuele Plan van Aanpak.",
    exam: "Voortgangscontrole op openstaande maatregelen uit het Plan van Aanpak.",
    certification: "Geactualiseerd auditrapport voor Arbodienst, Inspectie SZW en verzekeraar.",
    inclusions: [
      "Evaluatie van afgeronde actiepunten uit het Plan van Aanpak",
      "Herbeoordeling van gewijzigde werkplekken en risicocategorieën",
      "Bijwerken van het Arbobeleid en BHV-capaciteitsberekening",
      "Certificaat van actualiteit"
    ],
    modules: [
      { name: "Controle op uitvoering van eerdere actiepunten" },
      { name: "Nieuwe Arbo-wetgeving en NEN-normen implementeren" },
      { name: "Risicoherbeoordeling bij interne verhuizing of uitbreiding" },
      { name: "Managementrapportage voor directie en OR / PVT" }
    ],
    image: "https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&q=80&w=800",
    registerLink: "/persoonlijk-advies?type=zakelijk&service=rie-advies"
  }
];
---

<Layout 
  title="RI&E Audit & Plan van Aanpak | Risico-Inventarisatie Edusafe"
  description="Wettelijk verplichte Risico-Inventarisatie en -Evaluatie (RI&E) laten uitvoeren of toetsen. Praktisch, betaalbaar en conform Arbowet en Inspectie SZW."
>
  <!-- Hero Section -->
  <section class="relative bg-brand-primary text-white pt-12 pb-16 sm:pt-20 sm:pb-20 md:pt-24 md:pb-24 overflow-hidden">
    <PageHeroBackdrop
      image="https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&q=80&w=1600"
      alt="Risico-Inventarisatie & Evaluatie (RI&E)"
    />
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 relative z-10">
      
      <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-wider mb-3.5 sm:mb-4">
        <a href="/" class="hover:underline text-white/75 hover:text-white">Home</a>
        <span class="text-white/40">/</span>
        <span class="text-white/75">Diensten</span>
        <span class="text-white/40">/</span>
        <span class="text-brand-accent">RI&E Audit</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <div class="lg:col-span-8">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/12 text-white border border-white/25 backdrop-blur-sm text-xs font-bold uppercase tracking-wider mb-3.5 sm:mb-4">
            <i class="fa-solid fa-clipboard-check text-brand-accent"></i>
            Wettelijk Verplicht sinds 1994
          </span>
          <h1 class="heading-page mb-4 sm:mb-6 text-white">
            Risico-Inventarisatie &amp; <span class="text-brand-accent">Evaluatie (RI&E)</span>
          </h1>
          <p class="text-[15px] sm:text-lg text-white/90 leading-relaxed max-w-2xl mb-6 sm:mb-8">
            Het bieden van een gezonde en veilige werkomgeving begint met inzicht in de risico's. Edusafe brengt alle arbeidsrisico's helder in kaart en levert een praktisch, wettelijk getoetst Plan van Aanpak.
          </p>

          <div class="flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-3 sm:gap-4">
            <a href="/persoonlijk-advies?type=zakelijk&service=rie-advies" class="w-full sm:w-auto inline-flex items-center justify-center text-center min-h-[48px] bg-brand-accent hover:bg-brand-accent-hover text-white font-display font-semibold px-6 sm:px-8 py-3.5 sm:py-4 rounded-xl transition-all shadow-lg hover:-translate-y-0.5">
              Direct RI&E Offerte Aanvragen
            </a>
            <a href="#details" class="w-full sm:w-auto inline-flex items-center justify-center text-center min-h-[48px] bg-white/12 hover:bg-white/20 text-white border border-white/30 backdrop-blur-sm font-display font-semibold px-6 sm:px-8 py-3.5 sm:py-4 rounded-xl shadow-sm transition-all">
              Bekijk Werkwijze &amp; Toetsing
            </a>
          </div>
        </div>

        <div class="lg:col-span-4 grid grid-cols-2 gap-3 sm:gap-4">
          <div class="bg-[#062856]/50 backdrop-blur-md border border-white/20 rounded-2xl p-4 sm:p-5 text-center shadow-lg">
            <div class="text-2xl sm:text-3xl font-display font-bold text-white mb-1">100%</div>
            <div class="text-xs text-white/80">Inspectie SZW Proof</div>
          </div>
          <div class="bg-[#062856]/50 backdrop-blur-md border border-white/20 rounded-2xl p-4 sm:p-5 text-center shadow-lg">
            <div class="text-2xl sm:text-3xl font-display font-bold text-brand-accent mb-1">Arbowet</div>
            <div class="text-xs text-white/80">Wettelijk Getoetst</div>
          </div>
          <div class="bg-[#062856]/50 backdrop-blur-md border border-white/20 rounded-2xl p-4 sm:p-5 text-center shadow-lg">
            <div class="text-2xl sm:text-3xl font-display font-bold text-white mb-1">&lt; 25 mw</div>
            <div class="text-xs text-white/80">Toetsingsvrijstelling</div>
          </div>
          <div class="bg-[#062856]/50 backdrop-blur-md border border-white/20 rounded-2xl p-4 sm:p-5 text-center shadow-lg">
            <div class="text-2xl sm:text-3xl font-display font-bold text-brand-accent mb-1">Direct</div>
            <div class="text-xs text-white/80">Plan van Aanpak</div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Interactive Master Detail Tabs -->
  <section id="details" class="py-14 sm:py-20 bg-brand-cream relative">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6">
      
      <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
        <span class="text-brand-accent font-display font-semibold text-xs uppercase tracking-wider mb-2 block">
          Maatwerk voor uw organisatie
        </span>
        <h2 class="heading-section text-brand-secondary">
          Onze RI&E Dienstverlening
        </h2>
        <p class="text-brand-dark/70 text-[15px] sm:text-base mt-3">
          Kies voor een complete nieuwe opzet of een periodieke actualisatie van uw bestaande Risico-Inventarisatie.
        </p>
      </div>

      <!-- Service Cards Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8 mb-12 sm:mb-16">
        {services.map((srv) => (
          <div class="bg-white rounded-3xl p-5 sm:p-8 border border-brand-dark/5 shadow-xl flex flex-col justify-between hover:border-brand-primary/30 transition-all">
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2 sm:gap-4 mb-4">
                <span class="px-3 py-1 rounded-full bg-brand-primary/10 text-brand-primary text-xs font-bold uppercase tracking-wider">
                  {srv.spotsText}
                </span>
                <span class="text-lg font-display font-bold text-brand-accent">
                  {srv.price}
                </span>
              </div>
              <h3 class="font-display text-2xl font-semibold text-brand-secondary mb-2">
                {srv.title}
              </h3>
              <p class="text-brand-dark/70 text-sm mb-6 leading-relaxed">
                {srv.tagline}
              </p>

              <div class="space-y-4 mb-8">
                <div class="flex items-start gap-3">
                  <i class="fa-solid fa-clock text-brand-primary mt-1"></i>
                  <div>
                    <strong class="text-xs text-brand-secondary uppercase tracking-wider block">Doorlooptijd:</strong>
                    <span class="text-sm text-brand-dark/80">{srv.duration}</span>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <i class="fa-solid fa-shield-halved text-brand-primary mt-1"></i>
                  <div>
                    <strong class="text-xs text-brand-secondary uppercase tracking-wider block">Toetsing &amp; Certificering:</strong>
                    <span class="text-sm text-brand-dark/80">{srv.certification}</span>
                  </div>
                </div>
              </div>

              <h4 class="text-xs font-semibold uppercase tracking-wider text-brand-secondary mb-3">Inbegrepen in deze dienst:</h4>
              <ul class="space-y-2 mb-8">
                {srv.inclusions.map((inc) => (
                  <li class="flex items-center gap-2.5 text-sm text-brand-dark/80">
                    <i class="fa-solid fa-circle-check text-green-500 text-xs"></i>
                    <span>{inc}</span>
                  </li>
                ))}
              </ul>
            </div>

            <a 
              href="/persoonlijk-advies?type=zakelijk&service=rie-advies"
              class="w-full py-4 rounded-xl bg-brand-accent hover:bg-brand-accent-hover text-white font-display font-semibold text-center transition-all shadow-md block"
            >
              Vrijblijvende Offerte Aanvragen
            </a>
          </div>
        ))}
      </div>

      <!-- Why RI&E is Mandatory section -->
      <div class="bg-white rounded-3xl p-5 sm:p-8 lg:p-12 border border-brand-dark/5 shadow-sm">
        <h3 class="heading-section text-brand-secondary mb-6">
          Waarom is een actuele RI&E onmisbaar voor uw onderneming?
        </h3>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-sm text-brand-dark/80 leading-relaxed">
          <div class="p-5 rounded-2xl bg-brand-cream/50 border border-brand-dark/5">
            <div class="w-10 h-10 rounded-xl bg-brand-primary/10 text-brand-primary flex items-center justify-center mb-4">
              <i class="fa-solid fa-gavel text-lg"></i>
            </div>
            <h4 class="font-display font-semibold text-brand-secondary text-base mb-2">Wettelijke Verplichting</h4>
            <p>Sinds 1 januari 1994 verplicht voor alle bedrijven met personeel conform de Arbowet. De Inspectie SZW controleert hier strikt op en kan forse boetes opleggen.</p>
          </div>

          <div class="p-5 rounded-2xl bg-brand-cream/50 border border-brand-dark/5">
            <div class="w-10 h-10 rounded-xl bg-brand-accent/10 text-brand-accent flex items-center justify-center mb-4">
              <i class="fa-solid fa-file-contract text-lg"></i>
            </div>
            <h4 class="font-display font-semibold text-brand-secondary text-base mb-2">Verzekeringseisen</h4>
            <p>Zakelijke verzekeraars stellen een actuele en getoetste RI&E verplicht bij het afsluiten van de bedrijfsaansprakelijkheids- en brandverzekering.</p>
          </div>

          <div class="p-5 rounded-2xl bg-brand-cream/50 border border-brand-dark/5">
            <div class="w-10 h-10 rounded-xl bg-green-500/10 text-green-600 flex items-center justify-center mb-4">
              <i class="fa-solid fa-heart-pulse text-lg"></i>
            </div>
            <h4 class="font-display font-semibold text-brand-secondary text-base mb-2">Minder Verzuim</h4>
            <p>Gericht inzicht in fysieke belasting, psychosociale arbeidsbelasting (PSA) en werkplekveiligheid leidt direct tot een lager ziekteverzuim en hogere productiviteit.</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <MobileCourseBottomBar
    defaultCourse={services[0]}
    itemType="service"
    serviceSlug="rie-advies"
    advisorText="RI&E of Plan van Aanpak nodig?"
  />
</Layout>
