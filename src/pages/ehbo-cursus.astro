---
import CourseCategoryHub from '../components/CourseCategoryHub.astro';
import { courseCatalog } from '../data/catalog';

const ehboCourses = courseCatalog
  .filter((c) => c.category === 'EHBO')
  .map((c) => ({
    id: c.slug,
    slug: c.slug,
    title: c.title,
    shortTitle: c.shortTitle,
    tagline: c.tagline,
    price: c.price,
    duration: c.duration,
    target: c.target,
    suitableForHtml: c.suitableForHtml,
    requirements: c.requirements,
    exam: c.exam,
    certification: c.certification,
    inclusions: c.inclusions,
    modules: c.modules,
    learningOutcomes: c.learningOutcomes,
    image: c.image,
  }));
---

<CourseCategoryHub
  lang="nl"
  category="EHBO"
  seoTitle="EHBO Cursus & Kinder-EHBO (Oranje Kruis / NRR Erkend) | Edusafe"
  seoDescription="Volg een erkende EHBO cursus bij Edusafe. Van het officiële Diploma Eerste Hulp (Oranje Kruis) tot Kinder-EHBO (Wet IKK) en Reanimatie & AED. Vergoeding zorgverzekeraar mogelijk."
  breadcrumbLabel="EHBO Opleidingen"
  heroTitle="EHBO Cursus & Eerste Hulp Opleidingen"
  heroSubtitle="Leer levensreddend handelen bij ongevallen, reanimatie en kinder-EHBO. Erkend volgens de richtlijnen van Het Oranje Kruis, NRR en de Wet IKK."
  heroImage="https://images.unsplash.com/photo-1603398938378-e54eab446dde?auto=format&fit=crop&q=80&w=1600"
  heroBullets={[
    'Oranje Kruis / NRR erkend',
    'Wet IKK & GGD gecertificeerd',
    'Vergoeding zorgverzekeraar',
    'Den Haag of Incompany',
  ]}
  primaryCtaUrl="/persoonlijk-advies?category=EHBO"
  courses={ehboCourses}
  coursesHeading="Alle gecertificeerde EHBO-opleidingen"
  faqTitle="EHBO & Kinder-EHBO"
  advisorText="Persoonlijk advies over EHBO-certificering?"
/>
