---
import Layout from '../../layouts/Layout.astro';

// Course data shared with cursusdata.astro
import { courses } from '../../data/courses.js';

export async function getStaticPaths() {
  return courses.map(course => ({
    params: { id: course.id },
    props: { course }
  }));
}

const { course } = Astro.props;
---

<Layout title={`Inschrijven voor ${course.title} | Edusafe`} description={`Reserveer direct uw plek voor de training ${course.title} bij Edusafe op ${course.date}.`}>
  <main class="w-full">
    
    <!-- Hero Detail Header (Spacious, Rich Photography & Directional Gradient) -->
    <section class="relative bg-brand-secondary text-white pt-20 pb-20 sm:pb-24 md:pt-24 md:pb-28 overflow-hidden">
      <!-- Background pattern/image overlay -->
      <div class="absolute inset-0 z-0 overflow-hidden">
        <img src={course.image} alt={course.title} class="w-full h-full object-cover opacity-30 scale-105" />
        <div class="absolute inset-0 bg-gradient-to-r from-brand-secondary via-brand-secondary/85 to-brand-secondary/40"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-brand-secondary via-transparent to-black/20"></div>
      </div>
      
      <div class="max-w-[1280px] mx-auto px-6 relative z-10">
        <!-- Back Button -->
        <a href="/cursusdata" class="inline-flex items-center gap-2 text-white/85 hover:text-white mb-6 transition-all duration-300 font-semibold bg-white/10 hover:bg-white/20 backdrop-blur-md px-3.5 py-1.5 rounded-xl border border-white/20 text-xs group">
          <i class="fa-solid fa-arrow-left text-[10px] group-hover:-translate-x-1 transition-transform"></i>
          <span>Terug naar alle cursusdata</span>
        </a>

        <div class="max-w-4xl animate-fade-in">
          <!-- Category Tag -->
          <span class="inline-flex items-center gap-1.5 text-brand-accent font-display font-semibold text-xs uppercase tracking-wider mb-3.5">
            <i class="fa-solid fa-graduation-cap"></i>
            {course.category} Opleiding
          </span>
          
          <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tight leading-tight mb-4 text-white">
            Direct <span class="relative inline-block text-white px-5 py-2 mx-1 transform -rotate-1"><span class="absolute inset-0 bg-brand-accent rounded-2xl z-0"></span><span class="relative z-10">inschrijven</span></span> voor {course.title}
          </h1>
          <p class="text-white/90 text-base md:text-lg max-w-2xl font-normal leading-relaxed">
            Reserveer direct uw plek voor deze professionele training bij Edusafe en ontvang na afloop een officieel certificaat.
          </p>
        </div>
      </div>
    </section>

    <!-- Content & Form Area -->
    <section class="max-w-[1280px] mx-auto px-6 -mt-10 sm:-mt-12 md:-mt-14 relative z-30 pb-24">
      
      <!-- Key Details Card (floating 50/50 over hero bottom line) -->
      <div class="bg-white rounded-2xl shadow-xl shadow-brand-dark/10 border border-brand-dark/5 p-5 sm:p-6 md:p-7 mb-8 grid grid-cols-2 lg:grid-cols-5 gap-4 md:gap-6">
        <!-- Datum -->
        <div class="flex items-center gap-3.5">
          <div class="h-11 w-11 rounded-xl bg-brand-primary/10 flex items-center justify-center text-brand-primary shrink-0">
            <i class="fa-solid fa-calendar-days text-lg"></i>
          </div>
          <div>
            <span class="text-[9px] uppercase font-semibold tracking-wider text-brand-dark/40 block mb-0.5">Datum</span>
            <span class="font-display font-semibold text-brand-secondary text-sm md:text-base">{course.date}</span>
          </div>
        </div>

        <!-- Tijd -->
        <div class="flex items-center gap-3.5">
          <div class="h-11 w-11 rounded-xl bg-brand-primary/10 flex items-center justify-center text-brand-primary shrink-0">
            <i class="fa-solid fa-clock text-lg"></i>
          </div>
          <div>
            <span class="text-[9px] uppercase font-semibold tracking-wider text-brand-dark/40 block mb-0.5">Tijdstip</span>
            <span class="font-display font-semibold text-brand-secondary text-sm md:text-base">{course.time}</span>
          </div>
        </div>

        <!-- Locatie -->
        <div class="flex items-center gap-3.5 col-span-2 lg:col-span-1">
          <div class="h-11 w-11 rounded-xl bg-brand-primary/10 flex items-center justify-center text-brand-primary shrink-0">
            <i class="fa-solid fa-location-dot text-lg"></i>
          </div>
          <div class="min-w-0">
            <span class="text-[9px] uppercase font-semibold tracking-wider text-brand-dark/40 block mb-0.5">Locatie</span>
            <span class="font-display font-semibold text-brand-secondary text-sm md:text-base block truncate" title={course.location}>{course.location}</span>
          </div>
        </div>

        <!-- Prijs -->
        <div class="flex items-center gap-3.5">
          <div class="h-11 w-11 rounded-xl bg-brand-primary/10 flex items-center justify-center text-brand-primary shrink-0">
            <i class="fa-solid fa-euro-sign text-lg"></i>
          </div>
          <div>
            <span class="text-[9px] uppercase font-semibold tracking-wider text-brand-dark/40 block mb-0.5">Prijs (excl. BTW)</span>
            <span class="font-display font-semibold text-brand-accent text-sm md:text-base">{course.price}</span>
          </div>
        </div>

        <!-- Plekken -->
        <div class="flex items-center gap-3.5">
          <div class="h-11 w-11 rounded-xl bg-brand-primary/10 flex items-center justify-center text-brand-primary shrink-0">
            <i class="fa-solid fa-users text-lg"></i>
          </div>
          <div>
            <span class="text-[9px] uppercase font-semibold tracking-wider text-brand-dark/40 block mb-0.5">Beschikbaarheid</span>
            <span class="font-display font-semibold text-brand-secondary text-sm md:text-base">{course.freeSpots}</span>
          </div>
        </div>
      </div>

      <!-- Main Layout Split -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        
        <!-- Left Side: Why Edusafe & Assistance -->
        <div class="lg:col-span-5 space-y-6 flex flex-col justify-between">
          
          <!-- Why Cards -->
          <div class="bg-white rounded-2xl p-6 sm:p-7 shadow-lg border border-brand-dark/5 flex-1 reveal">
            <h3 class="font-display text-xl sm:text-2xl font-semibold text-brand-secondary mb-3">
              Waarom kiezen voor Edusafe?
            </h3>
            <p class="text-brand-dark/70 text-xs sm:text-sm leading-relaxed mb-6 font-normal">
              Bij Edusafe staat kwaliteit en praktijkgerichtheid centraal. Onze trainingen worden verzorgd door ervaren instructeurs die de theorie direct vertalen naar de praktijk.
            </p>
            
            <div class="space-y-4">
              <!-- Item 1 -->
              <div class="flex items-start gap-3.5 group">
                <div class="h-10 w-10 rounded-xl bg-brand-primary/10 flex items-center justify-center text-brand-primary shrink-0 mt-0.5 transition-colors group-hover:bg-brand-primary/15">
                  <i class="fa-solid fa-certificate text-base"></i>
                </div>
                <div>
                  <h4 class="font-display font-semibold text-brand-secondary text-sm sm:text-base mb-0.5">Erkende Certificering</h4>
                  <p class="text-brand-dark/70 text-xs leading-relaxed font-normal">U ontvangt na succesvolle afronding een officieel erkend certificaat dat voldoet aan alle wettelijke eisen.</p>
                </div>
              </div>

              <!-- Item 2 -->
              <div class="flex items-start gap-3.5 group">
                <div class="h-10 w-10 rounded-xl bg-brand-primary/10 flex items-center justify-center text-brand-primary shrink-0 mt-0.5 transition-colors group-hover:bg-brand-primary/15">
                  <i class="fa-solid fa-graduation-cap text-base"></i>
                </div>
                <div>
                  <h4 class="font-display font-semibold text-brand-secondary text-sm sm:text-base mb-0.5">Praktijkgerichte Aanpak</h4>
                  <p class="text-brand-dark/70 text-xs leading-relaxed font-normal">Direct toepasbare kennis door realistische scenario-trainingen in een veilige leeromgeving.</p>
                </div>
              </div>

              <!-- Item 3 -->
              <div class="flex items-start gap-3.5 group">
                <div class="h-10 w-10 rounded-xl bg-brand-primary/10 flex items-center justify-center text-brand-primary shrink-0 mt-0.5 transition-colors group-hover:bg-brand-primary/15">
                  <i class="fa-solid fa-user-group text-base"></i>
                </div>
                <div>
                  <h4 class="font-display font-semibold text-brand-secondary text-sm sm:text-base mb-0.5">Kleine Groepen</h4>
                  <p class="text-brand-dark/70 text-xs leading-relaxed font-normal">Maximale aandacht voor elke cursist voor het beste leerresultaat en persoonlijke begeleiding.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Need Help Card -->
          <div class="bg-brand-secondary text-white rounded-2xl p-6 sm:p-7 relative overflow-hidden shadow-lg group reveal">
            <!-- Background doodle -->
            <div class="absolute -right-10 -bottom-10 text-white/5 pointer-events-none transition-transform duration-700 group-hover:scale-110">
              <i class="fa-solid fa-shield-halved text-[200px]"></i>
            </div>
            
            <div class="relative z-10">
              <span class="text-[10px] font-semibold text-brand-accent uppercase tracking-wider block mb-1">Direct contact</span>
              <h4 class="font-display text-xl font-semibold mb-2 text-white">Vragen over deze datum?</h4>
              <p class="text-white/80 text-xs sm:text-sm leading-relaxed mb-6 font-normal">
                Onze opleidingsadviseurs staan voor u klaar om al uw vragen te beantwoorden of groepen in te plannen.
              </p>
              
              <div class="space-y-3">
                <a href="tel:0704447795" class="flex items-center gap-3 font-display font-semibold text-sm sm:text-base text-white hover:text-brand-accent transition-colors group/link w-fit">
                  <div class="h-9 w-9 rounded-xl bg-white/10 flex items-center justify-center group-hover/link:bg-white/20 transition-all">
                    <i class="fa-solid fa-phone text-xs"></i>
                  </div>
                  <span>070 - 444 77 95</span>
                </a>
                <a href="mailto:info@edusafe.nl" class="flex items-center gap-3 font-display font-semibold text-sm sm:text-base text-white hover:text-brand-accent transition-colors group/link w-fit">
                  <div class="h-9 w-9 rounded-xl bg-white/10 flex items-center justify-center group-hover/link:bg-white/20 transition-all">
                    <i class="fa-solid fa-envelope text-xs"></i>
                  </div>
                  <span>info@edusafe.nl</span>
                </a>
              </div>
            </div>
          </div>

        </div>

        <!-- Right Side: Enrollment Form -->
        <div class="lg:col-span-7">
          <div class="bg-white rounded-2xl shadow-lg border border-brand-dark/5 p-6 sm:p-8 h-full flex flex-col justify-between reveal">
            <div class="mb-6">
              <h2 class="font-display text-xl sm:text-2xl font-semibold text-brand-secondary mb-1.5">Direct Inschrijven</h2>
              <p class="text-brand-dark/70 text-xs sm:text-sm font-normal">Vul onderstaand formulier in om uw plek voor deze cursusdatum te reserveren.</p>
            </div>
            
            <form id="enrollment-form" class="space-y-4 flex-1 flex flex-col justify-between" onsubmit="event.preventDefault(); document.getElementById('success-modal').style.display = 'flex';">
              
              <!-- Geslacht -->
              <div class="space-y-1.5">
                <span class="text-xs font-semibold text-brand-secondary uppercase tracking-wider block">Aanhef</span>
                <div class="flex gap-6">
                  <label class="flex items-center gap-2 cursor-pointer group text-xs sm:text-sm font-medium text-brand-dark/85 hover:text-brand-primary transition-colors">
                    <input type="radio" name="gender" class="w-4 h-4 accent-brand-primary cursor-pointer" required value="male" checked>
                    Dhr.
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer group text-xs sm:text-sm font-medium text-brand-dark/85 hover:text-brand-primary transition-colors">
                    <input type="radio" name="gender" class="w-4 h-4 accent-brand-primary cursor-pointer" required value="female">
                    Mevr.
                  </label>
                </div>
              </div>

              <!-- Name Grid -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                  <label for="firstName" class="text-xs font-semibold text-brand-secondary uppercase tracking-wider block">Voornaam</label>
                  <input 
                    type="text" 
                    id="firstName" 
                    name="firstName" 
                    class="w-full border border-brand-dark/10 px-4 py-3 rounded-xl text-sm bg-brand-cream/30 focus:outline-none focus:border-brand-primary transition-colors font-medium text-brand-secondary placeholder:text-brand-dark/35"
                    placeholder="Bijv. Jan" 
                    required
                  />
                </div>
                <div class="space-y-1.5">
                  <label for="lastName" class="text-xs font-semibold text-brand-secondary uppercase tracking-wider block">Achternaam</label>
                  <input 
                    type="text" 
                    id="lastName" 
                    name="lastName" 
                    class="w-full border border-brand-dark/10 px-4 py-3 rounded-xl text-sm bg-brand-cream/30 focus:outline-none focus:border-brand-primary transition-colors font-medium text-brand-secondary placeholder:text-brand-dark/35"
                    placeholder="Bijv. de Vries" 
                    required
                  />
                </div>
              </div>

              <!-- Contact Grid -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                  <label for="email" class="text-xs font-semibold text-brand-secondary uppercase tracking-wider block">E-mailadres</label>
                  <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    class="w-full border border-brand-dark/10 px-4 py-3 rounded-xl text-sm bg-brand-cream/30 focus:outline-none focus:border-brand-primary transition-colors font-medium text-brand-secondary placeholder:text-brand-dark/35"
                    placeholder="jan@voorbeeld.nl" 
                    required
                  />
                </div>
                <div class="space-y-1.5">
                  <label for="phone" class="text-xs font-semibold text-brand-secondary uppercase tracking-wider block">Telefoonnummer</label>
                  <input 
                    type="tel" 
                    id="phone" 
                    name="phone" 
                    class="w-full border border-brand-dark/10 px-4 py-3 rounded-xl text-sm bg-brand-cream/30 focus:outline-none focus:border-brand-primary transition-colors font-medium text-brand-secondary placeholder:text-brand-dark/35"
                    placeholder="06 12345678" 
                    required
                  />
                </div>
              </div>

              <!-- Bedrijfsnaam -->
              <div class="space-y-1.5">
                <label for="company" class="text-xs font-semibold text-brand-secondary uppercase tracking-wider block">Bedrijfsnaam (optioneel)</label>
                <input 
                  type="text" 
                  id="company" 
                  name="company" 
                  class="w-full border border-brand-dark/10 px-4 py-3 rounded-xl text-sm bg-brand-cream/30 focus:outline-none focus:border-brand-primary transition-colors font-medium text-brand-secondary placeholder:text-brand-dark/35"
                  placeholder="Bijv. Bedrijf B.V."
                />
              </div>

              <!-- Address Straat + Postcode -->
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="md:col-span-2 space-y-1.5">
                  <label for="street" class="text-xs font-semibold text-brand-secondary uppercase tracking-wider block">Straat + Huisnummer</label>
                  <input 
                    type="text" 
                    id="street" 
                    name="street" 
                    class="w-full border border-brand-dark/10 px-4 py-3 rounded-xl text-sm bg-brand-cream/30 focus:outline-none focus:border-brand-primary transition-colors font-medium text-brand-secondary placeholder:text-brand-dark/35"
                    placeholder="Hoofdstraat 1" 
                    required
                  />
                </div>
                <div class="space-y-1.5">
                  <label for="postalCode" class="text-xs font-semibold text-brand-secondary uppercase tracking-wider block">Postcode</label>
                  <input 
                    type="text" 
                    id="postalCode" 
                    name="postalCode" 
                    class="w-full border border-brand-dark/10 px-4 py-3 rounded-xl text-sm bg-brand-cream/30 focus:outline-none focus:border-brand-primary transition-colors font-medium text-brand-secondary placeholder:text-brand-dark/35"
                    placeholder="1234 AB" 
                    required
                  />
                </div>
              </div>

              <!-- Woonplaats -->
              <div class="space-y-1.5">
                <label for="city" class="text-xs font-semibold text-brand-secondary uppercase tracking-wider block">Woonplaats</label>
                <input 
                  type="text" 
                  id="city" 
                  name="city" 
                  class="w-full border border-brand-dark/10 px-4 py-3 rounded-xl text-sm bg-brand-cream/30 focus:outline-none focus:border-brand-primary transition-colors font-medium text-brand-secondary placeholder:text-brand-dark/35"
                  placeholder="Den Haag" 
                  required
                />
              </div>

              <!-- Notes -->
              <div class="space-y-1.5">
                <label for="notes" class="text-xs font-semibold text-brand-secondary uppercase tracking-wider block">Opmerkingen (optioneel)</label>
                <textarea 
                  id="notes" 
                  name="notes" 
                  rows="2" 
                  class="w-full border border-brand-dark/10 px-4 py-2.5 rounded-xl text-sm bg-brand-cream/30 focus:outline-none focus:border-brand-primary transition-colors font-medium text-brand-secondary placeholder:text-brand-dark/35 resize-none"
                  placeholder="Heeft u specifieke wensen of dieetwensen voor de lunch?"
                ></textarea>
              </div>

              <!-- Agreement -->
              <div class="flex items-start gap-2.5 py-1">
                <input type="checkbox" id="agree" class="w-4 h-4 accent-brand-primary cursor-pointer mt-0.5" required />
                <label for="agree" class="text-xs text-brand-dark/70 leading-relaxed cursor-pointer select-none font-normal">
                  Ik ga akkoord met de <a href="#" class="text-brand-primary font-semibold hover:underline">algemene voorwaarden</a> en het privacybeleid van Edusafe.
                </label>
              </div>

              <!-- Submit Button -->
              <button 
                type="submit" 
                class="font-display font-semibold text-sm sm:text-base py-3.5 px-6 rounded-xl text-center bg-brand-accent text-white hover:bg-brand-accent-hover transition-all duration-300 w-full shadow-md shadow-brand-accent/20 hover:-translate-y-0.5 active:scale-[0.99] cursor-pointer mt-2"
              >
                Inschrijving Voltooien & Reserveren
              </button>

            </form>
          </div>
        </div>

      </div>

    </section>

    <!-- Success Modal popup -->
    <div id="success-modal" class="fixed inset-0 bg-brand-secondary/60 backdrop-blur-sm z-[999] hidden items-center justify-center p-6">
      <div class="bg-white rounded-2xl p-6 sm:p-8 max-w-md w-full shadow-2xl text-center border border-brand-dark/5 relative animate-fade-in">
        <div class="w-14 h-14 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-2xl mx-auto mb-4">
          <i class="fa-solid fa-circle-check"></i>
        </div>
        <h3 class="font-display text-xl sm:text-2xl font-semibold text-brand-secondary mb-2">Inschrijving Ontvangen!</h3>
        <p class="text-brand-dark/70 text-xs sm:text-sm leading-relaxed mb-6 font-normal">
          Hartelijk dank voor uw inschrijving. Wij hebben uw reservering voor <strong class="text-brand-secondary font-semibold">{course.title}</strong> op <strong class="text-brand-secondary font-semibold">{course.date}</strong> succesvol ontvangen. U ontvangt binnen enkele minuten een bevestiging per e-mail.
        </p>
        <button 
          onclick="document.getElementById('success-modal').style.display = 'none'; window.location.href = '/cursusdata';" 
          class="font-display font-semibold text-sm py-3 px-6 rounded-xl bg-brand-primary text-white hover:bg-brand-primary-hover transition-all duration-300 w-full cursor-pointer"
        >
          Terug naar Cursusdata
        </button>
      </div>
    </div>

  </main>
</Layout>
