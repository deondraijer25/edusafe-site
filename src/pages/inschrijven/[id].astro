---
import Layout from '../../layouts/Layout.astro';

// Course data shared with cursusdata.astro
import { courses } from '../../data/courses.js';

export async function getStaticPaths() {
  return courses.map(course => ({
    params: { id: course.id },
    props: { course }
  }));
}

const { course } = Astro.props;
---

<Layout title={`Inschrijven voor ${course.title} | Edusafe`} description={`Reserveer direct uw plek voor de training ${course.title} bij Edusafe op ${course.date}.`}>
  <main class="w-full">
    
    <!-- Hero Detail Header -->
    <section class="relative bg-brand-secondary text-white pt-28 pb-40 md:pt-36 md:pb-48 overflow-hidden">
      <!-- Background pattern/image overlay -->
      <div class="absolute inset-0 z-0 overflow-hidden bg-brand-cream/5">
        <img src={course.image} alt={course.title} class="w-full h-full object-cover opacity-20 blur-sm scale-105" />
        <div class="absolute inset-0 bg-gradient-to-r from-brand-secondary via-brand-secondary/90 to-transparent"></div>
      </div>
      
      <div class="max-w-[1280px] mx-auto px-6 relative z-10">
        <!-- Back Button -->
        <a href="/cursusdata" class="inline-flex items-center gap-2 text-white/80 hover:text-white mb-8 transition-all duration-300 font-bold bg-white/10 backdrop-blur-md px-4 py-2 rounded-2xl border border-white/15 text-xs group">
          <i class="fa-solid fa-arrow-left group-hover:-translate-x-1 transition-transform"></i>
          Terug naar alle cursusdata
        </a>

        <div class="max-w-4xl">
          <!-- Category Tag -->
          <span class="inline-flex items-center bg-brand-accent text-white text-xs font-black px-4 py-1.5 rounded-full shadow-md uppercase tracking-wider mb-6">
            {course.category}
          </span>
          
          <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-black tracking-tight leading-tight mb-6 text-white">
            Direct <span class="relative inline-block text-white px-5 py-2 mx-1 mt-2 transform -rotate-1"><span class="absolute inset-0 bg-brand-accent rounded-2xl z-0"></span><span class="relative z-10">inschrijven</span></span> voor {course.title}
          </h1>
          <p class="text-white/80 text-base md:text-lg max-w-2xl font-semibold leading-relaxed">
            Reserveer direct uw plek voor deze professionele training bij Edusafe en ontvang na afloop een officieel certificaat.
          </p>
        </div>
      </div>
    </section>

    <!-- Content & Form Area -->
    <section class="max-w-[1280px] mx-auto px-6 -mt-24 relative z-20 pb-24">
      
      <!-- Key Details Card (floating) -->
      <div class="bg-white rounded-3xl shadow-xl border border-brand-dark/5 p-6 md:p-8 mb-10 grid grid-cols-2 lg:grid-cols-5 gap-6 md:gap-8">
        <!-- Datum -->
        <div class="flex items-center gap-4">
          <div class="h-12 w-12 rounded-2xl bg-brand-primary/10 flex items-center justify-center text-brand-primary shrink-0">
            <i class="fa-solid fa-calendar-days text-xl"></i>
          </div>
          <div>
            <span class="text-[10px] uppercase font-black tracking-wider text-brand-dark/45 block mb-0.5">Datum</span>
            <span class="font-display font-black text-brand-secondary text-sm md:text-base">{course.date}</span>
          </div>
        </div>

        <!-- Tijd -->
        <div class="flex items-center gap-4">
          <div class="h-12 w-12 rounded-2xl bg-brand-primary/10 flex items-center justify-center text-brand-primary shrink-0">
            <i class="fa-solid fa-clock text-xl"></i>
          </div>
          <div>
            <span class="text-[10px] uppercase font-black tracking-wider text-brand-dark/45 block mb-0.5">Tijdstip</span>
            <span class="font-display font-black text-brand-secondary text-sm md:text-base">{course.time}</span>
          </div>
        </div>

        <!-- Locatie -->
        <div class="flex items-center gap-4 col-span-2 lg:col-span-1">
          <div class="h-12 w-12 rounded-2xl bg-brand-primary/10 flex items-center justify-center text-brand-primary shrink-0">
            <i class="fa-solid fa-location-dot text-xl"></i>
          </div>
          <div>
            <span class="text-[10px] uppercase font-black tracking-wider text-brand-dark/45 block mb-0.5">Locatie</span>
            <span class="font-display font-black text-brand-secondary text-sm md:text-base block truncate max-w-[160px]">{course.location}</span>
          </div>
        </div>

        <!-- Prijs -->
        <div class="flex items-center gap-4">
          <div class="h-12 w-12 rounded-2xl bg-brand-primary/10 flex items-center justify-center text-brand-primary shrink-0">
            <i class="fa-solid fa-euro-sign text-xl"></i>
          </div>
          <div>
            <span class="text-[10px] uppercase font-black tracking-wider text-brand-dark/45 block mb-0.5">Prijs</span>
            <span class="font-display font-black text-brand-accent text-sm md:text-base">{course.price}</span>
          </div>
        </div>

        <!-- Plekken -->
        <div class="flex items-center gap-4">
          <div class="h-12 w-12 rounded-2xl bg-brand-primary/10 flex items-center justify-center text-brand-primary shrink-0">
            <i class="fa-solid fa-users text-xl"></i>
          </div>
          <div>
            <span class="text-[10px] uppercase font-black tracking-wider text-brand-dark/45 block mb-0.5">Beschikbaarheid</span>
            <span class="font-display font-black text-brand-secondary text-sm md:text-base">{course.freeSpots}</span>
          </div>
        </div>
      </div>

      <!-- Main Layout Split -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        
        <!-- Left Side: Why Edusafe & Assistance -->
        <div class="lg:col-span-5 space-y-8 flex flex-col justify-between">
          
          <!-- Why Cards -->
          <div class="bg-white rounded-3xl p-8 shadow-lg border border-brand-dark/5 flex-1 reveal">
            <h3 class="font-display text-2xl font-black text-brand-secondary mb-6">
              Waarom kiezen voor Edusafe?
            </h3>
            <p class="text-brand-dark/70 text-sm leading-relaxed mb-8">
              Bij Edusafe staat kwaliteit en praktijkgerichtheid centraal. Onze trainingen worden verzorgd door ervaren instructeurs die de theorie direct vertalen naar de praktijk.
            </p>
            
            <div class="space-y-6">
              <!-- Item 1 -->
              <div class="flex gap-4 group">
                <div class="h-12 w-12 rounded-2xl bg-brand-primary/10 flex items-center justify-center text-brand-primary shrink-0 mt-0.5 transition-colors group-hover:bg-brand-primary/15">
                  <i class="fa-solid fa-certificate text-lg"></i>
                </div>
                <div>
                  <h4 class="font-display font-black text-brand-secondary text-base mb-1">Erkende Certificering</h4>
                  <p class="text-brand-dark/60 text-xs leading-relaxed">U ontvangt na succesvolle afronding een officieel erkend certificaat dat voldoet aan alle wettelijke eisen.</p>
                </div>
              </div>

              <!-- Item 2 -->
              <div class="flex gap-4 group">
                <div class="h-12 w-12 rounded-2xl bg-brand-primary/10 flex items-center justify-center text-brand-primary shrink-0 mt-0.5 transition-colors group-hover:bg-brand-primary/15">
                  <i class="fa-solid fa-graduation-cap text-lg"></i>
                </div>
                <div>
                  <h4 class="font-display font-black text-brand-secondary text-base mb-1">Praktijkgerichte Aanpak</h4>
                  <p class="text-brand-dark/60 text-xs leading-relaxed">Direct toepasbare kennis door realistische scenario-trainingen in een veilige leeromgeving.</p>
                </div>
              </div>

              <!-- Item 3 -->
              <div class="flex gap-4 group">
                <div class="h-12 w-12 rounded-2xl bg-brand-primary/10 flex items-center justify-center text-brand-primary shrink-0 mt-0.5 transition-colors group-hover:bg-brand-primary/15">
                  <i class="fa-solid fa-user-group text-lg"></i>
                </div>
                <div>
                  <h4 class="font-display font-black text-brand-secondary text-base mb-1">Kleine Groepen</h4>
                  <p class="text-brand-dark/60 text-xs leading-relaxed">Maximale aandacht voor elke cursist voor het beste leerresultaat en persoonlijke begeleiding.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Need Help Card -->
          <div class="bg-brand-secondary text-white rounded-3xl p-8 relative overflow-hidden shadow-lg group reveal">
            <!-- Background doodle -->
            <div class="absolute -right-12 -bottom-12 text-white/5 pointer-events-none transition-transform duration-700 group-hover:scale-110">
              <i class="fa-solid fa-shield-halved text-[240px]"></i>
            </div>
            
            <div class="relative z-10">
              <h4 class="font-display text-2xl font-black mb-3">Hulp nodig?</h4>
              <p class="text-white/70 text-sm leading-relaxed mb-8">
                Onze adviseurs staan klaar om al uw vragen over deze training te beantwoorden.
              </p>
              
              <div class="space-y-4">
                <a href="tel:0704447795" class="flex items-center gap-4 font-display font-black text-lg hover:text-brand-accent transition-colors group/link w-fit">
                  <div class="h-10 w-10 rounded-xl bg-white/10 flex items-center justify-center group-hover/link:bg-white/20 transition-all">
                    <i class="fa-solid fa-phone text-sm"></i>
                  </div>
                  070 444 77 95
                </a>
                <a href="mailto:info@edusafe.nl" class="flex items-center gap-4 font-display font-black text-lg hover:text-brand-accent transition-colors group/link w-fit">
                  <div class="h-10 w-10 rounded-xl bg-white/10 flex items-center justify-center group-hover/link:bg-white/20 transition-all">
                    <i class="fa-solid fa-envelope text-sm"></i>
                  </div>
                  info@edusafe.nl
                </a>
              </div>
            </div>
          </div>

        </div>

        <!-- Right Side: Enrollment Form -->
        <div class="lg:col-span-7">
          <div class="bg-white rounded-3xl shadow-lg border border-brand-dark/5 p-8 h-full flex flex-col justify-between reveal">
            <div class="mb-8">
              <h2 class="font-display text-2xl font-black text-brand-secondary mb-2">Direct Inschrijven</h2>
              <p class="text-brand-dark/60 text-sm">Vul onderstaand formulier in om uw plek te reserveren.</p>
            </div>
            
            <form id="enrollment-form" class="space-y-5 flex-1 flex flex-col justify-between" onsubmit="event.preventDefault(); document.getElementById('success-modal').style.display = 'flex';">
              
              <!-- Geslacht -->
              <div class="space-y-2">
                <span class="text-xs font-bold text-brand-secondary uppercase tracking-wider block">Geslacht</span>
                <div class="flex gap-6">
                  <label class="flex items-center gap-2 cursor-pointer group text-sm font-semibold text-brand-dark/85 hover:text-brand-primary transition-colors">
                    <input type="radio" name="gender" class="w-4.5 h-4.5 accent-brand-primary cursor-pointer" required value="male">
                    Dhr.
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer group text-sm font-semibold text-brand-dark/85 hover:text-brand-primary transition-colors">
                    <input type="radio" name="gender" class="w-4.5 h-4.5 accent-brand-primary cursor-pointer" required value="female">
                    Mevr.
                  </label>
                </div>
              </div>

              <!-- Name Grid -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div class="space-y-2">
                  <label for="firstName" class="text-xs font-bold text-brand-secondary uppercase tracking-wider block">Voornaam</label>
                  <input 
                    type="text" 
                    id="firstName" 
                    name="firstName" 
                    class="w-full border border-brand-dark/10 px-4 py-3 rounded-xl text-sm bg-brand-cream/10 focus:outline-none focus:border-brand-primary/45 transition-colors font-medium text-brand-secondary placeholder:text-brand-dark/35"
                    placeholder="Bijv. Jan" 
                    required
                  />
                </div>
                <div class="space-y-2">
                  <label for="lastName" class="text-xs font-bold text-brand-secondary uppercase tracking-wider block">Achternaam</label>
                  <input 
                    type="text" 
                    id="lastName" 
                    name="lastName" 
                    class="w-full border border-brand-dark/10 px-4 py-3 rounded-xl text-sm bg-brand-cream/10 focus:outline-none focus:border-brand-primary/45 transition-colors font-medium text-brand-secondary placeholder:text-brand-dark/35"
                    placeholder="Bijv. de Vries" 
                    required
                  />
                </div>
              </div>

              <!-- Contact Grid -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div class="space-y-2">
                  <label for="email" class="text-xs font-bold text-brand-secondary uppercase tracking-wider block">E-mailadres</label>
                  <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    class="w-full border border-brand-dark/10 px-4 py-3 rounded-xl text-sm bg-brand-cream/10 focus:outline-none focus:border-brand-primary/45 transition-colors font-medium text-brand-secondary placeholder:text-brand-dark/35"
                    placeholder="jan@voorbeeld.nl" 
                    required
                  />
                </div>
                <div class="space-y-2">
                  <label for="phone" class="text-xs font-bold text-brand-secondary uppercase tracking-wider block">Telefoonnummer</label>
                  <input 
                    type="tel" 
                    id="phone" 
                    name="phone" 
                    class="w-full border border-brand-dark/10 px-4 py-3 rounded-xl text-sm bg-brand-cream/10 focus:outline-none focus:border-brand-primary/45 transition-colors font-medium text-brand-secondary placeholder:text-brand-dark/35"
                    placeholder="06 12345678" 
                    required
                  />
                </div>
              </div>

              <!-- Bedrijfsnaam -->
              <div class="space-y-2">
                <label for="company" class="text-xs font-bold text-brand-secondary uppercase tracking-wider block">Bedrijfsnaam (optioneel)</label>
                <input 
                  type="text" 
                  id="company" 
                  name="company" 
                  class="w-full border border-brand-dark/10 px-4 py-3 rounded-xl text-sm bg-brand-cream/10 focus:outline-none focus:border-brand-primary/45 transition-colors font-medium text-brand-secondary placeholder:text-brand-dark/35"
                  placeholder="Bijv. Uw Bedrijf B.V."
                />
              </div>

              <!-- Address Straat + Postcode -->
              <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                <div class="md:col-span-2 space-y-2">
                  <label for="street" class="text-xs font-bold text-brand-secondary uppercase tracking-wider block">Straat + Huisnummer</label>
                  <input 
                    type="text" 
                    id="street" 
                    name="street" 
                    class="w-full border border-brand-dark/10 px-4 py-3 rounded-xl text-sm bg-brand-cream/10 focus:outline-none focus:border-brand-primary/45 transition-colors font-medium text-brand-secondary placeholder:text-brand-dark/35"
                    placeholder="Hoofdstraat 1" 
                    required
                  />
                </div>
                <div class="space-y-2">
                  <label for="postalCode" class="text-xs font-bold text-brand-secondary uppercase tracking-wider block">Postcode</label>
                  <input 
                    type="text" 
                    id="postalCode" 
                    name="postalCode" 
                    class="w-full border border-brand-dark/10 px-4 py-3 rounded-xl text-sm bg-brand-cream/10 focus:outline-none focus:border-brand-primary/45 transition-colors font-medium text-brand-secondary placeholder:text-brand-dark/35"
                    placeholder="1234 AB" 
                    required
                  />
                </div>
              </div>

              <!-- Woonplaats -->
              <div class="space-y-2">
                <label for="city" class="text-xs font-bold text-brand-secondary uppercase tracking-wider block">Woonplaats</label>
                <input 
                  type="text" 
                  id="city" 
                  name="city" 
                  class="w-full border border-brand-dark/10 px-4 py-3 rounded-xl text-sm bg-brand-cream/10 focus:outline-none focus:border-brand-primary/45 transition-colors font-medium text-brand-secondary placeholder:text-brand-dark/35"
                  placeholder="Amsterdam" 
                  required
                />
              </div>

              <!-- Notes -->
              <div class="space-y-2">
                <label for="notes" class="text-xs font-bold text-brand-secondary uppercase tracking-wider block">Opmerkingen (optioneel)</label>
                <textarea 
                  id="notes" 
                  name="notes" 
                  rows="3" 
                  class="w-full border border-brand-dark/10 px-4 py-3 rounded-xl text-sm bg-brand-cream/10 focus:outline-none focus:border-brand-primary/45 transition-colors font-medium text-brand-secondary placeholder:text-brand-dark/35 resize-none"
                  placeholder="Heeft u specifieke wensen, dieetwensen of opmerkingen?"
                ></textarea>
              </div>

              <!-- Agreement -->
              <div class="flex items-start gap-3 py-2">
                <input type="checkbox" id="agree" class="w-4.5 h-4.5 accent-brand-primary cursor-pointer mt-0.5" required />
                <label for="agree" class="text-xs text-brand-dark/60 leading-relaxed cursor-pointer select-none">
                  Ik ga akkoord met de <a href="#" class="text-brand-primary font-bold hover:underline">algemene voorwaarden</a> en het privacybeleid van Edusafe.
                </label>
              </div>

              <!-- Submit Button -->
              <button 
                type="submit" 
                class="font-display font-black text-lg py-4 px-6 rounded-2xl text-center bg-brand-accent text-white hover:bg-brand-accent-hover transition-all duration-300 w-full shadow-[0_4px_15px_rgba(255,107,53,0.3)] hover:-translate-y-0.5 active:scale-[0.99] cursor-pointer mt-4"
              >
                Inschrijving Voltooien
              </button>

            </form>
          </div>
        </div>

      </div>

    </section>

    <!-- Success Modal popup -->
    <div id="success-modal" class="fixed inset-0 bg-brand-secondary/60 backdrop-blur-sm z-[999] hidden items-center justify-center p-6">
      <div class="bg-white rounded-3xl p-8 max-w-md w-full shadow-2xl text-center border border-brand-dark/5 relative animate-fade-in">
        <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-3xl mx-auto mb-6">
          <i class="fa-solid fa-circle-check"></i>
        </div>
        <h3 class="font-display text-2xl font-black text-brand-secondary mb-3">Inschrijving Ontvangen!</h3>
        <p class="text-brand-dark/70 text-sm leading-relaxed mb-8">
          Hartelijk dank voor uw inschrijving. Wij hebben uw aanvraag voor <strong class="text-brand-secondary">{course.title}</strong> op <strong class="text-brand-secondary">{course.date}</strong> succesvol ontvangen. U ontvangt binnen enkele minuten een bevestiging per e-mail.
        </p>
        <button 
          onclick="document.getElementById('success-modal').style.display = 'none'; window.location.href = '/cursusdata';" 
          class="font-display font-black text-sm py-3.5 px-8 rounded-2xl bg-brand-primary text-white hover:bg-brand-primary-hover transition-all duration-300 w-full"
        >
          Terug naar Cursusdata
        </button>
      </div>
    </div>

  </main>
</Layout>
