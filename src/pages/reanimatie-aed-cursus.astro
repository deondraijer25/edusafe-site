---
import CourseCategoryHub, { type HubCourseItem } from '../components/CourseCategoryHub.astro';
import { courseCatalog } from '../data/catalog';

const catalogAed = courseCatalog.find((c) => c.slug === 'aed-reanimatie');

const aedCourses: HubCourseItem[] = [
  ...(catalogAed
    ? [
        {
          id: catalogAed.slug,
          slug: catalogAed.slug,
          title: catalogAed.title,
          shortTitle: catalogAed.shortTitle,
          tagline: catalogAed.tagline,
          price: catalogAed.price,
          duration: catalogAed.duration,
          target: catalogAed.target,
          suitableForHtml: catalogAed.suitableForHtml,
          requirements: catalogAed.requirements,
          exam: catalogAed.exam,
          certification: catalogAed.certification,
          inclusions: catalogAed.inclusions,
          modules: catalogAed.modules,
          image: catalogAed.image,
        },
      ]
    : []),
  {
    id: 'aed-herhaling',
    title: 'Reanimatie & AED Herhaling (NRR)',
    shortTitle: 'Reanimatie & AED Herhaling',
    tagline: 'Houd uw NRR-certificaat en HartslagNu-registratie scherp in 2,5 uur',
    price: '€ 75,00',
    duration: '1 dagdeel / avond (2,5 uur)',
    target:
      'Voor houders van een NRR Reanimatie & AED-certificaat die hun spiergeheugen willen opfrissen en oproepbaar willen blijven bij HartslagNu.',
    requirements: 'In het bezit van een eerder behaald Reanimatie & AED-certificaat.',
    exam: 'Praktijkbeoordeling op QCPR-reanimatiepoppen door een NRR-instructeur.',
    certification: 'Officiële verlenging van uw NRR BLS/AED-certificaat (2 jaar geldig).',
    inclusions: [
      'Praktijk op QCPR-poppen',
      'NRR-certificaatverlenging',
      'Geschikt voor HartslagNu',
      'Koffie, thee & parkeren',
    ],
    modules: [
      {
        name: 'Opfrissen borstcompressies & beademing (30:2)',
        description: 'Direct trainen op compressiediepte en tempo met digitale kwaliteitsfeedback.',
      },
      {
        name: 'AED-inzet & bijzondere praktijksituaties',
        description: 'Veilig handelen bij natte ondergrond, pacemaker, medicijnpleisters en storingsmeldingen.',
      },
      {
        name: 'Verstikking, stabiele zijligging & actuele NRR-richtlijnen',
        description: 'Herhaling van de Heimlich-greep en de nieuwste richtlijnen van de Nederlandse Reanimatie Raad.',
      },
    ],
    image: 'https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?auto=format&fit=crop&q=80&w=600',
    requestUrl: '/persoonlijk-advies?course=aed-reanimatie',
    incompanyUrl: '/persoonlijk-advies?type=zakelijk&course=aed-reanimatie&mode=incompany',
  },
  {
    id: 'pbls-kinderreanimatie',
    title: 'PBLS — Baby- & Kinderreanimatie (NRR)',
    shortTitle: 'Baby- & Kinderreanimatie',
    tagline: 'Paediatric Basic Life Support voor zuigelingen en kinderen',
    price: '€ 115,00',
    duration: '1 dagdeel (3,5 uur)',
    target:
      'Voor ouders, leerkrachten, pedagogisch medewerkers en sporttrainers die gericht baby- en kinderreanimatie willen beheersen.',
    requirements: 'Geen vooropleiding vereist.',
    exam: 'Praktische vaardigheidstoetsing op speciale baby- en kindertorso’s.',
    certification: 'Officieel NRR PBLS-certificaat Kinderreanimatie (2 jaar geldig).',
    inclusions: [
      'Praktijk op baby-/kindpoppen',
      'Oefenen met kinderelektroden',
      'Officieel NRR PBLS-diploma',
      'Koffie, thee & lesmateriaal',
    ],
    modules: [
      {
        name: 'Verschillen tussen volwassenen- en kinderreanimatie',
        description: 'Waarom zuurstoftekort bij kinderen centraal staat en hoe u direct ingrijpt.',
      },
      {
        name: '5 initiële beademingen & 15:2 borstcompressies',
        description: 'Twee-vingertechniek bij zuigelingen en één-handtechniek bij kinderen tot de puberteit.',
      },
      {
        name: 'AED met kinderelektroden & luchtwegbelemmering',
        description: 'Veilig aansluiten van de AED en opheffen van ernstige verslikking bij baby’s en kinderen.',
      },
    ],
    image: 'https://images.unsplash.com/photo-1588072432836-e10032774350?auto=format&fit=crop&q=80&w=600',
    requestUrl: '/persoonlijk-advies?course=aed-reanimatie',
    incompanyUrl: '/persoonlijk-advies?type=zakelijk&course=aed-reanimatie&mode=incompany',
  },
  {
    id: 'burgerhulpverlener',
    title: 'Burgerhulpverlener & HartslagNu Training',
    shortTitle: 'Burgerhulpverlener (HartslagNu)',
    tagline: 'Word gecertificeerd burgerhulpverlener in de 6-minutenzone van uw buurt',
    price: '€ 85,00',
    duration: '1 dagdeel (3 uur)',
    target:
      'Voor buurtbewoners, VvE’s, sportverenigingen en vrijwilligers die levens willen redden bij een hartstilstand in hun eigen wijk.',
    requirements: 'Vanaf 18 jaar. Geen medische vooropleiding vereist.',
    exam: 'Praktijktoets reanimatie en AED-bediening.',
    certification: 'Officieel NRR-certificaat + directe aanmeldmogelijkheid bij HartslagNu.',
    inclusions: [
      'Praktijktraining BLS & AED',
      'Uitleg HartslagNu-oproepapp',
      'Officieel NRR-certificaat',
      'Koffie, thee & lesboekje',
    ],
    modules: [
      {
        name: 'De 6-minutenzone en het HartslagNu-oproepsysteem',
        description: 'Hoe een 112-melding werkt en hoe u een buurt-AED met pincode uit een buitenkast haalt.',
      },
      {
        name: 'Direct starten met reanimatie & samenwerken',
        description: 'Taakverdeling tussen meerdere burgerhulpverleners en overdracht aan het ambulanceteam.',
      },
    ],
    image: 'https://images.unsplash.com/photo-1505751172876-fa1923c5c528?auto=format&fit=crop&q=80&w=600',
    requestUrl: '/persoonlijk-advies?course=aed-reanimatie',
    incompanyUrl: '/persoonlijk-advies?type=zakelijk&course=aed-reanimatie&mode=incompany',
  },
];

const faqs = [
  {
    q: 'Wat is het verschil tussen een EHBO-cursus en een Reanimatie & AED-cursus?',
    a: 'Een Reanimatie & AED-cursus focust in één dagdeel (3,5 tot 4 uur) volledig op de meest acute noodsituaties: circulatiestilstand (hartstilstand), AED-bediening en ernstige verstikking. Een volledige EHBO-cursus behandelt daarnaast ook wonden, botbreuken, brandwonden en ziektebeelden.',
  },
  {
    q: 'Kan ik mij na deze cursus aanmelden als burgerhulpverlener bij HartslagNu?',
    a: 'Ja! Met het officiële NRR-certificaat dat u bij Edusafe behaalt, kunt u zich direct registreren bij het landelijke reanimatie-oproepsysteem HartslagNu.',
  },
  {
    q: 'Wordt een reanimatiecursus vergoed door mijn zorgverzekeraar?',
    a: 'Veel Nederlandse zorgverzekeraars vergoeden een NRR-erkende reanimatiecursus geheel of gedeeltelijk vanuit het aanvullende pakket (preventieve cursussen), zonder invloed op uw eigen risico.',
  },
  {
    q: 'Kunnen wij een Reanimatie & AED-training op ons kantoor of sportclub boeken?',
    a: 'Zeker. Vanaf 6 deelnemers komen onze NRR-gecertificeerde instructeurs met professionele QCPR-reanimatiepoppen en oefen-AED’s naar uw bedrijf, VvE of vereniging — overdag of in de avonduren.',
  },
];
---

<CourseCategoryHub
  lang="nl"
  category="EHBO"
  seoTitle="Reanimatie & AED Cursus (NRR Erkend & HartslagNu) | Edusafe"
  seoDescription="Leer in 1 dagdeel levensreddend reanimeren en een AED bedienen. Officieel NRR-gecertificeerd, geschikt voor HartslagNu en vaak vergoed via uw zorgverzekeraar."
  breadcrumbLabel="Reanimatie & AED"
  heroTitle="Reanimatie & AED Cursus (NRR)"
  heroSubtitle="Leer binnen één praktijkgericht dagdeel doortastend borstcompressies toepassen en een AED aansluiten bij een circulatiestilstand."
  heroImage="https://images.unsplash.com/photo-1516549655169-df83a0774514?auto=format&fit=crop&q=80&w=1600"
  heroBullets={[
    'Certificaat in 1 dagdeel',
    'Officieel NRR-gecertificeerd',
    'Geschikt voor HartslagNu',
    'Den Haag of op uw locatie',
  ]}
  primaryCtaUrl="/persoonlijk-advies?course=aed-reanimatie"
  courses={aedCourses}
  coursesHeading="Alle Reanimatie, AED & PBLS trainingen"
  faqTitle="Reanimatie & AED"
  customFaqs={faqs}
  advisorText="Vragen over reanimatie of AED-training?"
  contactCourseSlug="aed-reanimatie"
/>
