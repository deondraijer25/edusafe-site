---
import CourseCategoryHub, { type HubCourseItem } from '../components/CourseCategoryHub.astro';

const incompanyCourses: HubCourseItem[] = [
  {
    id: 'incompany-bhv',
    slug: 'bhv-basis',
    title: 'Incompany BHV (Basis, Herhaling & Ploegleider)',
    shortTitle: 'Incompany BHV',
    tagline: 'Train uw BHV-team in uw eigen pand met uw eigen vluchtwegen en blusmiddelen',
    price: 'v.a. € 125,00',
    duration: '1 dag of dagdeel op uw locatie',
    target:
      'Voor bedrijven, scholen, zorginstellingen en VvE’s vanaf 6 medewerkers die hun BHV-team bedrijfsspecifiek en zonder reistijd willen certificeren.',
    suitableForHtml: [
      'Vanaf <strong>6 deelnemers</strong> is een Incompany BHV-training op uw eigen locatie vrijwel altijd voordeliger en effectiever dan losse open inschrijvingen.',
      'Uw medewerkers oefenen direct met uw eigen AED, brandmeldcentrale, verzamelplaats en bedrijfsspecifieke RI&amp;E-risico’s (beschikbaar in het Nederlands én Engels).',
    ],
    requirements: 'Een geschikte vergader-/lesruimte en een veilige buitenplek (ca. 6x6m) voor de blusoefening.',
    exam: 'Online theorie vooraf of klassikaal + praktijkbeoordeling op uw locatie.',
    certification: 'Officieel erkende Arbowet BHV-certificaten + pasjes (1 jaar geldig).',
    inclusions: [
      'Docent & materiaal op locatie',
      'Oefenpoppen, AED’s & blusbak',
      'Maatwerk op uw eigen pand',
      'Officiële certificaten & pasjes',
    ],
    modules: [
      {
        name: 'Levensreddend handelen & reanimatie met uw bedrijfs-AED',
        description: 'Praktische EHBO- en reanimatiescenario’s afgestemd op uw specifieke werkvloer.',
      },
      {
        name: 'Praktisch blussen met schuim, CO2 en blusdeken',
        description: 'Veilige en schone blusoefening op uw eigen buitenterrein onder leiding van onze instructeur.',
      },
      {
        name: 'Ontruimingsronde langs uw eigen nooduitgangen',
        description: 'Toetsing van alarmering, vluchtroutes, deurprocedures en verzamelplaats in uw pand.',
      },
    ],
    image: 'https://images.unsplash.com/photo-1576091160550-2173dba999ef?auto=format&fit=crop&q=80&w=600',
    requestUrl: '/persoonlijk-advies?type=zakelijk&course=bhv-basis&mode=incompany',
    incompanyUrl: '#incompany-aanvraag',
  },
  {
    id: 'incompany-ehbo',
    slug: 'ehbo-basis',
    title: 'Incompany EHBO, Kinder-EHBO (IKK) & Reanimatie',
    shortTitle: 'Incompany EHBO & AED',
    tagline: 'Gecertificeerde Eerste Hulp- of IKK-training voor uw volledige team op locatie',
    price: 'v.a. € 95,00',
    duration: '1 dagdeel of 1 dag op locatie',
    target:
      'Voor kinderdagverblijven, scholen, sportverenigingen, horeca, productiebedrijven en zorgorganisaties.',
    requirements: 'Een rustige binnenruimte met voldoende vloeroppervlak voor reanimatiepoppen.',
    exam: 'Praktische vaardigheidstoetsing conform Het Oranje Kruis / NRR / Wet IKK.',
    certification: 'Officieel erkend EHBO-, EHAK- of NRR-reanimatiecertificaat (2 jaar geldig).',
    inclusions: [
      'QCPR-poppen & verbandsets',
      'Maatwerk op uw branche',
      'Erkende certificaten & pasjes',
      'Overdag, avond of zaterdag',
    ],
    modules: [
      {
        name: 'Reanimatie (BLS / PBLS) en AED-inzet',
        description: 'Intensieve hands-on training voor al uw medewerkers in kleine subgroepen.',
      },
      {
        name: 'Branchespecifieke letsels en bedrijfsongevallen',
        description: 'Gerichte aandacht voor bijvoorbeeld kinderopvang (Wet IKK), machines, chemie of sport.',
      },
    ],
    image: 'https://images.unsplash.com/photo-1603398938378-e54eab446dde?auto=format&fit=crop&q=80&w=600',
    requestUrl: '/persoonlijk-advies?type=zakelijk&course=ehbo-basis&mode=incompany',
    incompanyUrl: '#incompany-aanvraag',
  },
  {
    id: 'incompany-vca',
    slug: 'vca-vol',
    title: 'Incompany VCA Cursus + Officieel CBT-Examen op Locatie',
    shortTitle: 'Incompany VCA + Examen',
    tagline: 'Klassikale examentraining én officieel SSVV-examen in uw eigen bedrijfspand',
    price: 'v.a. € 175,00',
    duration: '1 cursusdag (incl. examen)',
    target:
      'Voor aannemers, installateurs, uitzendbureaus en technische diensten die een groep medewerkers in één dag willen certificeren.',
    requirements: 'Lesruimte met tafels, stoelen en stabiele stroom-/internetvoorziening.',
    exam: 'Officieel SSVV CBT-beeldschermexamen afgenomen door een onafhankelijk examenbureau op uw locatie.',
    certification: 'Officieel VCA Basis of VOL-VCA diploma + 10 jaar CDR-registratie.',
    inclusions: [
      'Examentraining op locatie',
      'Officieel CBT-examen inbegrepen',
      '10 jaar CDR-registratie',
      'Beschikbaar in NL & meerdere talen',
    ],
    modules: [
      {
        name: 'Gerichte VCA-examentraining met praktijkvoorbeelden',
        description: 'Arbowet, gevaarlijke stoffen, werken op hoogte, LMRA en elektrische veiligheid.',
      },
      {
        name: 'Aansluitend officieel SSVV-examen met directe uitslag',
        description: 'Wij regelen examinator, examenlaptops en officiële CDR-afmelding op uw locatie.',
      },
    ],
    image: 'https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&q=80&w=600',
    requestUrl: '/persoonlijk-advies?type=zakelijk&course=vca-vol&mode=incompany',
    incompanyUrl: '#incompany-aanvraag',
  },
  {
    id: 'incompany-transport',
    slug: 'heftruck',
    title: 'Incompany Heftruck, Reachtruck & Hoogwerker op Eigen Materieel',
    shortTitle: 'Incompany Intern Transport',
    tagline: 'Certificeer uw chauffeurs direct in uw eigen magazijn op hun eigen trucks',
    price: 'v.a. € 165,00',
    duration: '1 dag of dagdeel in uw magazijn',
    target:
      'Voor logistieke bedrijven, groothandels en productiehallen die chauffeurs in hun eigen stellingen en rijpaden willen certificeren.',
    requirements: 'Gekeurde heftruck/reachtruck/hoogwerker en veilige oefenzone in uw magazijn.',
    exam: 'Theorietoets + praktijkexamen in uw eigen werkomgeving.',
    certification: 'Officieel Arbowet-certificaat Intern Transport + pasje (5 jaar geldig).',
    inclusions: [
      'Trainen op eigen machines',
      'Geen reistijd voor chauffeurs',
      'Conform Arbobesluit 7.17c',
      'Certificaten & veiligheidspasjes',
    ],
    modules: [
      {
        name: 'Rijklaarcontrole, lastdiagram en magazijnveiligheid',
        description: 'Specifiek afgestemd op uw eigen trucks, vloerbelasting, laadkades en voetgangersroutes.',
      },
      {
        name: 'Praktijkbeoordeling in uw eigen stellingen',
        description: 'Veilig manoeuvreren en stapelen op hoogte met minimale onderbreking van uw operatie.',
      },
    ],
    image: 'https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&q=80&w=600',
    requestUrl: '/persoonlijk-advies?type=zakelijk&course=heftruck&mode=incompany',
    incompanyUrl: '#incompany-aanvraag',
  },
  {
    id: 'incompany-ontruiming',
    slug: 'ontruimingsoefening',
    title: 'Incompany Ontruimingsoefening & Veiligheidsdag',
    shortTitle: 'Incompany Ontruimingsoefening',
    tagline: 'Jaarlijkse realistische ontruimingssimulatie met rook, LOTUS en officieel verslag',
    price: 'Offerte op maat',
    duration: '1 dagdeel op uw locatie',
    target:
      'Voor kantoren, scholen, zorginstellingen en bedrijfspanden die hun jaarlijkse wettelijke ontruimingsoefening professioneel willen borgen.',
    requirements: 'Vooroverleg over scenario en tijdelijke testmelding bij uw meldkamer (PAC/RAC).',
    exam: 'Praktijkobservatie met tijdmeting en verbeteradvies.',
    certification: 'Officieel Evaluatierapport Ontruimingsoefening conform Arbowet & NEN 8112.',
    inclusions: [
      'Draaiboek & vooroverleg',
      'Oefenrook & waarnemers',
      'Plenaire nabespreking',
      'Officieel Arbo-evaluatierapport',
    ],
    modules: [
      {
        name: 'Realistische calamiteitensimulatie in uw pand',
        description: 'Toetsing van alarmering, ontruimingstijd, vluchtwegen en verzamelplaatsregistratie.',
      },
      {
        name: 'Schriftelijk evaluatierapport voor Arbeidsinspectie & verzekeraar',
        description: 'Concreet rapport met bevindingen en verbeterpunten voor uw Arbo-veiligheidsdossier.',
      },
    ],
    image: 'https://images.unsplash.com/photo-1544551763-46a013bb70d5?auto=format&fit=crop&q=80&w=600',
    requestUrl: '/persoonlijk-advies?type=zakelijk&course=ontruimingsoefening&mode=incompany',
    incompanyUrl: '#incompany-aanvraag',
  },
];
---

<CourseCategoryHub
  lang="nl"
  category="Incompany"
  seoTitle="Incompany Veiligheidstrainingen op Locatie (BHV, EHBO, VCA & Heftruck) | Edusafe"
  seoDescription="Organiseer een praktijkgerichte Incompany BHV, EHBO, VCA, Heftruck of Ontruimingstraining op uw eigen bedrijfslocatie. Vanaf 6 personen met scherpe staffelkorting."
  breadcrumbLabel="Incompany Trainingen"
  heroTitle="Incompany Veiligheidstrainingen op Locatie"
  heroSubtitle="Train uw team in uw eigen bedrijfspand of magazijn zonder reistijd. Volledig op maat vanaf 6 deelnemers door heel Nederland (NL & ENG)."
  heroImage="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&q=80&w=1600"
  heroBullets={[
    'Voordelig vanaf 6 personen',
    'Op uw eigen bedrijfslocatie',
    'Flexibel: dag, avond of weekend',
    'Offerte binnen 1 werkdag',
  ]}
  primaryCtaUrl="/persoonlijk-advies?type=zakelijk&mode=incompany"
  primaryCtaLabel="Incompany offerte aanvragen"
  courses={incompanyCourses}
  coursesHeading="Alle Incompany trainingen op uw locatie"
  faqTitle="Incompany Trainingen"
  advisorText="Incompany offerte of datum op maat?"
>
  <div
    slot="extra-left"
    id="incompany-aanvraag"
    class="bg-white rounded-3xl p-5 sm:p-8 shadow-md border border-brand-dark/5 scroll-mt-24 lg:scroll-mt-40"
  >
    <span class="section-eyebrow text-brand-primary mb-1">
      <span>Directe Groepsaanvraag</span>
    </span>
    <h2 class="heading-card text-brand-secondary mb-2">
      Vraag vrijblijvend een Incompany voorstel aan
    </h2>
    <p class="text-body text-brand-dark/75 mb-6">
      Ontvang binnen 1 werkdag een heldere groepsofferte inclusief instructeur, oefenmateriaal en officiële certificering op uw locatie.
    </p>

    <form id="incompany-quote-form" class="space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-brand-secondary uppercase tracking-wider mb-1.5">Bedrijfsnaam</label>
          <input type="text" name="company" placeholder="Bijv. Jansen Logistiek BV" class="w-full bg-brand-cream/60 border border-brand-dark/10 rounded-xl px-4 py-3 text-base sm:text-sm focus:outline-none focus:border-brand-primary" required />
        </div>
        <div>
          <label class="block text-xs font-semibold text-brand-secondary uppercase tracking-wider mb-1.5">Contactpersoon</label>
          <input type="text" name="name" placeholder="Voor- en achternaam" class="w-full bg-brand-cream/60 border border-brand-dark/10 rounded-xl px-4 py-3 text-base sm:text-sm focus:outline-none focus:border-brand-primary" required />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-brand-secondary uppercase tracking-wider mb-1.5">E-mailadres</label>
          <input type="email" name="email" placeholder="naam@bedrijf.nl" class="w-full bg-brand-cream/60 border border-brand-dark/10 rounded-xl px-4 py-3 text-base sm:text-sm focus:outline-none focus:border-brand-primary" required />
        </div>
        <div>
          <label class="block text-xs font-semibold text-brand-secondary uppercase tracking-wider mb-1.5">Telefoonnummer</label>
          <input type="tel" name="phone" placeholder="06 - 12345678" class="w-full bg-brand-cream/60 border border-brand-dark/10 rounded-xl px-4 py-3 text-base sm:text-sm focus:outline-none focus:border-brand-primary" required />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-brand-secondary uppercase tracking-wider mb-1.5">Gewenste Training</label>
          <select name="category" class="w-full bg-brand-cream/60 border border-brand-dark/10 rounded-xl px-4 py-3 text-base sm:text-sm focus:outline-none focus:border-brand-primary cursor-pointer">
            <option>Incompany BHV (Basis / Herhaling)</option>
            <option>Incompany EHBO, Kinder-EHBO of Reanimatie</option>
            <option>Incompany VCA Training & Examen</option>
            <option>Incompany Heftruck / Reachtruck / Hoogwerker</option>
            <option>Incompany Ontruimingsoefening</option>
            <option>Maatwerk combinatie</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-brand-secondary uppercase tracking-wider mb-1.5">Aantal Deelnemers</label>
          <input type="number" name="participants" min="1" placeholder="Bijv. 10 medewerkers" class="w-full bg-brand-cream/60 border border-brand-dark/10 rounded-xl px-4 py-3 text-base sm:text-sm focus:outline-none focus:border-brand-primary" />
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-brand-secondary uppercase tracking-wider mb-1.5">Locatie & Specifieke Wensen</label>
        <textarea name="message" rows="3" placeholder="Plaatsnaam, gewenste taal (NL / Engels) of voorkeursdata..." class="w-full bg-brand-cream/60 border border-brand-dark/10 rounded-xl px-4 py-3 text-base sm:text-sm resize-none focus:outline-none focus:border-brand-primary"></textarea>
      </div>

      <button type="submit" class="btn-base w-full sm:w-auto min-h-[48px] cursor-pointer">
        <span>Vrijblijvende offerte aanvragen →</span>
      </button>
    </form>

    <div id="incompany-quote-success" class="hidden flex-col items-center justify-center text-center p-6 bg-emerald-50 border border-emerald-200 rounded-2xl mt-4">
      <h3 class="heading-tile text-emerald-900 mb-1">Offerteaanvraag ontvangen!</h3>
      <p class="text-card text-emerald-700">Bedankt voor uw aanvraag. Wij nemen binnen 1 werkdag contact met u op met een voorstel op maat.</p>
    </div>

    <script>
      const incForm = document.getElementById('incompany-quote-form') as HTMLFormElement | null;
      const incSuccess = document.getElementById('incompany-quote-success');
      if (incForm && incSuccess) {
        incForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const btn = incForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
          const orig = btn ? btn.innerHTML : '';
          if (btn) { btn.disabled = true; btn.textContent = 'Bezig met versturen...'; }
          const fd = new FormData(incForm);
          try {
            await fetch('/api/advies', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                source: 'incompany-offerte',
                customerType: 'Zakelijk',
                company: fd.get('company') || '',
                name: fd.get('name') || '',
                email: fd.get('email') || '',
                phone: fd.get('phone') || '',
                category: fd.get('category') || 'Incompany Training',
                participants: fd.get('participants') ? `${fd.get('participants')} deelnemers` : '',
                message: fd.get('message') || '',
              }),
            });
            incForm.classList.add('hidden');
            incSuccess.classList.remove('hidden');
            incSuccess.classList.add('flex');
          } catch (err) {
            console.error(err);
          } finally {
            if (btn) { btn.disabled = false; btn.innerHTML = orig; }
          }
        });
      }
    </script>
  </div>
</CourseCategoryHub>
