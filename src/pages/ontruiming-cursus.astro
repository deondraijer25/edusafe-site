---
import CourseCategoryHub, { type HubCourseItem } from '../components/CourseCategoryHub.astro';
import { courseCatalog } from '../data/catalog';

const slugs = [
  'brand-en-ontruiming',
  'ontruimingsoefening',
  'bhv-ploegleider',
  'kleine-blusmiddelen',
];

const catalogItems: HubCourseItem[] = slugs
  .map((s) => courseCatalog.find((c) => c.slug === s))
  .filter((c): c is NonNullable<typeof c> => Boolean(c))
  .map((c) => ({
    id: c.slug,
    slug: c.slug,
    title: c.title,
    shortTitle: c.shortTitle,
    tagline: c.tagline,
    price: c.price,
    duration: c.duration,
    target: c.target,
    suitableForHtml: c.suitableForHtml,
    requirements: c.requirements,
    exam: c.exam,
    certification: c.certification,
    inclusions: c.inclusions,
    modules: c.modules,
    image: c.image,
  }));

const ontruimingCourses: HubCourseItem[] = [
  ...catalogItems,
  {
    id: 'bbmi',
    title: 'Beheerder Brandmeldinstallatie (BBMI — NEN 2654-1)',
    shortTitle: 'Beheerder BMI (BBMI)',
    tagline: 'Wettelijk verplicht periodiek beheer van uw brandmeld- en ontruimingsinstallatie',
    price: '€ 325,00',
    duration: '1 cursusdag (incl. examen)',
    target:
      'Voor facilitair medewerkers, gebouwbeheerders en Hoofden BHV die verantwoordelijk zijn voor het beheer en logboek van een brandmeldinstallatie (BMI/OAI).',
    suitableForHtml: [
      'Beschikt uw gebouw over een brandmeld- en ontruimingsalarminstallatie? Volgens het Besluit bouwwerken leefomgeving (Bbl) en <strong>NEN 2654-1 / 2654-2</strong> moet er een aantoonbaar opgeleide Beheerder Brandmeldinstallatie (voorheen Opgeleid Persoon) zijn aangesteld.',
      'In één praktijkgerichte dag leert u maandelijkse controles uitvoeren, ongewenste meldingen voorkomen en het verplichte logboek correct beheren voor brandweer en verzekeraar.',
    ],
    requirements: 'Geen specifieke vooropleiding vereist.',
    exam: 'Theorie- en praktijktoetsing conform NEN 2654-1 normering.',
    certification: 'Officieel diploma Beheerder Brandmeldinstallatie (BBMI).',
    inclusions: [
      'Lesboek & checklists NEN 2654',
      'Oefenen op echte BMI-centrale',
      'Officieel BBMI-diploma',
      'Lunch, koffie/thee & parkeren',
    ],
    modules: [
      {
        name: 'Opbouw en werking van BMI- en OAI-systemen',
        description: 'Melders, handbrandmelders, doormelding en bediening van het brandmeldpaneel.',
      },
      {
        name: 'Maandelijkse en 4-maandelijkse beheerderstaken',
        description: 'Zelfstandig uitvoeren van periodieke controles en bijhouden van het verplichte logboek.',
      },
      {
        name: 'Voorkomen van ongewenste en onechte brandmeldingen',
        description: 'Tijdelijk uitschakelen van groepen bij werkzaamheden en begeleiden van jaarlijks onderhoud.',
      },
    ],
    image: 'https://images.unsplash.com/photo-1516738901171-8eb4fc13bd20?auto=format&fit=crop&q=80&w=600',
    requestUrl: '/persoonlijk-advies?course=brand-en-ontruiming',
    incompanyUrl: '/persoonlijk-advies?type=zakelijk&course=ontruimingsoefening&mode=incompany',
  },
];

const faqs = [
  {
    q: 'Hoe vaak is een bedrijf verplicht een ontruimingsoefening te houden?',
    a: 'Volgens Artikel 15 van de Arbowet en het Besluit bouwwerken leefomgeving (Bbl) moet uw BHV-organisatie aantoonbaar geoefend zijn. De landelijke norm vanuit de Arbeidsinspectie en verzekeraars is minimaal één realistische ontruimingsoefening per jaar, vastgelegd in een evaluatierapport.',
  },
  {
    q: 'Moet de brandweer aanwezig zijn tijdens onze ontruimingsoefening?',
    a: 'Nee, fysieke aanwezigheid van de brandweer is niet nodig. Wel stemmen wij vooraf met u af dat een eventuele doormelding naar de meldkamer (PAC/RAC) tijdelijk in test wordt gezet zodat er geen onnodige uitruk plaatsvindt.',
  },
  {
    q: 'Wat is het verschil tussen Ploegleider BHV en Beheerder Brandmeldinstallatie (BBMI)?',
    a: 'De Beheerder Brandmeldinstallatie (BBMI) verzorgt het technische en periodieke beheer van de brandmeldcentrale conform NEN 2654-1. De Ploegleider BHV stuurt tijdens een daadwerkelijke brand of calamiteit het BHV-team en de ontruiming operationeel aan.',
  },
  {
    q: 'Verzorgen jullie ook de verplichte ontruimingsplattegronden en het ontruimingsplan?',
    a: 'Ja! Naast blus- en ontruimingstrainingen stelt Edusafe ook volledige bedrijfsnoodplannen en NEN 1414 / ISO 23601 ontruimingsplattegronden op voor uw bedrijfspand.',
  },
];
---

<CourseCategoryHub
  lang="nl"
  category="BHV"
  seoTitle="Brand, Blussen & Ontruimingsoefening Cursussen | Edusafe"
  seoDescription="Praktijkgerichte trainingen Brand & Ontruiming, jaarlijkse Incompany ontruimingsoefeningen met evaluatierapport, Kleine Blusmiddelen en Beheerder BMI (BBMI)."
  breadcrumbLabel="Brand & Ontruiming"
  heroTitle="Brand & Ontruiming Opleidingen"
  heroSubtitle="Leer beginnende branden veilig blussen op echt vuur en toets uw bedrijfsnoodplan met een realistische ontruimingsoefening op locatie."
  heroImage="https://images.unsplash.com/photo-1544551763-46a013bb70d5?auto=format&fit=crop&q=80&w=1600"
  heroBullets={[
    'Blussen op echt vuur',
    'Jaarlijkse ontruimingsoefening',
    'Officieel Arbo-evaluatieverslag',
    'Den Haag of op uw locatie',
  ]}
  primaryCtaUrl="/persoonlijk-advies?course=brand-en-ontruiming"
  courses={ontruimingCourses}
  coursesHeading="Alle trainingen Brandbestrijding, Ontruiming & BBMI"
  faqTitle="Brand & Ontruiming"
  customFaqs={faqs}
  advisorText="Ontruimingsoefening of blustraining inplannen?"
  contactCourseSlug="ontruimingsoefening"
/>
