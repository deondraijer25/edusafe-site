---
import Layout from '../layouts/Layout.astro';

const bhvCourses = [
  {
    id: "bhv-basis",
    title: "BHV Basis",
    tagline: "Volledige basisopleiding inclusief e-learning",
    price: "€ 195,00",
    spotsText: "Direct instappen",
    duration: "E-learning + 1 praktijkdag",
    target: "Voor werknemers die voor het eerst BHV-er worden en een officieel certificaat willen behalen.",
    requirements: "Geen vooropleiding of specifieke ervaring vereist. Iedereen kan deelnemen.",
    exam: "Theorie via e-learning & praktijkbeoordeling op de lesdag.",
    certification: "Officieel erkend diploma Bedrijfshulpverlener + pasje (1 jaar geldig).",
    inclusions: ["Lesmateriaal", "E-learning licentie", "Officieel certificaat", "Koffie, thee & lunch"],
    modules: [
      { name: "Spoedeisende Eerste Hulp" },
      { name: "Niet-spoedeisende Eerste Hulp" },
      { name: "Brandbestrijding" },
      { name: "Ontruiming & Communicatie" }
    ],
    image: "https://images.unsplash.com/photo-1576091160550-2173dba999ef?auto=format&fit=crop&q=80&w=600",
