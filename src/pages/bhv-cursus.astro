    requirements: "No prior safety training required. Fluent in English.",
    exam: "English e-learning exam + continuous practical evaluation on the training day.",
    certification: "Official English BHV Certificate + ID card (valid for 1 year).",
    inclusions: ["English study material", "English E-learning", "English certificate", "Coffee, tea & lunch"],
    modules: [
      { name: "First Aid & CPR" },
      { name: "Fire Fighting" },
      { name: "Evacuation & Communication" }
    ],
    image: "https://images.unsplash.com/photo-1524178232363-1fb2b075b655?auto=format&fit=crop&q=80&w=600",
    registerLink: "/cursusdata?category=BHV"
  },
  {
    id: "bhv-herhaling-bo",
    title: "BHV Herhaling B & O",
    tagline: "Specifieke herhaling voor Beheer & Onderhoud",
    price: "€ 155,00",
    spotsText: "Technische specialisatie",
    duration: "1 praktijkdag",
    target: "Voor BHV-ers werkzaam in technische diensten, beheer, onderhoud of bouwomgevingen.",
    requirements: "Geldig (of recent verlopen) BHV Basis certificaat.",
    exam: "Praktische scenario-toetsing door gecertificeerde instructeurs.",
    certification: "BHV herhalingscertificaat met B&O specialisatie + pasje.",
    inclusions: ["Gerichte praktijktraining", "Certificaatverlenging", "Koffie, thee & lunch"],
    modules: [
      { name: "Technische EHBO" },
      { name: "Brand & Heet Werk" },
      { name: "Besloten Ruimtes" }
    ],
    image: "https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&q=80&w=600",
    registerLink: "/cursusdata?category=BHV"
  },
  {
    id: "ploegleider-bhv",
    title: "Ploegleider BHV",
    tagline: "Stuur effectief een BHV-inzet aan op de werkvloer",
    price: "€ 345,00",
    spotsText: "Leidinggevende rol",
    duration: "2 praktijkdagen",
    target: "Voor ervaren BHV-ers die de leiding en coördinatie krijgen over een BHV-ploeg.",
    requirements: "In het bezit van een geldig BHV Basis of Herhalingscertificaat.",
    exam: "Praktische inzettoetsing en beoordeling van leidinggevende vaardigheden.",
    certification: "Officieel diploma Ploegleider BHV (1 jaar geldig).",
    inclusions: ["Uitgebreid lesmateriaal", "Oefenmaterialen", "Diploma Ploegleider", "Lunch op beide dagen"],
