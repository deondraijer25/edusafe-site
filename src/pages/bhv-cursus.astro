---
import CourseCategoryHub from '../components/CourseCategoryHub.astro';
import { courseCatalog } from '../data/catalog';

const bhvCourses = courseCatalog
  .filter((c) => c.category === 'BHV')
  .map((c) => ({
    id: c.slug,
    slug: c.slug,
    title: c.title,
    shortTitle: c.shortTitle,
    tagline: c.tagline,
    price: c.price,
    duration: c.duration,
    target: c.target,
    suitableForHtml: c.suitableForHtml,
    requirements: c.requirements,
    exam: c.exam,
    certification: c.certification,
    inclusions: c.inclusions,
    modules: c.modules,
    learningOutcomes: c.learningOutcomes,
    image: c.image,
  }));
---

<CourseCategoryHub
  lang="nl"
  category="BHV"
  seoTitle="BHV Cursus & Opleidingen (Basis, Herhaling & Ploegleider) | Edusafe"
  seoDescription="Officieel erkende BHV cursus conform Arbowet Art. 15. Kies uit BHV Basis (E-learning + 1 praktijkdag), BHV Herhaling, Ploegleider en Hoofd BHV in Den Haag of Incompany."
  breadcrumbLabel="BHV Opleidingen"
  heroTitle="BHV Cursus & Opleidingen"
  heroSubtitle="Voldoe direct aan Artikel 15 van de Arbowet met praktijkgerichte bedrijfshulpverleningstrainingen in Den Haag of Incompany op uw locatie."
  heroImage="/assets/images/hero_poster.webp"
  heroBullets={[
    'E-learning + 1 praktijkdag',
    'Erkend Arbowet-certificaat',
    'Incl. lesmateriaal & lunch',
    'Den Haag of Incompany',
  ]}
  primaryCtaUrl="/persoonlijk-advies?category=BHV"
  courses={bhvCourses}
  coursesHeading="Alle 8 gecertificeerde BHV-opleidingen"
  faqTitle="BHV Opleidingen"
  advisorText="Persoonlijk advies voor uw BHV-team?"
/>
