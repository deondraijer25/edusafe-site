---
import Layout from '../layouts/Layout.astro';
import PageHeroBackdrop from '../components/PageHeroBackdrop.astro';
import MobileCourseBottomBar from '../components/MobileCourseBottomBar.astro';

const services = [
  {
    id: "noodverlichting-inspectie",
    title: "Jaarlijkse NEN-EN 1838 Inspectie & Onderhoud",
    tagline: "Wettelijke controle van armaturen, accutests en 1-uurs autonomiemeting",
    price: "Vaste staffelprijs",
    spotsText: "Wettelijk verplicht",
    duration: "Op locatie binnen 1 dagdeel",
    target: "Voor alle gebouwen waar personeel, gasten of publiek aanwezig zijn conform het Bouwbesluit en de Arbowet.",
    requirements: "Toegang tot alle noodverlichtingsarmaturen en de hoofdschakelkast.",
    exam: "Autonomietest (min. 1 uur brandduur bij netspanningsuitval), lux-meting en accutest.",
    certification: "Officieel NEN-EN 50172 inspectierapport + digitaal logboek voor de brandweer en verzekeraar.",
    inclusions: [
      "Controle van vluchtrouteaanduiding en vluchtrouteverlichting",
      "Functionele test en 1-uurs accutest bij stroomuitval",
      "Vervanging van defecte lichtbronnen en versleten accu's",
      "Actualisatie van het wettelijk verplichte noodverlichtingslogboek"
    ],
    modules: [
      { name: "Controle van permanente vluchtrouteaanduiding (groene pictogrammen conform NEN 3011)" },
      { name: "Inspectie van anti-paniekverlichting en vluchtrouteverlichting (min. 1 lux op de vloer)" },
      { name: "Preventieve 4-jaars accuwissel om uitval te voorkomen" },
      { name: "Rapportage met prioriteitenlijst conform NEN-EN 1838 & ISSO 79" }
    ],
    image: "https://images.unsplash.com/photo-1517430816045-df4b7de11d1d?auto=format&fit=crop&q=80&w=800",
    registerLink: "/persoonlijk-advies?type=zakelijk&service=noodverlichting"
  },
  {
    id: "noodverlichting-nieuwbouw",
    title: "Projectering & LED Noodverlichting Ombouw",
    tagline: "Vervanging van verouderde TL-armaturen naar energiezuinige LED-noodverlichting",
    price: "Offerte op maat",
    spotsText: "Bespaar tot 80% energie",
    duration: "Binnen 5 werkdagen gemonteerd",
    target: "Voor bedrijven die hun energiekosten willen verlagen en armaturen willen moderniseren met een langere acculevensduur.",
    requirements: "Plattegrond van het gebouw of opname ter plaatse.",
    exam: "Lichtberekening en projectering conform NEN-EN 1838.",
    certification: "Volledig NEN-gecertificeerde installatie met 5 jaar fabrieksgarantie.",
    inclusions: [
      "Lichtplan en projectering conform NEN-EN 1838",
      "Levering van moderne LED armaturen met automatische zelftest (autotest)",
      "Vakkundige montage en aansluiting op de noodstroomgroepen",
      "Inclusief 5 jaar garantie op LED en accu"
    ],
    modules: [
      { name: "Berekening van vluchtweg- en werkplekverlichting" },
      { name: "Installatie van slimme zelftestende LED-armaturen" },
      { name: "Milieuvriendelijke afvoer van oude TL-bakken en NiCd batterijen" },
      { name: "Opleveringscertificaat en plattegrondregistratie" }
    ],
    image: "https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&q=80&w=800",
    registerLink: "/persoonlijk-advies?type=zakelijk&service=noodverlichting"
  }
];
---

<Layout 
  title="Noodverlichting Inspectie & Onderhoud NEN-EN 1838 | Edusafe"
  description="Wettelijk verplicht onderhoud, inspectie en LED-ombouw van noodverlichting en vluchtrouteaanduiding. Gecertificeerd conform Bouwbesluit en Arbowet."
>
  <!-- Hero Section -->
  <section class="relative bg-brand-primary text-white pt-12 pb-16 sm:pt-20 sm:pb-20 md:pt-24 md:pb-24 overflow-hidden">
    <PageHeroBackdrop
      image="https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&q=80&w=1600"
      alt="Noodverlichting & Vluchtwegaanduiding"
    />
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 relative z-10">
      
      <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-wider mb-3.5 sm:mb-4">
        <a href="/" class="hover:underline text-white/75 hover:text-white">Home</a>
        <span class="text-white/40">/</span>
        <span class="text-white/75">Diensten</span>
        <span class="text-white/40">/</span>
        <span class="text-brand-accent">Noodverlichting</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <div class="lg:col-span-8">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/12 text-white border border-white/25 backdrop-blur-sm text-xs font-bold uppercase tracking-wider mb-3.5 sm:mb-4">
            <i class="fa-solid fa-lightbulb text-brand-accent"></i>
            NEN-EN 1838 &amp; Bouwbesluit
          </span>
          <h1 class="heading-page mb-4 sm:mb-6 text-white">
            Noodverlichting &amp; <span class="text-brand-accent">Vluchtweg&shy;aanduiding</span>
          </h1>
          <p class="text-[15px] sm:text-lg text-white/90 leading-relaxed max-w-2xl mb-6 sm:mb-8">
            Bij stroomuitval of calamiteiten moet iedereen uw pand snel en veilig kunnen verlaten. Edusafe verzorgt de jaarlijkse inspectie, accutests en LED-modernisering van uw complete noodverlichtingsinstallatie.
          </p>

          <div class="flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-3 sm:gap-4">
            <button type="button" data-open-contact-drawer class="w-full sm:w-auto inline-flex items-center justify-center text-center min-h-[48px] bg-brand-accent hover:bg-brand-accent-hover text-white font-display font-semibold px-6 sm:px-8 py-3.5 sm:py-4 rounded-xl transition-all shadow-lg hover:-translate-y-0.5 cursor-pointer">
              Inspectie of Offerte Aanvragen
            </button>
            <a href="#details" class="w-full sm:w-auto inline-flex items-center justify-center text-center min-h-[48px] bg-white/12 hover:bg-white/20 text-white border border-white/30 backdrop-blur-sm font-display font-semibold px-6 sm:px-8 py-3.5 sm:py-4 rounded-xl shadow-sm transition-all">
              Bekijk Normen &amp; Eisen
            </a>
          </div>
        </div>

        <div class="lg:col-span-4 grid grid-cols-2 gap-3 sm:gap-4">
          <div class="bg-[#062856]/50 backdrop-blur-md border border-white/20 rounded-2xl p-4 sm:p-5 text-center shadow-lg">
            <div class="text-2xl sm:text-3xl font-display font-bold text-white mb-1">60 min</div>
            <div class="text-xs text-white/80">Wettelijke Autonomie</div>
          </div>
          <div class="bg-[#062856]/50 backdrop-blur-md border border-white/20 rounded-2xl p-4 sm:p-5 text-center shadow-lg">
            <div class="text-2xl sm:text-3xl font-display font-bold text-brand-accent mb-1">4 Jaar</div>
            <div class="text-xs text-white/80">Accu Vervangingscyclus</div>
          </div>
          <div class="bg-[#062856]/50 backdrop-blur-md border border-white/20 rounded-2xl p-4 sm:p-5 text-center shadow-lg">
            <div class="text-2xl sm:text-3xl font-display font-bold text-white mb-1">NEN 1838</div>
            <div class="text-xs text-white/80">Europese Norm</div>
          </div>
          <div class="bg-[#062856]/50 backdrop-blur-md border border-white/20 rounded-2xl p-4 sm:p-5 text-center shadow-lg">
            <div class="text-2xl sm:text-3xl font-display font-bold text-brand-accent mb-1">LED</div>
            <div class="text-xs text-white/80">Tot 80% Besparing</div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Content Section -->
  <section id="details" class="py-14 sm:py-20 bg-brand-cream relative">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6">
      
      <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
        <span class="text-brand-accent font-display font-semibold text-xs uppercase tracking-wider mb-2 block">
          Zekerheid bij stroomuitval
        </span>
        <h2 class="heading-section text-brand-secondary">
          Onderhoud, Projectering &amp; Ombouw
        </h2>
        <p class="text-brand-dark/70 text-[15px] sm:text-base mt-3">
          Van jaarlijkse accutesten en logboekbeheer tot complete overstap naar slimme, zelftestende LED noodverlichting.
        </p>
      </div>

      <!-- Service Cards Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8 mb-12 sm:mb-16">
        {services.map((srv) => (
          <div class="bg-white rounded-3xl p-5 sm:p-8 border border-brand-dark/5 shadow-xl flex flex-col justify-between hover:border-brand-primary/30 transition-all">
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2 sm:gap-4 mb-4">
                <span class="px-3 py-1 rounded-full bg-brand-primary/10 text-brand-primary text-xs font-bold uppercase tracking-wider">
                  {srv.spotsText}
                </span>
                <span class="text-lg font-display font-bold text-brand-accent">
                  {srv.price}
                </span>
              </div>
              <h3 class="font-display text-2xl font-semibold text-brand-secondary mb-2">
                {srv.title}
              </h3>
              <p class="text-brand-dark/70 text-sm mb-6 leading-relaxed">
                {srv.tagline}
              </p>

              <div class="space-y-4 mb-8">
                <div class="flex items-start gap-3">
                  <i class="fa-solid fa-clock text-brand-primary mt-1"></i>
                  <div>
                    <strong class="text-xs text-brand-secondary uppercase tracking-wider block">Doorlooptijd:</strong>
                    <span class="text-sm text-brand-dark/80">{srv.duration}</span>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <i class="fa-solid fa-shield-halved text-brand-primary mt-1"></i>
                  <div>
                    <strong class="text-xs text-brand-secondary uppercase tracking-wider block">Certificering &amp; Normen:</strong>
                    <span class="text-sm text-brand-dark/80">{srv.certification}</span>
                  </div>
                </div>
              </div>

              <h4 class="text-xs font-semibold uppercase tracking-wider text-brand-secondary mb-3">Inbegrepen in deze dienst:</h4>
              <ul class="space-y-2 mb-8">
                {srv.inclusions.map((inc) => (
                  <li class="flex items-center gap-2.5 text-sm text-brand-dark/80">
                    <i class="fa-solid fa-circle-check text-green-500 text-xs"></i>
                    <span>{inc}</span>
                  </li>
                ))}
              </ul>
            </div>

            <button 
              type="button" 
              data-open-contact-drawer 
              class="w-full py-4 rounded-xl bg-brand-accent hover:bg-brand-accent-hover text-white font-display font-semibold text-center transition-all shadow-md"
            >
              Vrijblijvende Offerte Aanvragen
            </button>
          </div>
        ))}
      </div>

    </div>
  </section>

  <MobileCourseBottomBar
    defaultCourse={services[0]}
    itemType="service"
    serviceSlug="noodverlichting"
    advisorText="Noodverlichting keuring of LED-ombouw?"
  />
</Layout>
