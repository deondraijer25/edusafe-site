---
import Layout from '../layouts/Layout.astro';
import PageHeroBackdrop from '../components/PageHeroBackdrop.astro';
import MobileCourseBottomBar from '../components/MobileCourseBottomBar.astro';

const services = [
  {
    id: "blusmiddelen-onderhoud",
    title: "Jaarlijks NEN 2559 Onderhoud & Keuring",
    tagline: "Wettelijk verplichte periodieke inspectie van alle brandblussers en haspels",
    price: "Vaste staffelprijs",
    spotsText: "NEN 2559 / NEN-EN 671-3",
    duration: "Op locatie binnen 1 dagdeel",
    target: "Voor bedrijven, VvE's, scholen, retail en horeca met draagbare blusmiddelen en brandslanghaspels.",
    requirements: "Vrije toegang tot alle blusmiddelen in het pand.",
    exam: "Volledige inspectie volgens NEN-normen inclusief afpersen en hervullen.",
    certification: "Officiële REOB-keuringsstickers + digitaal inspectielogboek voor de brandweer en verzekeraar.",
    inclusions: [
      "Visuele en technische inspectie van blusapparaten en haspels",
      "Controle op druk, afdichtingen, slangen en gewicht",
      "Aanbrengen van officiële REOB keuringsstickers",
      "Digitaal keuringsrapport & up-to-date logboek"
    ],
    modules: [
      { name: "Controle schuimblussers, CO2-blussers en poederblussers (NEN 2559)" },
      { name: "Controle en hydrostatische druktest brandslanghaspels (NEN-EN 671-3)" },
      { name: "Inspectie blusdekens en pictogrammen conform NEN 3011" },
      { name: "Advies over strategische herpositionering bij verbouwing" }
    ],
    image: "https://images.unsplash.com/photo-1582139329536-e7284fece509?auto=format&fit=crop&q=80&w=800",
    registerLink: "/persoonlijk-advies?type=zakelijk&service=brandveiligheid"
  },
  {
    id: "brandpreventie-pakket",
    title: "Edusafe Brandpreventie Pakket",
    tagline: "Compleet ontzorgingspakket: levering, montage en onderhoud op maat",
    price: "Offerte op maat",
    spotsText: "Totaaloplossing",
    duration: "Binnen 5 werkdagen gemonteerd",
    target: "Voor nieuwbouwpanden, startende ondernemingen of panden die een complete upgrade van de brandveiligheid nodig hebben.",
    requirements: "Bouwtekening of rondgang door het pand.",
    exam: "Capaciteitsberekening conform Bouwbesluit en NEN 4001.",
    certification: "Volledige NEN 4001 projectering + conformiteitsverklaring.",
    inclusions: [
      "Persoonlijk advies en NEN 4001 projectering",
      "Levering van hoogwaardige schuim-, CO2- of vetblussers",
      "Vakkundige montage inclusief NEN 3011 veiligheidspictogrammen",
      "Inclusief eerste jaarkeuring en registratie in logboek"
    ],
    modules: [
      { name: "Projectering van het benodigde aantal bluseenheden per m²" },
      { name: "Plaatsing van blusmiddelen bij specifieke risico's (bijv. serverruimtes, keukens)" },
      { name: "Montage van vlamvertragende blusdekens en borden" },
      { name: "Koppeling met uw BHV- en ontruimingsplan" }
    ],
    image: "https://images.unsplash.com/photo-1582139329536-e7284fece509?auto=format&fit=crop&q=80&w=800",
    registerLink: "/persoonlijk-advies?type=zakelijk&service=brandveiligheid"
  }
];
---

<Layout 
  title="Brandveiligheid & Blusmiddelen Onderhoud | Edusafe"
  description="Levering, montage en jaarlijks NEN 2559 onderhoud van brandblussers, haspels en blusdekens. Gecertificeerd, scherp geprijsd en 100% conform wetgeving."
>
  <!-- Hero Section -->
  <section class="relative bg-brand-primary text-white pt-12 pb-16 sm:pt-20 sm:pb-20 md:pt-24 md:pb-24 overflow-hidden">
    <PageHeroBackdrop
      image="https://images.unsplash.com/photo-1582139329536-e7284fece509?auto=format&fit=crop&q=80&w=1600"
      alt="Brandveiligheid & Blusmiddelen"
    />
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 relative z-10">
      
      <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-wider mb-3.5 sm:mb-4">
        <a href="/" class="hover:underline text-white/75 hover:text-white">Home</a>
        <span class="text-white/40">/</span>
        <span class="text-white/75">Diensten</span>
        <span class="text-white/40">/</span>
        <span class="text-brand-accent">Brandveiligheid &amp; Blusmiddelen</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <div class="lg:col-span-8">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/12 text-white border border-white/25 backdrop-blur-sm text-xs font-bold uppercase tracking-wider mb-3.5 sm:mb-4">
            <i class="fa-solid fa-fire-extinguisher text-brand-accent"></i>
            REOB &amp; NEN Gecertificeerd
          </span>
          <h1 class="heading-page mb-4 sm:mb-6 text-white">
            Brandveiligheid &amp; <span class="text-brand-accent">Blusmiddelen</span>
          </h1>
          <p class="text-[15px] sm:text-lg text-white/90 leading-relaxed max-w-2xl mb-6 sm:mb-8">
            Bij Edusafe staat betrouwbare brandpreventie en professioneel onderhoud voorop. Wij leveren, keuren en onderhouden alle elementaire blusmiddelen conform NEN 2559 en het Bouwbesluit.
          </p>

          <div class="flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-3 sm:gap-4">
            <a href="https://www.firesafebv.nl" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto justify-center min-h-[48px] bg-brand-accent hover:bg-brand-accent-hover text-white font-display font-semibold px-6 sm:px-8 py-3.5 sm:py-4 rounded-xl transition-all shadow-lg hover:-translate-y-0.5 inline-flex items-center gap-2.5 text-center">
              <span>Bezoek FireSafe B.V. (firesafebv.nl)</span>
              <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
            </a>
            <button type="button" data-open-contact-drawer class="w-full sm:w-auto inline-flex items-center justify-center text-center min-h-[48px] bg-white/12 hover:bg-white/20 text-white border border-white/30 backdrop-blur-sm font-display font-semibold px-6 sm:px-8 py-3.5 sm:py-4 rounded-xl shadow-sm transition-all cursor-pointer">
              Direct Keuring of Offerte Aanvragen
            </button>
          </div>
        </div>

        <div class="lg:col-span-4 grid grid-cols-2 gap-3 sm:gap-4">
          <div class="bg-[#062856]/50 backdrop-blur-md border border-white/20 rounded-2xl p-4 sm:p-5 text-center shadow-lg">
            <div class="text-2xl sm:text-3xl font-display font-bold text-white mb-1">NEN 2559</div>
            <div class="text-xs text-white/80">Blussers Keuring</div>
          </div>
          <div class="bg-[#062856]/50 backdrop-blur-md border border-white/20 rounded-2xl p-4 sm:p-5 text-center shadow-lg">
            <div class="text-2xl sm:text-3xl font-display font-bold text-brand-accent mb-1">REOB</div>
            <div class="text-xs text-white/80">Erkend Onderhoud</div>
          </div>
          <div class="bg-[#062856]/50 backdrop-blur-md border border-white/20 rounded-2xl p-4 sm:p-5 text-center shadow-lg">
            <div class="text-2xl sm:text-3xl font-display font-bold text-white mb-1">24/7</div>
            <div class="text-xs text-white/80">Snelle Service</div>
          </div>
          <div class="bg-[#062856]/50 backdrop-blur-md border border-white/20 rounded-2xl p-4 sm:p-5 text-center shadow-lg">
            <div class="text-2xl sm:text-3xl font-display font-bold text-brand-accent mb-1">Logboek</div>
            <div class="text-xs text-white/80">Digitaal Beheer</div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Content Section -->
  <section id="details" class="py-14 sm:py-20 bg-brand-cream relative">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6">
      
      <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
        <span class="text-brand-accent font-display font-semibold text-xs uppercase tracking-wider mb-2 block">
          Compleet ontzorgd in brandveiligheid
        </span>
        <h2 class="heading-section text-brand-secondary">
          Onderhoud, Levering &amp; Advies
        </h2>
        <p class="text-brand-dark/70 text-[15px] sm:text-base mt-3">
          Van de periodieke jaarlijkse keuring tot complete installatie van brandslanghaspels en blusapparaten.
        </p>
      </div>

      <!-- Service Cards Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8 mb-12 sm:mb-16">
        {services.map((srv) => (
          <div class="bg-white rounded-3xl p-5 sm:p-8 border border-brand-dark/5 shadow-xl flex flex-col justify-between hover:border-brand-primary/30 transition-all">
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2 sm:gap-4 mb-4">
                <span class="px-3 py-1 rounded-full bg-brand-primary/10 text-brand-primary text-xs font-bold uppercase tracking-wider">
                  {srv.spotsText}
                </span>
                <span class="text-lg font-display font-bold text-brand-accent">
                  {srv.price}
                </span>
              </div>
              <h3 class="font-display text-2xl font-semibold text-brand-secondary mb-2">
                {srv.title}
              </h3>
              <p class="text-brand-dark/70 text-sm mb-6 leading-relaxed">
                {srv.tagline}
              </p>

              <div class="space-y-4 mb-8">
                <div class="flex items-start gap-3">
                  <i class="fa-solid fa-clock text-brand-primary mt-1"></i>
                  <div>
                    <strong class="text-xs text-brand-secondary uppercase tracking-wider block">Uitvoering:</strong>
                    <span class="text-sm text-brand-dark/80">{srv.duration}</span>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <i class="fa-solid fa-certificate text-brand-primary mt-1"></i>
                  <div>
                    <strong class="text-xs text-brand-secondary uppercase tracking-wider block">Certificering &amp; Logboek:</strong>
                    <span class="text-sm text-brand-dark/80">{srv.certification}</span>
                  </div>
                </div>
              </div>

              <h4 class="text-xs font-semibold uppercase tracking-wider text-brand-secondary mb-3">Wat zit er in dit pakket:</h4>
              <ul class="space-y-2 mb-8">
                {srv.inclusions.map((inc) => (
                  <li class="flex items-center gap-2.5 text-sm text-brand-dark/80">
                    <i class="fa-solid fa-circle-check text-green-500 text-xs"></i>
                    <span>{inc}</span>
                  </li>
                ))}
              </ul>
            </div>

            <button 
              type="button" 
              data-open-contact-drawer 
              class="w-full py-4 rounded-xl bg-brand-accent hover:bg-brand-accent-hover text-white font-display font-semibold text-center transition-all shadow-md"
            >
              Keuring of Offerte Aanvragen
            </button>
          </div>
        ))}
      </div>

    </div>
  </section>

  <MobileCourseBottomBar
    defaultCourse={services[0]}
    itemType="service"
    serviceSlug="brandveiligheid"
    advisorText="Keuring of blusmiddelen nodig?"
  />
</Layout>
