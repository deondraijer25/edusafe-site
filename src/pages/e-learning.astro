---
import Layout from '../layouts/Layout.astro';
import PageHeroBackdrop from '../components/PageHeroBackdrop.astro';
import CourseFaq from '../components/CourseFaq.astro';
import Reviews from '../components/Reviews.astro';
import ContactForm from '../components/ContactForm.astro';

const elearningCourses = [
  {
    id: 'bhv-theorie',
    title: 'BHV Basis & Herhaling E-learning',
    badge: 'BHV Theorie',
    price: '€ 59,00',
    rawPrice: 59.0,
    duration: '± 3 tot 4 uur',
    description:
      'Volledige online theorievoorbereiding voor de BHV-praktijkdag (Basis & Herhaling) conform Artikel 15 van de Arbowet. Direct te volgen op mobiel, tablet of pc.',
  },
  {
    id: 'vca-basis',
    title: 'VCA Basis (B-VCA) E-learning',
    badge: 'VCA + Proefexamens',
    price: '€ 49,00',
    rawPrice: 49.0,
    duration: '± 6 uur',
    description:
      'Complete online voorbereiding op het officiële SSVV B-VCA beeldschermexamen, inclusief onbeperkt officiële proefexamens oefenen.',
  },
  {
    id: 'vca-vol',
    title: 'VOL-VCA Leidinggevenden E-learning',
    badge: 'VOL-VCA + Proefexamens',
    price: '€ 69,00',
    rawPrice: 69.0,
    duration: '± 8 uur',
    description:
      'Speciaal voor leidinggevenden, uitvoerders en ZZP’ers. Alle SSVV-eindtermen, Arbowet-modules en uitgebreide database met VOL-VCA oefenexamens.',
  },
  {
    id: 'ehbo-ehak',
    title: 'EHBO & Kinder-EHBO (Wet IKK) E-learning',
    badge: 'Oranje Kruis / IKK',
    price: '€ 55,00',
    rawPrice: 55.0,
    duration: '± 3 tot 4 uur',
    description:
      'Interactieve online theoriemodule ter voorbereiding op de praktijkdag Eerste Hulp of Eerste Hulp aan Kinderen (conform Wet IKK & GGD).',
  },
];

const defaultCourse = elearningCourses[0];
---

<Layout
  title="E-learning Academie (BHV, VCA & EHBO Online) | Edusafe"
  description="Start direct online met uw BHV-, VCA- of EHBO-theorie via de Edusafe E-learning Academie. Losse licenties via iDEAL of zakelijk maandabonnement voor teams."
>
  <main class="w-full">
    <!-- 1. GOLD-STANDARD HERO HEADER -->
    <section class="relative bg-brand-primary text-white pt-12 pb-20 sm:pt-20 sm:pb-28 md:pt-24 md:pb-36 overflow-hidden">
      <PageHeroBackdrop
        image="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&q=80&w=1600"
        alt="Edusafe E-learning Academie"
      />

      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 relative z-10">
        <nav aria-label="Breadcrumb" class="section-eyebrow text-brand-primary mb-3.5 flex-wrap">
          <a href="/" class="hover:underline text-white/70 hover:text-white">Home</a>
          <span class="text-white/40">/</span>
          <span class="text-brand-accent">E-learning Academie</span>
        </nav>

        <div class="max-w-3xl">
          <h1 class="heading-page mb-3 text-white">
            Edusafe E-learning Academie
          </h1>
          <p class="text-lead text-white/85 max-w-2xl mb-6">
            Volg uw BHV-, VCA- of EHBO-theorie op uw eigen tempo op mobiel, tablet of pc — als losse licentie of als flexibel zakelijk maandabonnement voor uw hele team.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2.5 max-w-xl mb-7 text-card text-white/95 font-medium">
            <div class="flex items-center gap-2.5">
              <i class="fa-solid fa-circle-check text-brand-accent text-sm shrink-0"></i>
              <span>Direct inloggen na aanmelding</span>
            </div>
            <div class="flex items-center gap-2.5">
              <i class="fa-solid fa-circle-check text-brand-accent text-sm shrink-0"></i>
              <span>Mobiel, tablet &amp; desktop</span>
            </div>
            <div class="flex items-center gap-2.5">
              <i class="fa-solid fa-circle-check text-brand-accent text-sm shrink-0"></i>
              <span>Digitaal theoriecertificaat</span>
            </div>
            <div class="flex items-center gap-2.5">
              <i class="fa-solid fa-circle-check text-brand-accent text-sm shrink-0"></i>
              <span>Los of zakelijk maandabonnement</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-3 sm:gap-3.5">
            <a href="#elearning-selectie" class="btn-hero w-full sm:w-auto justify-center min-h-[48px]">
              <span>Kies uw E-learning ↓</span>
            </a>
            <a
              href="/persoonlijk-advies?intent=praktijkdag"
              class="w-full sm:w-auto min-h-[48px] inline-flex items-center justify-center gap-2.5 font-display font-semibold text-[14px] sm:text-[15px] px-5 sm:px-7 py-3.5 sm:py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white border border-white/20 backdrop-blur-sm transition-all duration-300 text-center"
            >
              <i class="fa-regular fa-calendar-check text-brand-accent shrink-0"></i>
              <span>Theorie al afgerond? Plan praktijkdag →</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. MAIN CONTENT GRID (7 Cols Left + 5 Cols Sticky Right Checkout at lg:top-[152px]) -->
    <section class="max-w-[1280px] mx-auto px-4 sm:px-6 -mt-12 sm:-mt-14 md:-mt-20 relative z-20 pb-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 md:gap-8">

        <!-- Left Column: Course Selection & Corporate Monthly Subscription (7 columns) -->
        <div class="lg:col-span-7 space-y-7">

          <!-- KAART 1: KIES UW E-LEARNING MODULE -->
          <div
            id="elearning-selectie"
            class="bg-white rounded-3xl p-5 sm:p-8 shadow-lg border border-brand-dark/5 scroll-mt-24 lg:scroll-mt-40"
          >
            <div class="mb-6">
              <span class="section-eyebrow text-brand-primary mb-1">
                <span>Losse Cursistlicentie</span>
              </span>
              <h2 class="heading-card text-brand-secondary mb-1.5">
                1. Kies uw E-learning module
              </h2>
              <p class="text-body text-brand-dark/70">
                Selecteer de gewenste online theoriecursus. Na bestelling kunt u bij het inloggen direct kiezen tussen Nederlands of Engels.
              </p>
            </div>

            <div class="space-y-3.5">
              {elearningCourses.map((course, idx) => (
                <label
                  class={`course-option-label relative flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-4 sm:p-5 rounded-2xl border transition-all duration-200 cursor-pointer ${
                    idx === 0
                      ? 'border-brand-primary bg-white ring-2 ring-brand-primary/15 shadow-xs'
                      : 'border-brand-dark/8 bg-brand-cream/40 hover:border-brand-primary/30 hover:bg-white'
                  }`}
                >
                  <input
                    type="radio"
                    name="selected_course_radio"
                    value={course.id}
                    checked={idx === 0}
                    class="sr-only"
                  />

                  <div class="flex items-start gap-3.5">
                    <div class="w-5 h-5 rounded-full border-2 border-brand-primary/40 flex items-center justify-center shrink-0 mt-1">
                      <div
                        class={`radio-dot w-2.5 h-2.5 rounded-full bg-brand-primary transition-transform ${
                          idx === 0 ? 'scale-100' : 'scale-0'
                        }`}
                      ></div>
                    </div>

                    <div>
                      <div class="flex flex-wrap items-center gap-2 mb-1">
                        <span class="heading-tile text-brand-secondary">{course.title}</span>
                        <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-brand-primary/10 text-brand-primary">
                          {course.badge}
                        </span>
                      </div>
                      <p class="text-card text-brand-dark/70 mb-2">
                        {course.description}
                      </p>
                      <span class="text-xs font-semibold text-brand-dark/55 inline-flex items-center gap-1.5">
                        <i class="fa-solid fa-clock text-brand-primary"></i>
                        <span>Studieduur: {course.duration}</span>
                      </span>
                    </div>
                  </div>

                  <div class="text-left sm:text-right shrink-0 pl-8 sm:pl-0">
                    <span class="font-display font-semibold text-xl text-brand-secondary block leading-tight">
                      {course.price}
                    </span>
                    <span class="text-xs text-brand-dark/50">excl. BTW</span>
                  </div>
                </label>
              ))}
            </div>

            <div class="lg:hidden mt-5 pt-4 border-t border-brand-dark/6">
              <a href="#checkout-sidebar" class="btn-base w-full min-h-[48px]">
                <span>Verder naar gegevens &amp; betaling ↓</span>
              </a>
            </div>
          </div>

          <!-- KAART 2: ZAKELIJK MAANDABONNEMENT VOOR TEAMS & ORGANISATIES -->
          <div class="bg-brand-secondary text-white rounded-3xl p-5 sm:p-8 shadow-lg border border-white/10">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 mb-5 border-b border-white/10">
              <div>
                <span class="section-eyebrow text-brand-accent mb-1">
                  <i class="fa-solid fa-arrows-rotate"></i>
                  <span>Voor Bedrijven &amp; HR-Teams</span>
                </span>
                <h2 class="heading-card text-white">
                  Zakelijk E-learning Maandabonnement
                </h2>
              </div>
              <div class="sm:text-right shrink-0">
                <span class="font-display text-2xl font-semibold text-brand-accent block leading-tight">
                  v.a. € 9,50 / mnd
                </span>
                <span class="text-xs text-white/65">per medewerker (excl. BTW)</span>
              </div>
            </div>

            <p class="text-body text-white/80 mb-5">
              Wilt u meerdere medewerkers doorlopend geschoold houden in BHV, VCA en werkplekveiligheid? Met ons zakelijke E-learning maandabonnement spreidt u de opleidingskosten overzichtelijk per maand en beheert u alle certificaten in één centraal HR-portaal.
            </p>

            <ul class="space-y-2.5 mb-6 text-card text-white/90">
              <li class="flex items-center gap-2.5">
                <i class="fa-solid fa-circle-check text-brand-accent text-xs shrink-0"></i>
                <span>Onbeperkt toegang tot periodieke micro-learnings &amp; jaarlijkse theorie-updates</span>
              </li>
              <li class="flex items-center gap-2.5">
                <i class="fa-solid fa-circle-check text-brand-accent text-xs shrink-0"></i>
                <span>Centraal HR-dashboard met automatische herinnering vóór verloopdatum</span>
              </li>
              <li class="flex items-center gap-2.5">
                <i class="fa-solid fa-circle-check text-brand-accent text-xs shrink-0"></i>
                <span>Optioneel uit te breiden met jaarlijkse Incompany praktijkdag op uw locatie</span>
              </li>
            </ul>

            <a
              href="/persoonlijk-advies?type=zakelijk&course=e-learning"
              class="btn-base w-full sm:w-auto min-h-[48px]"
            >
              <span>Zakelijk maandabonnement aanvragen →</span>
            </a>
          </div>

        </div>

        <!-- Right Column: Truly Sticky Checkout Card (5 columns, lg:top-[152px] self-start) -->
        <aside class="lg:col-span-5 lg:sticky lg:top-[152px] self-start z-20 scroll-mt-24" id="checkout-sidebar">
          <div class="bg-white rounded-3xl shadow-lg border border-brand-dark/5 p-5 sm:p-6">
            <span class="section-eyebrow text-brand-primary mb-1">
              <span>Direct online starten</span>
            </span>
            <h2 class="heading-card text-brand-secondary mb-4">
              2. Gegevens &amp; Betaling
            </h2>

            <!-- Beschikbare talen met echte SVG-vlaggetjes NL & ENG op 1 regel -->
            <div class="mb-4 p-3.5 rounded-xl bg-brand-cream/60 border border-brand-dark/5 flex flex-wrap items-center justify-between gap-2 text-card">
              <span class="font-semibold text-brand-dark/65">Beschikbare talen:</span>
              <div class="flex items-center gap-1.5">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white border border-brand-dark/10 font-semibold text-brand-secondary text-xs shadow-2xs">
                  <svg class="w-4 h-3 rounded-[2px] shrink-0" viewBox="0 0 640 480" aria-hidden="true">
                    <path fill="#21468b" d="M0 0h640v480H0z"/>
                    <path fill="#fff" d="M0 0h640v320H0z"/>
                    <path fill="#ae1c28" d="M0 0h640v160H0z"/>
                  </svg>
                  <span>NL</span>
                </span>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white border border-brand-dark/10 font-semibold text-brand-secondary text-xs shadow-2xs">
                  <svg class="w-4 h-3 rounded-[2px] shrink-0" viewBox="0 0 60 30" aria-hidden="true">
                    <clipPath id="uk-clip-elearn"><path d="M0,0 v30 h60 v-30 z"/></clipPath>
                    <path d="M0,0 v30 h60 v-30 z" fill="#012169"/>
                    <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" clip-path="url(#uk-clip-elearn)"/>
                    <path d="M0,0 L60,30 M60,0 L0,30" stroke="#C8102E" stroke-width="4" clip-path="url(#uk-clip-elearn)"/>
                    <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10"/>
                    <path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6"/>
                  </svg>
                  <span>ENG</span>
                </span>
              </div>
            </div>

            <!-- Order Summary -->
            <div class="bg-brand-cream/60 border border-brand-dark/5 rounded-2xl p-4 space-y-2.5 mb-5 text-card">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <span class="section-eyebrow text-brand-dark/45">Gekozen module</span>
                  <span id="summary-title" class="heading-tile text-brand-secondary block">
                    {defaultCourse.title}
                  </span>
                </div>
                <span id="summary-duration" class="text-xs font-semibold text-brand-dark/55 shrink-0 mt-1">
                  {defaultCourse.duration}
                </span>
              </div>

              <div class="border-t border-brand-dark/6 pt-2.5 flex items-center justify-between">
                <span class="text-brand-dark/65">Subtotaal (excl. BTW)</span>
                <span id="summary-subtotal" class="font-semibold text-brand-secondary">{defaultCourse.price}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-brand-dark/65">BTW (21%)</span>
                <span id="summary-btw" class="font-semibold text-brand-secondary">€ 12,39</span>
              </div>
              <div class="border-t border-brand-dark/8 pt-2.5 flex items-baseline justify-between">
                <span class="font-display font-semibold text-brand-secondary">Totaal incl. BTW</span>
                <span id="summary-total" class="font-display text-xl font-semibold text-brand-primary">€ 71,39</span>
              </div>
            </div>

            <form id="elearning-checkout-form" class="space-y-3.5">
              <div>
                <label class="block text-xs font-semibold uppercase text-brand-secondary mb-1 tracking-wider">Voor- en achternaam *</label>
                <input type="text" id="checkout-name" class="w-full bg-brand-cream/40 border border-brand-dark/10 rounded-xl px-4 py-3 sm:py-2.5 text-base sm:text-sm text-brand-secondary font-medium focus:outline-none focus:border-brand-primary" required placeholder="Bijv. Jan de Vries" />
              </div>

              <div>
                <label class="block text-xs font-semibold uppercase text-brand-secondary mb-1 tracking-wider">E-mailadres *</label>
                <input type="email" id="checkout-email" class="w-full bg-brand-cream/40 border border-brand-dark/10 rounded-xl px-4 py-3 sm:py-2.5 text-base sm:text-sm text-brand-secondary font-medium focus:outline-none focus:border-brand-primary" required placeholder="jan@bedrijf.nl" />
              </div>

              <div>
                <label class="block text-xs font-semibold uppercase text-brand-secondary mb-1 tracking-wider">Bedrijfsnaam (optioneel)</label>
                <input type="text" id="checkout-company" class="w-full bg-brand-cream/40 border border-brand-dark/10 rounded-xl px-4 py-3 sm:py-2.5 text-base sm:text-sm text-brand-secondary font-medium focus:outline-none focus:border-brand-primary" placeholder="Bijv. De Vries Techniek B.V." />
              </div>

              <div class="pt-1">
                <label class="block text-xs font-semibold uppercase text-brand-secondary mb-1.5 tracking-wider">Betaalmethode *</label>
                <div class="grid grid-cols-1 min-[375px]:grid-cols-2 gap-2.5">
                  <label class="payment-method-btn min-h-[44px] flex items-center justify-between p-3 rounded-xl border border-brand-primary bg-brand-cream/20 ring-2 ring-brand-primary/15 cursor-pointer transition-all">
                    <input type="radio" name="payment_method" value="ideal" checked class="sr-only" />
                    <span class="text-card font-semibold text-brand-secondary">iDEAL</span>
                    <i class="fa-solid fa-building-columns text-brand-primary text-xs"></i>
                  </label>
                  <label class="payment-method-btn min-h-[44px] flex items-center justify-between p-3 rounded-xl border border-brand-dark/10 bg-white cursor-pointer transition-all hover:border-brand-primary/25">
                    <input type="radio" name="payment_method" value="creditcard" class="sr-only" />
                    <span class="text-card font-semibold text-brand-secondary">Creditcard / Factuur</span>
                    <i class="fa-solid fa-credit-card text-brand-dark/45 text-xs"></i>
                  </label>
                </div>
              </div>

              <button type="submit" class="btn-base w-full min-h-[48px] cursor-pointer mt-2">
                <i class="fa-solid fa-lock text-xs"></i>
                <span>Afrekenen &amp; direct starten</span>
              </button>

              <div class="text-center text-xs font-medium text-brand-dark/55 flex items-center justify-center gap-1.5 pt-1">
                <i class="fa-solid fa-shield-halved text-emerald-600"></i>
                <span>Beveiligde SSL-verbinding &amp; directe inlogmail</span>
              </div>
            </form>
          </div>
        </aside>

      </div>
    </section>

    <!-- 3. COMPLETE FOOTER STACK -->
    <CourseFaq category="E-learning" hubTitle="Edusafe E-learning Academie" lang="nl" />
    <Reviews />
    <ContactForm />
  </main>

  <!-- iDEAL Betaling Modal -->
  <div id="ideal-modal" class="fixed inset-0 z-[999] hidden items-center justify-center bg-brand-secondary/95 backdrop-blur-md opacity-0 transition-opacity duration-300">
    <div class="relative bg-white rounded-3xl shadow-2xl p-6 sm:p-8 max-w-md w-full mx-4 scale-95 transition-transform duration-300" id="ideal-card-container">
      <div id="ideal-step-1" class="text-center py-6 space-y-6">
        <div class="w-16 h-16 border-4 border-brand-primary border-t-transparent rounded-full animate-spin mx-auto"></div>
        <div>
          <h3 class="heading-card text-brand-secondary mb-1">Verbinding maken met betaalomgeving...</h3>
          <p class="text-card text-brand-dark/65">Uw licentie en betaalverzoek worden aangemaakt.</p>
        </div>
      </div>

      <div id="ideal-step-2" class="text-center py-6 space-y-6 hidden animate-fade-in">
        <div class="w-20 h-20 bg-emerald-50 border border-emerald-200 rounded-full flex items-center justify-center text-emerald-500 text-3xl mx-auto shadow-sm">
          <i class="fa-solid fa-check"></i>
        </div>
        <div>
          <h3 class="heading-card text-brand-secondary mb-2">Aanmelding bevestigd!</h3>
          <p class="text-body text-brand-dark/80 max-w-xs mx-auto">
            Er is een bevestiging verstuurd naar <span id="confirmed-email" class="font-semibold text-brand-primary"></span> met uw E-learning toegangsgegevens.
          </p>
        </div>

        <div class="border-t border-brand-dark/6 pt-5 space-y-3">
          <button id="success-close-btn" class="btn-base w-full cursor-pointer">
            <span>Sluiten &amp; terug naar overzicht</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ elearningCourses }}>
  function initElearningCheckout() {
    const radioLabels = document.querySelectorAll('.course-option-label');
    const paymentLabels = document.querySelectorAll('.payment-method-btn');
    const checkoutForm = document.getElementById('elearning-checkout-form');

    const summaryTitle = document.getElementById('summary-title');
    const summaryDuration = document.getElementById('summary-duration');
    const summarySubtotal = document.getElementById('summary-subtotal');
    const summaryBtw = document.getElementById('summary-btw');
    const summaryTotal = document.getElementById('summary-total');

    const idealModal = document.getElementById('ideal-modal');
    const idealCard = document.getElementById('ideal-card-container');
    const idealStep1 = document.getElementById('ideal-step-1');
    const idealStep2 = document.getElementById('ideal-step-2');
    const confirmedEmail = document.getElementById('confirmed-email');
    const successCloseBtn = document.getElementById('success-close-btn');

    radioLabels.forEach((label) => {
      const radioInput = label.querySelector('input[type="radio"]');
      if (!radioInput) return;

      radioInput.addEventListener('change', () => {
        if (!radioInput.checked) return;

        radioLabels.forEach((lbl) => {
          lbl.classList.remove('border-brand-primary', 'bg-white', 'ring-2', 'ring-brand-primary/15', 'shadow-xs');
          lbl.classList.add('border-brand-dark/8', 'bg-brand-cream/40');
          const dot = lbl.querySelector('.radio-dot');
          if (dot) {
            dot.classList.add('scale-0');
            dot.classList.remove('scale-100');
          }
        });

        label.classList.add('border-brand-primary', 'bg-white', 'ring-2', 'ring-brand-primary/15', 'shadow-xs');
        label.classList.remove('border-brand-dark/8', 'bg-brand-cream/40');
        const activeDot = label.querySelector('.radio-dot');
        if (activeDot) {
          activeDot.classList.remove('scale-0');
          activeDot.classList.add('scale-100');
        }

        const course = elearningCourses.find((c) => c.id === radioInput.value);
        if (!course) return;

        if (summaryTitle) summaryTitle.textContent = course.title;
        if (summaryDuration) summaryDuration.textContent = course.duration;
        if (summarySubtotal) summarySubtotal.textContent = course.price;

        const subtotal = course.rawPrice;
        const btw = subtotal * 0.21;
        const total = subtotal + btw;

        if (summaryBtw) summaryBtw.textContent = `€ ${btw.toFixed(2).replace('.', ',')}`;
        if (summaryTotal) summaryTotal.textContent = `€ ${total.toFixed(2).replace('.', ',')}`;
      });
    });

    paymentLabels.forEach((label) => {
      const radioInput = label.querySelector('input[type="radio"]');
      if (!radioInput) return;

      radioInput.addEventListener('change', () => {
        if (!radioInput.checked) return;

        paymentLabels.forEach((lbl) => {
          lbl.classList.remove('border-brand-primary', 'bg-brand-cream/20', 'ring-2', 'ring-brand-primary/15');
          lbl.classList.add('border-brand-dark/10', 'bg-white');
          const icon = lbl.querySelector('.fa-solid');
          if (icon) {
            icon.classList.remove('text-brand-primary');
            icon.classList.add('text-brand-dark/45');
          }
        });

        label.classList.add('border-brand-primary', 'bg-brand-cream/20', 'ring-2', 'ring-brand-primary/15');
        label.classList.remove('border-brand-dark/10', 'bg-white');
        const icon = label.querySelector('.fa-solid');
        if (icon) {
          icon.classList.add('text-brand-primary');
          icon.classList.remove('text-brand-dark/45');
        }
      });
    });

    if (checkoutForm && idealModal && idealCard) {
      checkoutForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const emailEl = document.getElementById('checkout-email');
        const email = emailEl ? emailEl.value : '';

        idealModal.classList.remove('hidden');
        idealModal.classList.add('flex');

        requestAnimationFrame(() => {
          idealModal.classList.remove('opacity-0');
          idealCard.classList.remove('scale-95');
          idealCard.classList.add('scale-100');
        });

        if (confirmedEmail) confirmedEmail.textContent = email;
        if (idealStep1) idealStep1.classList.remove('hidden');
        if (idealStep2) idealStep2.classList.add('hidden');

        setTimeout(() => {
          if (idealStep1) idealStep1.classList.add('hidden');
          if (idealStep2) {
            idealStep2.classList.remove('hidden');
            idealStep2.classList.add('block');
          }
        }, 1800);
      });
    }

    if (successCloseBtn && idealModal && idealCard) {
      successCloseBtn.addEventListener('click', () => {
        idealModal.classList.add('opacity-0');
        idealCard.classList.remove('scale-100');
        idealCard.classList.add('scale-95');
        setTimeout(() => {
          idealModal.classList.remove('flex');
          idealModal.classList.add('hidden');
          if (checkoutForm) checkoutForm.reset();
        }, 300);
      });
    }
  }

  initElearningCheckout();
  document.addEventListener('astro:page-load', initElearningCheckout);
</script>
