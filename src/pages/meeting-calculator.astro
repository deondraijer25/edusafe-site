                  <td class="py-3.5 px-4">128.040 / jr</td>
                  <td class="py-3.5 pl-4 font-semibold text-brand-accent">€ 8,69 – € 49,33</td>
                </tr>
                <tr>
                  <td class="py-3.5 pr-4 font-bold text-slate-900">3. BHV Opleidingen <span class="block text-xs font-normal text-slate-500">bhv cursus, bhv herhaling, ploegleider, incompany</span></td>
                  <td class="py-3.5 px-4 font-bold text-[#0C4EA2]">8.890 / mnd</td>
                  <td class="py-3.5 px-4">106.680 / jr</td>
                  <td class="py-3.5 pl-4 font-semibold text-brand-accent">€ 8,80 – € 61,35</td>
                </tr>
                <tr>
                  <td class="py-3.5 pr-4 font-bold text-slate-900">4. EHBO & Reanimatie <span class="block text-xs font-normal text-slate-500">ehbo cursus, reanimatie, ehbo bij kinderen, aed</span></td>
                  <td class="py-3.5 px-4 font-bold text-[#0C4EA2]">7.700 / mnd</td>
                  <td class="py-3.5 px-4">92.400 / jr</td>
                  <td class="py-3.5 pl-4 font-semibold text-brand-accent">€ 1,49 – € 4,37</td>
                </tr>
                <tr>
                  <td class="py-3.5 pr-4 font-bold text-slate-900">5. Transport & Offshore <span class="block text-xs font-normal text-slate-500">heftruckcertificaat, hoogwerker, reachtruck, bosiet</span></td>
                  <td class="py-3.5 px-4 font-bold text-[#0C4EA2]">3.450 / mnd</td>
                  <td class="py-3.5 px-4">41.400 / jr</td>
                  <td class="py-3.5 pl-4 font-semibold text-brand-accent">€ 4,91 – € 20,69</td>
                </tr>
                <tr class="border-t-2 border-slate-200 bg-slate-50 font-bold">
                  <td class="py-3.5 pr-4 text-slate-900">TOTAAL</td>
                  <td class="py-3.5 px-4 text-[#0C4EA2]">41.710 / mnd</td>
                  <td class="py-3.5 px-4 text-slate-900">500.520 / jr</td>
                  <td class="py-3.5 pl-4 text-slate-600">Gem. € 12 – € 61 / klik</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ============================================================ -->
      <!-- TAB 3: MEETING CHECKLIST                                     -->
      <!-- ============================================================ -->
      <div id="tab-panel-checklist" class="main-tab-panel hidden space-y-6">
        <div class="bg-white rounded-2xl border border-slate-200 p-4 sm:p-8 shadow-xs space-y-4">
          <h2 class="font-display font-bold text-xl text-slate-900">
            Checklist & Vraagstukken voor tijdens de Meeting
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
            <label class="flex items-start gap-3 p-4 rounded-xl bg-slate-50 border border-slate-200 cursor-pointer">
              <input type="checkbox" class="mt-1 w-4 h-4 accent-brand-accent rounded shrink-0" />
              <span><strong>1. Cursusoverzicht + Exacte Prijzen + E-learning Abonnement:</strong> Definitieve lijst met alle cursusprijzen én de prijzen voor het nieuwe E-learning abonnement.</span>
            </label>
            <label class="flex items-start gap-3 p-4 rounded-xl bg-slate-50 border border-slate-200 cursor-pointer">
              <input type="checkbox" class="mt-1 w-4 h-4 accent-brand-accent rounded shrink-0" />
              <span><strong>2. Officiële Livegang-datum:</strong> Wanneer willen ze officieel live?</span>
            </label>
            <label class="flex items-start gap-3 p-4 rounded-xl bg-slate-50 border border-slate-200 cursor-pointer">
              <input type="checkbox" class="mt-1 w-4 h-4 accent-brand-accent rounded shrink-0" />
              <span><strong>3. Google Bedrijfsprofiel (GBP):</strong> Wie heeft toegang en mij direct <strong>Beheerder</strong> maken.</span>
            </label>
            <label class="flex items-start gap-3 p-4 rounded-xl bg-slate-50 border border-slate-200 cursor-pointer">
              <input type="checkbox" class="mt-1 w-4 h-4 accent-brand-accent rounded shrink-0" />
              <span><strong>4. Facebook (Edusafe & Firesafe) + WhatsApp Business:</strong> Facebook Business + WhatsApp Business instellen via Leadfabriek CRM (mij <strong>Beheerder</strong> maken).</span>
            </label>
            <label class="flex items-start gap-3 p-4 rounded-xl bg-slate-50 border border-slate-200 cursor-pointer">
              <input type="checkbox" class="mt-1 w-4 h-4 accent-brand-accent rounded shrink-0" />
              <span><strong>5. Variabele onderdelen via Leadfabriek CRM:</strong> Welke onderdelen op de website willen ze zelf aanpassen vanuit het Leadfabriek CRM?</span>
            </label>
            <label class="flex items-start gap-3 p-4 rounded-xl bg-slate-50 border border-slate-200 cursor-pointer">
              <input type="checkbox" class="mt-1 w-4 h-4 accent-brand-accent rounded shrink-0" />
              <span><strong>6. Welke documenten/handelingen nog meer automatiseren?:</strong> Evaluatieformulier (`/evaluatieformulier`) is nu digitaal. Welke documenten of flows volgen?</span>
            </label>
            <label class="flex items-start gap-3 p-4 rounded-xl bg-slate-50 border border-slate-200 cursor-pointer">
              <input type="checkbox" class="mt-1 w-4 h-4 accent-brand-accent rounded shrink-0" />
              <span><strong>7. Firesafe B.V. (`firesafebv.nl`) & Webshop-URL:</strong> Meer context + optie voor een andere URL voor de webshop.</span>
            </label>
            <label class="flex items-start gap-3 p-4 rounded-xl bg-slate-50 border border-slate-200 cursor-pointer">
              <input type="checkbox" class="mt-1 w-4 h-4 accent-brand-accent rounded shrink-0" />
              <span><strong>8. Fotoshoot & Content-dag prikken:</strong> Foto's/video schieten op kantoor, van de auto's en tijdens een event/training op locatie.</span>
            </label>
          </div>
        </div>
      </div>

    </div>
  </main>
</Layout>

<script is:inline>
  (function () {
    // Tab switching
    const tabBtns = document.querySelectorAll('.main-tab-btn');
    const tabPanels = {
      calculator: document.getElementById('tab-panel-calculator'),
      zoekvolume: document.getElementById('tab-panel-zoekvolume'),
      checklist: document.getElementById('tab-panel-checklist'),
    };

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-main-tab');
        tabBtns.forEach((b) => {
          b.className =
            'main-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all text-white/85 hover:text-white hover:bg-white/10 cursor-pointer';
        });
        btn.className =
          'main-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all bg-brand-accent text-white cursor-pointer';

        Object.keys(tabPanels).forEach((k) => {
          if (k === target) {
            tabPanels[k]?.classList.remove('hidden');
          } else {
            tabPanels[k]?.classList.add('hidden');
          }
        });
      });
    });

    const fields = [
      'zzpCount',
      'zzpPrice',
      'compCount',
      'compStaff',
      'compPrice',
      'servCount',
      'servPrice',
      'subNewMonthly',
      'subPriceMonthly',
      'renewalRate',
      'lfStaffCount',
      'lfHoursPerWeek',
      'lfHourlyRate',
    ];

    const state = {
      zzpCount: 15,
      zzpPrice: 195,
      compCount: 10,
      compStaff: 10,
      compPrice: 195,
      servCount: 5,
      servPrice: 1750,
      subNewMonthly: 30,
      subPriceMonthly: 15,
      renewalRate: 85,
      lfStaffCount: 2,
      lfHoursPerWeek: 8,
      lfHourlyRate: 75,
    };

    function formatEuro(amount) {
      return '€ ' + Math.round(amount).toLocaleString('nl-NL') + ',-';
    }

    function formatEuroCompact(amount) {
      return '€ ' + Math.round(amount).toLocaleString('nl-NL');
    }

    function syncInputsFromState() {
      fields.forEach((f) => {
        const numEl = document.getElementById('num-' + f);
        const rngEl = document.getElementById('rng-' + f);
        if (numEl) numEl.value = String(state[f]);
        if (rngEl) rngEl.value = String(state[f]);
      });
    }

    function setTxt(id, txt) {
      const el = document.getElementById(id);
      if (el) el.textContent = txt;
    }

    function recalculate() {
      // Stap 1: ZZP (Aantal per maand × € 195/jr)
      const mndZzp = state.zzpCount * state.zzpPrice;
      const yrZzp = mndZzp * 12;
      setTxt('sub-zzp-month', formatEuro(mndZzp));
      setTxt('sub-zzp-year', formatEuro(yrZzp));
      setTxt(
        'sub-zzp-count-yr',
        state.zzpCount +
          ' per maand = ' +
          state.zzpCount * 12 +
          ' cursisten per jaar'
      );

      // Stap 2: Bedrijven (Aantal bedrijven per maand × gem. personeel × € 195/jr)
      const mndComp = state.compCount * state.compStaff * state.compPrice;
      const yrComp = mndComp * 12;
      const mndStaff = state.compCount * state.compStaff;
      setTxt('sub-comp-month', formatEuro(mndComp));
      setTxt('sub-comp-year', formatEuro(yrComp));
      setTxt(
        'sub-comp-staff-total',
        state.compCount +
          ' bedrijven/mnd × ' +
          state.compStaff +
          ' medewerkers = ' +
          mndStaff +
          ' cursisten/mnd'
      );

      // Stap 3: Diensten (Aantal opdrachten per maand × opdrachtwaarde)
      const mndServ = state.servCount * state.servPrice;
      const yrServ = mndServ * 12;
      setTxt('sub-serv-month', formatEuro(mndServ));
      setTxt('sub-serv-year', formatEuro(yrServ));
      setTxt(
        'sub-serv-count-yr',
        state.servCount +
          ' opdrachten per maand = ' +
          state.servCount * 12 +
          ' opdrachten per jaar'
      );

      // Stap 4: E-learning maandabonnementen (Aantal nieuwe abonnees/mnd × 12 = actieve abonnees J1 × maandprijs)
      const renRate = state.renewalRate / 100;
      const activeSubsY1 = state.subNewMonthly * 12;
      const mndSub = activeSubsY1 * state.subPriceMonthly;
      const subY1 = mndSub * 12;
      const subY2 = subY1 + subY1 * renRate;
      const subY3 = subY1 + subY2 * renRate;

      setTxt('sub-elearning-mnd', formatEuro(mndSub) + ' / mnd');
      setTxt('sub-elearning-y1', formatEuro(subY1) + ' / jr');
      setTxt(
        'sub-elearn-count-yr',
        state.subNewMonthly +
          ' nieuwe abonnees/mnd = ' +
          activeSubsY1 +
          ' abonnees in Jaar 1 (groeit naar ' +
          formatEuro(subY3) +
          '/jr in J3)'
      );

      // Directe nieuwe omzet (Stap 1 + 2 + 3)
      const mndNewDirect = mndZzp + mndComp + mndServ;
      const yrNewDirect = mndNewDirect * 12;

      // Stap 5: Verlenging (op directe jaaromzet)
      const y2Ren = yrNewDirect * renRate;
      const y3Ren = (yrNewDirect + y2Ren) * renRate;
      setTxt('sub-renewal-y2', '+ ' + formatEuro(y2Ren));
      setTxt('sub-renewal-y3', '+ ' + formatEuro(y3Ren));

      // Stap 6: Besparing Leadfabriek
      const lfHoursYear = state.lfStaffCount * state.lfHoursPerWeek * 50;
      const yrLfLaborSaved = lfHoursYear * state.lfHourlyRate;
      setTxt(
        'sub-lf-hours-label',
        lfHoursYear.toLocaleString('nl-NL') +
          ' uur per jaar bespaard op uitnodigingen, evaluaties & verlengingen'
      );
      setTxt('sub-lf-saving-year', '+ ' + formatEuro(yrLfLaborSaved));
      setTxt('sub-lf-month-label', '+ ' + formatEuro(yrLfLaborSaved / 12));

      // Samenvatting onderaan (Jaar 1, Jaar 2, Jaar 3)
      const mndTotalNew = mndNewDirect + mndSub;
      const yrTotalNew = yrNewDirect + subY1;

      const y1Total = yrNewDirect + subY1 + yrLfLaborSaved;
      const y2Total = yrNewDirect + y2Ren + subY2 + yrLfLaborSaved;
      const y3Total = yrNewDirect + y3Ren + subY3 + yrLfLaborSaved;
      const grand3Yr = y1Total + y2Total + y3Total;

      setTxt('res-monthly-new', formatEuro(mndTotalNew) + ' / mnd');
      setTxt('res-yearly-new', formatEuro(yrTotalNew) + ' / jr');

      setTxt('res-y1-total', formatEuro(y1Total) + ' / jr');
      setTxt('res-y1-mnd', formatEuro(y1Total / 12) + ' / mnd');
      setTxt('res-y1-new', formatEuroCompact(yrNewDirect));
      setTxt('res-y1-sub', formatEuroCompact(subY1));
      setTxt('res-y1-labor', '+ ' + formatEuroCompact(yrLfLaborSaved));

      setTxt('res-y2-total', formatEuro(y2Total) + ' / jr');
      setTxt('res-y2-mnd', formatEuro(y2Total / 12) + ' / mnd');
      setTxt('res-y2-new', formatEuroCompact(yrNewDirect));
      setTxt('res-y2-ren', '+ ' + formatEuroCompact(y2Ren));
      setTxt('res-y2-sub', formatEuroCompact(subY2));
      setTxt('res-y2-labor', '+ ' + formatEuroCompact(yrLfLaborSaved));

      setTxt('res-y3-total', formatEuro(y3Total) + ' / jr');
      setTxt('res-y3-mnd', formatEuro(y3Total / 12) + ' / mnd');
      setTxt('res-y3-new', formatEuroCompact(yrNewDirect));
      setTxt('res-y3-ren', '+ ' + formatEuroCompact(y3Ren));
      setTxt('res-y3-sub', formatEuroCompact(subY3));
      setTxt('res-y3-labor', '+ ' + formatEuroCompact(yrLfLaborSaved));

      setTxt('res-3yr-grand', formatEuro(grand3Yr));
      setTxt(
        'res-lf-summary-line',
        'Inclusief ' +
          formatEuro(yrLfLaborSaved * 3) +
          ' besparing op kantooruren over 3 jaar (' +
          state.lfStaffCount +
          ' pers. à € ' +
          state.lfHourlyRate +
          '/uur)'
      );

      // Vergelijkingstabel onderaan (3%, 5%, 7.5%, 10%)
      setTxt('tbl-staff-label', String(state.compStaff));
      setTxt('tbl-price-label', String(state.compPrice));

      const baseCounts = { zzp: 15, comp: 10, serv: 5, sub: 30 };
      const cols = [
        { key: '3', mult: 1 },
        { key: '5', mult: 5 / 3 },
        { key: '75', mult: 7.5 / 3 },
        { key: '10', mult: 10 / 3 },
      ];

      cols.forEach((col) => {
        const zC = Math.round(baseCounts.zzp * col.mult);
        const cC = Math.round(baseCounts.comp * col.mult);
        const sC = Math.round(baseCounts.serv * col.mult);
        const subC = Math.round(baseCounts.sub * col.mult);

        const mDirect =
          zC * state.zzpPrice +
          cC * state.compStaff * state.compPrice +
          sC * state.servPrice;
        const yDirect = mDirect * 12;

        const mSub = subC * 12 * state.subPriceMonthly;
        const sY1 = mSub * 12;
        const sY2 = sY1 + sY1 * renRate;
        const sY3 = sY1 + sY2 * renRate;

        const y1 = yDirect + sY1 + yrLfLaborSaved;
        const r2 = yDirect * renRate;
        const y2 = yDirect + r2 + sY2 + yrLfLaborSaved;
        const r3 = (yDirect + r2) * renRate;
        const y3 = yDirect + r3 + sY3 + yrLfLaborSaved;
        const sum3 = y1 + y2 + y3;

        setTxt('t-req-' + col.key, zC + cC + sC + ' / mnd');
        setTxt('t-mnd-' + col.key, formatEuro(mDirect + mSub) + ' / mnd');
        setTxt('t-lf-' + col.key, '+ ' + formatEuro(yrLfLaborSaved) + ' / jr');
        setTxt('t-y1-' + col.key, formatEuro(y1));
        setTxt('t-y2-' + col.key, formatEuro(y2));
        setTxt('t-y3-' + col.key, formatEuro(y3));
        setTxt('t-sum-' + col.key, formatEuro(sum3));
      });
    }

    fields.forEach((f) => {
      const numEl = document.getElementById('num-' + f);
      const rngEl = document.getElementById('rng-' + f);

      numEl?.addEventListener('input', () => {
        const val = Number(numEl.value) || 0;
        state[f] = val;
        if (rngEl) rngEl.value = String(val);
        recalculate();
      });

      rngEl?.addEventListener('input', () => {
        const val = Number(rngEl.value) || 0;
        state[f] = val;
        if (numEl) numEl.value = String(val);
        recalculate();
      });
    });

    const presetBtns = document.querySelectorAll('.preset-btn');
    presetBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const pct = Number(btn.getAttribute('data-preset'));
        const mult = pct / 3;

        presetBtns.forEach((b) => {
          b.className =
            'preset-btn px-3.5 py-2 rounded-xl text-xs font-bold border border-slate-200 bg-slate-50 text-slate-700 hover:border-[#0C4EA2] transition-all cursor-pointer';
        });
        btn.className =
          'preset-btn is-active px-3.5 py-2 rounded-xl text-xs font-bold border border-brand-accent bg-brand-accent text-white transition-all cursor-pointer';

        state.zzpCount = Math.round(15 * mult);
        state.compCount = Math.round(10 * mult);
        state.servCount = Math.round(5 * mult);
        state.subNewMonthly = Math.round(30 * mult);

        syncInputsFromState();
        recalculate();
      });
    });

    recalculate();
  })();
</script>
