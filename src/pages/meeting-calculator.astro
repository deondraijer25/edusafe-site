---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Edusafe × Leadfabriek — Businesscase & ROI Calculator"
  description="Overzichtelijke omzet-, herhalings- en besparingscalculator voor Edusafe."
>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <main class="w-full bg-[#F4F7FB] min-h-screen pb-24">
    <!-- Rustige Header over de volledige breedte -->
    <section class="bg-[#0C4EA2] text-white py-6 sm:py-8 border-b border-white/10">
      <div class="max-w-[1280px] mx-auto px-4 sm:px-6">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-brand-accent block mb-1">
              Edusafe × Leadfabriek CRM
            </span>
            <h1 class="font-display font-bold text-2xl sm:text-3xl text-white">
              Interactieve Businesscase & Calculator
            </h1>
          </div>

          <!-- Tabbladen + PDF Knop -->
          <div class="flex flex-wrap gap-1.5 bg-white/10 p-1.5 rounded-xl border border-white/15 self-start md:self-auto">
            <button
              type="button"
              data-main-tab="calculator"
              class="main-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all bg-brand-accent text-white cursor-pointer"
            >
              1. Calculator
            </button>
            <button
              type="button"
              data-main-tab="zoekvolume"
              class="main-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all text-white/85 hover:text-white hover:bg-white/10 cursor-pointer"
            >
              2. Zoekvolume Details
            </button>
            <button
              type="button"
              data-main-tab="checklist"
              class="main-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all text-white/85 hover:text-white hover:bg-white/10 cursor-pointer"
            >
              3. Checklist
            </button>
            <a
              href="/Edusafe-Meeting-Overzicht.pdf"
              target="_blank"
              class="px-4 py-2 rounded-lg text-xs font-bold transition-all bg-white text-[#0C4EA2] hover:bg-white/90 inline-flex items-center gap-1.5"
            >
              <i class="fa-solid fa-file-pdf text-brand-accent"></i> PDF Overzicht
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Hoofdcontainer (1280px breed voor rust, ruimte en gelijke kolommen) -->
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 pt-6 sm:pt-8">
      
      <!-- ============================================================ -->
      <!-- TAB 1: OVERZICHTELIJKE BUSINESSCASE & CALCULATOR             -->
      <!-- ============================================================ -->
      <div id="tab-panel-calculator" class="main-tab-panel space-y-6 sm:space-y-8">
        
        <!-- DEEL 1: SAMENVATTING VAN DE OMVANG VAN DE MARKT -->
        <div class="bg-white rounded-2xl border border-slate-200/90 p-4 sm:p-7 shadow-xs space-y-5">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-100">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-[#0C4EA2] block">
                1. Marktpotentieel Nederland (DataForSEO)
              </span>
              <h2 class="font-display font-bold text-xl text-slate-900 mt-0.5">
                De Omvang van de Markt in Google
              </h2>
            </div>
            <div class="grid grid-cols-2 sm:flex items-center gap-2 sm:gap-3">
              <div class="bg-slate-50 border border-slate-200 rounded-xl px-3 sm:px-4 py-2 text-left sm:text-right">
                <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-400">Zoekvolume / mnd</span>
                <span class="font-display font-bold text-base sm:text-lg text-slate-900 whitespace-nowrap">41.710 / mnd</span>
              </div>
              <div class="bg-[#0C4EA2]/8 border border-[#0C4EA2]/20 rounded-xl px-3 sm:px-4 py-2 text-left sm:text-right">
                <span class="block text-[10px] font-bold uppercase tracking-wider text-[#0C4EA2]">Zoekvolume / jaar</span>
                <span class="font-display font-bold text-base sm:text-lg text-[#0C4EA2] whitespace-nowrap">500.520 / jaar</span>
              </div>
            </div>
          </div>

          <!-- 5 gelijke kolommen voor de branches -->
          <div class="grid grid-cols-1 min-[375px]:grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4">
            <div class="bg-slate-50/80 border border-slate-200/80 rounded-xl p-4">
              <span class="block text-xs font-bold text-slate-800">VCA & Veiligheid</span>
              <span class="block font-display font-bold text-xl text-[#0C4EA2] mt-1 whitespace-nowrap">11.000 <span class="text-xs font-normal text-slate-500">/mnd</span></span>
              <span class="block text-xs text-slate-500 mt-0.5">132.000 per jaar</span>
              <span class="inline-block text-[11px] font-semibold text-brand-accent bg-brand-accent/10 px-2 py-0.5 rounded mt-2">CPC tot € 10,86</span>
            </div>
            <div class="bg-slate-50/80 border border-slate-200/80 rounded-xl p-4">
              <span class="block text-xs font-bold text-slate-800">Keuringen & RI&E</span>
              <span class="block font-display font-bold text-xl text-[#0C4EA2] mt-1 whitespace-nowrap">10.670 <span class="text-xs font-normal text-slate-500">/mnd</span></span>
              <span class="block text-xs text-slate-500 mt-0.5">128.040 per jaar</span>
              <span class="inline-block text-[11px] font-semibold text-brand-accent bg-brand-accent/10 px-2 py-0.5 rounded mt-2">CPC tot € 49,33</span>
            </div>
            <div class="bg-slate-50/80 border border-slate-200/80 rounded-xl p-4">
              <span class="block text-xs font-bold text-slate-800">BHV Opleidingen</span>
              <span class="block font-display font-bold text-xl text-[#0C4EA2] mt-1 whitespace-nowrap">8.890 <span class="text-xs font-normal text-slate-500">/mnd</span></span>
              <span class="block text-xs text-slate-500 mt-0.5">106.680 per jaar</span>
              <span class="inline-block text-[11px] font-semibold text-brand-accent bg-brand-accent/10 px-2 py-0.5 rounded mt-2">CPC tot € 61,35</span>
            </div>
            <div class="bg-slate-50/80 border border-slate-200/80 rounded-xl p-4">
              <span class="block text-xs font-bold text-slate-800">EHBO & Reanimatie</span>
              <span class="block font-display font-bold text-xl text-[#0C4EA2] mt-1 whitespace-nowrap">7.700 <span class="text-xs font-normal text-slate-500">/mnd</span></span>
              <span class="block text-xs text-slate-500 mt-0.5">92.400 per jaar</span>
              <span class="inline-block text-[11px] font-semibold text-brand-accent bg-brand-accent/10 px-2 py-0.5 rounded mt-2">CPC tot € 4,37</span>
            </div>
            <div class="bg-slate-50/80 border border-slate-200/80 rounded-xl p-4 min-[375px]:col-span-2 sm:col-span-1">
              <span class="block text-xs font-bold text-slate-800">Heftruck & Offshore</span>
              <span class="block font-display font-bold text-xl text-[#0C4EA2] mt-1 whitespace-nowrap">3.450 <span class="text-xs font-normal text-slate-500">/mnd</span></span>
              <span class="block text-xs text-slate-500 mt-0.5">41.400 per jaar</span>
              <span class="inline-block text-[11px] font-semibold text-brand-accent bg-brand-accent/10 px-2 py-0.5 rounded mt-2">CPC tot € 20,69</span>
            </div>
          </div>
        </div>

        <!-- SNELKEUZE BALK -->
        <div class="bg-white rounded-2xl border border-slate-200/90 px-4 sm:px-6 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-xs">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-[#0C4EA2] block">
              2. Rekenmodel & Schuifjes
            </span>
            <span class="text-sm font-semibold text-slate-700">
              Kies een groeiscenario of pas de 6 onderdelen hieronder aan:
            </span>
          </div>
          <div class="flex flex-wrap gap-2">
            <button
              type="button"
              data-preset="1.5"
              class="preset-btn px-3.5 py-2 rounded-xl text-xs font-bold border border-slate-200 bg-slate-50 text-slate-700 hover:border-[#0C4EA2] transition-all cursor-pointer"
            >
              Voorzichtig (1,5%)
            </button>
            <button
              type="button"
              data-preset="3"
              class="preset-btn is-active px-3.5 py-2 rounded-xl text-xs font-bold border border-brand-accent bg-brand-accent text-white transition-all cursor-pointer"
            >
              3% (Basis)
            </button>
            <button
              type="button"
              data-preset="5"
              class="preset-btn px-3.5 py-2 rounded-xl text-xs font-bold border border-slate-200 bg-slate-50 text-slate-700 hover:border-[#0C4EA2] transition-all cursor-pointer"
            >
              5% (Groei)
            </button>
            <button
              type="button"
              data-preset="7.5"
              class="preset-btn px-3.5 py-2 rounded-xl text-xs font-bold border border-slate-200 bg-slate-50 text-slate-700 hover:border-[#0C4EA2] transition-all cursor-pointer"
            >
              7,5% (Sterk)
            </button>
            <button
              type="button"
              data-preset="10"
              class="preset-btn px-3.5 py-2 rounded-xl text-xs font-bold border border-slate-200 bg-slate-50 text-slate-700 hover:border-[#0C4EA2] transition-all cursor-pointer"
            >
              10% (Marktleider)
            </button>
          </div>
        </div>

        <!-- ============================================================ -->
        <!-- DE 6 REKENBLOKKEN IN EEN RUSTIG 2-KOLOMS GRID                -->
        <!-- ============================================================ -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch">
          
          <!-- KAART 1: DIRECTE ZZP'ERS & PARTICULIEREN -->
          <div class="bg-white rounded-2xl border border-slate-200/90 p-4 sm:p-6 shadow-xs flex flex-col justify-between space-y-6">
            <div class="space-y-5">
              <div class="flex items-center gap-3 pb-4 border-b border-slate-100">
                <span class="w-8 h-8 rounded-lg bg-[#0C4EA2] text-white font-display font-bold text-sm flex items-center justify-center shrink-0">
                  1
                </span>
                <div>
                  <h3 class="font-display font-bold text-base text-slate-900">
                    Directe ZZP'ers & Losse Cursisten
                  </h3>
                  <span id="sub-zzp-count-yr" class="text-xs text-slate-500">15 per maand = 180 cursisten per jaar</span>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div class="space-y-2">
                  <div class="flex items-center justify-between gap-2">
                    <label for="num-zzpCount" class="text-xs font-semibold text-slate-600">Aantal per maand</label>
                    <div class="flex items-center bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-1">
                      <input type="number" id="num-zzpCount" min="0" max="500" step="1" value="15" class="w-14 text-right font-display font-bold text-sm text-slate-900 bg-transparent focus:outline-none" />
                      <span class="text-xs text-slate-500 ml-1">/mnd</span>
                    </div>
                  </div>
                  <input type="range" id="rng-zzpCount" min="0" max="150" step="1" value="15" class="w-full accent-[#0C4EA2] cursor-pointer h-2 bg-slate-200 rounded-lg" />
                </div>

                <div class="space-y-2">
                  <div class="flex items-center justify-between gap-2">
                    <label for="num-zzpPrice" class="text-xs font-semibold text-slate-600">Cursusprijs p.p. (/jr)</label>
                    <div class="flex items-center bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-1">
                      <span class="text-xs text-slate-500 mr-1">€</span>
                      <input type="number" id="num-zzpPrice" min="50" max="1000" step="5" value="195" class="w-14 text-right font-display font-bold text-sm text-slate-900 bg-transparent focus:outline-none" />
                      <span class="text-xs text-slate-500 ml-1">/jr</span>
                    </div>
                  </div>
                  <input type="range" id="rng-zzpPrice" min="95" max="450" step="5" value="195" class="w-full accent-[#0C4EA2] cursor-pointer h-2 bg-slate-200 rounded-lg" />
                </div>
              </div>
            </div>

            <!-- Vaste Resultaatbalk onderaan de kaart -->
            <div class="grid grid-cols-1 min-[420px]:grid-cols-2 gap-2.5 sm:gap-3 pt-4 border-t border-slate-100">
              <div class="bg-slate-50 border border-slate-200/80 rounded-xl px-4 py-2.5 flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500">Per maand</span>
                <span id="sub-zzp-month" class="font-display font-bold text-sm text-slate-900 whitespace-nowrap">€ 2.925,-</span>
              </div>
              <div class="bg-[#0C4EA2]/8 border border-[#0C4EA2]/20 rounded-xl px-4 py-2.5 flex items-center justify-between">
                <span class="text-xs font-semibold text-[#0C4EA2]">Per jaar</span>
                <span id="sub-zzp-year" class="font-display font-bold text-sm text-[#0C4EA2] whitespace-nowrap">€ 35.100,-</span>
              </div>
            </div>
          </div>

          <!-- KAART 2: BEDRIJVEN & GROEPEN -->
          <div class="bg-white rounded-2xl border border-slate-200/90 p-4 sm:p-6 shadow-xs flex flex-col justify-between space-y-6">
            <div class="space-y-5">
              <div class="flex items-center gap-3 pb-4 border-b border-slate-100">
                <span class="w-8 h-8 rounded-lg bg-[#0C4EA2] text-white font-display font-bold text-sm flex items-center justify-center shrink-0">
                  2
                </span>
                <div>
                  <h3 class="font-display font-bold text-base text-slate-900">
                    Bedrijven & Groepen (B2B Multiplier)
                  </h3>
                  <span id="sub-comp-staff-total" class="text-xs text-slate-500">10 bedrijven/mnd × 10 medewerkers = 100 cursisten/mnd</span>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="space-y-2">
                  <div class="flex items-center justify-between gap-2">
                    <label for="num-compCount" class="text-xs font-semibold text-slate-600">Bedrijven / mnd</label>
                    <div class="flex items-center bg-slate-50 border border-slate-200 rounded-lg px-2 py-1">
                      <input type="number" id="num-compCount" min="0" max="200" step="1" value="10" class="w-12 text-right font-display font-bold text-sm text-slate-900 bg-transparent focus:outline-none" />
                    </div>
                  </div>
                  <input type="range" id="rng-compCount" min="0" max="60" step="1" value="10" class="w-full accent-[#0C4EA2] cursor-pointer h-2 bg-slate-200 rounded-lg" />
                </div>

                <div class="space-y-2">
                  <div class="flex items-center justify-between gap-2">
                    <label for="num-compStaff" class="text-xs font-semibold text-slate-600">Gem. personeel</label>
                    <div class="flex items-center bg-slate-50 border border-slate-200 rounded-lg px-2 py-1">
                      <input type="number" id="num-compStaff" min="1" max="200" step="1" value="10" class="w-12 text-right font-display font-bold text-sm text-slate-900 bg-transparent focus:outline-none" />
                      <span class="text-[11px] text-slate-500 ml-1">p.</span>
                    </div>
                  </div>
                  <input type="range" id="rng-compStaff" min="1" max="50" step="1" value="10" class="w-full accent-brand-accent cursor-pointer h-2 bg-slate-200 rounded-lg" />
                </div>

                <div class="space-y-2">
                  <div class="flex items-center justify-between gap-2">
                    <label for="num-compPrice" class="text-xs font-semibold text-slate-600">Prijs p.p. (/jr)</label>
                    <div class="flex items-center bg-slate-50 border border-slate-200 rounded-lg px-2 py-1">
                      <span class="text-[11px] text-slate-500 mr-0.5">€</span>
                      <input type="number" id="num-compPrice" min="50" max="600" step="5" value="195" class="w-13 text-right font-display font-bold text-sm text-slate-900 bg-transparent focus:outline-none" />
                    </div>
                  </div>
                  <input type="range" id="rng-compPrice" min="95" max="350" step="5" value="195" class="w-full accent-[#0C4EA2] cursor-pointer h-2 bg-slate-200 rounded-lg" />
                </div>
              </div>
            </div>

            <!-- Vaste Resultaatbalk onderaan de kaart -->
            <div class="grid grid-cols-1 min-[420px]:grid-cols-2 gap-2.5 sm:gap-3 pt-4 border-t border-slate-100">
              <div class="bg-slate-50 border border-slate-200/80 rounded-xl px-4 py-2.5 flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500">Per maand</span>
                <span id="sub-comp-month" class="font-display font-bold text-sm text-slate-900 whitespace-nowrap">€ 19.500,-</span>
              </div>
              <div class="bg-[#0C4EA2]/8 border border-[#0C4EA2]/20 rounded-xl px-4 py-2.5 flex items-center justify-between">
                <span class="text-xs font-semibold text-[#0C4EA2]">Per jaar</span>
                <span id="sub-comp-year" class="font-display font-bold text-sm text-[#0C4EA2] whitespace-nowrap">€ 234.000,-</span>
              </div>
            </div>
          </div>

          <!-- KAART 3: KEURINGEN, RI&E & VEILIGHEIDSMIDDELEN -->
          <div class="bg-white rounded-2xl border border-slate-200/90 p-4 sm:p-6 shadow-xs flex flex-col justify-between space-y-6">
            <div class="space-y-5">
              <div class="flex items-center gap-3 pb-4 border-b border-slate-100">
                <span class="w-8 h-8 rounded-lg bg-[#0C4EA2] text-white font-display font-bold text-sm flex items-center justify-center shrink-0">
                  3
                </span>
                <div>
                  <h3 class="font-display font-bold text-base text-slate-900">
                    Keuringen (NEN / Scope), RI&E & Middelen
                  </h3>
                  <span id="sub-serv-count-yr" class="text-xs text-slate-500">5 opdrachten per maand = 60 opdrachten per jaar</span>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div class="space-y-2">
                  <div class="flex items-center justify-between gap-2">
                    <label for="num-servCount" class="text-xs font-semibold text-slate-600">Opdrachten per maand</label>
                    <div class="flex items-center bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-1">
                      <input type="number" id="num-servCount" min="0" max="200" step="1" value="5" class="w-14 text-right font-display font-bold text-sm text-slate-900 bg-transparent focus:outline-none" />
                      <span class="text-xs text-slate-500 ml-1">/mnd</span>
                    </div>
                  </div>
                  <input type="range" id="rng-servCount" min="0" max="50" step="1" value="5" class="w-full accent-[#0C4EA2] cursor-pointer h-2 bg-slate-200 rounded-lg" />
                </div>

                <div class="space-y-2">
                  <div class="flex items-center justify-between gap-2">
                    <label for="num-servPrice" class="text-xs font-semibold text-slate-600">Waarde per opdracht</label>
                    <div class="flex items-center bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-1">
                      <span class="text-xs text-slate-500 mr-1">€</span>
                      <input type="number" id="num-servPrice" min="100" max="25000" step="50" value="1750" class="w-16 text-right font-display font-bold text-sm text-slate-900 bg-transparent focus:outline-none" />
                    </div>
                  </div>
                  <input type="range" id="rng-servPrice" min="250" max="5000" step="50" value="1750" class="w-full accent-[#0C4EA2] cursor-pointer h-2 bg-slate-200 rounded-lg" />
                </div>
              </div>
            </div>

            <!-- Vaste Resultaatbalk onderaan de kaart -->
            <div class="grid grid-cols-1 min-[420px]:grid-cols-2 gap-2.5 sm:gap-3 pt-4 border-t border-slate-100">
              <div class="bg-slate-50 border border-slate-200/80 rounded-xl px-4 py-2.5 flex items-center justify-between">
                <span class="text-xs font-semibold text-slate-500">Per maand</span>
                <span id="sub-serv-month" class="font-display font-bold text-sm text-slate-900 whitespace-nowrap">€ 8.750,-</span>
              </div>
              <div class="bg-[#0C4EA2]/8 border border-[#0C4EA2]/20 rounded-xl px-4 py-2.5 flex items-center justify-between">
                <span class="text-xs font-semibold text-[#0C4EA2]">Per jaar</span>
                <span id="sub-serv-year" class="font-display font-bold text-sm text-[#0C4EA2] whitespace-nowrap">€ 105.000,-</span>
              </div>
            </div>
          </div>

          <!-- KAART 4: NIEUW VERDIENMODEL — E-LEARNING MAANDABONNEMENTEN -->
          <div class="bg-white rounded-2xl border border-slate-200/90 p-4 sm:p-6 shadow-xs flex flex-col justify-between space-y-6">
            <div class="space-y-5">
              <div class="flex items-center gap-3 pb-4 border-b border-slate-100">
                <span class="w-8 h-8 rounded-lg bg-brand-accent text-white font-display font-bold text-sm flex items-center justify-center shrink-0">
                  4
                </span>
                <div>
                  <h3 class="font-display font-bold text-base text-slate-900">
                    Nieuw: E-Learning Maandabonnementen
                  </h3>
                  <span id="sub-elearn-count-yr" class="text-xs text-slate-500">
                    30 nieuwe abonnees/mnd = 360 actieve abonnees in Jaar 1 (stapelt maandelijks op)
                  </span>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div class="space-y-2">
                  <div class="flex items-center justify-between gap-2">
                    <label for="num-subNewMonthly" class="text-xs font-semibold text-slate-600">Nieuwe abonnees / mnd</label>
                    <div class="flex items-center bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-1">
                      <input type="number" id="num-subNewMonthly" min="0" max="1000" step="5" value="30" class="w-14 text-right font-display font-bold text-sm text-slate-900 bg-transparent focus:outline-none" />
                      <span class="text-xs text-slate-500 ml-1">/mnd</span>
                    </div>
                  </div>
                  <input type="range" id="rng-subNewMonthly" min="0" max="200" step="5" value="30" class="w-full accent-brand-accent cursor-pointer h-2 bg-slate-200 rounded-lg" />
                </div>

                <div class="space-y-2">
                  <div class="flex items-center justify-between gap-2">
                    <label for="num-subPriceMonthly" class="text-xs font-semibold text-slate-600">Abonnementsprijs / mnd</label>
                    <div class="flex items-center bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-1">
                      <span class="text-xs text-slate-500 mr-1">€</span>
