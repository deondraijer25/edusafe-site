---
import Layout from '../layouts/Layout.astro';
import PageHeroBackdrop from '../components/PageHeroBackdrop.astro';

const faqs = [
  {
    q: "Wat kost een BHV-cursus en hoe lang duurt de opleiding?",
    a: "Een erkende BHV-cursus bij Edusafe kost € 145,- excl. btw voor BHV Herhaling (1 dagdeel praktijk) en € 195,- excl. btw voor BHV Basis (online e-learning + 1 praktijkdag). Dit tarief is all-in: inclusief lesmateriaal, koffie/thee, uitgebreide lunch en het officiële BHV-certificaat met pasje. Onze BHV-trainingen zijn beschikbaar in het Nederlands en Engels."
  },
  {
    q: "Is BHV verplicht voor elk bedrijf en hoe lang is een BHV-certificaat geldig?",
    a: "Ja, volgens artikel 15 van de Arbowet is iedere werkgever met één of meer medewerkers (inclusief stagiairs en uitzendkrachten) wettelijk verplicht om gecertificeerde bedrijfshulpverleners aan te wijzen. Een BHV-certificaat is 1 jaar geldig. Om te blijven voldoen aan de eisen van de Nederlandse Arbeidsinspectie en uw brandverzekering, volgt de BHV'er jaarlijks een BHV-herhalingstraining."
  },
  {
    q: "Wat is het verschil tussen VCA Basis (B-VCA) en VCA-VOL, en hoe lang is VCA geldig?",
    a: "B-VCA (VCA Basis) is bedoeld voor uitvoerende vakmensen op de werkvloer, terwijl VCA-VOL verplicht is voor operationeel leidinggevenden en ZZP'ers die onder een VCA-gecertificeerde hoofdaannemer werken. Bij Edusafe behaalt u uw VCA-certificaat binnen 1 lesdag met aansluitend het officiële SSVV-examen (vanaf € 195,- excl. btw). Een behaald VCA-diploma is 10 jaar geldig in het Centraal Diplomaregister."
  },
  {
    q: "Wat is het verschil tussen een BHV-cursus en een EHBO-cursus?",
    a: "Een BHV-cursus richt zich op de vier kerntaken bij bedrijfscalamiteiten: spoedeisende eerste hulp (reanimatie & AED), niet-spoedeisende eerste hulp, brandbestrijding en ontruiming. Een officiële EHBO-cursus (conform Het Oranje Kruis, 2 jaar geldig) behandelt geen brand en ontruiming, maar gaat veel dieper in op uitgebreide medische hulpverlening, verbandleer en kinder-EHBO (EHAK voor kinderopvang conform de wet IKK)."
  },
  {
    q: "Is een heftruckcertificaat wettelijk verplicht en hoe lang is het geldig?",
    a: "Volgens artikel 7.17c van het Arbobesluit is een werkgever wettelijk verplicht aan te tonen dat chauffeurs van een heftruck, reachtruck of hoogwerker beschikken over aantoonbare, specifieke deskundigheid. Verzekeraars en de Arbeidsinspectie eisen hiervoor bij controle of een arbeidsongeval een geldig heftruckcertificaat. U behaalt dit certificaat binnen 1 dag (€ 195,- excl. btw) en het is 5 jaar geldig."
  },
  {
    q: "Vanaf hoeveel medewerkers is een RI&E verplicht en wanneer loont Incompany trainen?",
    a: "Een actuele RI&E (Risico-Inventarisatie & -Evaluatie) inclusief Plan van Aanpak is volgens artikel 5 van de Arbowet verplicht voor ieder bedrijf met personeel vanaf 1 werknemer (en moet boven de 25 medewerkers getoetst worden). Moeten er meerdere collega's getraind worden? Al vanaf 5 à 6 deelnemers is een Incompany training op uw eigen bedrijfslocatie voordeliger én direct afgestemd op uw eigen RI&E en vluchtroutes."
  },
  {
    q: "Waar vinden de openbare trainingen plaats?",
    a: "Onze openbare trainingen vinden plaats op onze hoofdlocatie in Den Haag (Oude Middenweg 241A, 2491 AH Den Haag, met gratis parkeergelegenheid voor de deur). Daarnaast verzorgen wij incompany trainingen op elke gewenste bedrijfslocatie in Nederland."
  },
  {
    q: "Wat gebeurt er als een medewerker verhinderd is op de cursusdag?",
    a: "Een ingeschreven medewerker mag te allen tijde kosteloos worden vervangen door een directe collega. Mocht verplaatsing nodig zijn, dan kan dit conform onze voorwaarden kosteloos tot 14 dagen voor aanvang."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<Layout 
  title="Veelgestelde Vragen (FAQ) over BHV, VCA, EHBO & RI&E | Edusafe"
  description="Vind direct antwoord op veelgezochte vragen over BHV kosten en geldigheid, VCA Basis vs VOL, EHBO erkenning, heftruckcertificaat verplichtingen en de RI&E."
>
  <!-- Hero Section -->
  <section class="relative bg-brand-primary text-white pt-12 pb-14 sm:pt-20 sm:pb-16 md:pt-24 md:pb-20 overflow-hidden">
    <PageHeroBackdrop
      image="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&q=80&w=1600"
      alt="Veelgestelde Vragen bij Edusafe"
    />
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 relative z-10">
      
      <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-wider mb-4">
        <a href="/" class="hover:underline text-white/75 hover:text-white">Home</a>
        <span class="text-white/40">/</span>
        <span class="text-brand-accent">Veelgestelde Vragen</span>
      </div>

      <h1 class="heading-page mb-4 text-white">
        Veelgestelde <span class="text-brand-accent">Vragen (FAQ)</span>
      </h1>
      <p class="text-white/90 text-sm sm:text-base max-w-2xl leading-relaxed">
        Hieronder vindt u heldere antwoorden op de meest gestelde vragen over onze cursussen, wettelijke verplichtingen (Arbowet), tarieven, geldigheid en veiligheidsdiensten.
      </p>

    </div>
  </section>

  <!-- FAQ Accordion List -->
  <section class="py-12 sm:py-16 bg-brand-cream relative">
    <div class="max-w-[960px] mx-auto px-4 sm:px-6 space-y-3.5 sm:space-y-4">
      {faqs.map((faq, index) => (
        <details class="group bg-white rounded-2xl border border-brand-dark/8 p-4 sm:p-6 shadow-xs [&_summary::-webkit-details-marker]:hidden transition-all open:border-brand-primary/30 open:shadow-md" open={index === 0}>
          <summary class="flex items-center justify-between gap-3 cursor-pointer list-none heading-tile text-brand-secondary">
            <span>{faq.q}</span>
            <span class="w-8 h-8 rounded-xl bg-brand-cream/80 group-open:bg-brand-accent group-open:text-white flex items-center justify-center shrink-0 transition duration-300 group-open:rotate-180 text-brand-primary">
              <i class="fa-solid fa-chevron-down text-xs"></i>
            </span>
          </summary>
          <div class="mt-4 pt-4 border-t border-brand-dark/5 text-card">
            {faq.a}
          </div>
        </details>
      ))}

      <!-- Contact CTA -->
      <div class="mt-10 sm:mt-12 text-center bg-white p-6 sm:p-8 rounded-3xl border border-brand-dark/8 shadow-xs">
        <h2 class="heading-card text-brand-secondary mb-2">
          Staat uw vraag er niet tussen?
        </h2>
        <p class="text-card mb-6 max-w-lg mx-auto">
          Neem gerust direct contact met ons op via telefoon of e-mail. Onze veiligheidsadviseurs helpen u direct verder!
        </p>
        <a 
          href="/contact" 
          class="btn-base w-full sm:w-auto min-h-[48px] bg-brand-accent hover:bg-brand-accent-hover text-white shadow-sm"
        >
          <span>Neem Contact Op</span>
          <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
      </div>

    </div>

    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </section>
</Layout>
