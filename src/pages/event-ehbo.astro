---
import Layout from '../layouts/Layout.astro';
import PageHeroBackdrop from '../components/PageHeroBackdrop.astro';
import MobileCourseBottomBar from '../components/MobileCourseBottomBar.astro';
import CourseFaq from '../components/CourseFaq.astro';
import Reviews from '../components/Reviews.astro';
import ContactForm from '../components/ContactForm.astro';

const services = [
  {
    id: 'event-ehbo-team',
    title: 'Gediplomeerde Evenementen EHBO-Teams',
    tagline: 'Professionele eerstehulpverleners met AED, herkenbare kleding en complete uitrusting',
    price: 'Uurtarief op maat',
    spotsText: 'Vanaf 2 hulpverleners',
    duration: 'Inzetbaar per dagdeel of meerdaags',
    target: 'Voor festivals, sportevenementen, braderieën, bedrijfsfeesten, concerten en congressen.',
    certification: 'Volledig conform Veldnorm Evenementenzorg (WGBO) en GHOR-richtlijnen.',
    inclusions: [
      'Gediplomeerde en representatieve EHBO’ers in uniforme kleding',
      'Complete professionele EHBO-tassen, zuurstofkoffers en AED’s',
      'Onderlinge portofooncommunicatie en coördinatie met beveiliging',
      'Registratie van behandelingen in digitaal incidentenjournaal',
    ],
    image: 'https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?auto=format&fit=crop&q=80&w=800',
    registerLink: '/persoonlijk-advies?type=zakelijk&service=event-ehbo',
  },
  {
    id: 'mobiele-ehbo-post-ambulance',
    title: 'Mobiele Behandelposten & Evenementen-Ambulance',
    tagline: 'Volledig ingerichte behandelposten, quads, motoren en medische coördinatie ter plaatse',
    price: 'Offerte op maat',
    spotsText: 'Grootschalige Events',
    duration: 'Turnkey opbouw, bemanning & afbouw',
    target: 'Voor grootschalige publieksevenementen, sporttoernooien en evenementen met verhoogd risicoprofiel.',
    certification: 'Professionele mobiele medische voorziening conform gemeentelijke vergunning & GHOR.',
    inclusions: [
      'Inrichting van mobiele behandelposten met behandeltafels en verlichting',
      'Inzet van evenementen-ambulance voor directe medische stabilisatie',
      'Mobiele biketeams, quads of medische motoren voor snelle respons',
      'Medisch coördinator als vast aanspreekpunt voor organisatie en GHOR',
    ],
    image: 'https://images.unsplash.com/photo-1505373877841-8d25f7d46678?auto=format&fit=crop&q=80&w=800',
    registerLink: '/persoonlijk-advies?type=zakelijk&service=event-ehbo',
  },
];

const eventFaqs = [
  {
    q: 'Voldoet de Evenementen-EHBO van Edusafe aan de Veldnorm Evenementenzorg en GHOR-eisen?',
    a: 'Ja. Onze evenementenhulpverleners, uitrusting en medische registratie voldoen volledig aan de landelijke Veldnorm Evenementenzorg en de vergunningseisen van gemeenten en regionale GHOR-bureaus.',
  },
  {
    q: 'Hoeveel EHBO’ers zijn er verplicht voor ons evenement?',
    a: 'Als basisrichtlijn geldt vaak minimaal 2 gecertificeerde hulpverleners per 1.000 gelijktijdige bezoekers, afhankelijk van het risicoprofiel (sport, alcohol, buitenlocatie, bereikbaarheid). Wij adviseren u graag bij uw vergunningsaanvraag.',
  },
  {
    q: 'Nemen jullie zelf AED’s, portofoons en behandelmateriaal mee?',
    a: 'Ja, onze teams zijn volledig zelfvoorzienend uitgerust met professionele EHBO-rugzakken, AED’s, portofoons en — indien gewenst — compleet ingerichte mobiele behandelposten.',
  },
  {
    q: 'Hoe snel ontvangen wij een offerte voor medische evenementenondersteuning?',
    a: 'Wanneer u uw evenementdatum, locatie en verwachte bezoekersaantal doorgeeft via onze aanvraagpagina, ontvangt u binnen 1 werkdag een sluitend inzetvoorstel op maat.',
  },
];
---

<Layout
  title="Evenementen EHBO & Medische Ondersteuning Huren (GHOR Conform) | Edusafe"
  description="Professionele evenementen-EHBO, mobiele behandelposten en medische teams huren conform Veldnorm Evenementenzorg en GHOR-eisen door heel Nederland."
>
  <main class="w-full">
    <!-- 1. GOLD-STANDARD HERO SECTION -->
    <section class="relative bg-brand-primary text-white pt-12 pb-20 sm:pt-20 sm:pb-28 md:pt-24 md:pb-36 overflow-hidden">
      <PageHeroBackdrop
        image="https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?auto=format&fit=crop&q=80&w=1600"
        alt="Evenementen EHBO en Medische Ondersteuning"
      />

      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 relative z-10">
        <nav aria-label="Breadcrumb" class="section-eyebrow text-brand-primary mb-3 sm:mb-3.5 flex-wrap">
          <a href="/" class="hover:underline text-white/70 hover:text-white">Home</a>
          <span class="text-white/40">/</span>
          <a href="/ehbo-cursus" class="hover:underline text-white/70 hover:text-white">EHBO</a>
          <span class="text-white/40">/</span>
          <span class="text-brand-accent">Evenementen EHBO</span>
        </nav>

        <div class="max-w-3xl">
          <h1 class="heading-page mb-3 text-white">
            Evenementen EHBO &amp; Medische Teams
          </h1>
          <p class="text-lead text-white/85 max-w-2xl mb-5 sm:mb-6">
            Organiseert u een festival, sportevenement of congres? Edusafe levert gediplomeerde EHBO-teams, AED-uitrusting en mobiele behandelposten conform de Veldnorm Evenementenzorg.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2.5 max-w-xl mb-6 sm:mb-7 text-card text-white/95 font-medium">
            <div class="flex items-center gap-2.5">
              <i class="fa-solid fa-circle-check text-brand-accent text-sm shrink-0"></i>
              <span>Conform Veldnorm &amp; GHOR</span>
            </div>
            <div class="flex items-center gap-2.5">
              <i class="fa-solid fa-circle-check text-brand-accent text-sm shrink-0"></i>
              <span>Standaard uitgerust met AED</span>
            </div>
            <div class="flex items-center gap-2.5">
              <i class="fa-solid fa-circle-check text-brand-accent text-sm shrink-0"></i>
              <span>Mobiele posten, quads &amp; portofoons</span>
            </div>
            <div class="flex items-center gap-2.5">
              <i class="fa-solid fa-circle-check text-brand-accent text-sm shrink-0"></i>
              <span>24/7 landelijk inzetbaar</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-3 sm:gap-3.5">
            <a href="/persoonlijk-advies?type=zakelijk&service=event-ehbo" class="btn-hero w-full sm:w-auto">
              <span>EHBO-team aanvragen</span>
              <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>
            <a
              href="#details"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 font-display font-semibold text-[15px] px-7 py-3.5 sm:py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white border border-white/20 backdrop-blur-sm transition-all duration-300"
            >
              <i class="fa-solid fa-kit-medical text-brand-accent"></i>
              <span>Bekijk inzetopties ↓</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. SERVICE CARDS SECTION -->
    <section id="details" class="max-w-[1280px] mx-auto px-4 sm:px-6 -mt-12 sm:-mt-14 md:-mt-20 relative z-20 pb-20 scroll-mt-40">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8">
        {services.map((srv) => (
          <div class="bg-white rounded-3xl p-5 sm:p-8 border border-brand-dark/5 shadow-lg flex flex-col justify-between hover:border-brand-primary/30 transition-all">
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2 sm:gap-4 mb-4">
                <span class="px-3 py-1 rounded-full bg-brand-primary/10 text-brand-primary text-xs font-semibold uppercase tracking-wider">
                  {srv.spotsText}
                </span>
                <span class="font-display text-lg font-semibold text-brand-accent">
                  {srv.price}
                </span>
              </div>

              <h2 class="heading-card text-brand-secondary mb-2">
                {srv.title}
              </h2>
              <p class="text-body text-brand-dark/75 mb-6">
                {srv.tagline}
              </p>

              <div class="rounded-2xl bg-brand-cream/55 border border-brand-dark/6 p-4 space-y-3 mb-6 text-card">
                <div class="flex items-start gap-3">
                  <i class="fa-solid fa-clock text-brand-primary mt-1 shrink-0"></i>
                  <div>
                    <strong class="text-brand-secondary block">Inzetbaarheid</strong>
                    <span class="text-brand-dark/75">{srv.duration}</span>
                  </div>
                </div>
                <div class="flex items-start gap-3 pt-2.5 border-t border-brand-dark/6">
                  <i class="fa-solid fa-shield-halved text-brand-primary mt-1 shrink-0"></i>
                  <div>
                    <strong class="text-brand-secondary block">Kwaliteitsnorm</strong>
                    <span class="text-brand-dark/75">{srv.certification}</span>
                  </div>
                </div>
              </div>

              <span class="section-eyebrow text-brand-dark/45 mb-3">
                <span>Inbegrepen in de inzet</span>
              </span>
              <ul class="space-y-2.5 mb-8">
                {srv.inclusions.map((inc) => (
                  <li class="flex items-start gap-2.5 text-card text-brand-dark/80">
                    <i class="fa-solid fa-circle-check text-emerald-500 text-xs mt-1 shrink-0"></i>
                    <span>{inc}</span>
                  </li>
                ))}
              </ul>
            </div>

            <a
              href="/persoonlijk-advies?type=zakelijk&service=event-ehbo"
              class="btn-base w-full"
            >
              <span>Vrijblijvende offerte aanvragen →</span>
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. COMPLETE FOOTER STACK -->
    <CourseFaq
      category="EHBO"
      hubTitle="Evenementen EHBO"
      customFaqs={eventFaqs}
      lang="nl"
    />
    <Reviews />
    <ContactForm />

    <MobileCourseBottomBar
      defaultCourse={services[0]}
      itemType="service"
      serviceSlug="event-ehbo"
      advisorText="Medisch team nodig voor uw evenement?"
    />
  </main>
</Layout>
