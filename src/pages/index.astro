---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CourseCategories from '../components/CourseCategories.astro';
import PortalPromo from '../components/PortalPromo.astro';
import UpcomingEvents from '../components/UpcomingEvents.astro';
import AboutUs from '../components/AboutUs.astro';
import Reviews from '../components/Reviews.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout title="Edusafe | Expert in Bedrijfsveiligheid, BHV & VCA Trainingen">
	<main class="w-full relative">
		<!-- Hero Section -->
		<Hero />

		<!-- Course Categories -->
		<CourseCategories />

		<!-- Portal Promotion Section -->
		<PortalPromo />

		<!-- Upcoming Events Teaser -->
		<UpcomingEvents />

		<!-- About Us & Certifications -->
		<AboutUs />

		<!-- Reviews Section -->
		<Reviews />

		<!-- Contact & Lead Generation Form -->
		<ContactForm />
	</main>
</Layout>
