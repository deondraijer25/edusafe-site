---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CourseCategories from '../components/CourseCategories.astro';
import PortalPromo from '../components/PortalPromo.astro';
import UpcomingEvents from '../components/UpcomingEvents.astro';
import AboutUs from '../components/AboutUs.astro';
import HomeFaq from '../components/HomeFaq.astro';
import Reviews from '../components/Reviews.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout 
  title="BHV, EHBO, VCA & Bedrijfsveiligheid | Cursussen, Keuringen & Incompany | Edusafe" 
  description="Dé partner in BHV (NL & EN), EHBO, VCA, Heftruck en Offshore trainingen, NEN-keuringen en RI&E. Vaak al binnen 1 dag gecertificeerd op onze hoofdlocatie in Den Haag of landelijk incompany."
>
	<main class="w-full relative">
		<!-- Hero Section -->
		<Hero />

		<!-- Course Categories -->
		<CourseCategories />

		<!-- Portal Promotion Section -->
		<PortalPromo />

		<!-- Upcoming Events Teaser -->
		<UpcomingEvents />

		<!-- About Us & Certifications -->
		<AboutUs />

		<!-- DataForSEO & GEO FAQ Section (Directly Above Reviews) -->
		<HomeFaq />

		<!-- Reviews Section -->
		<Reviews />

		<!-- Contact & Lead Generation Form -->
		<ContactForm />
	</main>
</Layout>
