---
import CourseCategoryHub from '../components/CourseCategoryHub.astro';
import { courseCatalog } from '../data/catalog';

const transportCourses = courseCatalog
  .filter((c) => c.category === 'Transport')
  .map((c) => ({
    id: c.slug,
    slug: c.slug,
    title: c.title,
    shortTitle: c.shortTitle,
    tagline: c.tagline,
    price: c.price,
    duration: c.duration,
    target: c.target,
    suitableForHtml: c.suitableForHtml,
    requirements: c.requirements,
    exam: c.exam,
    certification: c.certification,
    inclusions: c.inclusions,
    modules: c.modules,
    learningOutcomes: c.learningOutcomes,
    image: c.image,
  }));
---

<CourseCategoryHub
  lang="nl"
  category="Transport"
  seoTitle="Heftruck, Reachtruck & Hoogwerker Certificaat Halen | Edusafe"
  seoDescription="Haal in 1 dag uw officiële heftruckcertificaat, reachtruckcertificaat, hoogwerkercertificaat of stapelaar/EPT-pas conform Arbobesluit Art. 7.17c (5 jaar geldig)."
  breadcrumbLabel="Heftruck & Intern Transport"
  heroTitle="Heftruck & Intern Transport Opleidingen"
  heroSubtitle="Behaal in één praktijkgerichte trainingsdag uw officiële heftruck-, reachtruck-, hoogwerker- of stapelaar/EPT-certificaat (5 jaar geldig conform Arbowet)."
  heroImage="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&q=80&w=1600"
  heroBullets={[
    'Certificaat in 1 praktijkdag',
    '5 jaar geldig + pasje',
    'Conform Arbobesluit 7.17c',
    'Den Haag of Incompany',
  ]}
  primaryCtaUrl="/persoonlijk-advies?category=Transport"
  courses={transportCourses}
  coursesHeading="Alle opleidingen Intern Transport & Hoogwerker"
  faqTitle="Heftruck & Intern Transport"
  advisorText="Advies voor uw logistieke of magazijnteam?"
/>
