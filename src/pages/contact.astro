---
import Layout from '../layouts/Layout.astro';
import PageHeroBackdrop from '../components/PageHeroBackdrop.astro';
---

<Layout 
  title="Contact & Locatie | Edusafe Trainingen en Opleidingen"
  description="Neem contact op met Edusafe. Bezoek onze hoofdlocatie aan de Oude Middenweg 241A in Den Haag of bel 070-4447795. Openingstijden ma t/m vr 08:30 - 17:00."
>
  <!-- Hero Section -->
  <section class="relative bg-brand-primary text-white pt-12 pb-14 sm:pt-20 sm:pb-20 md:pt-24 md:pb-24 overflow-hidden">
    <PageHeroBackdrop
      image="/assets/images/edusafe_coffee_banner.webp"
      alt="Contact met Edusafe in Den Haag"
    />
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 relative z-10">
      
      <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-wider mb-4">
        <a href="/" class="hover:underline text-white/75 hover:text-white">Home</a>
        <span class="text-white/40">/</span>
        <span class="text-brand-accent">Contact</span>
      </div>

      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/12 text-white border border-white/25 backdrop-blur-sm text-xs font-bold uppercase tracking-wider mb-4">
          <i class="fa-solid fa-headset text-brand-accent"></i>
          Heb je een vraag?
        </span>
        <h1 class="heading-page mb-6 text-white">
          Neem Contact op met <span class="text-brand-accent">Edusafe</span>
        </h1>
        <p class="text-lg text-white/90 leading-relaxed max-w-2xl">
          Heb je een vraag? Ons team staat telefonisch op werkdagen van 08:30-17:00 voor u klaar. Mail beantwoorden wij binnen 24 uur.
        </p>
      </div>

    </div>
  </section>

  <!-- Contact & Details Grid -->
  <section class="py-12 sm:py-20 bg-brand-cream relative">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
        
        <!-- Left: Direct Contact Information & Details -->
        <div class="lg:col-span-5 space-y-6 sm:space-y-8">
          
          <div class="bg-white p-5 sm:p-8 rounded-3xl border border-brand-dark/5 shadow-sm space-y-6">
            <h3 class="font-display font-semibold text-2xl text-brand-secondary">
              Vestigingsgegevens
            </h3>

            <div class="space-y-5 text-sm text-brand-dark/80">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-brand-primary/10 text-brand-primary flex items-center justify-center shrink-0">
                  <i class="fa-solid fa-location-dot"></i>
                </div>
                <div>
                  <strong class="text-brand-secondary block text-base font-semibold">Hoofdkantoor &amp; Opleidingscentrum</strong>
                  <span>Oude Middenweg 241A</span><br />
                  <span>2491 AH Den Haag</span><br />
                  <span class="text-xs text-brand-dark/60">Gratis parkeren voor de deur</span>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-brand-primary/10 text-brand-primary flex items-center justify-center shrink-0">
                  <i class="fa-solid fa-phone"></i>
                </div>
                <div>
                  <strong class="text-brand-secondary block text-base font-semibold">Telefonisch Bereikbaar</strong>
                  <a href="tel:0704447795" class="text-brand-primary font-bold hover:underline block text-base">
                    070 - 444 77 95
                  </a>
                  <span class="text-xs text-brand-dark/60">Werkdagen: 08:30 – 17:00</span>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-brand-primary/10 text-brand-primary flex items-center justify-center shrink-0">
                  <i class="fa-solid fa-envelope"></i>
                </div>
                <div>
                  <strong class="text-brand-secondary block text-base font-semibold">E-mailadres</strong>
                  <a href="mailto:info@edusafe.nl" class="text-brand-primary font-bold hover:underline block text-base">
                    info@edusafe.nl
                  </a>
                  <span class="text-xs text-brand-dark/60">Mail beantwoorden wij binnen 24 uur</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Company registration details from old website -->
          <div class="bg-white p-5 sm:p-8 rounded-3xl border border-brand-dark/5 shadow-sm">
            <h4 class="font-display font-semibold text-lg text-brand-secondary mb-4">
              Bedrijfsgegevens
            </h4>
            <ul class="text-xs text-brand-dark/70 space-y-2.5">
              <li class="flex flex-col min-[420px]:flex-row min-[420px]:justify-between gap-0.5 border-b border-brand-dark/5 pb-2">
                <strong>KvK-nummer:</strong>
                <span>73291447 (Inschrijfnummer 27260603)</span>
              </li>
              <li class="flex flex-col min-[420px]:flex-row min-[420px]:justify-between gap-0.5 border-b border-brand-dark/5 pb-2">
                <strong>BTW-nummer:</strong>
                <span>NL859442640B01</span>
              </li>
              <li class="flex flex-col min-[420px]:flex-row min-[420px]:justify-between gap-0.5">
                <strong>Bankrekening (ABN AMRO):</strong>
                <span>NL68 ABNA 0834117177</span>
              </li>
            </ul>
          </div>

          <!-- Training locations -->
          <div class="bg-brand-secondary text-white p-5 sm:p-8 rounded-3xl shadow-xl">
            <h4 class="font-display font-semibold text-lg mb-3 text-brand-accent">
              Onze Trainingslocaties
            </h4>
            <ul class="space-y-3 text-xs text-white/80">
              <li class="flex items-start gap-2">
                <i class="fa-solid fa-check text-brand-primary mt-0.5"></i>
                <span><strong>Den Haag Hoofdlocatie:</strong> Oude Middenweg 241A, 2491 AH Den Haag</span>
              </li>
              <li class="flex items-start gap-2">
                <i class="fa-solid fa-check text-brand-primary mt-0.5"></i>
                <span><strong>Zoetermeer:</strong> Golden Tulip Hotel, Kinderen van Versteegplein 18</span>
              </li>
              <li class="flex items-start gap-2">
                <i class="fa-solid fa-check text-brand-primary mt-0.5"></i>
                <span><strong>Incompany:</strong> Op elke bedrijfslocatie in heel Nederland</span>
              </li>
            </ul>
          </div>

        </div>

        <!-- Right: Interactive Contact Form -->
        <div class="lg:col-span-7">
          <div class="bg-white p-5 sm:p-8 lg:p-12 rounded-3xl border border-brand-dark/5 shadow-xl">
            <h3 class="font-display font-semibold text-2xl sm:text-3xl text-brand-secondary mb-2">
              Stuur ons direct een bericht
            </h3>
            <p class="text-sm text-brand-dark/70 mb-6 sm:mb-8">
              Vul het formulier in en een van onze veiligheidsadviseurs neemt dezelfde werkdag contact met u op.
            </p>

            <form id="contact-page-form" class="space-y-5 sm:space-y-6">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6">
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-brand-secondary mb-2">
                    Naam *
                  </label>
                  <input 
                    type="text" 
                    name="name"
                    required 
                    placeholder="Uw volledige naam"
                    class="w-full px-4 py-3.5 rounded-xl border border-brand-dark/15 focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 text-base sm:text-sm"
                  />
                </div>
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-brand-secondary mb-2">
                    Bedrijfsnaam (optioneel)
                  </label>
                  <input 
                    type="text" 
                    name="company"
                    placeholder="Uw organisatie"
                    class="w-full px-4 py-3.5 rounded-xl border border-brand-dark/15 focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 text-base sm:text-sm"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6">
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-brand-secondary mb-2">
                    E-mailadres *
                  </label>
                  <input 
                    type="email" 
                    name="email"
                    required 
                    placeholder="naam@bedrijf.nl"
                    class="w-full px-4 py-3.5 rounded-xl border border-brand-dark/15 focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 text-base sm:text-sm"
                  />
                </div>
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-brand-secondary mb-2">
                    Telefoonnummer *
                  </label>
                  <input 
                    type="tel" 
                    name="phone"
                    required 
                    placeholder="06 - 12345678"
                    class="w-full px-4 py-3.5 rounded-xl border border-brand-dark/15 focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 text-base sm:text-sm"
                  />
                </div>
              </div>

              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-brand-secondary mb-2">
                  Waar kunnen we u mee helpen?
                </label>
                <select name="category" class="w-full px-4 py-3.5 rounded-xl border border-brand-dark/15 focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 text-base sm:text-sm bg-white">
                  <option>BHV Cursus (Basis of Herhaling)</option>
                  <option>EHBO / EHAK Training (Oranje Kruis)</option>
                  <option>VCA Basis of VOL</option>
                  <option>Incompany Groepstraining</option>
                  <option>RI&E Risico-Inventarisatie</option>
                  <option>Brandbeveiliging &amp; Blusmiddelen</option>
                  <option>Noodverlichting Inspectie</option>
                  <option>Ontruimingsplattegronden</option>
                  <option>Evenementen EHBO Huren</option>
                  <option>Dakveiligheid &amp; Valbeveiliging</option>
                  <option>Overige vraag / adviesgesprek</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-brand-secondary mb-2">
                  Uw Bericht *
                </label>
                <textarea 
                  name="message"
                  rows="4" 
                  required 
                  placeholder="Typ hier uw vraag of wensen..."
                  class="w-full px-4 py-3.5 rounded-xl border border-brand-dark/15 focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 text-base sm:text-sm"
                ></textarea>
              </div>

              <button 
                type="submit" 
                class="w-full min-h-[48px] py-4 rounded-xl bg-brand-accent hover:bg-brand-accent-hover text-white font-display font-semibold text-center transition-all shadow-lg hover:-translate-y-0.5 cursor-pointer"
              >
                Verstuur Bericht
              </button>
            </form>

            <div id="contact-page-success" class="hidden flex-col items-center justify-center text-center p-8 bg-emerald-50 border border-emerald-200 rounded-2xl mt-4">
              <div class="w-12 h-12 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600 mb-3">
                <i class="fa-solid fa-check text-lg"></i>
              </div>
              <h4 class="font-display font-semibold text-emerald-900 text-lg mb-1">
                Bericht succesvol ontvangen!
              </h4>
              <p class="text-sm text-emerald-700">
                Bedankt voor uw bericht. Een van onze veiligheidsadviseurs neemt dezelfde werkdag contact met u op.
              </p>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <script>
    const contactForm = document.getElementById('contact-page-form') as HTMLFormElement | null;
    const contactSuccess = document.getElementById('contact-page-success');
    if (contactForm && contactSuccess) {
      contactForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = contactForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
        const origText = btn ? btn.textContent : '';
        if (btn) {
          btn.disabled = true;
          btn.textContent = 'Bezig met versturen...';
        }
        const fd = new FormData(contactForm);
        try {
          await fetch('/api/advies', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              source: 'contact-page',
              name: fd.get('name') || '',
              company: fd.get('company') || '',
              email: fd.get('email') || '',
              phone: fd.get('phone') || '',
              category: fd.get('category') || '',
              message: fd.get('message') || '',
            }),
          });
          contactForm.classList.add('hidden');
          contactSuccess.classList.remove('hidden');
          contactSuccess.classList.add('flex');
        } catch (err) {
          console.error(err);
        } finally {
          if (btn) {
            btn.disabled = false;
            btn.textContent = origText;
          }
        }
      });
    }
  </script>
</Layout>
