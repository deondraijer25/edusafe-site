---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import CourseCategories from '../../components/CourseCategories.astro';
import PortalPromo from '../../components/PortalPromo.astro';
import UpcomingEvents from '../../components/UpcomingEvents.astro';
import AboutUs from '../../components/AboutUs.astro';
import HomeFaq from '../../components/HomeFaq.astro';
import Reviews from '../../components/Reviews.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<Layout 
  title="BHV, First Aid, VCA & Workplace Safety | Courses, Inspections & Incompany | Edusafe" 
  description="Your partner in accredited BHV (ERO), First Aid, VCA, Forklift and Offshore safety training, NEN inspections and RI&E audits. At our training facility or incompany across the Netherlands."
>
	<main class="w-full relative">
		<!-- Hero Section -->
		<Hero />

		<!-- Course Categories -->
		<CourseCategories />

		<!-- Portal Promotion Section -->
		<PortalPromo />

		<!-- Upcoming Events Teaser -->
		<UpcomingEvents />

		<!-- About Us & Certifications -->
		<AboutUs />

		<!-- DataForSEO & GEO FAQ Section (Directly Above Reviews) -->
		<HomeFaq />

		<!-- Reviews Section -->
		<Reviews />

		<!-- Contact & Lead Generation Form -->
		<ContactForm />
	</main>
</Layout>
