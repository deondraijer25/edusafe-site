---
import Layout from '../../layouts/Layout.astro';
import PageHeroBackdrop from '../../components/PageHeroBackdrop.astro';
---

<Layout 
  title="About Us | Who is Edusafe Safety Training & Consulting"
  description="Learn about Edusafe. For years the leading specialist in accredited ERO (BHV), First Aid, VCA, and occupational health safety across the Netherlands."
>
  <!-- Hero Section -->
  <section class="relative bg-brand-primary text-white pt-12 pb-14 sm:pt-20 sm:pb-20 md:pt-24 md:pb-24 overflow-hidden">
    <PageHeroBackdrop
      image="/assets/images/hero_poster.webp"
      alt="Edusafe Safety Training & Consulting"
    />
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 relative z-10">
      
      <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-wider mb-4">
        <a href="/en" class="hover:underline text-white/75 hover:text-white">Home</a>
        <span class="text-white/40">/</span>
        <span class="text-brand-accent">About Us</span>
      </div>

      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/12 text-white border border-white/25 backdrop-blur-sm text-xs font-bold uppercase tracking-wider mb-4">
          <i class="fa-solid fa-award text-brand-accent"></i>
          Excellence in Safety
        </span>
        <h1 class="heading-page mb-6 text-white">
          The Leading Specialist in <span class="text-brand-accent">Occupational Safety</span> &amp; Certification
        </h1>
        <p class="text-lg text-white/90 leading-relaxed max-w-2xl">
          Edusafe Training &amp; Education has built an outstanding reputation in the western and central Netherlands. We believe in dynamic, hands-on training courses that make a genuine difference during actual emergencies.
        </p>
      </div>

    </div>
  </section>

  <!-- Story & Vision -->
  <section class="py-12 sm:py-20 bg-brand-cream relative overflow-hidden">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center mb-14 sm:mb-20">
        <div class="lg:col-span-7">
          <span class="text-brand-accent font-display font-semibold text-xs uppercase tracking-wider mb-2 block">
            Our Philosophy
          </span>
          <h2 class="heading-section text-brand-secondary mb-6 leading-tight">
            Tailored care because every corporate operating environment is unique
          </h2>
          <div class="space-y-4 text-brand-dark/80 text-base leading-relaxed">
            <p>
              No two companies are identical. An office facility involves different hazards than an industrial logistics warehouse, childcare center, or construction site. That is why Edusafe always prioritizes tailored training solutions.
            </p>
            <p>
              We operate with a dedicated team of <strong>certified instructors</strong> from active frontline backgrounds (including professional paramedic crews, fire brigade officers, and safety engineers). Our modules are interactive and focused on practical emergency response rather than dry theory.
            </p>
            <p>
              Both multinational corporations and private individuals rely on our expertise. Edusafe is officially affiliated with <strong>Het Oranje Kruis</strong>, the <strong>NIBHV</strong>, and the <strong>Dutch Resuscitation Council (NRR)</strong>.
            </p>
          </div>
        </div>

        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white">
            <img 
              src="/assets/images/about_training.png" 
              alt="Edusafe Practical Safety Training" 
              class="w-full h-auto object-cover"
            />
          </div>
          <div class="absolute bottom-3 left-3 sm:-bottom-6 sm:-left-6 bg-brand-secondary text-white p-4 sm:p-6 rounded-2xl shadow-xl border border-white/10 max-w-[230px] sm:max-w-xs">
            <div class="text-xl sm:text-2xl font-display font-bold text-brand-accent mb-0.5 sm:mb-1">2,000+</div>
            <div class="text-xs text-white/80">Candidates certified across the Netherlands</div>
          </div>
        </div>
      </div>

      <!-- Core Pillars -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-8 mb-14 sm:mb-20">
        <div class="bg-white p-6 sm:p-8 rounded-3xl border border-brand-dark/5 shadow-sm">
          <div class="w-12 h-12 rounded-2xl bg-brand-primary/10 text-brand-primary flex items-center justify-center text-xl mb-5 sm:mb-6">
            <i class="fa-solid fa-user-doctor"></i>
          </div>
          <h3 class="font-display font-semibold text-xl text-brand-secondary mb-3">Frontline Instructors</h3>
          <p class="text-sm text-brand-dark/70 leading-relaxed">
            Our trainers bring extensive experience from acute emergency healthcare and fire response, sharing real-life case studies that stick.
          </p>
        </div>

        <div class="bg-white p-6 sm:p-8 rounded-3xl border border-brand-dark/5 shadow-sm">
          <div class="w-12 h-12 rounded-2xl bg-brand-accent/10 text-brand-accent flex items-center justify-center text-xl mb-5 sm:mb-6">
            <i class="fa-solid fa-sliders"></i>
          </div>
          <h3 class="font-display font-semibold text-xl text-brand-secondary mb-3">Customization &amp; Agility</h3>
          <p class="text-sm text-brand-dark/70 leading-relaxed">
            Train at our modern training campus in Zoetermeer, or hosted entirely incompany at your company premises anywhere in the Netherlands.
          </p>
        </div>

        <div class="bg-white p-6 sm:p-8 rounded-3xl border border-brand-dark/5 shadow-sm">
          <div class="w-12 h-12 rounded-2xl bg-green-500/10 text-green-600 flex items-center justify-center text-xl mb-5 sm:mb-6">
            <i class="fa-solid fa-headset"></i>
          </div>
          <h3 class="font-display font-semibold text-xl text-brand-secondary mb-3">Zero Admin Overhead</h3>
          <p class="text-sm text-brand-dark/70 leading-relaxed">
            We track candidate certificate expirations and dispatch automated reminder alerts before recertification deadlines expire.
          </p>
        </div>
      </div>

      <!-- Certifications Badge section -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 lg:p-12 border border-brand-dark/5 shadow-sm text-center">
        <h3 class="font-display text-xl sm:text-2xl font-semibold text-brand-secondary mb-4">
          Our Accreditations &amp; Quality Guarantees
        </h3>
        <p class="text-sm text-brand-dark/70 max-w-2xl mx-auto mb-6 sm:mb-8">
          All our curricula adhere strictly to Dutch statutory Working Conditions legislation (Arbowet) and European safety standards.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-12 opacity-85">
          <span class="font-display font-semibold text-base sm:text-lg text-brand-secondary">Het Oranje Kruis</span>
          <span class="font-display font-semibold text-base sm:text-lg text-brand-secondary">NIBHV Certified</span>
          <span class="font-display font-semibold text-base sm:text-lg text-brand-secondary">Dutch Resuscitation Council (NRR)</span>
          <span class="font-display font-semibold text-base sm:text-lg text-brand-secondary">SSVV / VCA Examination Agency</span>
          <span class="font-display font-semibold text-base sm:text-lg text-brand-secondary">REOB Accredited Maintenance</span>
        </div>
      </div>

    </div>
  </section>
</Layout>
