---
import Layout from '../../layouts/Layout.astro';
import PageHeroBackdrop from '../../components/PageHeroBackdrop.astro';
import CourseFaq from '../../components/CourseFaq.astro';
import Reviews from '../../components/Reviews.astro';
import ContactForm from '../../components/ContactForm.astro';

const offshorePillarsEn = [
  {
    id: 'trainingen',
    icon: 'fa-solid fa-helicopter',
    badge: 'BOSIET & OPITO',
    title: 'Offshore Training',
    description:
      'Accredited offshore safety training in accordance with OPITO and NOGEPA standards, including BOSIET (with HUET & CA-EBS), FOET and maritime refreshers.',
    links: [
      { label: 'BOSIET Course', href: '/en/courses/bosiet' },
      { label: 'OPITO & FOET', href: '/en/courses/opito' },
    ],
  },
  {
    id: 'middelen',
    icon: 'fa-solid fa-life-ring',
    badge: 'Equipment & Inspection',
    title: 'Offshore Equipment',
    description:
      'Supply, rental and certified inspection of life jackets, immersion suits, gas detection, breathing apparatus and fall protection.',
    links: [{ label: 'Inspections & Equipment', href: '/en/services/keuringen' }],
  },
  {
    id: 'detachering',
    icon: 'fa-solid fa-user-shield',
    badge: '24/7 Deployment',
    title: 'Offshore Safety Staffing',
    description:
      '24/7 deployment of certified safety personnel: offshore medics, fire watches, confined space attendants and gas analysts.',
    links: [{ label: 'View Safety Staffing', href: '/en/services/detachering' }],
  },
];
---

<Layout
  title="Offshore Training (BOSIET & OPITO), Equipment & Staffing | Edusafe"
  description="Complete offshore safety partner in the Netherlands: OPITO-accredited BOSIET & FOET training with Vantage registration, certified offshore equipment and 24/7 safety staffing."
>
  <main class="w-full">
    <!-- 1. GOLD-STANDARD HERO HEADER -->
    <section class="relative bg-brand-primary text-white pt-12 pb-20 sm:pt-20 sm:pb-28 md:pt-24 md:pb-36 overflow-hidden">
      <PageHeroBackdrop
        image="https://images.unsplash.com/photo-1544551763-46a013bb70d5?auto=format&fit=crop&q=80&w=1600"
        alt="Offshore Platform and Wind Turbines"
      />

      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 relative z-10">
        <nav aria-label="Breadcrumb" class="section-eyebrow text-brand-primary mb-3.5 flex-wrap">
          <a href="/en" class="hover:underline text-white/70 hover:text-white">Home</a>
          <span class="text-white/40">/</span>
          <span class="text-brand-accent">Offshore &amp; Maritime</span>
        </nav>

        <div class="max-w-3xl">
          <h1 class="heading-page mb-3 text-white">
            Offshore Training, Equipment &amp; Safety Staffing
          </h1>

          <p class="text-lead text-white/85 max-w-2xl mb-6">
            Your full-service partner for offshore platforms, wind farms and maritime operations: from OPITO-accredited BOSIET &amp; FOET courses to certified PPE and 24/7 safety crews.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2.5 max-w-xl mb-7 text-card text-white/95 font-medium">
            <div class="flex items-center gap-2.5">
              <i class="fa-solid fa-circle-check text-brand-accent text-sm shrink-0"></i>
              <span>BOSIET &amp; FOET (OPITO)</span>
            </div>
            <div class="flex items-center gap-2.5">
              <i class="fa-solid fa-circle-check text-brand-accent text-sm shrink-0"></i>
              <span>4-year Vantage registration</span>
            </div>
            <div class="flex items-center gap-2.5">
              <i class="fa-solid fa-circle-check text-brand-accent text-sm shrink-0"></i>
              <span>Certified PPE &amp; inspection</span>
            </div>
            <div class="flex items-center gap-2.5">
              <i class="fa-solid fa-circle-check text-brand-accent text-sm shrink-0"></i>
              <span>24/7 Offshore safety crews</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-3 sm:gap-3.5">
            <a href="/en/courses/bosiet" class="btn-hero w-full sm:w-auto justify-center min-h-[48px]">
              <span>View BOSIET &amp; OPITO</span>
              <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>
            <a
              href="/en/personal-advice?type=zakelijk&course=bosiet"
              class="w-full sm:w-auto min-h-[48px] inline-flex items-center justify-center gap-2.5 font-display font-semibold text-[15px] px-6 sm:px-7 py-3.5 sm:py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white border border-white/20 backdrop-blur-sm transition-all duration-300"
            >
              <i class="fa-regular fa-file-lines text-brand-accent"></i>
              <span>Request quote or advice</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. THE 3 OFFSHORE PILLARS -->
    <section class="max-w-[1280px] mx-auto px-4 sm:px-6 -mt-12 sm:-mt-14 md:-mt-20 relative z-20 pb-20">
      <div class="bg-white rounded-3xl p-5 sm:p-10 md:p-12 shadow-lg border border-brand-dark/5">
        <div class="text-center max-w-2xl mx-auto mb-8">
          <span class="section-eyebrow justify-center text-brand-primary mb-1">
            <span>Offshore Total Solution</span>
          </span>
          <h2 class="heading-section text-brand-secondary">Our 3 Offshore Pillars</h2>
          <p class="text-body text-brand-dark/70 mt-2">
            Everything under one roof for safe operations on offshore platforms, wind parks and vessels.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-stretch">
          {offshorePillarsEn.map((pillar) => (
            <div
              id={pillar.id}
              class="bg-brand-cream/45 rounded-2xl p-5 sm:p-7 border border-brand-dark/8 hover:border-brand-primary/30 hover:bg-white transition-all flex flex-col justify-between scroll-mt-24 lg:scroll-mt-40"
            >
              <div>
                <div class="flex flex-wrap items-center justify-between gap-2.5 mb-4">
                  <div class="w-11 h-11 rounded-xl bg-brand-primary text-white flex items-center justify-center text-base shrink-0 shadow-xs">
                    <i class={pillar.icon}></i>
                  </div>
                  <span class="text-xs font-display font-semibold uppercase tracking-wider text-brand-accent bg-brand-accent/10 px-2.5 py-1 rounded-md">
                    {pillar.badge}
                  </span>
                </div>

                <h3 class="heading-card text-brand-secondary mb-2">
                  {pillar.title}
                </h3>
                <p class="text-card text-brand-dark/75 mb-6">
                  {pillar.description}
                </p>
              </div>

              <div class={`grid gap-2.5 pt-4 border-t border-brand-dark/8 ${pillar.links.length > 1 ? 'grid-cols-1 sm:grid-cols-2' : 'grid-cols-1'}`}>
                {pillar.links.map((lnk) => (
                  <a
                    href={lnk.href}
                    class="w-full min-h-[44px] font-display font-semibold text-sm bg-brand-accent hover:bg-brand-accent-hover text-white py-3 px-4 rounded-xl flex items-center justify-center gap-2 shadow-xs hover:shadow-md transition-all whitespace-nowrap"
                  >
                    <span>{lnk.label}</span>
                    <i class="fa-solid fa-arrow-right text-xs"></i>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. COMPLETE FOOTER STACK -->
    <CourseFaq category="Offshore" hubTitle="Offshore (BOSIET & OPITO)" lang="en" />
    <Reviews />
    <ContactForm courseSlug="bosiet" />
  </main>
</Layout>
