---
import CourseCategoryHub, { type HubCourseItem } from '../../components/CourseCategoryHub.astro';
import { courseCatalogEn } from '../../data/catalog_en';

const slugs = [
  'brand-en-ontruiming',
  'ontruimingsoefening',
  'bhv-ploegleider',
  'kleine-blusmiddelen',
];

const catalogItems: HubCourseItem[] = slugs
  .map((s) => courseCatalogEn.find((c) => c.slug === s))
  .filter((c): c is NonNullable<typeof c> => Boolean(c))
  .map((c) => ({
    id: c.slug,
    slug: c.slug,
    title: c.title,
    shortTitle: c.shortTitle,
    tagline: c.tagline,
    price: c.price,
    duration: c.duration,
    target: c.target,
    suitableForHtml: c.suitableForHtml,
    requirements: c.requirements,
    exam: c.exam,
    certification: c.certification,
    inclusions: c.inclusions,
    modules: c.modules,
    image: c.image,
  }));

const evacuationCourses: HubCourseItem[] = [
  ...catalogItems,
  {
    id: 'bbmi',
    title: 'Fire Alarm System Administrator (BBMI — NEN 2654-1)',
    shortTitle: 'Fire Alarm Admin (BBMI)',
    tagline: 'Statutory periodic management and logbook control of your fire alarm system',
    price: '€ 325,00',
    duration: '1 training day (incl. exam)',
    target:
      'For facility managers, building administrators and Heads of BHV responsible for managing a fire alarm and evacuation alarm system (BMI/OAI) under Dutch NEN 2654-1.',
    requirements: 'No prior technical training required.',
    exam: 'Theory and practical assessment per NEN 2654-1 standards.',
    certification: 'Official Fire Alarm System Administrator (BBMI) diploma.',
    inclusions: [
      'NEN 2654 manual & checklists',
      'Live fire panel exercises',
      'Official BBMI diploma',
      'Lunch, coffee/tea & parking',
    ],
    modules: [
      {
        name: 'Architecture & operation of fire and evacuation alarm panels',
        description: 'Detectors, manual call points, alarm transmission and panel controls.',
      },
      {
        name: 'Monthly & 4-monthly statutory inspection tasks',
        description: 'Performing required periodic checks and maintaining the mandatory logbook.',
      },
      {
        name: 'Preventing false alarms & supervising annual maintenance',
        description: 'Safely disabling zones during maintenance work and coordinating certified service partners.',
      },
    ],
    image: 'https://images.unsplash.com/photo-1516738901171-8eb4fc13bd20?auto=format&fit=crop&q=80&w=600',
    requestUrl: '/en/personal-advice?course=brand-en-ontruiming',
    incompanyUrl: '/en/personal-advice?type=zakelijk&course=ontruimingsoefening&mode=incompany',
  },
];

const faqs = [
  {
    q: 'How often is a company legally required to conduct an evacuation drill in the Netherlands?',
    a: 'Under Article 15 of the Dutch Working Conditions Act (Arbowet) and the Environment Buildings Decree (Bbl), employers must ensure their emergency response organization practices regularly. The Dutch Labour Inspectorate and insurers expect at least one documented evacuation drill per year.',
  },
  {
    q: 'Does the fire brigade need to attend our evacuation drill?',
    a: 'No, physical attendance by the fire brigade is not required. Prior to the drill we coordinate placing any automatic alarm transmission (PAC/RAC) into test mode to prevent an unintended emergency dispatch.',
  },
  {
    q: 'What is the difference between a BHV Team Leader and a Fire Alarm Administrator (BBMI)?',
    a: 'The Fire Alarm Administrator (BBMI) manages the technical and monthly preventive maintenance of the fire alarm panel per NEN 2654-1. The BHV Team Leader operationally commands the emergency response team during an actual fire or evacuation.',
  },
  {
    q: 'Can Edusafe also create our statutory evacuation floor plans and emergency plan?',
    a: 'Yes! Alongside firefighting trainings and on-site evacuation drills, Edusafe designs compliant NEN 1414 / ISO 23601 evacuation floor plans and emergency response plans for your facility.',
  },
];
---

<CourseCategoryHub
  lang="en"
  category="BHV"
  seoTitle="Firefighting & Evacuation Drill Courses | Edusafe"
  seoDescription="Hands-on Firefighting & Evacuation courses, annual on-site Evacuation Drills with official Arbowet evaluation report, Small Fire Extinguishers and BBMI training."
  breadcrumbLabel="Fire & Evacuation"
  heroTitle="Firefighting & Evacuation Courses"
  heroSubtitle="Practice extinguishing incipient fires on live flames and test your emergency response plan with a realistic on-site evacuation drill."
  heroImage="https://images.unsplash.com/photo-1544551763-46a013bb70d5?auto=format&fit=crop&q=80&w=1600"
  heroBullets={[
    'Live-fire extinguisher drills',
    'Annual on-site evacuation drill',
    'Official Arbowet audit report',
    'The Hague or at your site',
  ]}
  primaryCtaUrl="/en/personal-advice?course=brand-en-ontruiming"
  courses={evacuationCourses}
  coursesHeading="All Firefighting, Evacuation & BBMI trainings"
  faqTitle="Firefighting & Evacuation"
  customFaqs={faqs}
  advisorText="Planning an evacuation drill or fire training?"
  contactCourseSlug="ontruimingsoefening"
/>
