---
import Layout from '../../layouts/Layout.astro';
import MobileCourseBottomBar from '../../components/MobileCourseBottomBar.astro';

const services = [
  {
    id: "fire-maintenance",
    title: "Annual NEN 2559 Fire Safety Inspection",
    tagline: "Statutory periodic maintenance & certification of all fire extinguishers and reels",
    price: "Tiered corporate rates",
    spotsText: "NEN 2559 / NEN-EN 671-3",
    duration: "On-site within half a day",
    target: "For commercial facilities, corporate offices, schools, retail, and hospitality entities.",
    requirements: "Unobstructed access to all safety units and hose reels across the premises.",
    exam: "Full technical testing under Dutch NEN standards, including pressure testing and refilling.",
    certification: "Official REOB certification inspection labels + digital compliance logbook for fire authorities and insurers.",
    inclusions: [
      "Visual and mechanical inspection of portable extinguishers and hose reels",
      "Pressure testing, seal inspection, hose check, and weight verification",
      "Application of accredited REOB statutory certification badges",
      "Digital audit report and updated fire safety compliance register"
    ],
    modules: [
      { name: "Inspection of foam, CO2, and powder fire extinguishers (NEN 2559)" },
      { name: "Hydrostatic flow and pressure testing of fire hose reels (NEN-EN 671-3)" },
      { name: "Inspection of fire blankets and safety signage in accordance with NEN 3011" },
      { name: "Strategic advice regarding relocation or capacity adjustments after building layout changes" }
    ],
    image: "https://images.unsplash.com/photo-1582139329536-e7284fece509?auto=format&fit=crop&q=80&w=800",
    registerLink: "#contact"
  },
  {
    id: "fire-prevention-package",
    title: "Edusafe Complete Fire Prevention Package",
    tagline: "Turnkey fire equipment supply, certified installation, and annual maintenance",
    price: "Custom proposal",
    spotsText: "Turnkey Solution",
    duration: "Installed within 5 business days",
    target: "For newly constructed facilities, company expansions, or premises requiring a comprehensive safety upgrade.",
    requirements: "Architectural floor plans or on-site survey.",
    exam: "Capacity and hazard zone calculation in accordance with Dutch Building Decree and NEN 4001.",
    certification: "Full NEN 4001 project design approval + declaration of conformity.",
    inclusions: [
      "Personal safety consultancy and NEN 4001 unit projection",
      "Delivery of premium foam, CO2, or specialized kitchen fat extinguishers",
      "Professional mounting and installation with NEN 3011 photo-luminescent signage",
      "Including initial annual certification and registration in compliance log"
    ],
    modules: [
      { name: "Projection of required extinguishing capacity per square meter" },
      { name: "Targeted placement for critical areas (server rooms, commercial kitchens, manufacturing)" },
      { name: "Mounting of fire-resistant fire blankets and mandatory signage" },
      { name: "Integration with emergency response team (BHV) and evacuation procedures" }
    ],
    image: "https://images.unsplash.com/photo-1542362567-b07eac790acd?auto=format&fit=crop&q=80&w=800",
    registerLink: "#contact"
  }
];
---

<Layout 
  title="Fire Safety Equipment & Extinguisher Inspection | Edusafe Netherlands"
  description="Certified supply, installation, and annual NEN 2559 maintenance for fire extinguishers, fire hose reels, and blankets across the Netherlands."
>
  <!-- Hero Section -->
  <section class="relative bg-brand-secondary text-white pt-36 pb-20 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#ffffff08_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>
    <div class="max-w-[1280px] mx-auto px-6 relative z-10">
      
      <div class="flex items-center gap-2 text-xs font-semibold text-brand-primary uppercase tracking-wider mb-4">
        <a href="/en" class="hover:underline">Home</a>
        <span>/</span>
        <span>Services</span>
        <span>/</span>
        <span class="text-white">Fire Safety &amp; Extinguishers</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-8">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-primary/20 text-brand-primary border border-brand-primary/30 text-xs font-bold uppercase tracking-wider mb-4">
            <i class="fa-solid fa-fire-extinguisher"></i>
            REOB &amp; NEN Certified
          </span>
          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight mb-6">
            Fire Safety Equipment &amp; <span class="text-brand-accent">Annual Inspection</span>
          </h1>
          <p class="text-lg text-white/80 leading-relaxed max-w-2xl mb-8">
            Reliable fire protection and certified maintenance are paramount for facility compliance. Edusafe delivers, inspects, and services all primary fire extinguishing systems in accordance with NEN 2559 and the Dutch Building Decree.
          </p>

          <div class="flex flex-wrap gap-4">
            <button type="button" data-open-contact-drawer class="bg-brand-accent hover:bg-brand-accent-hover text-white font-display font-semibold px-8 py-4 rounded-xl transition-all shadow-lg hover:-translate-y-0.5">
              Request Inspection or Proposal
            </button>
            <a href="#details" class="bg-white/10 hover:bg-white/20 text-white font-display font-semibold px-8 py-4 rounded-xl border border-white/20 transition-all">
              Explore Services
            </a>
          </div>
        </div>

        <div class="lg:col-span-4 grid grid-cols-2 gap-4">
          <div class="bg-white/5 border border-white/10 rounded-2xl p-5 text-center">
            <div class="text-3xl font-display font-bold text-brand-primary mb-1">NEN 2559</div>
            <div class="text-xs text-white/70">Extinguisher Testing</div>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-2xl p-5 text-center">
            <div class="text-3xl font-display font-bold text-brand-accent mb-1">REOB</div>
            <div class="text-xs text-white/70">Accredited Service</div>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-2xl p-5 text-center">
            <div class="text-3xl font-display font-bold text-brand-primary mb-1">Rapid</div>
            <div class="text-xs text-white/70">On-Site Dispatch</div>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-2xl p-5 text-center">
            <div class="text-3xl font-display font-bold text-brand-accent mb-1">Digital</div>
            <div class="text-xs text-white/70">Compliance Log</div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Content Section -->
  <section id="details" class="py-20 bg-brand-cream relative">
    <div class="max-w-[1280px] mx-auto px-6">
      
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="text-brand-accent font-display font-semibold text-xs uppercase tracking-wider mb-2 block">
          Complete fire protection management
        </span>
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-brand-secondary">
          Inspection, Supply &amp; Advisory
        </h2>
        <p class="text-brand-dark/70 text-base mt-3">
          From mandatory annual safety audits to turnkey installations of industrial fire hose reels and extinguishers.
        </p>
      </div>

      <!-- Service Cards Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-16">
        {services.map((srv) => (
          <div class="bg-white rounded-3xl p-8 border border-brand-dark/5 shadow-xl flex flex-col justify-between hover:border-brand-primary/30 transition-all">
            <div>
              <div class="flex items-center justify-between gap-4 mb-4">
                <span class="px-3 py-1 rounded-full bg-brand-primary/10 text-brand-primary text-xs font-bold uppercase tracking-wider">
                  {srv.spotsText}
                </span>
                <span class="text-lg font-display font-bold text-brand-accent">
                  {srv.price}
                </span>
              </div>
              <h3 class="font-display text-2xl font-bold text-brand-secondary mb-2">
                {srv.title}
              </h3>
              <p class="text-brand-dark/70 text-sm mb-6 leading-relaxed">
                {srv.tagline}
              </p>

              <div class="space-y-4 mb-8">
                <div class="flex items-start gap-3">
                  <i class="fa-solid fa-clock text-brand-primary mt-1"></i>
                  <div>
                    <strong class="text-xs text-brand-secondary uppercase tracking-wider block">Turnaround:</strong>
                    <span class="text-sm text-brand-dark/80">{srv.duration}</span>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <i class="fa-solid fa-certificate text-brand-primary mt-1"></i>
                  <div>
                    <strong class="text-xs text-brand-secondary uppercase tracking-wider block">Certification &amp; Compliance:</strong>
                    <span class="text-sm text-brand-dark/80">{srv.certification}</span>
                  </div>
                </div>
              </div>

              <h4 class="text-xs font-bold uppercase tracking-wider text-brand-secondary mb-3">Included in this service:</h4>
              <ul class="space-y-2 mb-8">
                {srv.inclusions.map((inc) => (
                  <li class="flex items-center gap-2.5 text-sm text-brand-dark/80">
                    <i class="fa-solid fa-circle-check text-green-500 text-xs"></i>
                    <span>{inc}</span>
                  </li>
                ))}
              </ul>
            </div>

            <button 
              type="button" 
              data-open-contact-drawer 
              class="w-full py-4 rounded-xl bg-brand-primary hover:bg-brand-primary-hover text-white font-display font-semibold text-center transition-all shadow-md"
            >
              Request Inspection Proposal
            </button>
          </div>
        ))}
      </div>

    </div>
  </section>

  <MobileCourseBottomBar defaultCourse={services[0]} />
</Layout>
