---
import Layout from '../../layouts/Layout.astro';
import PageHeroBackdrop from '../../components/PageHeroBackdrop.astro';
import MobileCourseBottomBar from '../../components/MobileCourseBottomBar.astro';

const services = [
  {
    id: "roof-fall-protection-audit",
    title: "Annual Fall Protection Inspection & Recertification",
    tagline: "Statutory NEN-EN 795 & NEN-EN 365 testing of roof anchor points, horizontal lifelines, and guardrails",
    price: "Custom proposal",
    spotsText: "Statutory Requirement",
    duration: "On-site within 1 day",
    target: "For building owners, commercial property managers, and facility directors responsible for safe roof access under Dutch Arbowet regulations.",
    requirements: "Safe access to the roof and existing fall arrest anchor points.",
    exam: "Tensile pull testing and mechanical inspection of anchor bolts, steel lifelines, pins, and harnesses.",
    certification: "Official compliance certificate + facility roof safety logbook conforming to NEN-EN 365.",
    inclusions: [
      "Visual and mechanical inspection of all installed fall arrest systems",
      "Tensile strength testing on structural anchor points under NEN-EN 795 standards",
      "Application of accredited statutory inspection badges and date labels",
      "Comprehensive photo audit report with degradation analysis and remedial advice"
    ],
    modules: [
      { name: "Inspection of permanent stainless steel cable lifeline systems" },
      { name: "Testing of single-point anchor posts, parapets, and caged roof ladders" },
      { name: "Inspection of personal protective equipment (PPE fall arrest safety harnesses and lanyards)" },
      { name: "Updating the mandatory statutory facility roof access safety regulations" }
    ],
    image: "https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&q=80&w=800",
    registerLink: "/en/personal-advice?type=zakelijk&service=dakveiligheid"
  },
  {
    id: "roof-safety-engineering",
    title: "Roof Safety Engineering & System Installation",
    tagline: "Independent hazard assessment, design, and mounting of collective and personal fall protection systems",
    price: "Project quote on request",
    spotsText: "Dutch Building Decree Compliant",
    duration: "Engineering proposal within 5 days",
    target: "For newly constructed facilities, major building renovations, and existing rooftops requiring safe HVAC/solar maintenance access.",
    requirements: "Architectural drawings or an on-site rooftop survey.",
    exam: "Working at Height Risk Assessment and statutory zoning (safe zone, warning zone, high-risk fall zone).",
    certification: "Complete Roof Safety Management Plan according to NEN 795 and Dutch Working Conditions decrees.",
    inclusions: [
      "Hazard analysis and zoning classification of the entire roof perimeter",
      "Design of the most cost-effective safety concept (collective perimeter guardrails vs lifeline anchors)",
      "Supply and certified installation of heavy-duty guardrails, anchors, and horizontal cable systems",
      "Commissioning including user operating instructions for maintenance contractors"
    ],
    modules: [
      { name: "Consultancy during the architectural design phase conforming to the Dutch Building Decree" },
      { name: "Comparative selection between perimeter guardrails (collective safety) and anchor lines" },
      { name: "Safe rooftop access design via facade access ladders and roof hatches" },
      { name: "Training for facility maintenance personnel on working safely at height" }
    ],
    image: "https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&q=80&w=800",
    registerLink: "/en/personal-advice?type=zakelijk&service=dakveiligheid"
  }
];
---

<Layout 
  title="Roof Safety & Fall Protection Inspection | Edusafe Netherlands"
  description="Independent safety advice, annual inspection, and certified installation of permanent rooftop fall protection systems across the Netherlands."
>
  <!-- Hero Section -->
  <section class="relative bg-brand-primary text-white pt-12 pb-16 sm:pt-20 sm:pb-20 md:pt-24 md:pb-24 overflow-hidden">
    <PageHeroBackdrop
      image="https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&q=80&w=1600"
      alt="Roof Safety & Fall Protection"
    />
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 relative z-10">
      
      <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-wider mb-3.5 sm:mb-4">
        <a href="/en" class="hover:underline text-white/75 hover:text-white">Home</a>
        <span class="text-white/40">/</span>
        <span class="text-white/75">Services</span>
        <span class="text-white/40">/</span>
        <span class="text-brand-accent">Roof Safety</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <div class="lg:col-span-8">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/12 text-white border border-white/25 backdrop-blur-sm text-xs font-bold uppercase tracking-wider mb-3.5 sm:mb-4">
            <i class="fa-solid fa-person-falling text-brand-accent"></i>
            Building Decree &amp; NEN-EN 795
          </span>
          <h1 class="heading-page mb-4 sm:mb-6 text-white">
            Roof Safety &amp; <span class="text-brand-accent">Fall Protection</span>
          </h1>
          <p class="text-[15px] sm:text-lg text-white/90 leading-relaxed max-w-2xl mb-6 sm:mb-8">
            Safe maintenance access for building envelopes and rooftops is a statutory obligation in the Netherlands. Edusafe delivers expert engineering consultancy for both new developments and existing commercial properties.
          </p>

          <div class="flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-3 sm:gap-4">
            <button type="button" data-open-contact-drawer class="w-full sm:w-auto inline-flex items-center justify-center text-center min-h-[48px] bg-brand-accent hover:bg-brand-accent-hover text-white font-display font-semibold px-6 sm:px-8 py-3.5 sm:py-4 rounded-xl transition-all shadow-lg hover:-translate-y-0.5 cursor-pointer">
              Request Rooftop Safety Survey
            </button>
            <a href="#details" class="w-full sm:w-auto inline-flex items-center justify-center text-center min-h-[48px] bg-white/12 hover:bg-white/20 text-white border border-white/30 backdrop-blur-sm font-display font-semibold px-6 sm:px-8 py-3.5 sm:py-4 rounded-xl shadow-sm transition-all">
              Explore Systems &amp; Standards
            </a>
          </div>
        </div>

        <div class="lg:col-span-4 grid grid-cols-2 gap-3 sm:gap-4">
          <div class="bg-[#062856]/50 backdrop-blur-md border border-white/20 rounded-2xl p-4 sm:p-5 text-center shadow-lg">
            <div class="text-2xl sm:text-3xl font-display font-bold text-white mb-1">NEN 795</div>
            <div class="text-xs text-white/80">Anchors &amp; Lines</div>
          </div>
          <div class="bg-[#062856]/50 backdrop-blur-md border border-white/20 rounded-2xl p-4 sm:p-5 text-center shadow-lg">
            <div class="text-2xl sm:text-3xl font-display font-bold text-brand-accent mb-1">Arbowet</div>
            <div class="text-xs text-white/80">Zero Fall Risk</div>
          </div>
          <div class="bg-[#062856]/50 backdrop-blur-md border border-white/20 rounded-2xl p-4 sm:p-5 text-center shadow-lg">
            <div class="text-2xl sm:text-3xl font-display font-bold text-white mb-1">100%</div>
            <div class="text-xs text-white/80">Certified Systems</div>
          </div>
          <div class="bg-[#062856]/50 backdrop-blur-md border border-white/20 rounded-2xl p-4 sm:p-5 text-center shadow-lg">
            <div class="text-2xl sm:text-3xl font-display font-bold text-brand-accent mb-1">Logbook</div>
            <div class="text-xs text-white/80">Annual Recertification</div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Content Section -->
  <section id="details" class="py-14 sm:py-20 bg-brand-cream relative">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6">
      
      <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
        <span class="text-brand-accent font-display font-semibold text-xs uppercase tracking-wider mb-2 block">
          Zero compromise when working at height
        </span>
        <h2 class="heading-section text-brand-secondary">
          Inspection, Consultancy &amp; Installation
        </h2>
        <p class="text-brand-dark/70 text-[15px] sm:text-base mt-3">
          From mandatory annual tensile testing of anchor points to complete rooftop safety access plans.
        </p>
      </div>

      <!-- Service Cards Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8 mb-12 sm:mb-16">
        {services.map((srv) => (
          <div class="bg-white rounded-3xl p-5 sm:p-8 border border-brand-dark/5 shadow-xl flex flex-col justify-between hover:border-brand-primary/30 transition-all">
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2 sm:gap-4 mb-4">
                <span class="px-3 py-1 rounded-full bg-brand-primary/10 text-brand-primary text-xs font-bold uppercase tracking-wider">
                  {srv.spotsText}
                </span>
                <span class="text-lg font-display font-bold text-brand-accent">
                  {srv.price}
                </span>
              </div>
              <h3 class="font-display text-2xl font-semibold text-brand-secondary mb-2">
                {srv.title}
              </h3>
              <p class="text-brand-dark/70 text-sm mb-6 leading-relaxed">
                {srv.tagline}
              </p>

              <div class="space-y-4 mb-8">
                <div class="flex items-start gap-3">
                  <i class="fa-solid fa-clock text-brand-primary mt-1"></i>
                  <div>
                    <strong class="text-xs text-brand-secondary uppercase tracking-wider block">Turnaround:</strong>
                    <span class="text-sm text-brand-dark/80">{srv.duration}</span>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <i class="fa-solid fa-shield-halved text-brand-primary mt-1"></i>
                  <div>
                    <strong class="text-xs text-brand-secondary uppercase tracking-wider block">Standards:</strong>
                    <span class="text-sm text-brand-dark/80">{srv.certification}</span>
                  </div>
                </div>
              </div>

              <h4 class="text-xs font-semibold uppercase tracking-wider text-brand-secondary mb-3">Included in this service:</h4>
              <ul class="space-y-2 mb-8">
                {srv.inclusions.map((inc) => (
                  <li class="flex items-center gap-2.5 text-sm text-brand-dark/80">
                    <i class="fa-solid fa-circle-check text-green-500 text-xs"></i>
                    <span>{inc}</span>
                  </li>
                ))}
              </ul>
            </div>

            <button 
              type="button" 
              data-open-contact-drawer 
              class="w-full py-4 rounded-xl bg-brand-accent hover:bg-brand-accent-hover text-white font-display font-semibold text-center transition-all shadow-md"
            >
              Request Proposal
            </button>
          </div>
        ))}
      </div>

    </div>
  </section>

  <MobileCourseBottomBar
    defaultCourse={services[0]}
    itemType="service"
    serviceSlug="dakveiligheid"
    advisorText="Need rooftop fall protection inspection?"
  />
</Layout>
