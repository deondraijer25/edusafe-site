---
import Layout from '../../layouts/Layout.astro';
import { courses_en as courses } from '../../data/courses_en.js';

// Extract unique categories and locations for dynamic filters
const uniqueCategories = [...new Set(courses.map(c => c.category))];
const uniqueLocations = [...new Set(courses.map(c => c.location))];
---

<Layout 
  title="Course Dates & Safety Training Schedule | Edusafe" 
  description="View all upcoming course dates for BHV, First Aid, VCA, and Offshore training. Book your certified training directly online."
>
  <main class="w-full">
    
    <!-- Hero Header Section -->
    <section class="relative bg-brand-secondary text-white pt-20 pb-20 sm:pb-24 md:pt-24 md:pb-28 overflow-hidden">
      <div class="absolute inset-0 z-0 overflow-hidden">
        <img 
          src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&q=80&w=1600" 
          alt="Course Dates & Training Schedule" 
          class="w-full h-full object-cover opacity-30 scale-105" 
        />
        <div class="absolute inset-0 bg-gradient-to-r from-brand-secondary via-brand-secondary/85 to-brand-secondary/40"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-brand-secondary via-transparent to-black/20"></div>
      </div>
      
      <div class="max-w-[1280px] mx-auto px-6 relative z-10">
        <div class="max-w-3xl animate-fade-in">
          <span class="inline-flex items-center gap-1.5 text-brand-accent font-display font-semibold text-xs uppercase tracking-wider mb-3.5">
            <i class="fa-solid fa-calendar-days animate-pulse"></i>
            Current Training Schedule
          </span>
          <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tight leading-tight mb-4 text-white">
            Choose a date <br class="hidden sm:inline" />and start <span class="relative inline-block text-white px-5 py-2 mx-1 transform -rotate-1"><span class="absolute inset-0 bg-brand-accent rounded-2xl z-0"></span><span class="relative z-10">learning</span></span>
          </h1>
          <p class="text-white/90 text-base md:text-lg max-w-2xl leading-relaxed mb-6 font-normal">
            Find the perfect safety course on a convenient date and location near you. Register directly online for official certification.
          </p>
          
          <ul class="flex flex-wrap gap-4 sm:gap-6 text-xs sm:text-sm font-normal text-white/90">
            <li class="flex items-center gap-2">
              <i class="fa-solid fa-circle-check text-emerald-400 text-sm"></i>
              <span>Hands-on practical training</span>
            </li>
            <li class="flex items-center gap-2">
              <i class="fa-solid fa-circle-check text-emerald-400 text-sm"></i>
              <span>Certified instructors</span>
            </li>
            <li class="flex items-center gap-2">
              <i class="fa-solid fa-circle-check text-emerald-400 text-sm"></i>
              <span>Nationwide training network</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Search & Filter Bar (Floating Container overlapping hero bottom) -->
    <section class="max-w-[1280px] mx-auto px-6 -mt-10 sm:-mt-12 md:-mt-14 relative z-30 mb-12">
      <div class="bg-white rounded-2xl shadow-xl shadow-brand-dark/10 border border-brand-dark/5 p-4 sm:p-5 flex flex-col lg:flex-row gap-3 sm:gap-4 items-stretch lg:items-center">
        <!-- Search Input -->
        <div class="relative flex-1">
          <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-brand-dark/40 text-sm"></i>
          <input 
            id="search-input"
            type="text" 
            class="w-full rounded-xl border border-brand-dark/10 px-4 py-3 pl-10 text-sm bg-brand-cream/30 placeholder:text-brand-dark/40 focus:outline-none focus:border-brand-primary transition-colors font-medium text-brand-secondary"
            placeholder="Search course title..."
          />
        </div>
        
        <!-- Category Dropdown -->
        <div class="relative flex-1">
          <select 
            id="category-select"
            class="w-full rounded-xl border border-brand-dark/10 px-4 py-3 text-sm bg-brand-cream/30 text-brand-secondary font-semibold focus:outline-none focus:border-brand-primary transition-colors appearance-none cursor-pointer"
          >
            <option value="all">All Categories</option>
            {uniqueCategories.map(cat => (
              <option value={cat}>{cat}</option>
            ))}
          </select>
          <i class="fa-solid fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-brand-dark/40 text-xs pointer-events-none"></i>
        </div>

        <!-- Location Dropdown -->
        <div class="relative flex-1">
          <select 
            id="location-select"
            class="w-full rounded-xl border border-brand-dark/10 px-4 py-3 text-sm bg-brand-cream/30 text-brand-secondary font-semibold focus:outline-none focus:border-brand-primary transition-colors appearance-none cursor-pointer"
          >
            <option value="all">All Locations</option>
            {uniqueLocations.map(loc => (
              <option value={loc}>{loc}</option>
            ))}
          </select>
          <i class="fa-solid fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-brand-dark/40 text-xs pointer-events-none"></i>
        </div>

        <!-- Reset Button -->
        <button 
          id="reset-filters"
          class="font-display font-semibold text-xs sm:text-sm px-5 py-3 rounded-xl bg-brand-cream hover:bg-brand-cream-dark text-brand-secondary transition-all duration-300 flex items-center justify-center gap-2 cursor-pointer shrink-0 border border-brand-dark/5"
        >
          <i class="fa-solid fa-filter-circle-xmark text-xs"></i>
          <span>Reset Filters</span>
        </button>
      </div>
    </section>

    <!-- Courses List Grid -->
    <section class="max-w-[1280px] mx-auto px-6 pb-20">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end mb-8 gap-4">
        <div>
          <h2 class="font-display text-2xl sm:text-3xl font-semibold text-brand-secondary mb-1">Upcoming Courses</h2>
          <p id="course-count" class="text-xs sm:text-sm text-brand-dark/60 font-normal">{courses.length} courses found</p>
        </div>
        
        <!-- View Toggle Buttons -->
        <div class="flex items-center gap-2 bg-brand-cream/80 p-1.5 rounded-xl border border-brand-dark/5">
          <button 
            id="view-grid" 
            class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-brand-secondary shadow-xs transition-all flex items-center gap-1.5 cursor-pointer"
            aria-label="Grid View"
          >
            <i class="fa-solid fa-grip text-xs"></i>
            <span class="hidden sm:inline">Grid</span>
          </button>
          <button 
            id="view-list" 
            class="px-3.5 py-1.5 rounded-lg text-xs font-semibold text-brand-dark/60 hover:text-brand-secondary transition-all flex items-center gap-1.5 cursor-pointer"
            aria-label="List View"
          >
            <i class="fa-solid fa-list text-xs"></i>
            <span class="hidden sm:inline">List</span>
          </button>
        </div>
      </div>

      <!-- Grid View Container -->
      <div id="grid-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {courses.map(course => (
          <div 
            class="course-card bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl border border-brand-dark/5 transition-all duration-300 flex flex-col group hover:-translate-y-1"
            data-category={course.category}
            data-location={course.location}
            data-title={course.title.toLowerCase()}
          >
            <!-- Card Image & Badges -->
            <div class="relative h-48 overflow-hidden">
              <img 
                src={course.image} 
                alt={course.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
              
              <span class="absolute top-4 left-4 bg-brand-secondary/90 backdrop-blur-md text-white text-[11px] font-semibold px-3 py-1 rounded-full uppercase tracking-wider">
                {course.category}
              </span>
              
              <span class="absolute bottom-3 left-4 text-white text-xs font-medium flex items-center gap-1.5">
                <i class="fa-solid fa-clock text-[10px] text-brand-accent"></i>
                {course.time}
              </span>
            </div>

            <!-- Card Content -->
            <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between text-xs text-brand-dark/60 mb-2.5">
                  <span class="font-semibold text-brand-primary flex items-center gap-1.5">
                    <i class="fa-solid fa-calendar-day text-xs"></i>
                    {course.date}
                  </span>
                  {course.spotsLeft && (
                    <span class="text-amber-600 bg-amber-50 px-2 py-0.5 rounded-md font-semibold text-[11px]">
                      {course.spotsLeft}
                    </span>
                  )}
                </div>

                <h3 class="font-display font-semibold text-lg text-brand-secondary leading-snug mb-3 group-hover:text-brand-primary transition-colors line-clamp-2">
                  {course.title}
                </h3>
                
                <p class="text-xs text-brand-dark/70 flex items-start gap-1.5 mb-5 font-normal">
                  <i class="fa-solid fa-location-dot text-brand-primary text-xs mt-0.5 shrink-0"></i>
                  <span>{course.location}</span>
                </p>
              </div>

              <!-- Price & CTA -->
              <div class="pt-4 border-t border-brand-dark/5 flex items-center justify-between mt-auto">
                <div>
                  <span class="text-[10px] uppercase font-semibold text-brand-dark/40 block leading-none mb-0.5">Price excl.</span>
                  <span class="font-display font-semibold text-xl text-brand-secondary">{course.price}</span>
                </div>
                
                <a 
                  href={`/en/register/${course.id}`} 
                  class="font-display font-semibold text-xs sm:text-sm px-4 py-2.5 rounded-xl bg-brand-primary hover:bg-brand-primary-hover text-white transition-all duration-300 shadow-sm flex items-center gap-1.5"
                >
                  <span>Register</span>
                  <i class="fa-solid fa-arrow-right text-[10px]"></i>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- List View Container (Initially Hidden) -->
      <div id="list-container" class="hidden flex-col gap-3">
        {courses.map(course => (
          <div 
            class="course-card-list bg-white rounded-2xl p-4 sm:p-5 shadow-sm hover:shadow-md border border-brand-dark/5 transition-all duration-300 flex flex-col md:flex-row md:items-center justify-between gap-4 group"
            data-category={course.category}
            data-location={course.location}
            data-title={course.title.toLowerCase()}
          >
            <div class="flex items-start sm:items-center gap-4 flex-1">
              <div class="hidden sm:flex flex-col items-center justify-center w-16 h-16 rounded-xl bg-brand-cream/80 text-brand-secondary shrink-0 border border-brand-dark/5">
                <span class="font-display font-semibold text-lg leading-tight">{course.date.split(' ')[0]}</span>
                <span class="text-[10px] uppercase font-semibold text-brand-primary leading-tight">{course.date.split(' ')[1]}</span>
              </div>
              
              <div class="space-y-1 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="bg-brand-secondary/10 text-brand-secondary text-[10px] font-semibold px-2 py-0.5 rounded uppercase tracking-wider">
                    {course.category}
                  </span>
                  <span class="text-xs text-brand-dark/50 font-medium sm:hidden">
                    {course.date} • {course.time}
                  </span>
                </div>
                <h3 class="font-display font-semibold text-base sm:text-lg text-brand-secondary group-hover:text-brand-primary transition-colors">
                  {course.title}
                </h3>
                <p class="text-xs text-brand-dark/60 flex items-center gap-1.5 font-normal">
                  <i class="fa-solid fa-location-dot text-brand-primary text-xs shrink-0"></i>
                  <span>{course.location}</span>
                </p>
              </div>
            </div>

            <div class="flex items-center justify-between md:justify-end gap-5 pt-3 md:pt-0 border-t md:border-t-0 border-brand-dark/5">
              <div class="text-left md:text-right">
                <span class="text-[10px] uppercase font-semibold text-brand-dark/40 block leading-none mb-0.5">Price excl.</span>
                <span class="font-display font-semibold text-lg sm:text-xl text-brand-secondary">{course.price}</span>
              </div>
              
              <a 
                href={`/en/register/${course.id}`} 
                class="font-display font-semibold text-xs sm:text-sm px-5 py-2.5 rounded-xl bg-brand-primary hover:bg-brand-primary-hover text-white transition-all duration-300 shadow-sm flex items-center gap-1.5 shrink-0"
              >
                <span>Register</span>
                <i class="fa-solid fa-arrow-right text-[10px]"></i>
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- No Results State -->
      <div id="no-results" class="hidden text-center py-16 bg-white rounded-3xl border border-brand-dark/5 shadow-xs p-8">
        <div class="w-16 h-16 rounded-full bg-brand-cream flex items-center justify-center text-brand-dark/40 mx-auto mb-4 text-2xl">
          <i class="fa-solid fa-magnifying-glass"></i>
        </div>
        <h3 class="font-display font-semibold text-xl text-brand-secondary mb-2">No courses found</h3>
        <p class="text-sm text-brand-dark/60 max-w-md mx-auto mb-6">
          No training sessions match your selected filters. Try clearing your filters or search for another term.
        </p>
        <button 
          id="clear-filters-btn" 
          class="font-display font-semibold text-xs px-5 py-2.5 rounded-xl bg-brand-primary text-white hover:bg-brand-primary-hover transition-all cursor-pointer"
        >
          Reset All Filters
        </button>
      </div>

    <!-- SECTION 4: Stat Counters -->
    <section class="py-16 bg-white border-t border-b border-brand-dark/5 reveal">
      <div class="max-w-[1280px] mx-auto px-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center reveal-stagger">
          <div class="flex flex-col items-center justify-center">
            <div class="text-4xl md:text-5xl font-display font-semibold text-brand-primary tracking-tight mb-1">
              30<span class="text-brand-accent">+</span>
            </div>
            <div class="text-xs font-semibold text-brand-dark/50 uppercase tracking-wider">Training Locations</div>
          </div>
          <div class="flex flex-col items-center justify-center">
            <div class="text-4xl md:text-5xl font-display font-semibold text-brand-primary tracking-tight mb-1">
              100<span class="text-brand-accent">%</span>
            </div>
            <div class="text-xs font-semibold text-brand-dark/50 uppercase tracking-wider">Pass Rate Guarantee</div>
          </div>
          <div class="flex flex-col items-center justify-center">
            <div class="text-4xl md:text-5xl font-display font-semibold text-brand-primary tracking-tight mb-1">
              20<span class="text-brand-accent">+</span>
            </div>
            <div class="text-xs font-semibold text-brand-dark/50 uppercase tracking-wider">Years Experience</div>
          </div>
          <div class="flex flex-col items-center justify-center">
            <div class="text-4xl md:text-5xl font-display font-semibold text-brand-primary tracking-tight mb-1">
              15<span class="text-brand-accent">+</span>
            </div>
            <div class="text-xs font-semibold text-brand-dark/50 uppercase tracking-wider">Certified Instructors</div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 5: E-Learning Promo Banner -->
    <section class="py-20 bg-brand-cream reveal">
      <div class="max-w-[1280px] mx-auto px-6">
        <div class="relative bg-brand-secondary text-white rounded-2xl md:rounded-3xl overflow-hidden flex flex-col md:flex-row items-stretch shadow-xl border border-white/5">
          <div class="p-8 md:p-12 lg:p-14 md:w-2/3 border-b md:border-b-0 md:border-r border-dashed border-white/15 relative">
            <div class="relative z-10">
              <div class="text-brand-accent font-display font-semibold tracking-wider uppercase mb-3 text-xs">New at Edusafe</div>
              <h2 class="font-display text-3xl md:text-4xl font-semibold mb-4 leading-tight text-white">Start immediately with <br class="hidden sm:inline" />
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-white to-white/75">E-Learning</span>
              </h2>
              <p class="text-white/80 text-sm md:text-base max-w-xl mb-6 leading-relaxed font-normal">Complete the theoretical part of our safety courses 100% online. At your own pace, wherever and whenever suits you best.</p>
              <div class="flex items-center gap-6 text-xs sm:text-sm font-semibold text-white/90">
                <span class="flex items-center gap-2">
                  <i class="fa-solid fa-circle-check text-brand-accent text-sm"></i> 24/7 Access
                </span>
                <span class="flex items-center gap-2">
                  <i class="fa-solid fa-circle-check text-brand-accent text-sm"></i> Interactive & Certified
                </span>
              </div>
            </div>
          </div>
          
          <div class="p-8 md:p-12 md:w-1/3 flex flex-col items-center justify-center text-center bg-white/5 relative overflow-hidden">
            <div class="relative z-10 w-full flex flex-col items-center">
              <div class="w-14 h-14 bg-brand-accent/20 rounded-full flex items-center justify-center mb-4">
                <div class="w-10 h-10 bg-brand-accent rounded-full flex items-center justify-center shadow-md">
                  <i class="fa-solid fa-arrow-right text-white text-sm"></i>
                </div>
              </div>
              <h3 class="font-display text-xl font-semibold mb-4 text-white">Access Portal</h3>
              <a 
                href="https://edusafe.app.clientclub.net/" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center justify-center h-12 bg-white text-brand-secondary hover:bg-brand-cream rounded-xl px-6 text-sm font-semibold w-full shadow-md transition-all duration-300 hover:-translate-y-0.5 cursor-pointer"
              >
                Go to E-Learning Portal
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 6: Full Testimonials Section -->
    <section class="py-20 bg-white border-t border-brand-dark/5 reveal">
      <div class="max-w-[1280px] mx-auto px-6">
        <div class="text-center mb-12">
          <h2 class="font-display text-2xl sm:text-3xl font-semibold text-brand-secondary mb-2">What our trainees say</h2>
          <p class="text-brand-dark/60 max-w-2xl mx-auto font-normal text-xs sm:text-sm">Read the experiences of international professionals and corporate clients who trained with us.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 reveal-stagger">
          <div class="bg-brand-cream/40 p-6 sm:p-7 rounded-2xl border border-brand-dark/5 flex flex-col justify-between hover:shadow-md transition-all duration-300">
            <div>
              <div class="flex gap-1 mb-4 text-amber-500 text-xs">
                <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
              </div>
              <p class="text-brand-dark/70 mb-6 font-normal text-xs sm:text-sm leading-relaxed">"Very professional English BHV course. The instructor explained everything clearly with plenty of hands-on practice. Highly recommended!"</p>
            </div>
            <div class="flex items-center gap-3">
              <div class="h-10 w-10 rounded-full overflow-hidden border border-brand-dark/10 shadow-xs">
                <img src="/assets/images/0942f99c-0c49-4f5a-b280-362643425d75.jpg" alt="Sanne de Jong" class="h-full w-full object-cover">
              </div>
              <div>
                <span class="font-display font-semibold text-brand-secondary text-sm block">Sarah Jenkins</span>
                <span class="text-[11px] text-brand-dark/50 font-normal">Rotterdam</span>
              </div>
            </div>
          </div>

          <div class="bg-brand-cream/40 p-6 sm:p-7 rounded-2xl border border-brand-dark/5 flex flex-col justify-between hover:shadow-md transition-all duration-300">
            <div>
              <div class="flex gap-1 mb-4 text-amber-500 text-xs">
                <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
              </div>
              <p class="text-brand-dark/70 mb-6 font-normal text-xs sm:text-sm leading-relaxed">"The e-learning portal is super convenient. I completed the VCA theory online in my own time, making the practical classroom day much shorter."</p>
            </div>
            <div class="flex items-center gap-3">
              <div class="h-10 w-10 rounded-full overflow-hidden border border-brand-dark/10 shadow-xs">
                <img src="/assets/images/00457656-619b-4bc5-bc92-364e6d5c7533.jpg" alt="Mark Visser" class="h-full w-full object-cover">
              </div>
              <div>
                <span class="font-display font-semibold text-brand-secondary text-sm block">Mark Williams</span>
                <span class="text-[11px] text-brand-dark/50 font-normal">The Hague</span>
              </div>
            </div>
          </div>

          <div class="bg-brand-cream/40 p-6 sm:p-7 rounded-2xl border border-brand-dark/5 flex flex-col justify-between hover:shadow-md transition-all duration-300">
            <div>
              <div class="flex gap-1 mb-4 text-amber-500 text-xs">
                <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
              </div>
              <p class="text-brand-dark/70 mb-6 font-normal text-xs sm:text-sm leading-relaxed">"Great facility and welcoming atmosphere. The trainer took time for everyone's questions and the catering was top notch."</p>
            </div>
            <div class="flex items-center gap-3">
              <div class="h-10 w-10 rounded-full overflow-hidden border border-brand-dark/10 shadow-xs">
                <img src="/assets/images/9f847927-354e-4000-9e3e-b31e062f316e.jpg" alt="Lisa Bakker" class="h-full w-full object-cover">
              </div>
              <div>
                <span class="font-display font-semibold text-brand-secondary text-sm block">Lisa Baker</span>
                <span class="text-[11px] text-brand-dark/50 font-normal">Amsterdam</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>
</Layout>

<script>
  function initCourseFilters() {
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const categorySelect = document.getElementById('category-select') as HTMLSelectElement;
    const locationSelect = document.getElementById('location-select') as HTMLSelectElement;
    const resetBtn = document.getElementById('reset-filters');
    const clearFiltersBtn = document.getElementById('clear-filters-btn');
    const courseCount = document.getElementById('course-count');
    const noResults = document.getElementById('no-results');
    
    const gridViewBtn = document.getElementById('view-grid');
    const listViewBtn = document.getElementById('view-list');
    const gridContainer = document.getElementById('grid-container');
    const listContainer = document.getElementById('list-container');
    
    const gridCards = document.querySelectorAll('.course-card');
    const listCards = document.querySelectorAll('.course-card-list');

    // Read URL query parameter for category pre-filtering
    const urlParams = new URLSearchParams(window.location.search);
    const categoryParam = urlParams.get('category');
    if (categoryParam && categorySelect) {
      categorySelect.value = categoryParam;
    }

    function filterCourses() {
      const searchTerm = searchInput ? searchInput.value.toLowerCase().trim() : '';
      const selectedCategory = categorySelect ? categorySelect.value : 'all';
      const selectedLocation = locationSelect ? locationSelect.value : 'all';

      let visibleCount = 0;

      // Filter Grid Cards
      gridCards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const category = card.getAttribute('data-category') || '';
        const location = card.getAttribute('data-location') || '';

        const matchesSearch = title.includes(searchTerm);
        const matchesCategory = selectedCategory === 'all' || category === selectedCategory;
        const matchesLocation = selectedLocation === 'all' || location === selectedLocation;

        if (matchesSearch && matchesCategory && matchesLocation) {
          (card as HTMLElement).style.display = 'flex';
          visibleCount++;
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      // Filter List Cards
      listCards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const category = card.getAttribute('data-category') || '';
        const location = card.getAttribute('data-location') || '';

        const matchesSearch = title.includes(searchTerm);
        const matchesCategory = selectedCategory === 'all' || category === selectedCategory;
        const matchesLocation = selectedLocation === 'all' || location === selectedLocation;

        if (matchesSearch && matchesCategory && matchesLocation) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      // Update counters & no results
      if (courseCount) {
        courseCount.textContent = `${visibleCount} courses found`;
      }

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
          if (gridContainer) gridContainer.classList.add('hidden');
          if (listContainer) listContainer.classList.add('hidden');
        } else {
          noResults.classList.add('hidden');
          if (gridContainer && !gridContainer.dataset.userHidden) gridContainer.classList.remove('hidden');
          if (listContainer && listContainer.dataset.userVisible) listContainer.classList.remove('hidden');
        }
      }
    }

    if (searchInput) searchInput.addEventListener('input', filterCourses);
    if (categorySelect) categorySelect.addEventListener('change', filterCourses);
    if (locationSelect) locationSelect.addEventListener('change', filterCourses);

    const resetAll = () => {
      if (searchInput) searchInput.value = '';
      if (categorySelect) categorySelect.value = 'all';
      if (locationSelect) locationSelect.value = 'all';
      filterCourses();
    };

    if (resetBtn) resetBtn.addEventListener('click', resetAll);
    if (clearFiltersBtn) clearFiltersBtn.addEventListener('click', resetAll);

    // View Switching Logic
    if (gridViewBtn && listViewBtn && gridContainer && listContainer) {
      gridViewBtn.addEventListener('click', () => {
        gridContainer.classList.remove('hidden');
        gridContainer.removeAttribute('data-user-hidden');
        listContainer.classList.add('hidden');
        listContainer.removeAttribute('data-user-visible');
        
        gridViewBtn.className = 'px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-brand-secondary shadow-xs transition-all flex items-center gap-1.5 cursor-pointer';
        listViewBtn.className = 'px-3.5 py-1.5 rounded-lg text-xs font-semibold text-brand-dark/60 hover:text-brand-secondary transition-all flex items-center gap-1.5 cursor-pointer';
      });

      listViewBtn.addEventListener('click', () => {
        gridContainer.classList.add('hidden');
        gridContainer.setAttribute('data-user-hidden', 'true');
        listContainer.classList.remove('hidden');
        listContainer.setAttribute('data-user-visible', 'true');
        
        listViewBtn.className = 'px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-brand-secondary shadow-xs transition-all flex items-center gap-1.5 cursor-pointer';
        gridViewBtn.className = 'px-3.5 py-1.5 rounded-lg text-xs font-semibold text-brand-dark/60 hover:text-brand-secondary transition-all flex items-center gap-1.5 cursor-pointer';
      });
    }

    // Run initial filter
    filterCourses();
  }

  initCourseFilters();
  document.addEventListener('astro:page-load', initCourseFilters);
</script>
