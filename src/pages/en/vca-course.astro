---
import CourseCategoryHub from '../../components/CourseCategoryHub.astro';
import { courseCatalogEn } from '../../data/catalog_en';

const vcaCourses = courseCatalogEn
  .filter((c) => c.category === 'VCA')
  .map((c) => ({
    id: c.slug,
    slug: c.slug,
    title: c.title,
    shortTitle: c.shortTitle,
    tagline: c.tagline,
    price: c.price,
    duration: c.duration,
    target: c.target,
    suitableForHtml: c.suitableForHtml,
    requirements: c.requirements,
    exam: c.exam,
    certification: c.certification,
    inclusions: c.inclusions,
    modules: c.modules,
    learningOutcomes: c.learningOutcomes,
    image: c.image,
  }));
---

<CourseCategoryHub
  lang="en"
  category="VCA"
  seoTitle="VCA Course & Official CBT Exam (VCA Basic, VOL-VCA & VIL-VCU) | Edusafe"
  seoDescription="Earn your official SSVV VCA diploma in 1 day with 10-year Central Diploma Register (CDR) registration. VCA Basic, VOL-VCA, VIL-VCU and VCA exams in The Hague or In-company."
  breadcrumbLabel="VCA Courses"
  heroTitle="VCA Course & Official CBT Exam"
  heroSubtitle="Obtain your SSVV-accredited VCA Basic, VOL-VCA or VIL-VCU safety diploma in one day, including 10-year registration in the Dutch Central Diploma Register (CDR)."
  heroImage="https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&q=80&w=1600"
  heroBullets={[
    'Course + exam in 1 day',
    'Official SSVV CBT exam',
    'Valid 10 years in CDR',
    'The Hague or In-company',
  ]}
  primaryCtaUrl="/en/personal-advice?category=VCA"
  courses={vcaCourses}
  coursesHeading="All VCA courses & official exams"
  faqTitle="VCA Certification"
  advisorText="Unsure between VCA Basic and VOL-VCA?"
/>
