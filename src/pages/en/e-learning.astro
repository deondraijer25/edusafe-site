---
import Layout from '../../layouts/Layout.astro';
import PageHeroBackdrop from '../../components/PageHeroBackdrop.astro';
import CourseFaq from '../../components/CourseFaq.astro';
import Reviews from '../../components/Reviews.astro';
import ContactForm from '../../components/ContactForm.astro';

const elearningCoursesEn = [
  {
    id: 'bhv-theory',
    title: 'BHV Basic & Refresher E-learning',
    badge: 'BHV Theory',
    price: '€ 59.00',
    rawPrice: 59.0,
    duration: '± 3 to 4 hours',
    description:
      'Complete online theory preparation for the Emergency Response Officer (BHV Basic & Refresher) practical day per Dutch Arbowet Art. 15.',
  },
  {
    id: 'vca-basis',
    title: 'VCA Basic (B-VCA) E-learning',
    badge: 'VCA + Mock Exams',
    price: '€ 49.00',
    rawPrice: 49.0,
    duration: '± 6 hours',
    description:
      'Comprehensive online preparation for the official SSVV B-VCA examination, including unlimited official mock exams.',
  },
  {
    id: 'vca-vol',
    title: 'VOL-VCA Supervisors E-learning',
    badge: 'VOL-VCA + Mock Exams',
    price: '€ 69.00',
    rawPrice: 69.0,
    duration: '± 8 hours',
    description:
      'Tailored for operational supervisors, site managers and independent contractors. Full SSVV curriculum and extensive VOL-VCA question bank.',
  },
  {
    id: 'ehbo-ehak',
    title: 'First Aid & Pediatric First Aid (Wet IKK) E-learning',
    badge: 'Orange Cross / IKK',
    price: '€ 55.00',
    rawPrice: 55.0,
    duration: '± 3 to 4 hours',
    description:
      'Interactive online theory module preparing for your First Aid (EHBO) or Pediatric First Aid (EHAK / Wet IKK) practical session.',
  },
];

const defaultCourse = elearningCoursesEn[0];
---

<Layout
  title="Online Safety Academy & E-learning (BHV, VCA & First Aid) | Edusafe"
  description="Start immediately with online BHV, VCA and First Aid theory via the Edusafe E-learning Academy. Individual licenses or corporate monthly team subscriptions."
>
  <main class="w-full">
    <!-- 1. GOLD-STANDARD HERO HEADER -->
    <section class="relative bg-brand-primary text-white pt-12 pb-20 sm:pt-20 sm:pb-28 md:pt-24 md:pb-36 overflow-hidden">
      <PageHeroBackdrop
        image="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&q=80&w=1600"
        alt="Edusafe Online E-learning Academy"
      />

      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 relative z-10">
        <nav aria-label="Breadcrumb" class="section-eyebrow text-brand-primary mb-3.5 flex-wrap">
          <a href="/en" class="hover:underline text-white/70 hover:text-white">Home</a>
          <span class="text-white/40">/</span>
          <span class="text-brand-accent">E-learning Academy</span>
        </nav>

        <div class="max-w-3xl">
          <h1 class="heading-page mb-3 text-white">
            Edusafe E-learning Academy
          </h1>
          <p class="text-lead text-white/85 max-w-2xl mb-6">
            Complete your BHV, VCA or First Aid theory at your own pace on mobile, tablet or PC — available as an individual license or flexible corporate monthly subscription.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2.5 max-w-xl mb-7 text-card text-white/95 font-medium">
            <div class="flex items-center gap-2.5">
              <i class="fa-solid fa-circle-check text-brand-accent text-sm shrink-0"></i>
              <span>Instant login credentials</span>
            </div>
            <div class="flex items-center gap-2.5">
              <i class="fa-solid fa-circle-check text-brand-accent text-sm shrink-0"></i>
              <span>Mobile, tablet &amp; desktop</span>
            </div>
            <div class="flex items-center gap-2.5">
              <i class="fa-solid fa-circle-check text-brand-accent text-sm shrink-0"></i>
              <span>Digital theory certificate</span>
            </div>
            <div class="flex items-center gap-2.5">
              <i class="fa-solid fa-circle-check text-brand-accent text-sm shrink-0"></i>
              <span>Single or monthly subscription</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-3 sm:gap-3.5">
            <a href="#elearning-selection" class="btn-hero w-full sm:w-auto justify-center min-h-[48px]">
              <span>Select E-learning ↓</span>
            </a>
            <a
              href="/en/personal-advice?intent=praktijkdag"
              class="w-full sm:w-auto min-h-[48px] inline-flex items-center justify-center gap-2.5 font-display font-semibold text-[14px] sm:text-[15px] px-5 sm:px-7 py-3.5 sm:py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white border border-white/20 backdrop-blur-sm transition-all duration-300 text-center"
            >
              <i class="fa-regular fa-calendar-check text-brand-accent shrink-0"></i>
              <span>Theory completed? Schedule practical day →</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. MAIN CONTENT GRID (7 Cols Left + 5 Cols Sticky Right Checkout at lg:top-[152px]) -->
    <section class="max-w-[1280px] mx-auto px-4 sm:px-6 -mt-12 sm:-mt-14 md:-mt-20 relative z-20 pb-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 md:gap-8">

        <!-- Left Column (7 columns) -->
        <div class="lg:col-span-7 space-y-7">

          <!-- CARD 1: SELECT YOUR E-LEARNING MODULE -->
          <div
            id="elearning-selection"
            class="bg-white rounded-3xl p-5 sm:p-8 shadow-lg border border-brand-dark/5 scroll-mt-24 lg:scroll-mt-40"
          >
            <div class="mb-6">
              <span class="section-eyebrow text-brand-primary mb-1">
                <span>Individual Participant License</span>
              </span>
              <h2 class="heading-card text-brand-secondary mb-1.5">
                1. Choose your E-learning module
              </h2>
              <p class="text-body text-brand-dark/70">
                Select the online theory course you wish to start right away. Upon login, participants can choose English or Dutch study materials.
              </p>
            </div>

            <div class="space-y-3.5">
              {elearningCoursesEn.map((course, idx) => (
                <label
                  class={`elearning-option relative flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-4 sm:p-5 rounded-2xl border transition-all duration-200 cursor-pointer ${
                    idx === 0
                      ? 'border-brand-primary bg-white ring-2 ring-brand-primary/15 shadow-xs'
                      : 'border-brand-dark/8 bg-brand-cream/40 hover:border-brand-primary/30 hover:bg-white'
                  }`}
                  data-price={course.rawPrice}
                  data-title={course.title}
                  data-duration={course.duration}
                >
                  <input
                    type="radio"
                    name="elearning-choice"
                    value={course.id}
                    checked={idx === 0}
                    class="sr-only"
                  />

                  <div class="flex items-start gap-3.5">
                    <div class="w-5 h-5 rounded-full border-2 border-brand-primary/40 flex items-center justify-center shrink-0 mt-1">
                      <div
                        class={`radio-dot w-2.5 h-2.5 rounded-full bg-brand-primary transition-transform ${
                          idx === 0 ? 'scale-100' : 'scale-0'
                        }`}
                      ></div>
                    </div>

                    <div>
                      <div class="flex flex-wrap items-center gap-2 mb-1">
                        <span class="heading-tile text-brand-secondary">{course.title}</span>
                        <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-brand-primary/10 text-brand-primary">
                          {course.badge}
                        </span>
                      </div>
                      <p class="text-card text-brand-dark/70 mb-2">
                        {course.description}
                      </p>
                      <span class="text-xs font-semibold text-brand-dark/55 inline-flex items-center gap-1.5">
                        <i class="fa-solid fa-clock text-brand-primary"></i>
                        <span>Study time: {course.duration}</span>
                      </span>
                    </div>
                  </div>

                  <div class="text-left sm:text-right shrink-0 pl-8 sm:pl-0">
                    <span class="font-display font-semibold text-xl text-brand-secondary block leading-tight">
                      {course.price}
                    </span>
                    <span class="text-xs text-brand-dark/50">excl. VAT</span>
                  </div>
                </label>
              ))}
            </div>

            <div class="lg:hidden mt-5 pt-4 border-t border-brand-dark/6">
              <a href="#checkout-sidebar" class="btn-base w-full min-h-[48px]">
                <span>Continue to details &amp; payment ↓</span>
              </a>
            </div>
          </div>

          <!-- CARD 2: CORPORATE MONTHLY SUBSCRIPTION -->
          <div class="bg-brand-secondary text-white rounded-3xl p-5 sm:p-8 shadow-lg border border-white/10">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 mb-5 border-b border-white/10">
              <div>
                <span class="section-eyebrow text-brand-accent mb-1">
                  <i class="fa-solid fa-arrows-rotate"></i>
                  <span>For Companies &amp; HR Teams</span>
                </span>
                <h2 class="heading-card text-white">
                  Corporate Monthly E-learning Subscription
                </h2>
              </div>
              <div class="sm:text-right shrink-0">
                <span class="font-display text-2xl font-semibold text-brand-accent block leading-tight">
                  from € 9.50 / mo
                </span>
                <span class="text-xs text-white/65">per employee (excl. VAT)</span>
              </div>
            </div>

            <p class="text-body text-white/80 mb-5">
              Keep your Dutch and international workforce continuously certified in BHV, VCA and workplace safety. With our corporate monthly E-learning subscription you spread training costs predictably per month and track every employee’s compliance in one central HR dashboard.
            </p>

            <ul class="space-y-2.5 mb-6 text-card text-white/90">
              <li class="flex items-center gap-2.5">
                <i class="fa-solid fa-circle-check text-brand-accent text-xs shrink-0"></i>
                <span>Continuous access to micro-learnings &amp; annual theory refreshers</span>
              </li>
              <li class="flex items-center gap-2.5">
                <i class="fa-solid fa-circle-check text-brand-accent text-xs shrink-0"></i>
                <span>Central HR compliance dashboard with automated expiry alerts</span>
              </li>
              <li class="flex items-center gap-2.5">
                <i class="fa-solid fa-circle-check text-brand-accent text-xs shrink-0"></i>
                <span>Optionally bundled with annual on-site In-company practical days</span>
              </li>
            </ul>

            <a
              href="/en/personal-advice?type=zakelijk&course=e-learning"
              class="btn-base w-full sm:w-auto min-h-[48px]"
            >
              <span>Request corporate subscription →</span>
            </a>
          </div>

        </div>

        <!-- Right Column: Truly Sticky Checkout Card (5 columns, lg:top-[152px] self-start) -->
        <aside class="lg:col-span-5 lg:sticky lg:top-[152px] self-start z-20 scroll-mt-24" id="checkout-sidebar">
          <div class="bg-white rounded-3xl p-5 sm:p-6 shadow-lg border border-brand-dark/5">
            <span class="section-eyebrow text-brand-primary mb-1">
              <span>Start Immediately</span>
            </span>
            <h2 class="heading-card text-brand-secondary mb-4">
              2. Participant &amp; Payment
            </h2>

            <!-- Available languages with crisp SVG flags NL & ENG on 1 line -->
            <div class="mb-4 p-3.5 rounded-xl bg-brand-cream/60 border border-brand-dark/5 flex flex-wrap items-center justify-between gap-2 text-card">
              <span class="font-semibold text-brand-dark/65">Available languages:</span>
              <div class="flex items-center gap-1.5">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white border border-brand-dark/10 font-semibold text-brand-secondary text-xs shadow-2xs">
                  <svg class="w-4 h-3 rounded-[2px] shrink-0" viewBox="0 0 640 480" aria-hidden="true">
                    <path fill="#21468b" d="M0 0h640v480H0z"/>
                    <path fill="#fff" d="M0 0h640v320H0z"/>
                    <path fill="#ae1c28" d="M0 0h640v160H0z"/>
                  </svg>
                  <span>NL</span>
                </span>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white border border-brand-dark/10 font-semibold text-brand-secondary text-xs shadow-2xs">
                  <svg class="w-4 h-3 rounded-[2px] shrink-0" viewBox="0 0 60 30" aria-hidden="true">
                    <clipPath id="uk-clip-elearn-en"><path d="M0,0 v30 h60 v-30 z"/></clipPath>
                    <path d="M0,0 v30 h60 v-30 z" fill="#012169"/>
                    <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" clip-path="url(#uk-clip-elearn-en)"/>
                    <path d="M0,0 L60,30 M60,0 L0,30" stroke="#C8102E" stroke-width="4" clip-path="url(#uk-clip-elearn-en)"/>
                    <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10"/>
                    <path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6"/>
                  </svg>
                  <span>ENG</span>
                </span>
              </div>
            </div>

            <!-- Order Summary -->
            <div class="bg-brand-cream/60 rounded-2xl p-4 border border-brand-dark/5 space-y-2.5 mb-5 text-card">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <span class="section-eyebrow text-brand-dark/45">Selected module</span>
                  <span id="summary-course-title" class="heading-tile text-brand-secondary block">
                    {defaultCourse.title}
                  </span>
                </div>
                <span id="summary-duration-en" class="text-xs font-semibold text-brand-dark/55 shrink-0 mt-1">
                  {defaultCourse.duration}
                </span>
              </div>
              <div class="border-t border-brand-dark/6 pt-2.5 flex justify-between items-center text-brand-dark/70">
                <span>Subtotal (excl. VAT)</span>
                <span id="summary-subtotal" class="font-semibold text-brand-secondary">€ 59.00</span>
              </div>
              <div class="flex justify-between items-center text-brand-dark/70">
                <span>VAT (21%)</span>
                <span id="summary-tax" class="font-semibold text-brand-secondary">€ 12.39</span>
              </div>
              <div class="flex justify-between items-baseline pt-2.5 border-t border-brand-dark/8 font-display font-semibold text-brand-secondary">
                <span>Total incl. VAT</span>
                <span id="summary-total" class="text-xl text-brand-primary">€ 71.39</span>
              </div>
            </div>

            <form id="elearning-checkout-form" class="space-y-3.5">
              <div>
                <label class="block text-xs font-semibold uppercase text-brand-secondary tracking-wider mb-1">Full Name *</label>
                <input required type="text" class="w-full rounded-xl border border-brand-dark/10 px-4 py-3 sm:py-2.5 text-base sm:text-sm bg-brand-cream/40 focus:outline-none focus:border-brand-primary font-medium text-brand-secondary" placeholder="e.g. Alex Smith" />
              </div>

              <div>
                <label class="block text-xs font-semibold uppercase text-brand-secondary tracking-wider mb-1">Email Address *</label>
                <input required type="email" class="w-full rounded-xl border border-brand-dark/10 px-4 py-3 sm:py-2.5 text-base sm:text-sm bg-brand-cream/40 focus:outline-none focus:border-brand-primary font-medium text-brand-secondary" placeholder="alex@company.com" />
              </div>

              <div>
                <label class="block text-xs font-semibold uppercase text-brand-secondary tracking-wider mb-1">Payment Method</label>
                <select class="w-full rounded-xl border border-brand-dark/10 px-4 py-3 sm:py-2.5 text-base sm:text-sm bg-brand-cream/40 focus:outline-none focus:border-brand-primary font-semibold text-brand-secondary">
                  <option value="ideal">iDEAL (Dutch Banks)</option>
                  <option value="creditcard">Credit Card (Visa / Mastercard)</option>
                  <option value="bancontact">Bancontact</option>
                  <option value="invoice">Corporate Invoice (B2B)</option>
                </select>
              </div>

              <button type="submit" class="btn-base w-full min-h-[48px] cursor-pointer mt-2">
                <i class="fa-solid fa-lock text-xs"></i>
                <span>Pay &amp; start learning</span>
              </button>
            </form>

            <div id="checkout-success" class="hidden mt-4 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-card">
              <div class="flex items-center gap-2 mb-1">
                <i class="fa-solid fa-circle-check text-emerald-600"></i>
                <span class="font-semibold">Order confirmed!</span>
              </div>
              <p>Login credentials and invoice have been sent to your email address.</p>
            </div>

            <div class="pt-3.5 border-t border-brand-dark/5 mt-4 text-center">
              <span class="text-xs font-medium text-brand-dark/55 flex items-center justify-center gap-1.5">
                <i class="fa-solid fa-shield-halved text-emerald-600"></i>
                <span>Secure SSL checkout &amp; instant credentials</span>
              </span>
            </div>
          </div>
        </aside>

      </div>
    </section>

    <!-- 3. COMPLETE FOOTER STACK -->
    <CourseFaq category="E-learning" hubTitle="Edusafe E-learning Academy" lang="en" />
    <Reviews />
    <ContactForm />
  </main>
</Layout>

<script>
  function initElearningCheckout() {
    const optionLabels = document.querySelectorAll('.elearning-option');
    const summaryTitle = document.getElementById('summary-course-title');
    const summaryDuration = document.getElementById('summary-duration-en');
    const summarySubtotal = document.getElementById('summary-subtotal');
    const summaryTax = document.getElementById('summary-tax');
    const summaryTotal = document.getElementById('summary-total');
    const form = document.getElementById('elearning-checkout-form');
    const successMsg = document.getElementById('checkout-success');

    function updateSummary(price: number, title: string, duration: string) {
      const tax = price * 0.21;
      const total = price + tax;

      if (summaryTitle) summaryTitle.textContent = title;
      if (summaryDuration) summaryDuration.textContent = duration;
      if (summarySubtotal) summarySubtotal.textContent = `€ ${price.toFixed(2)}`;
      if (summaryTax) summaryTax.textContent = `€ ${tax.toFixed(2)}`;
      if (summaryTotal) summaryTotal.textContent = `€ ${total.toFixed(2)}`;
    }

    optionLabels.forEach((label) => {
      const radioInput = label.querySelector('input[type="radio"]') as HTMLInputElement | null;
      if (!radioInput) return;

      radioInput.addEventListener('change', () => {
        if (!radioInput.checked) return;

        optionLabels.forEach((l) => {
          l.classList.remove('border-brand-primary', 'bg-white', 'ring-2', 'ring-brand-primary/15', 'shadow-xs');
          l.classList.add('border-brand-dark/8', 'bg-brand-cream/40');
          const dot = l.querySelector('.radio-dot');
          if (dot) {
            dot.classList.add('scale-0');
            dot.classList.remove('scale-100');
          }
        });

        label.classList.add('border-brand-primary', 'bg-white', 'ring-2', 'ring-brand-primary/15', 'shadow-xs');
        label.classList.remove('border-brand-dark/8', 'bg-brand-cream/40');
        const activeDot = label.querySelector('.radio-dot');
        if (activeDot) {
          activeDot.classList.remove('scale-0');
          activeDot.classList.add('scale-100');
        }

        const price = parseFloat(label.getAttribute('data-price') || '59');
        const title = label.getAttribute('data-title') || 'BHV Basic & Refresher E-learning';
        const duration = label.getAttribute('data-duration') || '± 3 to 4 hours';
        updateSummary(price, title, duration);
      });
    });

    if (form && successMsg) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        successMsg.classList.remove('hidden');
        form.classList.add('opacity-50', 'pointer-events-none');
      });
    }
  }

  initElearningCheckout();
  document.addEventListener('astro:page-load', initElearningCheckout);
</script>
