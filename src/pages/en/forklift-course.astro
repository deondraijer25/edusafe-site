---
import CourseCategoryHub from '../../components/CourseCategoryHub.astro';
import { courseCatalogEn } from '../../data/catalog_en';

const transportCourses = courseCatalogEn
  .filter((c) => c.category === 'Transport')
  .map((c) => ({
    id: c.slug,
    slug: c.slug,
    title: c.title,
    shortTitle: c.shortTitle,
    tagline: c.tagline,
    price: c.price,
    duration: c.duration,
    target: c.target,
    suitableForHtml: c.suitableForHtml,
    requirements: c.requirements,
    exam: c.exam,
    certification: c.certification,
    inclusions: c.inclusions,
    modules: c.modules,
    learningOutcomes: c.learningOutcomes,
    image: c.image,
  }));
---

<CourseCategoryHub
  lang="en"
  category="Transport"
  seoTitle="Forklift, Reach Truck & Aerial Platform Certificate | Edusafe"
  seoDescription="Get your official Dutch Forklift, Reach Truck, Aerial Platform (MEWP) or Stacker/EPT certificate in 1 day per Dutch Arbobesluit Art. 7.17c (valid for 5 years)."
  breadcrumbLabel="Forklift & Logistics"
  heroTitle="Forklift & Internal Transport Courses"
  heroSubtitle="Earn your official Forklift, Reach Truck, Aerial Platform or Stacker/EPT certificate in one practical training day (valid for 5 years under Dutch Arbowet)."
  heroImage="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&q=80&w=1600"
  heroBullets={[
    'Certified in 1 practical day',
    'Valid 5 years + safety card',
    'Per Dutch Arbobesluit 7.17c',
    'The Hague or In-company',
  ]}
  primaryCtaUrl="/en/personal-advice?category=Transport"
  courses={transportCourses}
  coursesHeading="All Internal Transport & Aerial Platform courses"
  faqTitle="Forklift & Internal Transport"
  advisorText="Need advice for your warehouse or logistics team?"
/>
