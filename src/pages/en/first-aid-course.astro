---
import CourseCategoryHub from '../../components/CourseCategoryHub.astro';
import { courseCatalogEn } from '../../data/catalog_en';

const ehboCourses = courseCatalogEn
  .filter((c) => c.category === 'EHBO')
  .map((c) => ({
    id: c.slug,
    slug: c.slug,
    title: c.title,
    shortTitle: c.shortTitle,
    tagline: c.tagline,
    price: c.price,
    duration: c.duration,
    target: c.target,
    suitableForHtml: c.suitableForHtml,
    requirements: c.requirements,
    exam: c.exam,
    certification: c.certification,
    inclusions: c.inclusions,
    modules: c.modules,
    learningOutcomes: c.learningOutcomes,
    image: c.image,
  }));
---

<CourseCategoryHub
  lang="en"
  category="EHBO"
  seoTitle="First Aid Course (EHBO), Pediatric First Aid & CPR / AED | Edusafe"
  seoDescription="Accredited First Aid (EHBO) training in The Hague and In-company. Official Orange Cross, NRR CPR/AED and Dutch Childcare Act (Wet IKK) certificates."
  breadcrumbLabel="First Aid (EHBO)"
  heroTitle="First Aid (EHBO) & Lifesaving Courses"
  heroSubtitle="Learn lifesaving First Aid, CPR & AED and Pediatric First Aid (EHAK) certified in accordance with The Orange Cross, NRR and Dutch Wet IKK standards."
  heroImage="https://images.unsplash.com/photo-1603398938378-e54eab446dde?auto=format&fit=crop&q=80&w=1600"
  heroBullets={[
    'Orange Cross / NRR recognized',
    'Childcare Wet IKK certified',
    'Health insurer reimbursement',
    'The Hague or In-company',
  ]}
  primaryCtaUrl="/en/personal-advice?category=EHBO"
  courses={ehboCourses}
  coursesHeading="All certified First Aid (EHBO) courses"
  faqTitle="First Aid & Pediatric First Aid"
  advisorText="Need advice on First Aid certification?"
/>
