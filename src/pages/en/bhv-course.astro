---
import CourseCategoryHub from '../../components/CourseCategoryHub.astro';
import { courseCatalogEn } from '../../data/catalog_en';

const bhvCourses = courseCatalogEn
  .filter((c) => c.category === 'BHV')
  .map((c) => ({
    id: c.slug,
    slug: c.slug,
    title: c.title,
    shortTitle: c.shortTitle,
    tagline: c.tagline,
    price: c.price,
    duration: c.duration,
    target: c.target,
    suitableForHtml: c.suitableForHtml,
    requirements: c.requirements,
    exam: c.exam,
    certification: c.certification,
    inclusions: c.inclusions,
    modules: c.modules,
    learningOutcomes: c.learningOutcomes,
    image: c.image,
  }));
---

<CourseCategoryHub
  lang="en"
  category="BHV"
  seoTitle="BHV Course & Emergency Response Training (Arbowet Certified) | Edusafe"
  seoDescription="Official Dutch Arbowet Art. 15 Emergency Response (BHV) courses. Choose BHV Basic (E-learning + 1 practical day), BHV Refresher, Team Leader or Head of BHV in The Hague or In-company."
  breadcrumbLabel="BHV Courses"
  heroTitle="BHV & Emergency Response Courses"
  heroSubtitle="Comply with Article 15 of the Dutch Working Conditions Act (Arbowet) through hands-on Emergency Response training in The Hague or In-company at your location."
  heroImage="/assets/images/hero_poster.webp"
  heroBullets={[
    'E-learning + 1 practical day',
    'Official Arbowet certificate',
    'Incl. materials & lunch',
    'The Hague or In-company',
  ]}
  primaryCtaUrl="/en/personal-advice?category=BHV"
  courses={bhvCourses}
  coursesHeading="All 8 certified BHV courses"
  faqTitle="BHV Courses"
  advisorText="Need personal advice for your BHV team?"
/>
