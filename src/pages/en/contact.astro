---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Contact & Training Facilities | Edusafe Netherlands"
  description="Get in touch with Edusafe. Visit our primary campus at Oude Middenweg 241A in The Hague or call +31 (0)70 - 444 77 95. Business hours Mon-Fri 08:30 - 17:00."
>
  <!-- Hero Section -->
  <section class="relative bg-brand-secondary text-white pt-36 pb-20 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#ffffff08_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>
    <div class="max-w-[1280px] mx-auto px-6 relative z-10">
      
      <div class="flex items-center gap-2 text-xs font-semibold text-brand-primary uppercase tracking-wider mb-4">
        <a href="/en" class="hover:underline">Home</a>
        <span>/</span>
        <span class="text-white">Contact</span>
      </div>

      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-primary/20 text-brand-primary border border-brand-primary/30 text-xs font-bold uppercase tracking-wider mb-4">
          <i class="fa-solid fa-headset"></i>
          Direct Client Support
        </span>
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight mb-6">
          Get in Touch with <span class="text-brand-accent">Edusafe</span>
        </h1>
        <p class="text-lg text-white/80 leading-relaxed">
          Have an inquiry about our safety courses, want to arrange customized incompany training, or request an official quotation? Our multilingual advisory team is at your disposal Mon–Fri from 08:30 to 17:00.
        </p>
      </div>

    </div>
  </section>

  <!-- Contact & Details Grid -->
  <section class="py-20 bg-brand-cream relative">
    <div class="max-w-[1280px] mx-auto px-6">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Left: Direct Contact Information & Details -->
        <div class="lg:col-span-5 space-y-8">
          
          <div class="bg-white p-8 rounded-3xl border border-brand-dark/5 shadow-sm space-y-6">
            <h3 class="font-display font-bold text-2xl text-brand-secondary">
              Headquarters &amp; Campus
            </h3>

            <div class="space-y-5 text-sm text-brand-dark/80">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-brand-primary/10 text-brand-primary flex items-center justify-center shrink-0">
                  <i class="fa-solid fa-location-dot"></i>
                </div>
                <div>
                  <strong class="text-brand-secondary block text-base font-semibold">Head Office &amp; Training Campus</strong>
                  <span>Oude Middenweg 241A</span><br />
                  <span>2491 AH The Hague, The Netherlands</span><br />
                  <span class="text-xs text-brand-dark/60">Free customer parking on-site</span>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-brand-primary/10 text-brand-primary flex items-center justify-center shrink-0">
                  <i class="fa-solid fa-phone"></i>
                </div>
                <div>
                  <strong class="text-brand-secondary block text-base font-semibold">Telephone Line</strong>
                  <a href="tel:0704447795" class="text-brand-primary font-bold hover:underline block text-base">
                    +31 (0)70 - 444 77 95
                  </a>
                  <span class="text-xs text-brand-dark/60">Monday to Friday: 08:30 – 17:00 CET</span>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-brand-primary/10 text-brand-primary flex items-center justify-center shrink-0">
                  <i class="fa-solid fa-envelope"></i>
                </div>
                <div>
                  <strong class="text-brand-secondary block text-base font-semibold">E-mail Dispatch</strong>
                  <a href="mailto:info@edusafe.nl" class="text-brand-primary font-bold hover:underline block text-base">
                    info@edusafe.nl
                  </a>
                  <span class="text-xs text-brand-dark/60">Response guaranteed within 24 business hours</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Company registration details -->
          <div class="bg-white p-8 rounded-3xl border border-brand-dark/5 shadow-sm">
            <h4 class="font-display font-bold text-lg text-brand-secondary mb-4">
              Corporate Registration
            </h4>
            <ul class="text-xs text-brand-dark/70 space-y-2">
              <li class="flex justify-between border-b border-brand-dark/5 pb-2">
                <strong>Chamber of Commerce (KvK):</strong>
                <span>73291447 (Registration 27260603)</span>
              </li>
              <li class="flex justify-between border-b border-brand-dark/5 pb-2">
                <strong>VAT ID (BTW):</strong>
                <span>NL859442640B01</span>
              </li>
              <li class="flex justify-between">
                <strong>Bank Account (IBAN):</strong>
                <span>NL68 ABNA 0834117177</span>
              </li>
            </ul>
          </div>

          <!-- Training locations -->
          <div class="bg-brand-secondary text-white p-8 rounded-3xl shadow-xl">
            <h4 class="font-display font-bold text-lg mb-3 text-brand-accent">
              Training Campuses &amp; Facilities
            </h4>
            <ul class="space-y-3 text-xs text-white/80">
              <li class="flex items-start gap-2">
                <i class="fa-solid fa-check text-brand-primary mt-0.5"></i>
                <span><strong>The Hague Main Campus:</strong> Oude Middenweg 241A, 2491 AH Den Haag</span>
              </li>
              <li class="flex items-start gap-2">
                <i class="fa-solid fa-check text-brand-primary mt-0.5"></i>
                <span><strong>Zoetermeer Facility:</strong> Golden Tulip Hotel, Kinderen van Versteegplein 18</span>
              </li>
              <li class="flex items-start gap-2">
                <i class="fa-solid fa-check text-brand-primary mt-0.5"></i>
                <span><strong>Incompany:</strong> Hosted on-site across any corporate facility in the Netherlands</span>
              </li>
            </ul>
          </div>

        </div>

        <!-- Right: Interactive Contact Form -->
        <div class="lg:col-span-7">
          <div class="bg-white p-8 lg:p-12 rounded-3xl border border-brand-dark/5 shadow-xl">
            <h3 class="font-display font-bold text-2xl sm:text-3xl text-brand-secondary mb-2">
              Send us a direct inquiry
            </h3>
            <p class="text-sm text-brand-dark/70 mb-8">
              Complete the form below and one of our dedicated safety consultants will reach out to you within one business day.
            </p>

            <form action="mailto:info@edusafe.nl" method="POST" enctype="text/plain" class="space-y-6">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-brand-secondary mb-2">
                    Full Name *
                  </label>
                  <input 
                    type="text" 
                    required 
                    placeholder="Your name"
                    class="w-full px-4 py-3.5 rounded-xl border border-brand-dark/15 focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 text-sm"
                  />
                </div>
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-brand-secondary mb-2">
                    Company Name (optional)
                  </label>
                  <input 
                    type="text" 
                    placeholder="Your organization"
                    class="w-full px-4 py-3.5 rounded-xl border border-brand-dark/15 focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 text-sm"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-brand-secondary mb-2">
                    Email Address *
                  </label>
                  <input 
                    type="email" 
                    required 
                    placeholder="name@company.com"
                    class="w-full px-4 py-3.5 rounded-xl border border-brand-dark/15 focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 text-sm"
                  />
                </div>
                <div>
                  <label class="block text-xs font-bold uppercase tracking-wider text-brand-secondary mb-2">
                    Phone Number *
                  </label>
                  <input 
                    type="tel" 
                    required 
                    placeholder="+31 6 12345678"
                    class="w-full px-4 py-3.5 rounded-xl border border-brand-dark/15 focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 text-sm"
                  />
                </div>
              </div>

              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-brand-secondary mb-2">
                  Topic of Interest
                </label>
                <select class="w-full px-4 py-3.5 rounded-xl border border-brand-dark/15 focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 text-sm bg-white">
                  <option>Emergency Response Officer (BHV) Course</option>
                  <option>First Aid / CPR AED Certification (Het Oranje Kruis)</option>
                  <option>VCA Safety Course in English</option>
                  <option>Incompany Corporate Group Training</option>
                  <option>Risk Assessment (RI&E) Audit</option>
                  <option>Fire Safety &amp; Extinguisher Maintenance</option>
                  <option>Emergency Lighting Testing</option>
                  <option>NEN 1414 Evacuation Floor Plans</option>
                  <option>Event First Aid Deployment</option>
                  <option>Roof Safety &amp; Fall Protection Inspection</option>
                  <option>General inquiry / consultancy consultation</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-brand-secondary mb-2">
                  Message / Details *
                </label>
                <textarea 
                  rows="4" 
                  required 
                  placeholder="Tell us about your requirements or dates..."
                  class="w-full px-4 py-3.5 rounded-xl border border-brand-dark/15 focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 text-sm"
                ></textarea>
              </div>

              <button 
                type="submit" 
                class="w-full py-4 rounded-xl bg-brand-accent hover:bg-brand-accent-hover text-white font-display font-semibold text-center transition-all shadow-lg hover:-translate-y-0.5"
              >
                Send Message
              </button>
            </form>
          </div>
        </div>

      </div>

    </div>
  </section>
</Layout>
