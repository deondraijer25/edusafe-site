---

<CourseCategoryHub
  lang="en"
  category="Incompany"
  seoTitle="In-company Safety Training on Site (BHV, First Aid, VCA & Forklift) | Edusafe"
  seoDescription="Book tailored In-company BHV, First Aid, VCA, Forklift or Evacuation training at your premises anywhere in the Netherlands. From 6 participants in English or Dutch."
  breadcrumbLabel="In-company Training"
  heroTitle="In-company Safety Training at Your Location"
  heroSubtitle="Train your team in your own building or warehouse with zero travel time. Fully tailored in English or Dutch from 6 participants across the Netherlands."
  heroImage="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&q=80&w=1600"
  heroBullets={[
    'Cost-effective from 6 pers.',
    'At your own company site',
    'Flexible: day, evening, weekend',
    'Proposal within 1 business day',
  ]}
  primaryCtaUrl="/en/personal-advice?type=zakelijk&mode=incompany"
  primaryCtaLabel="Request In-company quote"
  courses={incompanyCourses}
  coursesHeading="All In-company trainings at your location"
  faqTitle="In-company Safety Training"
  advisorText="Need an In-company quote or custom date?"
>
  <div
    slot="extra-left"
    id="incompany-request"
    class="bg-white rounded-3xl p-5 sm:p-8 shadow-md border border-brand-dark/5 scroll-mt-24 lg:scroll-mt-40"
  >
    <span class="section-eyebrow text-brand-primary mb-1">
      <span>Direct Group Proposal</span>
    </span>
    <h2 class="heading-card text-brand-secondary mb-2">
      Request a tailored In-company quote
    </h2>
    <p class="text-body text-brand-dark/75 mb-6">
      Receive a clear, no-obligation group proposal within 1 business day — including certified instructor, training equipment and official certification on site.
    </p>

    <form id="incompany-quote-form-en" class="space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-brand-secondary uppercase tracking-wider mb-1.5">Company Name</label>
          <input type="text" name="company" placeholder="e.g. Acme Logistics NL" class="w-full bg-brand-cream/60 border border-brand-dark/10 rounded-xl px-4 py-3 text-base sm:text-sm focus:outline-none focus:border-brand-primary" required />
        </div>
        <div>
          <label class="block text-xs font-semibold text-brand-secondary uppercase tracking-wider mb-1.5">Contact Person</label>
          <input type="text" name="name" placeholder="First and last name" class="w-full bg-brand-cream/60 border border-brand-dark/10 rounded-xl px-4 py-3 text-base sm:text-sm focus:outline-none focus:border-brand-primary" required />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-brand-secondary uppercase tracking-wider mb-1.5">Email Address</label>
          <input type="email" name="email" placeholder="name@company.com" class="w-full bg-brand-cream/60 border border-brand-dark/10 rounded-xl px-4 py-3 text-base sm:text-sm focus:outline-none focus:border-brand-primary" required />
        </div>
        <div>
          <label class="block text-xs font-semibold text-brand-secondary uppercase tracking-wider mb-1.5">Phone Number</label>
          <input type="tel" name="phone" placeholder="+31 6 12345678" class="w-full bg-brand-cream/60 border border-brand-dark/10 rounded-xl px-4 py-3 text-base sm:text-sm focus:outline-none focus:border-brand-primary" required />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-brand-secondary uppercase tracking-wider mb-1.5">Desired Training</label>
          <select name="category" class="w-full bg-brand-cream/60 border border-brand-dark/10 rounded-xl px-4 py-3 text-base sm:text-sm focus:outline-none focus:border-brand-primary cursor-pointer">
            <option>In-company BHV (Basic / Refresher)</option>
            <option>In-company First Aid, Pediatric First Aid or CPR</option>
            <option>In-company VCA Course & Exam</option>
            <option>In-company Forklift / Reach Truck / Aerial Platform</option>
            <option>In-company Evacuation Drill</option>
            <option>Custom combination</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-brand-secondary uppercase tracking-wider mb-1.5">Number of Participants</label>
          <input type="number" name="participants" min="1" placeholder="e.g. 10 employees" class="w-full bg-brand-cream/60 border border-brand-dark/10 rounded-xl px-4 py-3 text-base sm:text-sm focus:outline-none focus:border-brand-primary" />
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-brand-secondary uppercase tracking-wider mb-1.5">Location & Specific Preferences</label>
        <textarea name="message" rows="3" placeholder="City, preferred language (English / Dutch) or preferred dates..." class="w-full bg-brand-cream/60 border border-brand-dark/10 rounded-xl px-4 py-3 text-base sm:text-sm resize-none focus:outline-none focus:border-brand-primary"></textarea>
      </div>

      <button type="submit" class="btn-base w-full sm:w-auto min-h-[48px] cursor-pointer">
        <span>Request free quote →</span>
      </button>
    </form>

    <div id="incompany-quote-success-en" class="hidden flex-col items-center justify-center text-center p-6 bg-emerald-50 border border-emerald-200 rounded-2xl mt-4">
      <h3 class="heading-tile text-emerald-900 mb-1">Quote request received!</h3>
      <p class="text-card text-emerald-700">Thank you for your inquiry. We will contact you within 1 business day with a tailored proposal.</p>
    </div>

    <script>
      const incFormEn = document.getElementById('incompany-quote-form-en') as HTMLFormElement | null;
      const incSuccessEn = document.getElementById('incompany-quote-success-en');
      if (incFormEn && incSuccessEn) {
        incFormEn.addEventListener('submit', async (e) => {
          e.preventDefault();
          const btn = incFormEn.querySelector('button[type="submit"]') as HTMLButtonElement | null;
          const orig = btn ? btn.innerHTML : '';
          if (btn) { btn.disabled = true; btn.textContent = 'Sending...'; }
          const fd = new FormData(incFormEn);
          try {
            await fetch('/api/advies', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                source: 'incompany-offerte-en',
                customerType: 'Zakelijk',
                company: fd.get('company') || '',
                name: fd.get('name') || '',
                email: fd.get('email') || '',
                phone: fd.get('phone') || '',
                category: fd.get('category') || 'In-company Training',
                participants: fd.get('participants') ? `${fd.get('participants')} participants` : '',
                message: fd.get('message') || '',
              }),
            });
            incFormEn.classList.add('hidden');
            incSuccessEn.classList.remove('hidden');
            incSuccessEn.classList.add('flex');
          } catch (err) {
            console.error(err);
          } finally {
            if (btn) { btn.disabled = false; btn.innerHTML = orig; }
          }
        });
      }
    </script>
  </div>
</CourseCategoryHub>
