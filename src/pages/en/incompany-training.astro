    exam: 'Practical skills assessment per The Orange Cross / NRR / Wet IKK guidelines.',
    certification: 'Official recognized EHBO, EHAK or NRR CPR certificate (valid 2 years).',
    inclusions: [
      'QCPR manikins & bandage kits',
      'Tailored to your industry',
      'Official certificates & cards',
      'Daytime, evening or Saturday',
    ],
    modules: [
      {
        name: 'Adult & Pediatric CPR (BLS / PBLS) + AED deployment',
        description: 'High-engagement practical training in small groups with English-speaking instructors.',
      },
      {
        name: 'Industry-specific injuries & workplace emergencies',
        description: 'Focused scenarios for childcare (Wet IKK), offices, laboratories or production sites.',
      },
    ],
    image: 'https://images.unsplash.com/photo-1603398938378-e54eab446dde?auto=format&fit=crop&q=80&w=600',
    requestUrl: '/en/personal-advice?type=zakelijk&course=ehbo-basis&mode=incompany',
    incompanyUrl: '#incompany-request',
  },
  {
    id: 'incompany-vca',
    slug: 'vca-vol',
    title: 'In-company VCA Course + Official CBT Exam on Site',
    shortTitle: 'In-company VCA + Exam',
    tagline: 'Classroom exam training plus official SSVV CBT exam at your own premises',
    price: 'from € 175,00',
    duration: '1 training day (incl. exam)',
    target:
      'For contractors, engineering firms, staffing agencies and technical teams certifying groups in one day.',
    requirements: 'Training room with desks, chairs and reliable power/internet connection.',
    exam: 'Official SSVV CBT digital exam administered by an independent exam institute at your site.',
    certification: 'Official VCA Basic or VOL-VCA diploma + 10-year CDR registration.',
    inclusions: [
      'On-site exam training',
      'Official SSVV exam included',
      '10-year CDR registration',
      'Available in EN, NL & more',
    ],
    modules: [
      {
        name: 'Targeted VCA exam preparation with practical cases',
        description: 'Dutch Arbowet, hazardous substances, working at height, LMRA and electrical safety.',
      },
      {
        name: 'Same-day official SSVV CBT exam with instant result',
        description: 'We arrange the examiner, exam laptops and official Central Diploma Register entry.',
