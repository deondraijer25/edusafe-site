    incompanyUrl: '#incompany-request',
  },
  {
    id: 'incompany-evacuation',
    slug: 'ontruimingsoefening',
    title: 'In-company Evacuation Drill & Safety Day',
    shortTitle: 'In-company Evacuation Drill',
    tagline: 'Annual realistic evacuation simulation with smoke, observers and official report',
    price: 'Custom quote',
    duration: '1 half-day at your site',
    target:
      'For offices, schools, hotels and multi-tenant buildings fulfilling their annual statutory evacuation drill.',
    requirements: 'Pre-drill scenario briefing and temporary test status with your alarm monitoring center.',
    exam: 'Practical observation with evacuation timing and improvement audit.',
