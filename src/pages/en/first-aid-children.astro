---
import CourseCategoryHub, { type HubCourseItem } from '../../components/CourseCategoryHub.astro';
import { courseCatalogEn } from '../../data/catalog_en';

const catalogEhak = courseCatalogEn.find((c) => c.slug === 'ehak');

const ehakCourses: HubCourseItem[] = [
  ...(catalogEhak
    ? [
        {
          id: catalogEhak.slug,
          slug: catalogEhak.slug,
          title: catalogEhak.title,
          shortTitle: catalogEhak.shortTitle,
          tagline: catalogEhak.tagline,
          price: catalogEhak.price,
          duration: catalogEhak.duration,
          target: catalogEhak.target,
          suitableForHtml: catalogEhak.suitableForHtml,
          requirements: catalogEhak.requirements,
          exam: catalogEhak.exam,
          certification: catalogEhak.certification,
          inclusions: catalogEhak.inclusions,
          modules: catalogEhak.modules,
          image: catalogEhak.image,
        },
      ]
    : []),
  {
    id: 'ehak-refresher',
    title: 'Pediatric First Aid Refresher (Wet IKK)',
    shortTitle: 'Pediatric First Aid Refresher',
    tagline: 'Maintain your valid Dutch Wet IKK & GGD certification in one half-day session',
    price: '€ 85,00',
    duration: '1 half-day (4 hours)',
    target:
      'For certified childcare staff, teachers and childminders renewing their mandatory 2-year Pediatric First Aid (EHAK) certificate for GGD inspections.',
    requirements: 'Valid or recently expired Pediatric First Aid (EHAK) certificate.',
    exam: 'Practical skills assessment on infant and child CPR manikins.',
    certification: 'Official 2-year renewal of your Wet IKK-registered EHAK certificate.',
    inclusions: [
      'Hands-on scenario practice',
      'Wet IKK certificate renewal',
      'GGD compliance update',
      'Coffee, tea & free parking',
    ],
    modules: [
      {
        name: 'Infant & Child CPR refresher (PBLS + AED)',
        description: 'Hands-on practice of 5 initial rescue breaths, 15:2 chest compressions and pediatric AED pads.',
      },
      {
        name: 'Choking & severe airway obstruction in children',
        description: 'Safe application of back blows and chest/abdominal thrusts for babies and older children.',
      },
      {
        name: 'Childcare & international school emergency scenarios',
        description: 'Febrile seizures, anaphylaxis (EpiPen), head injuries, burns and poisoning.',
      },
    ],
    image: 'https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?auto=format&fit=crop&q=80&w=600',
    requestUrl: '/en/personal-advice?course=ehak',
    incompanyUrl: '/en/personal-advice?type=zakelijk&course=ehak&mode=incompany',
  },
  {
    id: 'childminder-lrk',
    title: 'Childminder First Aid Certification (LRK Registered)',
    shortTitle: 'Childminder First Aid (LRK)',
    tagline: 'Nationally registered certificate for the Dutch National Childcare Register (LRK)',
    price: '€ 125,00',
    duration: 'E-learning + 1 half-day (3.5 hours)',
    target:
      'For new and experienced childminders (gastouders) registering in the Dutch National Childcare Register (LRK).',
    requirements: 'No prior training required.',
    exam: 'Online theory + practical assessment on infant/child CPR and acute pediatric first aid.',
    certification: 'Official LRK & Wet IKK registered Childminder First Aid certificate (valid 2 years).',
    inclusions: [
      'Online E-learning module',
      '1 practical session (3.5 hrs)',
      'Official LRK certificate',
      'Coffee, tea & free parking',
    ],
    modules: [
      {
        name: 'Infant (0–1 yr) and child resuscitation + AED',
        description: 'Lifesaving CPR techniques tailored to home-based childcare settings.',
      },
      {
        name: 'Choking, poisoning & domestic childhood accidents',
        description: 'Effective response to household chemicals, plants, scalds and falls.',
      },
      {
        name: 'Handover to 112 emergency services, GP post & parents',
        description: 'Clear emergency calling protocols and structured communication with parents.',
      },
    ],
    image: 'https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&fit=crop&q=80&w=600',
    requestUrl: '/en/personal-advice?course=ehak',
    incompanyUrl: '/en/personal-advice?type=zakelijk&course=ehak&mode=incompany',
  },
  {
    id: 'infant-child-cpr-pbls',
    title: 'Infant & Child CPR (NRR PBLS)',
    shortTitle: 'Infant & Child CPR (PBLS)',
    tagline: 'Specialized NRR Pediatric Basic Life Support training for parents & carers',
    price: '€ 95,00',
    duration: '1 half-day (3.5 hours)',
    target:
      'For parents, expat families, nannies, maternity nurses and sports coaches wanting focused infant and child CPR skills.',
    requirements: 'No prior medical knowledge required.',
    exam: 'Practical assessment per Dutch Resuscitation Council (NRR) guidelines.',
    certification: 'Official NRR PBLS Infant & Child CPR certificate (valid 2 years).',
    inclusions: [
      'Practice on baby/child manikins',
      'Pediatric AED pad training',
      'Official NRR PBLS certificate',
      'Coffee, tea & course guide',
    ],
    modules: [
      {
        name: 'Recognizing respiratory & cardiac arrest in children',
        description: 'Rapid assessment of consciousness and breathing in infants and children.',
      },
      {
        name: '5 initial rescue breaths & 15:2 chest compressions',
        description: 'Two-finger infant technique and one-hand child technique with digital QCPR feedback.',
      },
      {
        name: 'Pediatric AED deployment & choking relief',
        description: 'Correct electrode placement on small children and resolving severe airway blockages.',
      },
    ],
    image: 'https://images.unsplash.com/photo-1505751172876-fa1923c5c528?auto=format&fit=crop&q=80&w=600',
    requestUrl: '/en/personal-advice?course=ehak',
    incompanyUrl: '/en/personal-advice?type=zakelijk&course=ehak&mode=incompany',
  },
];

const faqs = [
  {
    q: 'Does this Pediatric First Aid (EHAK) course meet Dutch Wet IKK and GGD requirements?',
    a: 'Yes, 100%. Our Pediatric First Aid (Eerste Hulp aan Kinderen) certificate complies fully with the Dutch Childcare Quality & Innovation Act (Wet IKK) and the National Childcare Register (LRK), ensuring full compliance during GGD inspections.',
  },
  {
    q: 'Is Pediatric First Aid reimbursed by Dutch health insurers?',
    a: 'Yes, many Dutch supplementary health insurance policies reimburse up to 100% of an accredited Pediatric First Aid course without affecting your annual deductible (eigen risico). You can submit your official Edusafe invoice directly.',
  },
  {
    q: 'How does the blended E-learning + practical session work?',
    a: 'Upon registration you receive immediate access to our online E-learning module (available in Dutch & English, approx. 2–3 hours at your own pace), followed by a focused hands-on session practicing on infant and child CPR manikins.',
  },
  {
    q: 'Can you deliver Pediatric First Aid In-company at our daycare or international school?',
    a: 'Absolutely. From 6 participants we deliver the practical training directly at your daycare center or school — during the day, on a staff study day or in the evening.',
  },
];
---

<CourseCategoryHub
  lang="en"
  category="EHBO"
  seoTitle="Pediatric First Aid Course (EHAK / Wet IKK Certified) | Edusafe"
  seoDescription="Official Dutch Wet IKK, LRK and GGD-approved Pediatric First Aid (EHAK) courses for childcare, international schools, childminders and parents."
  breadcrumbLabel="Pediatric First Aid (EHAK)"
  heroTitle="Pediatric First Aid (EHAK)"
  heroSubtitle="100% Wet IKK and GGD-recognized First Aid for Children courses for daycares, after-school care, international schools, childminders and parents."
  heroImage="https://images.unsplash.com/photo-1588072432836-e10032774350?auto=format&fit=crop&q=80&w=1600"
  heroBullets={[
    'E-learning + 1 half-day',
    '100% Wet IKK & GGD approved',
    'Health insurer reimbursement',
    'The Hague or at your daycare',
  ]}
  primaryCtaUrl="/en/personal-advice?course=ehak"
  courses={ehakCourses}
  coursesHeading="All Pediatric First Aid (EHAK) & PBLS courses"
  faqTitle="Pediatric First Aid & Wet IKK"
  customFaqs={faqs}
  advisorText="Need advice for your childcare or school team?"
  contactCourseSlug="ehak"
/>
