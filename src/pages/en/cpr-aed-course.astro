---
import CourseCategoryHub, { type HubCourseItem } from '../../components/CourseCategoryHub.astro';
import { courseCatalogEn } from '../../data/catalog_en';

const catalogAed = courseCatalogEn.find((c) => c.slug === 'aed-reanimatie');

const aedCourses: HubCourseItem[] = [
  ...(catalogAed
    ? [
        {
          id: catalogAed.slug,
          slug: catalogAed.slug,
          title: catalogAed.title,
          shortTitle: catalogAed.shortTitle,
          tagline: catalogAed.tagline,
          price: catalogAed.price,
          duration: catalogAed.duration,
          target: catalogAed.target,
          suitableForHtml: catalogAed.suitableForHtml,
          requirements: catalogAed.requirements,
          exam: catalogAed.exam,
          certification: catalogAed.certification,
          inclusions: catalogAed.inclusions,
          modules: catalogAed.modules,
          image: catalogAed.image,
        },
      ]
    : []),
  {
    id: 'cpr-aed-refresher',
    title: 'CPR & AED Refresher (NRR)',
    shortTitle: 'CPR & AED Refresher',
    tagline: 'Keep your NRR certificate and HartslagNu responder skills sharp in 2.5 hours',
    price: '€ 75,00',
    duration: '1 half-day / evening (2.5 hours)',
    target:
      'For NRR CPR & AED certificate holders refreshing their practical skills and maintaining active HartslagNu citizen responder status.',
    requirements: 'Previously earned CPR & AED certificate.',
    exam: 'Hands-on assessment on digital QCPR manikins by a certified NRR instructor.',
    certification: 'Official 2-year renewal of your NRR BLS/AED certificate.',
    inclusions: [
      'Digital QCPR manikin practice',
      'NRR certificate renewal',
      'Valid for HartslagNu',
      'Coffee, tea & free parking',
    ],
    modules: [
      {
        name: 'Chest compressions & rescue breaths refresher (30:2)',
        description: 'Real-time digital feedback on compression depth, recoil and rate.',
      },
      {
        name: 'AED deployment & special scenarios',
        description: 'Safe AED operation on wet surfaces, with pacemakers, medication patches and alerts.',
      },
      {
        name: 'Choking relief, recovery position & latest NRR/ERC guidelines',
        description: 'Hands-on practice of abdominal thrusts and updated European Resuscitation Council protocols.',
      },
    ],
    image: 'https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?auto=format&fit=crop&q=80&w=600',
    requestUrl: '/en/personal-advice?course=aed-reanimatie',
    incompanyUrl: '/en/personal-advice?type=zakelijk&course=aed-reanimatie&mode=incompany',
  },
  {
    id: 'pbls-child-cpr',
    title: 'PBLS — Infant & Child CPR (NRR)',
    shortTitle: 'Infant & Child CPR (PBLS)',
    tagline: 'Paediatric Basic Life Support for infants and children',
    price: '€ 115,00',
    duration: '1 half-day (3.5 hours)',
    target:
      'For parents, teachers, childcare staff and sports coaches wanting dedicated infant and child resuscitation training.',
    requirements: 'No prior training required.',
    exam: 'Practical skills assessment on dedicated infant and child manikins.',
    certification: 'Official NRR PBLS Pediatric Resuscitation certificate (valid 2 years).',
    inclusions: [
      'Infant & child manikin practice',
      'Pediatric AED pad training',
      'Official NRR PBLS diploma',
      'Coffee, tea & course guide',
    ],
    modules: [
      {
        name: 'Key differences between adult and pediatric resuscitation',
        description: 'Why oxygen deprivation is primary in children and how to intervene immediately.',
      },
      {
        name: '5 initial rescue breaths & 15:2 chest compressions',
        description: 'Two-finger technique for infants and one-hand technique for children.',
      },
      {
        name: 'Pediatric AED pads & severe choking relief',
        description: 'Safe AED use with pediatric attenuator keys/pads and clearing blocked airways.',
      },
    ],
    image: 'https://images.unsplash.com/photo-1588072432836-e10032774350?auto=format&fit=crop&q=80&w=600',
    requestUrl: '/en/personal-advice?course=aed-reanimatie',
    incompanyUrl: '/en/personal-advice?type=zakelijk&course=aed-reanimatie&mode=incompany',
  },
  {
    id: 'citizen-responder-hartslagnu',
    title: 'Citizen Responder & HartslagNu Training',
    shortTitle: 'Citizen Responder (HartslagNu)',
    tagline: 'Become a certified citizen responder within the 6-minute zone of your neighborhood',
    price: '€ 85,00',
    duration: '1 half-day (3 hours)',
    target:
      'For residents, homeowner associations (VvE), sports clubs and volunteers wanting to save lives during cardiac arrests nearby.',
    requirements: 'Age 18+. No medical background required.',
    exam: 'Practical CPR and AED assessment.',
    certification: 'Official NRR certificate eligible for direct HartslagNu registration.',
    inclusions: [
      'Hands-on BLS & AED training',
      'HartslagNu alert app walkthrough',
      'Official NRR certificate',
      'Coffee, tea & booklet',
    ],
    modules: [
      {
        name: 'The 6-minute zone & HartslagNu dispatch network',
        description: 'How 112 alerts work and retrieving a neighborhood AED from a PIN-locked outdoor cabinet.',
      },
      {
        name: 'Team CPR & professional ambulance handover',
        description: 'Coordinating roles with fellow responders until EMS paramedics take over.',
      },
    ],
    image: 'https://images.unsplash.com/photo-1505751172876-fa1923c5c528?auto=format&fit=crop&q=80&w=600',
    requestUrl: '/en/personal-advice?course=aed-reanimatie',
    incompanyUrl: '/en/personal-advice?type=zakelijk&course=aed-reanimatie&mode=incompany',
  },
];

const faqs = [
  {
    q: 'What is the difference between a full First Aid course and a CPR & AED course?',
    a: 'A CPR & AED course focuses 100% on the most critical life-threatening emergencies in a single half-day (3.5–4 hours): cardiac arrest, AED operation and severe choking. A full First Aid (EHBO) course also covers wounds, fractures, burns and medical conditions.',
  },
  {
    q: 'Can I register with HartslagNu after completing this course?',
    a: 'Yes! With the official NRR/ERC-recognized certificate issued by Edusafe, you can immediately register as a citizen responder with the Dutch national cardiac arrest alert network HartslagNu.',
  },
  {
    q: 'Is CPR & AED training reimbursed by Dutch health insurance?',
    a: 'Many Dutch supplementary health insurance packages reimburse an NRR-recognized CPR & AED course in part or in full without affecting your deductible.',
  },
  {
    q: 'Can you deliver CPR & AED training In-company at our office or sports club?',
    a: 'Yes. From 6 participants our NRR-certified instructors bring digital QCPR manikins and training AEDs directly to your office, international organization or club — during office hours or in the evening.',
  },
];
---

<CourseCategoryHub
  lang="en"
  category="EHBO"
  seoTitle="CPR & AED Course (NRR / ERC Certified) | Edusafe"
  seoDescription="Learn lifesaving CPR and AED operation in one half-day session. Officially NRR/ERC certified, eligible for HartslagNu and delivered in Dutch & English."
  breadcrumbLabel="CPR & AED"
  heroTitle="CPR & AED Course (NRR Certified)"
  heroSubtitle="Master lifesaving chest compressions, rescue breaths and AED deployment in a single hands-on half-day session."
  heroImage="https://images.unsplash.com/photo-1516549655169-df83a0774514?auto=format&fit=crop&q=80&w=1600"
  heroBullets={[
    'Certified in 1 half-day',
    'Official NRR / ERC diploma',
    'Eligible for HartslagNu',
    'The Hague or In-company',
  ]}
  primaryCtaUrl="/en/personal-advice?course=aed-reanimatie"
  courses={aedCourses}
  coursesHeading="All CPR, AED & Pediatric Resuscitation courses"
  faqTitle="CPR & AED Training"
  customFaqs={faqs}
  advisorText="Questions about CPR or AED training?"
  contactCourseSlug="aed-reanimatie"
/>
