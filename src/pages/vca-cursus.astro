---
import CourseCategoryHub from '../components/CourseCategoryHub.astro';
import { courseCatalog } from '../data/catalog';

const vcaCourses = courseCatalog
  .filter((c) => c.category === 'VCA')
  .map((c) => ({
    id: c.slug,
    slug: c.slug,
    title: c.title,
    shortTitle: c.shortTitle,
    tagline: c.tagline,
    price: c.price,
    duration: c.duration,
    target: c.target,
    suitableForHtml: c.suitableForHtml,
    requirements: c.requirements,
    exam: c.exam,
    certification: c.certification,
    inclusions: c.inclusions,
    modules: c.modules,
    learningOutcomes: c.learningOutcomes,
    image: c.image,
  }));
---

<CourseCategoryHub
  lang="nl"
  category="VCA"
  seoTitle="VCA Cursus & Examen (VCA Basis, VOL-VCA & VIL-VCU) | Edusafe"
  seoDescription="Haal in 1 dag uw officiële SSVV VCA-certificaat met 10 jaar CDR-registratie. Keuze uit VCA Basis, VOL-VCA, VIL-VCU en losse CBT VCA-examens in Den Haag of Incompany."
  breadcrumbLabel="VCA Opleidingen"
  heroTitle="VCA Cursus & Officieel CBT-Examen"
  heroSubtitle="Behaal in één dag uw SSVV-erkende VCA Basis, VOL-VCA of VIL-VCU diploma, inclusief directe registratie in het Centraal Diploma Register (CDR)."
  heroImage="https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&q=80&w=1600"
  heroBullets={[
    'Cursus + examen op 1 dag',
    'Officieel SSVV CBT-examen',
    '10 jaar geldig in CDR',
    'Den Haag of Incompany',
  ]}
  primaryCtaUrl="/persoonlijk-advies?category=VCA"
  courses={vcaCourses}
  coursesHeading="Alle VCA-opleidingen & examens"
  faqTitle="VCA Certificering"
  advisorText="Twijfelt u tussen VCA Basis en VOL-VCA?"
/>
