---
import '../styles/global.css';
import SeoHeader from '../components/SeoHeader.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ContactDrawer from '../components/ContactDrawer.astro';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
	title?: string;
	description?: string;
}

const lang = getLangFromUrl(Astro.url);
const pathname = Astro.url.pathname.replace(/\/$/, '');
const isHomePage = pathname === '' || pathname === '/en';
const { title, description } = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		{isHomePage && (
			<link rel="preload" as="image" href="/assets/images/hero_poster.webp" type="image/webp" fetchpriority="high" />
		)}
		<SeoHeader title={title} description={description} />
		
		<!-- JSON-LD Organization Schema for Google and AI Crawlers -->
		<script type="application/ld+json" is:inline>
			{
			  "@context": "https://schema.org",
			  "@type": "EducationalOrganization",
			  "name": "Edusafe",
			  "url": "https://edusafe.nl",
			  "logo": "https://edusafe.nl/favicon.svg",
			  "description": "Expert in bedrijfsveiligheid, BHV, EHBO en VCA trainingen, NEN-keuringen en RI&E.",
			  "areaServed": "NL",
			  "knowsAbout": [
				"BHV cursus",
				"EHBO en Reanimatie",
				"VCA Basis en VCA-VOL",
				"Heftruck en Reachtruck",
				"Offshore BOSIET en OPITO",
				"NEN 3140 en Scope keuringen",
				"RI&E en Vluchtwegplattegronden"
			  ],
			  "address": {
				"@type": "PostalAddress",
				"streetAddress": "Oude Middenweg 241A",
				"addressLocality": "Den Haag",
				"postalCode": "2491 AH",
				"addressCountry": "NL"
			  },
			  "contactPoint": {
				"@type": "ContactPoint",
				"telephone": "+31-70-4447795",
				"contactType": "customer service",
				"email": "info@edusafe.nl",
				"availableLanguage": ["nl", "en"]
			  }
			}
		</script>
		
		<!-- Google Fonts (Plus Jakarta Sans & Outfit) -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Outfit:wght@100..900&display=swap" rel="stylesheet">
		
		<!-- Font Awesome 6 for professional icons -->
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
	</head>
	<body class="bg-brand-cream text-brand-dark font-sans antialiased overflow-x-clip min-h-screen flex flex-col">
		<Navbar />
		<div class="flex-grow flex flex-col">
			<slot />
		</div>
		<Footer />
		<ContactDrawer />

		<script>
			// Scroll animation observer
			const observeRevealElements = () => {
				const observer = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							entry.target.classList.add('active');
						}
					});
				}, {
					threshold: 0.05,
					rootMargin: "0px 0px -40px 0px"
				});

				document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
			};

			// Run on initial load
			observeRevealElements();

			// Handle Astro page transitions or content updates if any
			document.addEventListener('astro:after-swap', observeRevealElements);
		</script>
	</body>
</html>
