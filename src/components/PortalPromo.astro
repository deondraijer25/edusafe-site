---
---
<section id="portaal" class="w-full bg-white py-16 md:py-24 relative reveal">
  <div class="max-w-[1280px] mx-auto px-6 relative">
    
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight text-brand-secondary leading-tight mb-4 max-w-4xl mx-auto">
        Maak kennis met ons nieuwe <span class="relative inline-block text-white px-5 py-2 mx-1 transform -rotate-1"><span class="absolute inset-0 bg-brand-accent rounded-2xl z-0"></span><span class="relative z-10">e-learning portaal</span></span>
      </h2>
      <p class="text-brand-dark/70 text-sm md:text-base max-w-2xl mx-auto mt-3 font-normal">
        Snel je theoriecertificaat halen als zelfstandige, of de veiligheid van al je medewerkers beheren vanaf één centraal dashboard.
      </p>
    </div>

    <!-- Symmetrical 2-Column Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 max-w-[960px] mx-auto items-stretch reveal-stagger">
      
      <!-- Card 1: ZZP & Particulieren (Lichte kaart) -->
      <div class="bg-white rounded-2xl border border-brand-dark/10 p-6 sm:p-8 flex flex-col justify-between shadow-sm hover:shadow-md transition-all duration-300 group">
        <div>
          <!-- Photo Banner -->
          <div class="relative w-full h-40 sm:h-44 rounded-xl overflow-hidden mb-6 bg-brand-cream border border-brand-dark/5">
            <img 
              src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&q=80&w=600" 
              alt="E-learning ZZP & Particulieren" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
            />
          </div>

          <h3 class="font-display text-xl sm:text-2xl font-semibold text-brand-secondary mb-2">
            Voor ZZP & Particulieren
          </h3>
          
          <p class="text-brand-dark/70 text-xs sm:text-sm leading-relaxed mb-6 font-normal min-h-[40px]">
            Start direct online met je theorie en plan je praktijkdag wanneer het jou uitkomt.
          </p>

          <!-- 4 USPs -->
          <ul class="space-y-3.5 mb-6 text-xs sm:text-sm text-brand-dark/80">
            <li class="flex items-start gap-2.5">
              <i class="fa-solid fa-check text-brand-primary text-xs mt-1 shrink-0"></i>
              <span><strong>Flexibel Leren:</strong> Studeer in je eigen tempo op mobiel of tablet.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <i class="fa-solid fa-check text-brand-primary text-xs mt-1 shrink-0"></i>
              <span><strong>Start Direct:</strong> Geen wachttijden, direct beginnen met leren.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <i class="fa-solid fa-check text-brand-primary text-xs mt-1 shrink-0"></i>
              <span><strong>Scherpe Tarieven:</strong> Voordelig en officieel gecertificeerd.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <i class="fa-solid fa-check text-brand-primary text-xs mt-1 shrink-0"></i>
              <span><strong>100% Slagingsgarantie:</strong> Oefen gratis examenvragen tot je slaagt.</span>
            </li>
          </ul>
        </div>

        <!-- Button -->
        <a href="/e-learning" class="font-display font-semibold text-sm py-3.5 px-6 rounded-xl text-center bg-brand-primary text-white hover:bg-brand-primary-hover transition-all duration-300 shadow-sm block w-full mt-4">
          Direct Online Starten
        </a>
      </div>

      <!-- Card 2: Bedrijven & Werkgevers (Donkere kaart) -->
      <div class="bg-brand-secondary text-white rounded-2xl border border-brand-secondary/5 p-6 sm:p-8 flex flex-col justify-between shadow-lg hover:shadow-xl transition-all duration-300 group">
        <div>
          <!-- Photo Banner -->
          <div class="relative w-full h-40 sm:h-44 rounded-xl overflow-hidden mb-6 bg-brand-secondary-hover border border-white/10">
            <img 
              src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&q=80&w=600" 
              alt="MKB Werkgeversportaal" 
              class="w-full h-full object-cover opacity-85 group-hover:scale-105 transition-transform duration-500" 
            />
          </div>

          <h3 class="font-display text-xl sm:text-2xl font-semibold text-white mb-2">
            Voor Bedrijven & Werkgevers
          </h3>

          <p class="text-white/80 text-xs sm:text-sm leading-relaxed mb-6 font-normal min-h-[40px]">
            Beheer certificeringen, uitnodigingen en herhalingen voor personeel op één dashboard.
          </p>

          <!-- 4 USPs -->
          <ul class="space-y-3.5 mb-6 text-xs sm:text-sm text-white/90">
            <li class="flex items-start gap-2.5">
              <i class="fa-solid fa-check text-brand-accent text-xs mt-1 shrink-0"></i>
              <span><strong>Centraal Dashboard:</strong> Real-time inzicht in veiligheid en status.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <i class="fa-solid fa-check text-brand-accent text-xs mt-1 shrink-0"></i>
              <span><strong>Automatisch Uitnodigen:</strong> Medewerkers ontvangen direct lesstoegang.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <i class="fa-solid fa-check text-brand-accent text-xs mt-1 shrink-0"></i>
              <span><strong>Digitaal Archief:</strong> Alle pasjes en certificaten direct downloadbaar.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <i class="fa-solid fa-check text-brand-accent text-xs mt-1 shrink-0"></i>
              <span><strong>Aantrekkelijk Voordeel:</strong> Staffelkorting voor groepen vanaf 5 personen.</span>
            </li>
          </ul>
        </div>

        <!-- Button -->
        <button type="button" data-open-contact-drawer class="font-display font-semibold text-sm py-3.5 px-6 rounded-xl text-center bg-brand-accent text-white hover:bg-brand-accent-hover transition-all duration-300 shadow-md shadow-brand-accent/20 block cursor-pointer w-full mt-4">
          Ontdek het Werkgeversportaal
        </button>
      </div>

    </div>

  </div>
</section>
