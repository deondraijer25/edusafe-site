---
<section id="cursussen" class="w-full bg-brand-cream py-20 md:py-28 relative reveal">
  <div class="max-w-[1280px] mx-auto px-6">
    
    <!-- Section Header -->
    <div class="mb-12">
      <div class="max-w-2xl">
        <!-- Sub-tagline -->
        <div class="inline-flex items-center gap-1.5 text-brand-accent font-display font-black text-sm uppercase tracking-wider mb-3">
          <svg class="w-4.5 h-4.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/>
          </svg>
          Ons Opleidings- & Dienstenaanbod
        </div>
        <!-- Title -->
        <h2 class="font-display text-4xl md:text-5xl font-black tracking-tight text-brand-secondary">
          Trainingen, Diensten & Producten
        </h2>
        <!-- Subtext -->
        <p class="text-brand-dark/70 text-base md:text-lg mt-3">
          Verhoog de veiligheid op de werkvloer en voldoe aan alle wettelijke eisen. Bekijk ons complete aanbod.
        </p>
      </div>
    </div>

    <!-- Category Tabs & Slider Controls -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 mb-10 border-b border-brand-dark/5 pb-6">
      <!-- Tabs Switcher -->
      <div class="flex flex-wrap gap-3">
        <button 
          id="tab-opleidingen" 
          class="font-display font-black text-sm px-6 py-3.5 rounded-2xl bg-brand-secondary text-white shadow-md transition-all duration-300 cursor-pointer"
        >
          <i class="fa-solid fa-graduation-cap mr-2"></i>Cursussen
        </button>
        <button 
          id="tab-diensten" 
          class="font-display font-black text-sm px-6 py-3.5 rounded-2xl bg-white text-brand-secondary hover:bg-brand-cream border border-brand-dark/10 transition-all duration-300 shadow-sm cursor-pointer"
        >
          <i class="fa-solid fa-briefcase mr-2"></i>Diensten
        </button>
      </div>

      <!-- Arrow Buttons for Slider -->
      <div class="flex gap-4">
        <button id="slider-prev" class="w-12 h-12 rounded-full border border-brand-dark/10 flex items-center justify-center text-brand-secondary hover:bg-brand-primary hover:text-white hover:border-brand-primary transition-all duration-300 shadow-sm cursor-pointer" aria-label="Vorige">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path></svg>
        </button>
        <button id="slider-next" class="w-12 h-12 rounded-full bg-brand-secondary text-white flex items-center justify-center hover:bg-brand-primary transition-all duration-300 shadow-md cursor-pointer" aria-label="Volgende">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
        </button>
      </div>
    </div>

    <!-- Cards Slider Container -->
    <div id="course-slider" class="flex gap-5 overflow-x-auto pb-8 snap-x snap-mandatory scroll-smooth hide-scrollbar -mx-6 px-6 lg:mx-0 lg:px-0 reveal-stagger">
      
      {courses.map((course) => (
        <div 
          data-type={course.type}
          class={`course-category-card min-w-[260px] md:min-w-[300px] flex-1 max-w-[340px] snap-start rounded-[24px] p-6 md:p-8 border transition-all duration-500 flex flex-col justify-between group ${
            course.isHighlighted 
              ? 'bg-brand-secondary text-white border-brand-secondary/5 shadow-[0_10px_30px_rgba(11,39,33,0.03)] hover:shadow-[0_15px_40px_rgba(11,39,33,0.08)] hover:scale-[1.01]' 
              : 'bg-white text-brand-dark border-brand-dark/10 hover:border-brand-primary/25 shadow-[0_10px_30px_rgba(0,0,0,0.015)] hover:shadow-[0_15px_40px_rgba(0,0,0,0.04)] hover:scale-[1.01]'
          }`}
        >
          <div>
            <!-- Top header in card (icon and tag) -->
            <div class="flex items-center justify-between mb-6">
              <div class={`w-12 h-12 rounded-2xl flex items-center justify-center transition-transform group-hover:scale-105 duration-300 ${
                course.isHighlighted ? 'bg-brand-primary text-brand-secondary' : 'bg-brand-cream text-brand-primary'
              }`}>
                <Fragment set:html={course.icon} />
              </div>
              <span class={`text-[10px] font-bold px-2.5 py-0.5 rounded-full border ${
                course.isHighlighted ? 'border-brand-primary/30 text-brand-primary bg-brand-primary/10' : 'border-brand-dark/10 text-brand-dark/50'
              }`}>
                {course.tag}
              </span>
            </div>

            <!-- Course Title -->
            <h3 class={`font-display text-xl font-black mb-3 tracking-tight leading-snug ${
              course.isHighlighted ? 'underline decoration-brand-primary decoration-4 underline-offset-8' : ''
            }`}>
              {course.title}
            </h3>

            <!-- Course Description -->
            <p class={`text-sm leading-relaxed mb-6 ${
              course.isHighlighted ? 'text-white/80' : 'text-brand-dark/70'
            }`}>
              {course.description}
            </p>
          </div>

          <!-- Bottom Button -->
          <a href={course.link} class={`font-display font-black text-xs py-2.5 px-4 rounded-xl text-center transition-all duration-300 flex items-center justify-center gap-2 shadow-sm hover:shadow-md ${
            course.isHighlighted 
              ? 'bg-brand-accent text-white hover:bg-brand-accent-hover hover:-translate-y-0.5' 
              : 'bg-brand-primary text-white hover:bg-brand-secondary hover:-translate-y-0.5'
          }`}>
            {course.type === 'opleiding' ? 'Informatie & Boeken' : 'Meer Informatie'}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>
        </div>
      ))}

    </div>

  </div>
</section>

<script>
  function initCourseSlider() {
    const slider = document.getElementById('course-slider');
    const prevBtn = document.getElementById('slider-prev');
    const nextBtn = document.getElementById('slider-next');

    // Tab buttons
    const tabOpleidingen = document.getElementById('tab-opleidingen');
    const tabDiensten = document.getElementById('tab-diensten');
    
    // Cards
    const cards = document.querySelectorAll('.course-category-card');

    if (slider && prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => {
        const visibleCards = slider.querySelectorAll('.course-category-card:not(.hidden)');
        const cardWidth = visibleCards[0]?.clientWidth || 300;
        slider.scrollBy({ left: -(cardWidth + 20), behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        const visibleCards = slider.querySelectorAll('.course-category-card:not(.hidden)');
        const cardWidth = visibleCards[0]?.clientWidth || 300;
        slider.scrollBy({ left: cardWidth + 20, behavior: 'smooth' });
      });
    }

    if (tabOpleidingen && tabDiensten) {
      const setTab = (activeTab: HTMLElement, inactiveTab: HTMLElement, filterType: string) => {
        // Update tab styles
        activeTab.classList.remove('bg-white', 'text-brand-secondary', 'border', 'border-brand-dark/10');
        activeTab.classList.add('bg-brand-secondary', 'text-white', 'shadow-md');
        
        inactiveTab.classList.remove('bg-brand-secondary', 'text-white', 'shadow-md');
        inactiveTab.classList.add('bg-white', 'text-brand-secondary', 'border', 'border-brand-dark/10', 'hover:bg-brand-cream');

        // Filter cards with animations
        cards.forEach((card) => {
          const htmlCard = card as HTMLElement;
          if (htmlCard.getAttribute('data-type') === filterType) {
            htmlCard.classList.remove('hidden');
            htmlCard.style.opacity = '0';
            htmlCard.style.transform = 'translateY(15px)';
            // Fade-in animation
            setTimeout(() => {
              htmlCard.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
              htmlCard.style.opacity = '1';
              htmlCard.style.transform = 'translateY(0)';
            }, 50);
          } else {
            htmlCard.classList.add('hidden');
          }
        });

        // Scroll back to beginning
        if (slider) slider.scrollLeft = 0;
      };

      tabOpleidingen.addEventListener('click', () => setTab(tabOpleidingen, tabDiensten, 'opleiding'));
      tabDiensten.addEventListener('click', () => setTab(tabDiensten, tabOpleidingen, 'dienst'));

      // Initial filter state
      setTab(tabOpleidingen, tabDiensten, 'opleiding');
    }
  }

  initCourseSlider();
  document.addEventListener('astro:page-load', initCourseSlider);
</script>
