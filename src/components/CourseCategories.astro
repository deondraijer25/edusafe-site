---
<section id="cursussen" class="w-full bg-brand-cream py-14 md:py-20 relative reveal">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6">
    
    <!-- Section Header & Tabs Row -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-5 mb-8">
      <div>
        <div class="section-eyebrow text-brand-primary mb-2">
          <i class="fa-solid fa-layer-group"></i>
          <span>{isEn ? "Complete Overview" : "Compleet Aanbod"}</span>
        </div>
        <h2 class="heading-section text-brand-secondary">
          {isEn ? "Training, Services & Products" : "Trainingen, Diensten & Producten"}
        </h2>
        <p class="text-lead text-brand-dark/70 mt-2">
          {isEn
            ? "Select a category to view courses, dates, or safety services."
            : "Kies een categorie voor alle opleidingen, startdata of veiligheidsdiensten."}
        </p>
      </div>

      <!-- Compact Tabs Switcher + Direct Schedule Link -->
      <div class="flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-2.5 sm:gap-3 w-full md:w-auto shrink-0">
        <div class="grid grid-cols-2 sm:inline-flex p-1 rounded-xl bg-white border border-brand-dark/10 shadow-xs w-full sm:w-auto">
          <button 
            id="tab-opleidingen" 
            type="button"
            class="font-display font-semibold text-xs sm:text-sm px-4 py-2.5 sm:py-2 min-h-[42px] sm:min-h-0 rounded-lg bg-brand-accent text-white shadow-xs transition-all duration-200 cursor-pointer flex items-center justify-center gap-2"
          >
            <i class="fa-solid fa-graduation-cap text-xs"></i>
            <span>{isEn ? "Courses" : "Cursussen"}</span>
          </button>
          <button 
            id="tab-diensten" 
            type="button"
            class="font-display font-semibold text-xs sm:text-sm px-4 py-2.5 sm:py-2 min-h-[42px] sm:min-h-0 rounded-lg text-brand-secondary hover:bg-brand-cream/70 transition-all duration-200 cursor-pointer flex items-center justify-center gap-2"
          >
            <i class="fa-solid fa-briefcase text-xs"></i>
            <span>{isEn ? "Services" : "Diensten"}</span>
          </button>
        </div>

        <a 
          href={allDatesUrl}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 font-display font-semibold text-xs sm:text-sm bg-brand-accent hover:bg-brand-accent-hover text-white px-4 py-2.5 min-h-[44px] sm:min-h-0 rounded-xl shadow-xs transition-all duration-200"
        >
          <span>{isEn ? "All course dates" : "Alle cursusdata"}</span>
          <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      </div>
    </div>

    <!-- 3x2 Compact Tiles Grid (Desktop: 3 cols x 2 rows, Tablet: 2 cols, Mobile: 1 col) -->
    <div id="course-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      
      {courses.map((course) => (
        <a 
          href={course.link}
          data-type={course.type}
          class={`course-category-card rounded-2xl p-5 border transition-all duration-200 flex items-start justify-between gap-4 group ${
            course.isHighlighted 
              ? 'bg-brand-secondary text-white border-brand-secondary shadow-sm hover:-translate-y-0.5' 
              : 'bg-white text-brand-dark border-brand-dark/8 hover:border-brand-primary/35 shadow-xs hover:shadow-sm hover:-translate-y-0.5'
          }`}
        >
          <div class="flex items-start gap-4">
            <!-- Left: Icon -->
            <div class={`w-11 h-11 rounded-xl flex items-center justify-center transition-transform group-hover:scale-105 duration-200 shrink-0 mt-0.5 ${
              course.isHighlighted ? 'bg-brand-primary text-white' : 'bg-brand-cream text-brand-primary'
            }`}>
              <Fragment set:html={course.icon} />
            </div>

            <!-- Middle: Title + Short 1-line Description -->
            <div>
              <h3 class={`heading-tile mb-1 ${
                course.isHighlighted ? 'text-white' : 'text-brand-secondary group-hover:text-brand-primary transition-colors'
              }`}>
                {course.title}
              </h3>
              <p class={`text-card ${
                course.isHighlighted ? 'text-white/75' : 'text-brand-dark/70'
              }`}>
                {course.description}
              </p>
            </div>
          </div>

          <!-- Right: Subtle Arrow -->
          <i class={`fa-solid fa-arrow-right text-xs mt-1.5 shrink-0 transition-transform duration-200 group-hover:translate-x-1 ${
            course.isHighlighted ? 'text-brand-accent' : 'text-brand-dark/30 group-hover:text-brand-primary'
          }`}></i>
        </a>
      ))}

    </div>

  </div>
</section>

<script>
  function initCourseTabs() {
    const tabOpleidingen = document.getElementById('tab-opleidingen');
    const tabDiensten = document.getElementById('tab-diensten');
    const cards = document.querySelectorAll('.course-category-card');

    if (tabOpleidingen && tabDiensten) {
      const setTab = (activeTab: HTMLElement, inactiveTab: HTMLElement, filterType: string) => {
        activeTab.classList.remove('text-brand-secondary', 'hover:bg-brand-cream/70');
        activeTab.classList.add('bg-brand-accent', 'text-white', 'shadow-xs');
        
        inactiveTab.classList.remove('bg-brand-accent', 'text-white', 'shadow-xs');
        inactiveTab.classList.add('text-brand-secondary', 'hover:bg-brand-cream/70');

        cards.forEach((card) => {
          const htmlCard = card as HTMLElement;
          if (htmlCard.getAttribute('data-type') === filterType) {
            htmlCard.classList.remove('hidden');
          } else {
            htmlCard.classList.add('hidden');
          }
        });
      };

      tabOpleidingen.addEventListener('click', () => setTab(tabOpleidingen, tabDiensten, 'opleiding'));
      tabDiensten.addEventListener('click', () => setTab(tabDiensten, tabOpleidingen, 'dienst'));

      setTab(tabOpleidingen, tabDiensten, 'opleiding');
    }
  }

  initCourseTabs();
  document.addEventListener('astro:page-load', initCourseTabs);
</script>
