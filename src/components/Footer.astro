---
---
<footer class="w-full bg-brand-secondary text-white pt-16 pb-8 border-t border-brand-cream/5 relative overflow-hidden">
  
  <!-- Subtle Grid Pattern in background -->
  <div class="absolute inset-0 bg-[radial-gradient(#ffffff03_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>

  <div class="max-w-[1280px] mx-auto px-6 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 mb-12">
      
      <!-- Column 1: Brand & Contact Info -->
      <div class="lg:col-span-4">
        <!-- Logo -->
        <a href="/" class="group inline-block mb-6">
          <img 
            class="h-12 w-auto object-contain block transform group-hover:scale-[1.02] transition-transform duration-300 brightness-0 invert" 
            src="/assets/images/edusafe_logo.png" 
            alt="Edusafe Logo" 
            height="48"
            width="108"
          />
        </a>
        
        <p class="text-white/70 text-sm leading-relaxed mb-6 max-w-sm">
          Edusafe is uw specialist in bedrijfsveiligheid en opleidingen. Wij zorgen voor gecertificeerde en praktijkgerichte trainingen door heel Nederland.
        </p>

        <!-- Direct Contact Details -->
        <div class="flex flex-col gap-3 text-sm text-white/80">
          <a href="tel:0704447795" class="flex items-center gap-3 hover:text-brand-primary transition-colors">
            <svg class="w-4 h-4 text-brand-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            070 - 444 77 95
          </a>
          <a href="mailto:info@edusafe.nl" class="flex items-center gap-3 hover:text-brand-primary transition-colors">
            <svg class="w-4 h-4 text-brand-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            info@edusafe.nl
          </a>
        </div>
      </div>

      <!-- Column 2: Navigation Links -->
      <div class="lg:col-span-2">
        <h4 class="font-display font-semibold text-white text-[15px] uppercase tracking-wider mb-6">Navigatie</h4>
        <nav class="flex flex-col gap-3 text-sm text-white/70">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <a href="/cursusdata" class="hover:text-white transition-colors">Cursusdata</a>
          <a href="/e-learning" class="hover:text-white transition-colors">E-learning</a>
          <a href="/incompany-training" class="hover:text-white transition-colors">Incompany</a>
          <a href="#contact" class="hover:text-white transition-colors">Contact</a>
        </nav>
      </div>

      <!-- Column 3: Cursussen -->
      <div class="lg:col-span-3">
        <h4 class="font-display font-semibold text-white text-[15px] uppercase tracking-wider mb-6">Opleidingen</h4>
        <nav class="flex flex-col gap-3 text-sm text-white/70">
          <a href="/bhv-cursus" class="hover:text-white transition-colors">BHV Basis & Herhaling</a>
          <a href="/ehbo-cursus" class="hover:text-white transition-colors">EHBO (Oranje Kruis)</a>
          <a href="/reanimatie-aed-cursus" class="hover:text-white transition-colors">Reanimatie & AED (NRR)</a>
          <a href="/vca-cursus" class="hover:text-white transition-colors">VCA Basis & VOL</a>
          <a href="/ontruiming-cursus" class="hover:text-white transition-colors">Brand & Ontruiming</a>
          <a href="/heftruck-cursus" class="hover:text-white transition-colors">Heftruck & Reachtruck</a>
          <a href="/ehak-cursus" class="hover:text-white transition-colors">Eerste Hulp aan Kinderen</a>
          <a href="/offshore-cursus" class="hover:text-white transition-colors">Offshore (OPITO)</a>
        </nav>
      </div>

      <!-- Column 4: Contact details & Hours -->
      <div class="lg:col-span-3">
        <h4 class="font-display font-semibold text-white text-[15px] uppercase tracking-wider mb-6">Contact & Locatie</h4>
        <p class="text-white/70 text-sm leading-relaxed mb-4">
          Oude Middenweg 241A<br />
          2491 AH Den Haag
        </p>
        <div class="text-xs text-white/50 leading-relaxed border-t border-white/10 pt-4">
          <strong class="text-white/70 block mb-1">Openingstijden:</strong>
          Maandag t/m vrijdag:<br />
          08:30 - 17:00 uur
        </div>
      </div>

    </div>

    <!-- Bottom Line (Copyright & Legal) -->
    <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-white/50">
      <div>
        &copy; {new Date().getFullYear()} Edusafe. Alle rechten voorbehouden.
      </div>
      <div class="flex gap-6">
        <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-white transition-colors">Algemene Voorwaarden</a>
        <a href="#" class="hover:text-white transition-colors">Cookies</a>
      </div>
    </div>

  </div>
</footer>
