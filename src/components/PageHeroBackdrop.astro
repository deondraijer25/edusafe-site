---
interface Props {
  image: string;
  alt: string;
  objectPosition?: string;
}

const { image, alt, objectPosition = 'object-center' } = Astro.props;

// Upgrade Unsplash w=600/800/1200 URLs to crisp w=1600 for hero display
const hiResImage = image.includes('images.unsplash.com')
  ? image.replace(/([?&])w=\d+/, '$1w=1600')
  : image;
---

<div class="absolute inset-0 z-0 overflow-hidden pointer-events-none select-none bg-brand-primary">
  <!-- Right-positioned full-opacity photo so the subject sits clearly on the right half -->
  <img
    src={hiResImage}
    alt={alt}
    loading="eager"
    decoding="async"
    class={`absolute inset-y-0 right-0 w-full md:w-[65%] h-full object-cover ${objectPosition}`}
  />

  <!-- Mobile overlay: ensures strong white-text readability while keeping the right image subtly visible -->
  <div
    class="absolute inset-0 md:hidden"
    style="background: linear-gradient(90deg, #0C4EA2 0%, rgba(12, 78, 162, 0.93) 56%, rgba(12, 78, 162, 0.68) 100%);"
  ></div>

  <!-- Tablet & Desktop overlay: Edusafe Brand Blue (#0C4EA2) left-to-right gradient matching Homepage Hero -->
  <div
    class="hidden md:block absolute inset-0"
    style="background: linear-gradient(90deg, #0C4EA2 0%, #0C4EA2 38%, rgba(12, 78, 162, 0.94) 48%, rgba(12, 78, 162, 0.70) 60%, rgba(12, 78, 162, 0.28) 78%, rgba(12, 78, 162, 0.06) 100%);"
  ></div>
</div>
