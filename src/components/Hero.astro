<style>
  .partner-marquee {
    display: flex;
    overflow: hidden;
    user-select: none;
    gap: 2.5rem;
  }
  .marquee-content {
    animation: scroll-partner-marquee 30s linear infinite;
  }
  .partner-marquee:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes scroll-partner-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-100% - 2.5rem));
    }
  }
</style>

<script>
  function initHeroVideo() {
    const video = document.getElementById('hero-video') as HTMLVideoElement | null;
    if (video) {
      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;
      
      const playPromise = video.play();
      if (playPromise !== undefined) {
        playPromise.catch(() => {
          const tryPlay = () => {
            video.play().catch(() => {});
            ['click', 'touchstart', 'scroll', 'mousemove'].forEach(ev => {
              window.removeEventListener(ev, tryPlay);
            });
          };
          ['click', 'touchstart', 'scroll', 'mousemove'].forEach(ev => {
            window.addEventListener(ev, tryPlay, { once: true, passive: true });
          });
        });
      }
    }
  }

  function initHeroCounters() {
    const intCounters = document.querySelectorAll<HTMLElement>('[data-counter-target]');
    const decCounters = document.querySelectorAll<HTMLElement>('[data-counter-decimal]');
    if (!intCounters.length && !decCounters.length) return;

    const runAnimation = () => {
      const duration = 1800;
      const startTime = performance.now();

      const formatInt = (val: number, sep: string | null) => {
        if (!sep || val < 1000) return String(val);
        return String(val).replace(/\B(?=(\d{3})+(?!\d))/g, sep);
      };

      const step = (now: number) => {
        const elapsed = Math.min((now - startTime) / duration, 1);
        const eased = 1 - Math.pow(1 - elapsed, 3); // cubic ease-out

        intCounters.forEach((el) => {
          const target = parseInt(el.getAttribute('data-counter-target') || '0', 10);
          const sep = el.getAttribute('data-counter-sep');
          const current = Math.round(target * eased);
          el.textContent = formatInt(current, sep);
        });

        decCounters.forEach((el) => {
          const target = parseFloat(el.getAttribute('data-counter-decimal') || '0');
          const current = (target * eased).toFixed(1);
          el.textContent = current;
        });

        if (elapsed < 1) {
          requestAnimationFrame(step);
        }
      };

      requestAnimationFrame(step);
    };

    runAnimation();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initHeroVideo();
      initHeroCounters();
    });
  } else {
    initHeroVideo();
    initHeroCounters();
  }
</script>
