---
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const isEn = lang === 'en';
---
<section class="w-full bg-brand-cream pt-6 sm:pt-8 md:pt-10 pb-12 sm:pb-16 overflow-hidden">
  
  <!-- Outer Container for Floating Hero Frame -->
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6">
    
    <!-- Floating Framed Hero Card (Zwevend Kader met volledige video achtergrond) -->
    <div class="relative rounded-[28px] sm:rounded-[36px] lg:rounded-[40px] overflow-hidden min-h-[560px] sm:min-h-[620px] lg:min-h-[660px] flex flex-col justify-between p-6 sm:p-10 md:p-14 lg:p-16 border border-brand-dark/10 shadow-[0_25px_70px_-15px_rgba(14,34,61,0.25)] ring-1 ring-white/20 bg-brand-secondary">
      
      <!-- Video Background (High quality, local loop, fast preload) -->
      <video 
        id="hero-video"
        autoplay 
        loop 
        muted 
        playsinline 
        webkit-playsinline
        preload="auto"
        disablepictureinpicture
        disableremoteplayback
        class="absolute inset-0 w-full h-full object-cover z-0 filter brightness-[0.9] contrast-[1.02] pointer-events-none"
      >
        <source src="/assets/videos/hero_video.mp4" type="video/mp4" />
      </video>

      <!-- Multi-Layered Modern Dark Gradient Overlay for Maximum Legibility & High-End B2B Look -->
      <div class="absolute inset-0 bg-gradient-to-r from-brand-secondary/90 via-brand-secondary/75 to-brand-secondary/35 z-10 pointer-events-none"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-brand-secondary/80 via-transparent to-black/20 z-10 pointer-events-none"></div>

      <!-- Hero Main Content (relative z-20) -->
      <div class="relative z-20 max-w-[760px] pt-4 sm:pt-6">
        
        <!-- Headline with tilted colored background -->
        <h1 class="font-display text-[34px] sm:text-5xl lg:text-[58px] font-semibold tracking-tight text-white leading-[1.22] mb-6 drop-shadow-sm">
          {isEn ? (
            <>
              Enhance safety across the <span class="relative inline-block text-white px-4 sm:px-5 py-1 sm:py-1.5 mx-1 sm:mx-1.5 my-1 transform -rotate-1 align-baseline"><span class="absolute inset-0 bg-brand-accent rounded-xl sm:rounded-2xl shadow-md z-0"></span><span class="relative z-10 font-semibold">workplace</span></span>
            </>
          ) : (
            <>
              Vergroot de veiligheid op de <span class="relative inline-block text-white px-4 sm:px-5 py-1 sm:py-1.5 mx-1 sm:mx-1.5 my-1 transform -rotate-1 align-baseline"><span class="absolute inset-0 bg-brand-accent rounded-xl sm:rounded-2xl shadow-md z-0"></span><span class="relative z-10 font-semibold">werkvloer</span></span>
            </>
          )}
        </h1>

        <!-- Subtitle -->
        <p class="text-white/85 text-base sm:text-lg lg:text-[19px] leading-relaxed mb-8 sm:mb-10 max-w-[620px] font-normal">
          {isEn 
            ? "Practical Emergency Response (BHV), First Aid and VCA safety training compliant with Dutch Arbowet regulations. Book incompany or at our modern training facilities."
            : "Praktijkgerichte BHV, EHBO en VCA trainingen conform de nieuwste Arbowetgeving. Direct in te plannen incompany of op één van onze opleidingslocaties."}
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center gap-4 sm:gap-5">
          <a 
            href={isEn ? "#courses" : "#cursussen"} 
            class="font-display font-semibold text-[15px] sm:text-base bg-brand-accent hover:bg-brand-accent-hover text-white px-7 sm:px-8 py-3.5 sm:py-4 rounded-xl transition-all duration-300 shadow-[0_10px_25px_rgba(255,107,53,0.35)] hover:-translate-y-0.5 flex items-center gap-2.5 group"
          >
            <span>{isEn ? "Get Started" : "Direct Starten"}</span>
            <i class="fa-solid fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>
          </a>
          
          <button 
            type="button"
            data-open-contact-drawer
            class="font-display font-semibold text-[15px] sm:text-base bg-white/10 hover:bg-white/20 backdrop-blur-md text-white border border-white/25 px-6 sm:px-7 py-3.5 sm:py-4 rounded-xl transition-all duration-300 hover:-translate-y-0.5 flex items-center gap-2.5 cursor-pointer"
          >
            <i class="fa-regular fa-comment-dots text-lg text-white"></i>
            <span>{isEn ? "Request Advice" : "Vraag advies aan"}</span>
          </button>
        </div>

      </div>

      <!-- Bottom Card Trust Bar / Social Proof (relative z-20) -->
      <div class="relative z-20 pt-8 sm:pt-10 border-t border-white/15 mt-8 flex flex-wrap items-center justify-between gap-6">
        
        <!-- Social Proof: Avatars & Counter (1.761+ Cursisten) -->
        <div class="flex items-center gap-4">
          <!-- Avatars Stack -->
          <div class="flex -space-x-3">
            <img class="w-10 h-10 rounded-full border-2 border-brand-secondary object-cover shadow-sm" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=100&h=100" alt="Cursist" width="40" height="40" />
            <img class="w-10 h-10 rounded-full border-2 border-brand-secondary object-cover shadow-sm" src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&q=80&w=100&h=100" alt="Cursist" width="40" height="40" />
            <img class="w-10 h-10 rounded-full border-2 border-brand-secondary object-cover shadow-sm" src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&q=80&w=100&h=100" alt="Cursist" width="40" height="40" />
            <img class="w-10 h-10 rounded-full border-2 border-brand-secondary object-cover shadow-sm" src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&q=80&w=100&h=100" alt="Cursist" width="40" height="40" />
          </div>

          <!-- Text -->
          <div class="flex flex-col">
            <span class="font-display font-semibold text-white text-base sm:text-lg leading-tight">1.761+ Cursisten</span>
            <span class="text-xs sm:text-[13px] text-white/70 font-normal">Gecertificeerd in heel Nederland</span>
          </div>
        </div>

        <!-- Rating & Badges -->
        <div class="flex items-center gap-6 text-white/90">
          <div class="flex items-center gap-2">
            <div class="flex text-amber-400 text-xs">
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
            </div>
            <span class="font-semibold text-xs sm:text-sm text-white">4.9 / 5</span>
            <span class="text-xs text-white/60">(250+ reviews)</span>
          </div>

          <div class="hidden md:flex items-center gap-2 text-xs font-medium text-emerald-300 bg-emerald-950/40 border border-emerald-500/30 px-3 py-1.5 rounded-lg">
            <i class="fa-solid fa-shield-check"></i>
            <span>100% Slagingsgarantie</span>
          </div>
        </div>

      </div>

    </div>

    <!-- Partner & Client Trust Logos Loop Banner (Full color and enlarged) -->
    <div class="pt-12 sm:pt-14 pb-4">
      <div class="flex flex-col lg:flex-row items-center gap-6 lg:gap-8 overflow-hidden">
        
        <!-- Left: Fixed Text Badge -->
        <div class="shrink-0 text-center lg:text-left lg:pr-8 lg:border-r border-brand-dark/10">
          <span class="font-display font-semibold text-xs sm:text-sm text-brand-dark/70 tracking-tight whitespace-nowrap block">
            Vertrouwd door 300+ bedrijven:
          </span>
        </div>

        <!-- Right: Continuous Infinite Marquee Loop in Full Color -->
        <div class="relative w-full overflow-hidden flex-1">
          <div class="partner-marquee flex items-center gap-12 sm:gap-16 whitespace-nowrap">
            
            <!-- Track Part 1 -->
            <div class="flex items-center gap-12 sm:gap-16 shrink-0 marquee-content">
              <div class="h-14 sm:h-16 flex items-center justify-center transition-all duration-300 hover:scale-105">
                <img src="/assets/images/ado-den-haag-160x80.svg" alt="ADO Den Haag" class="h-10 sm:h-12 md:h-13 w-auto object-contain" />
              </div>
              <div class="h-14 sm:h-16 flex items-center justify-center transition-all duration-300 hover:scale-105">
                <img src="/assets/images/cirque-du-soleil-160x80.png" alt="Cirque du Soleil" class="h-10 sm:h-12 md:h-13 w-auto object-contain" />
              </div>
              <div class="h-14 sm:h-16 flex items-center justify-center transition-all duration-300 hover:scale-105">
                <img src="/assets/images/world-forum-160x80.png" alt="World Forum Den Haag" class="h-10 sm:h-12 md:h-13 w-auto object-contain" />
              </div>
              <div class="h-14 sm:h-16 flex items-center justify-center transition-all duration-300 hover:scale-105">
                <img src="/assets/images/ronald-mcdonald-den-haag-160x80.png" alt="Ronald McDonald Huis" class="h-10 sm:h-12 md:h-13 w-auto object-contain" />
              </div>
              <div class="h-14 sm:h-16 flex items-center justify-center transition-all duration-300 hover:scale-105">
                <img src="/assets/images/uithof-160x80.png" alt="De Uithof" class="h-10 sm:h-12 md:h-13 w-auto object-contain" />
              </div>
              <div class="h-14 sm:h-16 flex items-center justify-center transition-all duration-300 hover:scale-105">
                <img src="/assets/images/paard-160x80.svg" alt="PAARD" class="h-10 sm:h-12 md:h-13 w-auto object-contain" />
              </div>
              <div class="h-14 sm:h-16 flex items-center justify-center transition-all duration-300 hover:scale-105">
                <img src="/assets/images/bex-beveiliging-160x80.jpg" alt="Bex Beveiliging" class="h-10 sm:h-12 md:h-13 w-auto object-contain rounded-md shadow-xs" />
              </div>
              <div class="h-14 sm:h-16 flex items-center justify-center transition-all duration-300 hover:scale-105">
                <img src="/assets/images/hofstad-security-160x80.png" alt="Hofstad Security" class="h-10 sm:h-12 md:h-13 w-auto object-contain" />
              </div>
              <div class="h-14 sm:h-16 flex items-center justify-center transition-all duration-300 hover:scale-105">
                <img src="/assets/images/ortec-160x80.jpg" alt="Ortec" class="h-10 sm:h-12 md:h-13 w-auto object-contain rounded-md shadow-xs" />
              </div>
              <div class="h-14 sm:h-16 flex items-center justify-center transition-all duration-300 hover:scale-105">
                <img src="/assets/images/khn-160x80.png" alt="Koninklijke Horeca Nederland" class="h-10 sm:h-12 md:h-13 w-auto object-contain" />
              </div>
              <div class="h-14 sm:h-16 flex items-center justify-center transition-all duration-300 hover:scale-105">
                <img src="/assets/images/de-maas-160x80.png" alt="De Maas" class="h-10 sm:h-12 md:h-13 w-auto object-contain" />
              </div>
            </div>

            <!-- Track Part 2 (Duplicate for smooth continuous marquee) -->
            <div class="flex items-center gap-12 sm:gap-16 shrink-0 marquee-content" aria-hidden="true">
              <div class="h-14 sm:h-16 flex items-center justify-center transition-all duration-300 hover:scale-105">
                <img src="/assets/images/ado-den-haag-160x80.svg" alt="ADO Den Haag" class="h-10 sm:h-12 md:h-13 w-auto object-contain" />
              </div>
              <div class="h-14 sm:h-16 flex items-center justify-center transition-all duration-300 hover:scale-105">
                <img src="/assets/images/cirque-du-soleil-160x80.png" alt="Cirque du Soleil" class="h-10 sm:h-12 md:h-13 w-auto object-contain" />
              </div>
              <div class="h-14 sm:h-16 flex items-center justify-center transition-all duration-300 hover:scale-105">
                <img src="/assets/images/world-forum-160x80.png" alt="World Forum Den Haag" class="h-10 sm:h-12 md:h-13 w-auto object-contain" />
              </div>
              <div class="h-14 sm:h-16 flex items-center justify-center transition-all duration-300 hover:scale-105">
                <img src="/assets/images/ronald-mcdonald-den-haag-160x80.png" alt="Ronald McDonald Huis" class="h-10 sm:h-12 md:h-13 w-auto object-contain" />
              </div>
              <div class="h-14 sm:h-16 flex items-center justify-center transition-all duration-300 hover:scale-105">
                <img src="/assets/images/uithof-160x80.png" alt="De Uithof" class="h-10 sm:h-12 md:h-13 w-auto object-contain" />
              </div>
              <div class="h-14 sm:h-16 flex items-center justify-center transition-all duration-300 hover:scale-105">
                <img src="/assets/images/paard-160x80.svg" alt="PAARD" class="h-10 sm:h-12 md:h-13 w-auto object-contain" />
              </div>
              <div class="h-14 sm:h-16 flex items-center justify-center transition-all duration-300 hover:scale-105">
                <img src="/assets/images/bex-beveiliging-160x80.jpg" alt="Bex Beveiliging" class="h-10 sm:h-12 md:h-13 w-auto object-contain rounded-md shadow-xs" />
              </div>
              <div class="h-14 sm:h-16 flex items-center justify-center transition-all duration-300 hover:scale-105">
                <img src="/assets/images/hofstad-security-160x80.png" alt="Hofstad Security" class="h-10 sm:h-12 md:h-13 w-auto object-contain" />
              </div>
              <div class="h-14 sm:h-16 flex items-center justify-center transition-all duration-300 hover:scale-105">
                <img src="/assets/images/ortec-160x80.jpg" alt="Ortec" class="h-10 sm:h-12 md:h-13 w-auto object-contain rounded-md shadow-xs" />
              </div>
              <div class="h-14 sm:h-16 flex items-center justify-center transition-all duration-300 hover:scale-105">
                <img src="/assets/images/khn-160x80.png" alt="Koninklijke Horeca Nederland" class="h-10 sm:h-12 md:h-13 w-auto object-contain" />
              </div>
              <div class="h-14 sm:h-16 flex items-center justify-center transition-all duration-300 hover:scale-105">
                <img src="/assets/images/de-maas-160x80.png" alt="De Maas" class="h-10 sm:h-12 md:h-13 w-auto object-contain" />
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  .partner-marquee {
    display: flex;
    overflow: hidden;
    user-select: none;
    gap: 2.5rem;
  }
  .marquee-content {
    animation: scroll-partner-marquee 30s linear infinite;
  }
  .partner-marquee:hover .marquee-content {
    animation-play-state: paused;
  }
  @keyframes scroll-partner-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-100% - 2.5rem));
    }
  }
</style>

<script>
  function initHeroVideo() {
    const video = document.getElementById('hero-video') as HTMLVideoElement | null;
    if (video) {
      video.muted = true;
      video.defaultMuted = true;
      video.playsInline = true;
      
      const playPromise = video.play();
      if (playPromise !== undefined) {
        playPromise.catch(() => {
          const tryPlay = () => {
            video.play().catch(() => {});
            ['click', 'touchstart', 'scroll', 'mousemove'].forEach(ev => {
              window.removeEventListener(ev, tryPlay);
            });
          };
          ['click', 'touchstart', 'scroll', 'mousemove'].forEach(ev => {
            window.addEventListener(ev, tryPlay, { once: true, passive: true });
          });
        });
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroVideo);
  } else {
    initHeroVideo();
  }
</script>
