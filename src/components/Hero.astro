---
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const isEn = lang === 'en';
---
<section class="w-full bg-brand-cream pt-6 sm:pt-8 md:pt-10 pb-12 sm:pb-16 overflow-hidden">
  
  <!-- Outer Container for Floating Hero Frame -->
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6">
    
    <!-- Wrapper for Floating Hero Card + Overlapping Corner Badge -->
    <div class="relative">

      <!-- Floating Framed Hero Card (Zwevend Kader met volledige video achtergrond) -->
      <div class="relative rounded-[28px] sm:rounded-[36px] lg:rounded-[40px] overflow-hidden min-h-[560px] sm:min-h-[620px] lg:min-h-[660px] flex flex-col justify-between p-6 sm:p-10 md:p-14 lg:p-16 border border-brand-primary/15 shadow-[0_25px_70px_-15px_rgba(12,78,162,0.28)] ring-1 ring-white/25 bg-brand-primary">
      
      <!-- Video Background (Fast WebP poster + responsive mobile/desktop streams) -->
      <video 
        id="hero-video"
        autoplay 
        loop 
        muted 
        playsinline 
        webkit-playsinline
        preload="metadata"
        poster="/assets/images/hero_poster.webp"
        disablepictureinpicture
        disableremoteplayback
        class="absolute inset-0 w-full h-full object-cover object-center z-0 filter brightness-[0.98] contrast-[1.03] pointer-events-none"
      >
        <source src="/assets/videos/hero_video_mobile.mp4" type="video/mp4" media="(max-width: 767px)" />
        <source src="/assets/videos/hero_video.mp4" type="video/mp4" />
      </video>

      <!-- Mobile High-Contrast Brand Blue Overlay (< md) -->
      <div 
        class="md:hidden absolute inset-0 z-10 pointer-events-none"
        style="background: linear-gradient(165deg, rgba(12, 78, 162, 0.95) 0%, rgba(12, 78, 162, 0.86) 55%, rgba(6, 40, 86, 0.80) 100%);"
      ></div>

      <!-- Pure Edusafe Brand Blue (#0C4EA2) Gradient Overlay (Tablet/Desktop >= md) -->
      <div 
        class="hidden md:block absolute inset-0 z-10 pointer-events-none"
        style="background: linear-gradient(90deg, #0C4EA2 0%, #0C4EA2 36%, rgba(12, 78, 162, 0.86) 56%, rgba(12, 78, 162, 0.38) 78%, rgba(12, 78, 162, 0.08) 100%);"
      ></div>

      <!-- Hero Main Content (relative z-20) -->
      <div class="relative z-20 max-w-[720px] pt-4 sm:pt-6">
        
        <!-- Headline with tilted colored background -->
        <h1 class="heading-hero text-white mb-6 drop-shadow-sm">
          {isEn ? (
            <>
              Together we create a safe <span class="relative inline-block text-white px-4 sm:px-5 py-1 sm:py-1.5 mx-1 sm:mx-1.5 my-1 transform -rotate-1 align-baseline"><span class="absolute inset-0 bg-brand-accent rounded-xl sm:rounded-2xl shadow-md z-0"></span><span class="relative z-10 font-semibold">workplace</span></span>
            </>
          ) : (
            <>
              Samen zorgen we voor een veilige <span class="relative inline-block text-white px-4 sm:px-5 py-1 sm:py-1.5 mx-1 sm:mx-1.5 my-1 transform -rotate-1 align-baseline"><span class="absolute inset-0 bg-brand-accent rounded-xl sm:rounded-2xl shadow-md z-0"></span><span class="relative z-10 font-semibold">werkvloer</span></span>
            </>
          )}
        </h1>

        <!-- Subtitle -->
        <p class="text-lead text-white/90 mb-8 sm:mb-10 max-w-[600px]">
          {isEn 
            ? "Practical BHV, First Aid and VCA training, inspections and safety advice. At our training facility or on-site at your company."
            : "Praktijkgerichte BHV-, EHBO- en VCA-opleidingen, keuringen en veiligheidsadvies. Op onze opleidingslocatie of bij u op het bedrijf."}
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-3 sm:gap-5">
          <a 
            href="#cursussen" 
            class="w-full sm:w-auto btn-hero bg-brand-accent hover:bg-brand-accent-hover text-white shadow-sm hover:-translate-y-0.5 group"
          >
            <span>{isEn ? "Explore our courses" : "Bekijk ons aanbod"}</span>
            <i class="fa-solid fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>
          </a>
          
          <a 
            href={isEn ? "/en/personal-advice" : "/persoonlijk-advies"}
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 font-display font-semibold text-[15px] px-6 sm:px-7 py-3.5 sm:py-4 rounded-xl bg-white/10 sm:bg-transparent backdrop-blur-2xs sm:backdrop-blur-none hover:bg-white/15 text-white border border-white/80 hover:border-white transition-all duration-300 hover:-translate-y-0.5 cursor-pointer"
          >
            <i class="fa-regular fa-comment-dots text-base text-white"></i>
            <span>{isEn ? "Quick personal advice" : "Snel persoonlijk advies"}</span>
          </a>
        </div>

      </div>

      <!-- Bottom Card Trust Bar / Social Proof (Left-aligned & unified counters) -->
      <div class="relative z-20 pt-8 sm:pt-10 border-t border-white/15 mt-8 flex flex-wrap items-center justify-start gap-6 sm:gap-8 lg:gap-10 sm:mr-36 md:mr-44 lg:mr-48">
        
        <!-- Block 1: Avatars & Animated Trainees Counter (2.000+ Cursisten) -->
        <div class="flex items-center gap-4">
          <!-- Avatars Stack -->
          <div class="flex -space-x-3 shrink-0">
            <img class="w-10 h-10 rounded-full border-2 border-brand-primary object-cover shadow-sm" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=100&h=100" alt="Cursist" width="40" height="40" />
            <img class="w-10 h-10 rounded-full border-2 border-brand-primary object-cover shadow-sm" src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&q=80&w=100&h=100" alt="Cursist" width="40" height="40" />
            <img class="w-10 h-10 rounded-full border-2 border-brand-primary object-cover shadow-sm" src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&q=80&w=100&h=100" alt="Cursist" width="40" height="40" />
            <img class="w-10 h-10 rounded-full border-2 border-brand-primary object-cover shadow-sm" src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&q=80&w=100&h=100" alt="Cursist" width="40" height="40" />
          </div>

          <!-- Text (2-line unified hierarchy) -->
          <div class="flex flex-col">
            <span class="font-display font-semibold text-white text-lg sm:text-xl leading-tight tabular-nums">
              <span data-counter-target="2000" data-counter-sep={isEn ? "," : "."}>0</span>+ {isEn ? "Trainees" : "Cursisten"}
            </span>
            <span class="text-xs sm:text-[13px] text-white/75 font-normal">
              {isEn ? "Certified across the Netherlands" : "Gecertificeerd in heel Nederland"}
            </span>
          </div>
        </div>

        <!-- Subtle Vertical Divider -->
        <div class="hidden sm:block h-10 w-px bg-white/15 shrink-0"></div>

        <!-- Block 2: Animated Rating & Reviews Counter (4.9 / 5 & 250+ reviews) -->
        <div class="flex flex-col">
          <div class="flex items-center gap-2">
            <div class="flex text-amber-400 text-xs sm:text-sm gap-0.5">
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
            </div>
            <span class="font-display font-semibold text-white text-lg sm:text-xl leading-tight tabular-nums">
              <span data-counter-decimal="4.9">0.0</span> / 5
            </span>
          </div>
          <span class="text-xs sm:text-[13px] text-white/75 font-normal tabular-nums">
            {isEn ? (
              <>Based on <strong class="text-white font-semibold"><span data-counter-target="250">0</span>+</strong> reviews</>
            ) : (
              <>Op basis van <strong class="text-white font-semibold"><span data-counter-target="250">0</span>+</strong> reviews</>
            )}
          </span>
        </div>

      </div>

      <!-- Round Seal Badge (White & Orange) Neatly Inside Bottom-Right Corner with Breathing Room -->
      <div 
        class="hidden sm:flex absolute bottom-6 right-6 md:bottom-8 md:right-8 lg:bottom-10 lg:right-10 z-30 w-36 h-36 md:w-40 md:h-40 lg:w-44 lg:h-44 rounded-full bg-white shadow-xl border-2 border-brand-accent/25 ring-4 ring-white/15 items-center justify-center select-none group hover:scale-105 transition-transform duration-300"
        aria-label={isEn ? "Practice-oriented certification" : "Praktijkgerichte certificering"}
      >
        <!-- Subtle dashed inner accent ring -->
        <div class="absolute inset-2.5 rounded-full border border-dashed border-brand-accent/40 pointer-events-none"></div>

        <!-- Rotating circular SVG text around the border -->
        <svg class="w-full h-full p-2 animate-[spin_24s_linear_infinite]" viewBox="0 0 120 120">
          <defs>
            <path id="hero-cert-seal-path" d="M 60, 60 m -43, 0 a 43,43 0 1,1 86,0 a 43,43 0 1,1 -86,0" />
          </defs>
          <text class="font-display font-bold uppercase text-[8.3px] tracking-[0.14em] fill-brand-accent">
            <textPath href="#hero-cert-seal-path" startOffset="0%" textLength="264" lengthAdjust="spacing">
              {isEn ? "PRACTICE-ORIENTED CERTIFICATION • EDUSAFE •" : "PRAKTIJKGERICHTE CERTIFICERING • EDUSAFE •"}
            </textPath>
          </text>
        </svg>

        <!-- Orange center core with crisp white shield-check icon -->
        <div class="absolute w-16 h-16 md:w-[72px] md:h-[72px] lg:w-20 lg:h-20 rounded-full bg-brand-accent text-white flex items-center justify-center shadow-sm group-hover:bg-brand-accent-hover transition-colors">
          <svg class="w-8 h-8 md:w-9 md:h-9 lg:w-10 lg:h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            <path d="m9 12 2 2 4-4" />
          </svg>
        </div>
      </div>

      </div>

    </div>

    <!-- Partner & Client Trust Logos Loop Banner (Full color and enlarged) -->
    <div class="pt-12 sm:pt-14 pb-4">
      <div class="flex flex-col lg:flex-row items-center gap-6 lg:gap-8 overflow-hidden">
        
        <!-- Left: Fixed Text Badge -->
        <div class="shrink-0 text-center lg:text-left lg:pr-8 lg:border-r border-brand-dark/10">
