                <img src="/assets/images/ortec-logo.svg" alt="ORTEC" class="h-7 sm:h-8 md:h-9 w-auto object-contain" />
              </div>
              <div class="h-14 sm:h-16 flex items-center justify-center transition-all duration-300 hover:scale-105">
                <img src="/assets/images/khn-logo.svg" alt="Koninklijke Horeca Nederland" class="h-9 sm:h-11 md:h-12 w-auto object-contain" />
              </div>
              <div class="h-14 sm:h-16 flex items-center justify-center transition-all duration-300 hover:scale-105">
                <img src="/assets/images/de-maas-160x80.png" alt="De Maas" class="h-10 sm:h-12 md:h-13 w-auto object-contain" />
