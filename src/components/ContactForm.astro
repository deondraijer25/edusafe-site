---
---
<section id="contact" class="w-full bg-brand-cream py-20 md:py-28 relative overflow-hidden reveal">
  
  <!-- Background scribble -->
  <div class="absolute bottom-[10%] left-[5%] text-brand-accent/20 pointer-events-none select-none hidden lg:block">
    <!-- Arrow/Loop Doodle -->
    <svg class="w-20 h-20" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.5">
      <path d="M10,20 Q50,90 90,20" />
      <path d="M75,20 L90,15 L88,30" />
    </svg>
  </div>

  <div class="max-w-[1280px] mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-stretch reveal-stagger">
      
      <!-- Left Column: Contact info card -->
      <div class="col-span-1 lg:col-span-5 bg-brand-secondary text-white rounded-[32px] p-8 md:p-12 flex flex-col justify-between relative overflow-hidden shadow-2xl border border-brand-cream/5">
        <!-- Background decorative grid -->
        <div class="absolute inset-0 bg-[radial-gradient(#ffffff03_1px,transparent_1px)] [background-size:16px_16px] pointer-events-none"></div>

        <div>
          <!-- Tagline -->
          <div class="inline-flex items-center gap-1.5 text-brand-primary font-display font-semibold text-sm uppercase tracking-wider mb-4">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd" />
            </svg>
            Contact
          </div>

          <h3 class="font-display text-3xl md:text-4xl font-semibold tracking-tight leading-tight mb-6 text-white">
            Laten we samenwerken aan veiligheid
          </h3>
          
          <p class="text-white/70 text-base leading-relaxed mb-8">
            Heeft u vragen over ons trainingsaanbod, wilt u een incompany training boeken of heeft u behoefte aan een offerte op maat? Neem direct contact met ons op. Onze veiligheidsexperts staan voor u klaar.
          </p>
        </div>

        <!-- Details -->
        <div class="flex flex-col gap-6 border-t border-white/10 pt-8 mt-8">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-brand-primary">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <div class="text-xs text-white/50 font-medium uppercase tracking-wider">Bel ons direct</div>
              <a href="tel:0704447795" class="font-display font-semibold text-lg hover:text-brand-primary transition-colors">070 - 444 77 95</a>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-brand-primary">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <div class="text-xs text-white/50 font-medium uppercase tracking-wider">Mail ons</div>
              <a href="mailto:info@edusafe.nl" class="font-display font-semibold text-lg hover:text-brand-primary transition-colors">info@edusafe.nl</a>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Form -->
      <div class="col-span-1 lg:col-span-7 bg-white rounded-[32px] p-8 md:p-12 shadow-xl border border-brand-dark/5 flex flex-col justify-center">
        
        <h4 class="font-display text-2xl font-semibold text-brand-secondary tracking-tight mb-8">
          Offerte of informatie aanvragen
        </h4>

        <form class="flex flex-col gap-6" id="lead-form">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Name -->
            <div class="flex flex-col gap-2">
              <label for="name" class="text-xs font-semibold text-brand-secondary uppercase tracking-wider">Naam *</label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                required 
                class="w-full bg-brand-cream border border-brand-dark/5 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-primary focus:ring-1 focus:ring-brand-primary transition-all"
                placeholder="Uw naam"
              />
            </div>
            <!-- Company -->
            <div class="flex flex-col gap-2">
              <label for="company" class="text-xs font-semibold text-brand-secondary uppercase tracking-wider">Bedrijfsnaam</label>
              <input 
                type="text" 
                id="company" 
                name="company" 
                class="w-full bg-brand-cream border border-brand-dark/5 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-primary focus:ring-1 focus:ring-brand-primary transition-all"
                placeholder="Bedrijf (optioneel)"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Email -->
            <div class="flex flex-col gap-2">
              <label for="email" class="text-xs font-semibold text-brand-secondary uppercase tracking-wider">E-mailadres *</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                class="w-full bg-brand-cream border border-brand-dark/5 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-primary focus:ring-1 focus:ring-brand-primary transition-all"
                placeholder="naam@voorbeeld.nl"
              />
            </div>
            <!-- Phone -->
            <div class="flex flex-col gap-2">
              <label for="phone" class="text-xs font-semibold text-brand-secondary uppercase tracking-wider">Telefoonnummer *</label>
              <input 
                type="tel" 
                id="phone" 
                name="phone" 
                required 
                class="w-full bg-brand-cream border border-brand-dark/5 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-primary focus:ring-1 focus:ring-brand-primary transition-all"
                placeholder="Bijv. 0612345678"
              />
            </div>
          </div>

          <!-- Training Selection -->
          <div class="flex flex-col gap-2">
            <label for="training" class="text-xs font-semibold text-brand-secondary uppercase tracking-wider">Gewenste Training / Dienst</label>
            <select 
              id="training" 
              name="training" 
              class="w-full bg-brand-cream border border-brand-dark/5 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-primary focus:ring-1 focus:ring-brand-primary transition-all cursor-pointer"
            >
              <option value="bhv">Bedrijfshulpverlening (BHV)</option>
              <option value="ehbo">EHBO & Reanimatie / AED</option>
              <option value="vca">VCA Basis / VOL</option>
              <option value="heftruck">Heftruckcertificaat</option>
              <option value="brandveiligheid">Brandveiligheid / RI&E / Blusmiddelen</option>
              <option value="anders">Anders (stel uw vraag hieronder)</option>
            </select>
          </div>

          <!-- Message -->
          <div class="flex flex-col gap-2">
            <label for="message" class="text-xs font-semibold text-brand-secondary uppercase tracking-wider">Bericht / Toelichting</label>
            <textarea 
              id="message" 
              name="message" 
              rows="4" 
              class="w-full bg-brand-cream border border-brand-dark/5 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-primary focus:ring-1 focus:ring-brand-primary transition-all resize-none"
              placeholder="Vertel ons meer over uw wensen..."
            ></textarea>
          </div>

          <!-- Submit button -->
          <button 
            type="submit" 
            class="w-full font-display font-semibold text-base bg-brand-accent hover:bg-brand-accent-hover text-white py-4 rounded-xl transition-all duration-300 shadow-[0_6px_20px_rgba(255,107,53,0.25)] hover:shadow-[0_8px_25px_rgba(255,107,53,0.4)] cursor-pointer text-center"
          >
            Aanvraag Verzenden
          </button>
        </form>

        <!-- Success Message Placeholder -->
        <div id="form-success" class="hidden flex flex-col items-center justify-center text-center p-6 bg-brand-primary/10 border border-brand-primary/20 rounded-2xl mt-4">
          <div class="w-12 h-12 rounded-full bg-brand-primary/20 flex items-center justify-center text-brand-primary mb-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h5 class="font-display font-semibold text-brand-secondary text-lg mb-1">Bedankt voor uw aanvraag!</h5>
          <p class="text-sm text-brand-dark/75">We hebben uw gegevens ontvangen en nemen zo snel mogelijk contact met u op.</p>
        </div>

      </div>

    </div>
  </div>
</section>

<script>
  function initForm() {
    const form = document.getElementById('lead-form') as HTMLFormElement;
    const successMsg = document.getElementById('form-success');

    if (form && successMsg) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        
        // Simuleer een succesvolle verzending voor de demo/marketing website
        form.classList.add('hidden');
        successMsg.classList.remove('hidden');

        // Optioneel: Stuur de data door naar een API of endpoint
        const formData = new FormData(form);
        console.log('Verzonden data:', Object.fromEntries(formData));
      });
    }
  }

  initForm();
  document.addEventListener('astro:page-load', initForm);
</script>
