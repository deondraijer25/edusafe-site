---
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  courseSlug?: string;
}

const { courseSlug } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const isEn = lang === 'en';
const adviceHref = isEn
  ? courseSlug ? `/en/personal-advice?course=${encodeURIComponent(courseSlug)}` : "/en/personal-advice"
  : courseSlug ? `/persoonlijk-advies?course=${encodeURIComponent(courseSlug)}` : "/persoonlijk-advies";
---
<section
  id="contact"
  class="w-full pt-8 sm:pt-12 pb-4 relative z-20 reveal"
  style="background: linear-gradient(to bottom, var(--color-brand-cream) 52%, var(--color-brand-secondary) 52%);"
>
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6">
    <!-- Overlappende Banner met Koffie-foto & Edusafe-oranje Directional Gradient -->
    <div class="relative rounded-3xl overflow-hidden shadow-[0_24px_60px_rgba(6,40,86,0.35)] border border-white/15 min-h-[250px] sm:min-h-[270px] flex items-center">
      
      <!-- Achtergrondfoto: Kopje koffie op houten tafel (rechts uitgelijnd zodat de kop koffie vrij in beeld staat) -->
      <picture class="absolute inset-0 w-full h-full pointer-events-none select-none z-0">
        <source srcset="/assets/images/edusafe_coffee_banner.webp" type="image/webp" />
        <img
          src="/assets/images/edusafe_coffee_banner.jpg"
          alt={isEn ? "Cup of coffee ready for personal safety advice" : "Kopje koffie staat klaar voor persoonlijk advies"}
          class="w-full h-full object-cover object-[78%_72%]"
          loading="lazy"
          decoding="async"
        />
      </picture>

      <!-- Mobiele Contrast Gradient (< md): zorgt dat witte tekst ook rechts goed leesbaar blijft voor het lichte raam -->
      <div
        class="md:hidden absolute inset-0 pointer-events-none z-0"
        style="background: linear-gradient(165deg, rgba(210, 66, 16, 0.97) 0%, rgba(235, 88, 34, 0.93) 55%, rgba(196, 60, 14, 0.88) 100%);"
      ></div>

      <!-- Directional Edusafe-Oranje Gradient (Tablet/Desktop >= md): Vol oranje links voor rustige leesbaarheid, vloeiend open naar het kopje koffie rechts -->
      <div
        class="hidden md:block absolute inset-0 pointer-events-none z-0"
        style="background: linear-gradient(98deg, rgba(218, 72, 20, 0.97) 0%, rgba(255, 107, 53, 0.94) 40%, rgba(255, 107, 53, 0.62) 60%, rgba(255, 107, 53, 0.12) 78%, rgba(255, 107, 53, 0.0) 95%);"
      ></div>

      <!-- Content aan de linkerzijde (zodat het kopje koffie rechts volledig vrij zichtbaar blijft) -->
      <div class="relative z-10 w-full p-6 sm:p-10 lg:px-12 lg:py-11">
        <div class="max-w-2xl text-white">
          
          <h2 class="font-display text-2xl sm:text-3xl lg:text-[34px] font-bold tracking-tight text-white leading-tight mb-2.5 drop-shadow-xs">
            {isEn
              ? "Questions about a course or need tailored advice?"
              : "Vragen over een cursus of advies op maat nodig?"}
          </h2>

          <p class="text-white/95 text-sm sm:text-base leading-relaxed mb-6 max-w-xl">
            {isEn
              ? "The coffee is ready. Call or email us directly, or put together your request in 1 minute via our personal advice street."
              : "De koffie staat klaar. Bel of mail ons direct, of stel in 1 minuut je aanvraag samen via onze persoonlijke adviesstraat."}
          </p>

          <!-- Actieknop + Directe Contactgegevens onder elkaar/naast elkaar aan de linkerkant -->
          <div class="flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-2.5 sm:gap-4">
            <!-- Witte Primaire CTA Knop naar de Klantenservice / Adviesstraat -->
            <a
              href={adviceHref}
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-white text-[#0C4EA2] hover:bg-slate-50 font-display font-bold text-sm sm:text-base px-6 py-3.5 min-h-[48px] rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 whitespace-nowrap"
            >
              <span>{isEn ? "Personal Advice →" : "Persoonlijk advies →"}</span>
            </a>

            <!-- Telefoon -->
            <a
              href="tel:0704447795"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-black/20 hover:bg-black/30 backdrop-blur-xs border border-white/25 rounded-xl px-4 py-3 min-h-[48px] text-white font-display font-semibold text-sm transition-all duration-200 whitespace-nowrap"
            >
              <i class="fa-solid fa-phone text-xs text-white/90"></i>
              <span>070 - 444 77 95</span>
            </a>

            <!-- E-mail -->
            <a
              href="mailto:info@edusafe.nl"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-black/20 hover:bg-black/30 backdrop-blur-xs border border-white/25 rounded-xl px-4 py-3 min-h-[48px] text-white font-display font-semibold text-sm transition-all duration-200 whitespace-nowrap"
            >
              <i class="fa-solid fa-envelope text-xs text-white/90"></i>
              <span>info@edusafe.nl</span>
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
