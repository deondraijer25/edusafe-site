---
interface Props {
  lang?: 'nl' | 'en';
}

const { lang = 'nl' } = Astro.props;
const isEn = lang === 'en';

const courses = isEn
  ? [
      'BHV Basis (Emergency Response Basic)',
      'BHV Herhaling (Emergency Response Refresher)',
      'BHV Ploegleider (Team Leader)',
      'EHBO (First Aid Basic / Refresher)',
      'EHAK (Child First Aid)',
      'Reanimatie & AED (CPR & AED)',
      'VCA Basis / VCA-VOL',
      'Heftruck / Reachtruck / Hoogwerker (Forklift / MEWP)',
      'Offshore (BOSIET / FOET / OPITO)',
      'Ontruimingsoefening / Anders (Evacuation / Other)',
    ]
  : [
      'BHV Basis',
      'BHV Herhaling',
      'BHV Ploegleider',
      'EHBO (Basis / Herhaling)',
      'EHAK (Eerste Hulp aan Kinderen)',
      'Reanimatie & AED',
      'VCA Basis / VCA-VOL',
      'Heftruck / Reachtruck / Hoogwerker',
      'Offshore (BOSIET / FOET / OPITO)',
      'Ontruimingsoefening / Anders',
    ];

const scaleLabels = isEn
  ? [
      { value: 1, short: 'Dissatisfied' },
      { value: 2, short: 'Fair' },
      { value: 3, short: 'Sufficient' },
      { value: 4, short: 'Satisfied' },
      { value: 5, short: 'Very satisfied' },
    ]
  : [
      { value: 1, short: 'Ontevreden' },
      { value: 2, short: 'Matig' },
      { value: 3, short: 'Voldoende' },
      { value: 4, short: 'Tevreden' },
      { value: 5, short: 'Zeer tevreden' },
    ];

const step2Questions = [
  {
    id: 'q1',
    num: 1,
    label: isEn
      ? '1. Overall, regarding the course as a whole I am'
      : '1. Over de cursus als geheel ben ik',
  },
  {
    id: 'q2',
    num: 2,
    label: isEn
      ? '2. Regarding the training room and training equipment I am'
      : '2. Over de oefenruimte en oefenmiddelen ben ik',
  },
  {
    id: 'q3',
    num: 3,
    label: isEn
      ? '3. Regarding the lunch I am (if applicable)'
      : '3. Over de lunch ben ik (indien van toepassing)',
    optionalHint: isEn ? 'If applicable' : 'Indien van toepassing',
  },
];

const step3Questions = [
  {
    id: 'q4',
    num: 4,
    section: isEn ? 'Content' : 'Inhoud',
    label: isEn
      ? '4. My knowledge and skills regarding the topics covered in the course have improved'
      : '4. Mijn kennis en vaardigheden over de onderwerpen die in de cursus zijn behandeld zijn verbeterd',
  },
  {
    id: 'q5',
    num: 5,
    label: isEn
      ? '5. I can apply the knowledge and skills I have learned in my own practical situation'
      : '5. Ik kan de kennis en vaardigheden die ik heb geleerd in mijn eigen praktijksituatie toepassen',
  },
  {
    id: 'q6',
    num: 6,
    section: isEn ? 'Course Design & Material' : 'Vormgeving',
    label: isEn
      ? '6. The course material was clear and understandable'
      : '6. Het lesmateriaal was duidelijk en begrijpelijk',
  },
];

const step4InstructorQuestions = [
  {
    id: 'q7',
    num: 7,
    label: isEn
      ? '7. Teaching / explanation of the First Aid module'
      : '7. Lesgeven / uitleg onderdeel Eerste Hulp',
  },
  {
    id: 'q8',
    num: 8,
    label: isEn
      ? '8. Teaching / explanation of the Fire & Evacuation module'
      : '8. Lesgeven / uitleg onderdeel Brand & Ontruiming',
  },
  {
    id: 'q9',
    num: 9,
    label: isEn
      ? '9. The topics were presented clearly'
      : '9. De onderwerpen werden duidelijk gepresenteerd',
  },
  {
    id: 'q10',
    num: 10,
    label: isEn
      ? '10. Questions asked were answered clearly'
      : '10. De gestelde vragen werden duidelijk beantwoord',
  },
  {
    id: 'q11',
    num: 11,
    label: isEn
      ? '11. Feedback on the performed tasks was sufficient'
      : '11. De feedback op de uitgevoerde taken was voldoende',
  },
];

const step4LotusQuestion = {
  id: 'q12',
  num: 12,
  label: isEn
    ? '12. Do you find the deployment of a LOTUS casualty actor during refresher classes of added value?'
    : '12. Vindt u de inzet van een LOTUS tijdens de herhalingslessen van toegevoegde waarde?',
  optionalHint: isEn ? 'If applicable' : 'Indien van toepassing',
};
---

<main class="w-full bg-brand-cream min-h-screen">
  <!-- Hero Header (Dezelfde stijl en beeldopbouw als Persoonlijk Advies & Homepage) -->
  <section class="relative bg-[#0C4EA2] text-white pt-10 pb-16 sm:pt-16 sm:pb-24 md:pt-20 md:pb-28 overflow-hidden">
    <div class="absolute inset-0 z-0 overflow-hidden">
      <img
        src="/assets/images/hero_poster.webp"
        alt={isEn ? 'Edusafe Course Evaluation Form' : 'Edusafe Evaluatieformulier'}
        class="w-full h-full object-cover object-center filter brightness-[0.98] contrast-[1.03]"
      />
      <div
        class="absolute inset-0"
        style="background: linear-gradient(90deg, #0C4EA2 0%, #0C4EA2 36%, rgba(12, 78, 162, 0.86) 56%, rgba(12, 78, 162, 0.38) 78%, rgba(12, 78, 162, 0.08) 100%);"
      ></div>
      <div class="absolute inset-0 md:hidden bg-gradient-to-b from-[#062856]/75 via-[#0C4EA2]/70 to-[#0C4EA2]/95"></div>
    </div>

    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 relative z-10">
      <!-- Back Button -->
      <a
        href={isEn ? '/en' : '/'}
        class="inline-flex items-center gap-2 text-white/85 hover:text-white mb-5 sm:mb-6 transition-all duration-300 font-semibold bg-white/10 hover:bg-white/20 backdrop-blur-md px-3.5 py-2 rounded-xl border border-white/20 text-xs group"
      >
        <i class="fa-solid fa-arrow-left text-[10px] group-hover:-translate-x-1 transition-transform"></i>
        <span>{isEn ? 'Back to homepage' : 'Terug naar overzicht'}</span>
      </a>

      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-1.5 text-brand-accent font-display font-semibold text-xs uppercase tracking-wider mb-3">
          <i class="fa-solid fa-star"></i>
          {isEn ? 'Course Evaluation & Quality Assurance' : 'Cursusevaluatie & Kwaliteitsbewaking'}
        </span>

        <h1 class="font-display text-[26px] min-[375px]:text-[30px] sm:text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tight leading-tight mb-4 text-white">
          {isEn ? (
            <>
              How did you experience <span class="relative inline-block text-white px-3.5 py-1 sm:px-5 sm:py-1.5 mx-0.5 sm:mx-1 transform -rotate-1"><span class="absolute inset-0 bg-brand-accent rounded-2xl z-0"></span><span class="relative z-10">your training?</span></span>
            </>
          ) : (
            <>
              Hoe heeft u onze <span class="relative inline-block text-white px-3.5 py-1 sm:px-5 sm:py-1.5 mx-0.5 sm:mx-1 transform -rotate-1"><span class="absolute inset-0 bg-brand-accent rounded-2xl z-0"></span><span class="relative z-10">cursus ervaren?</span></span>
            </>
          )}
        </h1>

        <p class="text-white/90 text-sm sm:text-base md:text-lg max-w-2xl font-normal leading-relaxed">
          {isEn
            ? 'Please answer the questions below. Your feedback helps us evaluate our courses and continuously improve our training quality.'
            : 'Beantwoord a.u.b. onderstaande vragen. Met uw antwoorden kunnen wij de cursus evalueren en waar nodig nog verder verbeteren.'}
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content & Evaluation Wizard Area -->
  <section class="max-w-[1280px] mx-auto px-4 sm:px-6 -mt-8 sm:-mt-12 md:-mt-14 relative z-30 pb-20 sm:pb-24">
    
    <!-- Top Progress Bar Card (5 Stappen) -->
    <div class="bg-white rounded-2xl shadow-xl shadow-brand-dark/10 border border-brand-dark/5 p-3 sm:p-5 md:p-6 mb-6 sm:mb-8">
      <div class="grid grid-cols-5 sm:grid-cols-3 lg:grid-cols-5 gap-1.5 sm:gap-3.5" id="eval-progress-steps">
        <!-- Step 1 Indicator -->
        <button
          type="button"
          data-eval-step-nav="1"
          aria-label={isEn ? 'Step 1: Course & Details' : 'Stap 1: Gegevens & Cursus'}
          class="eval-step-indicator flex items-center justify-center sm:justify-start gap-2 sm:gap-3 p-1.5 sm:p-3 min-h-[44px] rounded-xl text-left transition-all border border-[#0C4EA2]/35 bg-[#0C4EA2]/6 cursor-pointer"
        >
          <span class="eval-step-badge w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-[#0C4EA2] text-white font-display font-bold text-xs sm:text-sm flex items-center justify-center shrink-0">
            1
          </span>
          <div class="hidden sm:block min-w-0">
            <span class="block text-[10px] font-bold uppercase tracking-wider text-[#0C4EA2]">
              {isEn ? 'Step 1' : 'Stap 1'}
            </span>
            <span class="block font-display font-semibold text-xs sm:text-sm text-brand-secondary truncate">
              {isEn ? 'Course & Details' : 'Gegevens & Cursus'}
            </span>
          </div>
        </button>

        <!-- Step 2 Indicator -->
        <button
          type="button"
          data-eval-step-nav="2"
          disabled
          aria-label={isEn ? 'Step 2: Organization' : 'Stap 2: Organisatie'}
          class="eval-step-indicator flex items-center justify-center sm:justify-start gap-2 sm:gap-3 p-1.5 sm:p-3 min-h-[44px] rounded-xl text-left transition-all border border-brand-dark/8 bg-brand-cream/40 opacity-60 cursor-not-allowed"
        >
          <span class="eval-step-badge w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-brand-dark/10 text-brand-secondary font-display font-bold text-xs sm:text-sm flex items-center justify-center shrink-0">
            2
          </span>
          <div class="hidden sm:block min-w-0">
            <span class="block text-[10px] font-bold uppercase tracking-wider text-brand-dark/45">
              {isEn ? 'Step 2' : 'Stap 2'}
            </span>
            <span class="block font-display font-semibold text-xs sm:text-sm text-brand-secondary truncate">
              {isEn ? 'Organization' : 'Organisatie'}
            </span>
          </div>
        </button>

        <!-- Step 3 Indicator -->
        <button
          type="button"
          data-eval-step-nav="3"
          disabled
          aria-label={isEn ? 'Step 3: Content & Material' : 'Stap 3: Inhoud & Vormgeving'}
          class="eval-step-indicator flex items-center justify-center sm:justify-start gap-2 sm:gap-3 p-1.5 sm:p-3 min-h-[44px] rounded-xl text-left transition-all border border-brand-dark/8 bg-brand-cream/40 opacity-60 cursor-not-allowed"
        >
          <span class="eval-step-badge w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-brand-dark/10 text-brand-secondary font-display font-bold text-xs sm:text-sm flex items-center justify-center shrink-0">
            3
          </span>
          <div class="hidden sm:block min-w-0">
            <span class="block text-[10px] font-bold uppercase tracking-wider text-brand-dark/45">
              {isEn ? 'Step 3' : 'Stap 3'}
            </span>
            <span class="block font-display font-semibold text-xs sm:text-sm text-brand-secondary truncate">
              {isEn ? 'Content & Material' : 'Inhoud & Vormgeving'}
            </span>
          </div>
        </button>

        <!-- Step 4 Indicator -->
        <button
          type="button"
          data-eval-step-nav="4"
          disabled
          aria-label={isEn ? 'Step 4: Instructor & LOTUS' : 'Stap 4: Instructeur & LOTUS'}
          class="eval-step-indicator flex items-center justify-center sm:justify-start gap-2 sm:gap-3 p-1.5 sm:p-3 min-h-[44px] rounded-xl text-left transition-all border border-brand-dark/8 bg-brand-cream/40 opacity-60 cursor-not-allowed"
        >
          <span class="eval-step-badge w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-brand-dark/10 text-brand-secondary font-display font-bold text-xs sm:text-sm flex items-center justify-center shrink-0">
            4
          </span>
          <div class="hidden sm:block min-w-0">
            <span class="block text-[10px] font-bold uppercase tracking-wider text-brand-dark/45">
              {isEn ? 'Step 4' : 'Stap 4'}
            </span>
            <span class="block font-display font-semibold text-xs sm:text-sm text-brand-secondary truncate">
              {isEn ? 'Instructor & LOTUS' : 'Instructeur & LOTUS'}
            </span>
          </div>
        </button>

        <!-- Step 5 Indicator -->
        <button
          type="button"
          data-eval-step-nav="5"
          disabled
          aria-label={isEn ? 'Step 5: General & Submit' : 'Stap 5: Algemeen & Afronding'}
          class="eval-step-indicator flex items-center justify-center sm:justify-start gap-2 sm:gap-3 p-1.5 sm:p-3 min-h-[44px] rounded-xl text-left transition-all border border-brand-dark/8 bg-brand-cream/40 opacity-60 cursor-not-allowed"
        >
          <span class="eval-step-badge w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-brand-dark/10 text-brand-secondary font-display font-bold text-xs sm:text-sm flex items-center justify-center shrink-0">
            5
          </span>
          <div class="hidden sm:block min-w-0">
            <span class="block text-[10px] font-bold uppercase tracking-wider text-brand-dark/45">
              {isEn ? 'Step 5' : 'Stap 5'}
            </span>
            <span class="block font-display font-semibold text-xs sm:text-sm text-brand-secondary truncate">
              {isEn ? 'General & Submit' : 'Algemeen & Afronding'}
            </span>
          </div>
        </button>
      </div>
    </div>

    <!-- Main 2-Column Split -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left 8 Columns: Interactive Evaluation Form Steps -->
      <div class="lg:col-span-8 flex flex-col">
        <form id="evaluation-wizard-form" class="bg-white rounded-2xl shadow-lg border border-brand-dark/5 p-4 min-[375px]:p-5 sm:p-8 flex flex-col justify-between" novalidate>
          
          <!-- ========================================== -->
          <!-- STEP 1: GEGEVENS & CURSUS                  -->
          <!-- ========================================== -->
          <div id="eval-step-1" class="eval-panel flex flex-col justify-between space-y-6">
            <div class="space-y-6">
              <div>
                <span class="inline-block text-xs font-bold uppercase tracking-wider text-[#0C4EA2] mb-1.5">
                  {isEn ? 'Step 1 of 5 • Participant & Course Details' : 'Stap 1 van 5 • Gegevens deelnemer & cursus'}
                </span>
                <h2 class="font-display text-2xl sm:text-3xl font-semibold text-brand-secondary">
                  {isEn ? 'Which course did you attend?' : 'Welke cursus heeft u gevolgd?'}
                </h2>
                <p class="text-brand-dark/70 text-xs sm:text-sm mt-1.5 leading-relaxed">
                  {isEn
                    ? 'Please answer the questions below. With your answers we can evaluate the course and adjust it where necessary. Select the score that best matches your opinion in the next steps.'
                    : 'Beantwoord a.u.b. onderstaande vragen. Met uw antwoorden kunnen wij de cursus evalueren en eventueel bijstellen. Kies in de volgende stappen de beoordeling die uw mening het dichtst benadert.'}
                </p>
              </div>

              <!-- Course Selection Dropdown -->
              <div class="space-y-2">
                <label for="eval-course" class="block text-xs font-semibold uppercase tracking-wider text-brand-secondary">
                  {isEn ? 'Attended Course' : 'Gevolgde cursus'} <span class="text-brand-accent">*</span>
                </label>
                <div class="relative">
                  <select
                    id="eval-course"
                    name="course"
                    class="w-full appearance-none px-4 py-3.5 pr-10 rounded-xl bg-brand-cream/40 border border-brand-dark/12 focus:border-[#0C4EA2] focus:bg-white focus:outline-none text-base sm:text-sm font-semibold text-brand-secondary transition-all cursor-pointer"
                  >
                    {courses.map((c, idx) => (
                      <option value={c} selected={idx === 0}>{c}</option>
                    ))}
                  </select>
                  <i class="fa-solid fa-chevron-down text-xs text-brand-dark/50 absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <!-- Voor en achternaam (Niet verplicht zoals in GHL) -->
                <div class="space-y-1.5">
                  <label for="eval-name" class="block text-xs font-semibold uppercase tracking-wider text-brand-secondary">
                    {isEn ? 'First and last name' : 'Voor- en achternaam'}
                  </label>
                  <div class="relative">
                    <i class="fa-regular fa-user text-brand-dark/40 text-sm absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                    <input
                      type="text"
                      id="eval-name"
                      name="name"
                      placeholder={isEn ? 'Enter your full name' : 'Voer uw volledige naam in'}
                      class="w-full pl-10 pr-4 py-3 rounded-xl bg-brand-cream/35 border border-brand-dark/12 focus:border-[#0C4EA2] focus:bg-white focus:outline-none text-base sm:text-sm font-medium text-brand-secondary transition-all"
                    />
                  </div>
                </div>

                <!-- E-mail (Verplicht) -->
                <div class="space-y-1.5">
                  <label for="eval-email" class="block text-xs font-semibold uppercase tracking-wider text-brand-secondary">
                    {isEn ? 'Email' : 'E-mail'} <span class="text-brand-accent">*</span>
                  </label>
                  <div class="relative">
                    <i class="fa-regular fa-envelope text-brand-dark/40 text-sm absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                    <input
                      type="email"
                      id="eval-email"
                      name="email"
                      required
                      placeholder={isEn ? 'your@email.com' : 'jouw@email.com'}
                      class="w-full pl-10 pr-4 py-3 rounded-xl bg-brand-cream/35 border border-brand-dark/12 focus:border-[#0C4EA2] focus:bg-white focus:outline-none text-base sm:text-sm font-medium text-brand-secondary transition-all"
                    />
                  </div>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <!-- Naam instructeur (Niet verplicht) -->
                <div class="space-y-1.5">
                  <label for="eval-instructor" class="block text-xs font-semibold uppercase tracking-wider text-brand-secondary">
                    {isEn ? 'Instructor name:' : 'Naam instructeur:'}
                  </label>
                  <div class="relative">
                    <i class="fa-solid fa-chalkboard-user text-brand-dark/40 text-sm absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                    <input
                      type="text"
                      id="eval-instructor"
                      name="instructor"
                      placeholder={isEn ? 'Enter instructor name' : 'Voer de naam van de instructeur in'}
                      class="w-full pl-10 pr-4 py-3 rounded-xl bg-brand-cream/35 border border-brand-dark/12 focus:border-[#0C4EA2] focus:bg-white focus:outline-none text-base sm:text-sm font-medium text-brand-secondary transition-all"
                    />
                  </div>
                </div>

                <!-- Datum (Verplicht) -->
                <div class="space-y-1.5">
                  <label for="eval-date" class="block text-xs font-semibold uppercase tracking-wider text-brand-secondary">
                    {isEn ? 'Date:' : 'Datum:'} <span class="text-brand-accent">*</span>
                  </label>
                  <div class="relative">
                    <i class="fa-regular fa-calendar text-brand-dark/40 text-sm absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                    <input
                      type="date"
                      id="eval-date"
                      name="date"
                      required
                      class="w-full pl-10 pr-4 py-3 rounded-xl bg-brand-cream/35 border border-brand-dark/12 focus:border-[#0C4EA2] focus:bg-white focus:outline-none text-base sm:text-sm font-medium text-brand-secondary transition-all"
                    />
                  </div>
                </div>
              </div>

              <!-- Validation Error Box Step 1 -->
              <div id="eval-step1-error" class="hidden p-3.5 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs font-semibold flex items-center gap-2.5">
                <i class="fa-solid fa-circle-exclamation text-red-600"></i>
                <span id="eval-step1-error-text"></span>
              </div>
            </div>

            <!-- Bottom Navigation Bar Step 1 -->
            <div class="pt-6 mt-6 border-t border-brand-dark/8 flex flex-col-reverse sm:flex-row items-stretch sm:items-center justify-between gap-3">
              <span class="text-xs text-brand-dark/60 text-center sm:text-left">
                <i class="fa-regular fa-clock mr-1 text-[#0C4EA2]"></i>
                {isEn ? 'Takes about 1–2 minutes' : 'Duurt slechts 1 à 2 minuten'}
              </span>
              <button
                type="button"
                data-next-step="2"
                class="w-full sm:w-auto min-h-[48px] font-display font-semibold text-sm bg-brand-accent hover:bg-brand-accent-hover text-white px-7 py-3.5 rounded-xl transition-all shadow-xs flex items-center justify-center gap-2.5 cursor-pointer"
              >
                <span>{isEn ? 'Next' : 'Volgende'}</span>
                <i class="fa-solid fa-arrow-right text-xs"></i>
              </button>
            </div>
          </div>

          <!-- ========================================== -->
          <!-- STEP 2: ORGANISATIE (Vraag 1 t/m 3)        -->
          <!-- ========================================== -->
          <div id="eval-step-2" class="eval-panel hidden flex-col justify-between space-y-6">
            <div class="space-y-6">
              <div class="flex items-center justify-between">
                <button
                  type="button"
                  data-prev-step="1"
                  class="inline-flex items-center gap-2 text-xs font-bold text-brand-dark/60 hover:text-[#0C4EA2] transition-colors cursor-pointer"
                >
                  <i class="fa-solid fa-arrow-left"></i>
                  <span>{isEn ? 'Back' : 'Terug'}</span>
                </button>
                <span class="text-xs font-bold uppercase tracking-wider text-[#0C4EA2]">
                  {isEn ? 'Step 2 of 5' : 'Stap 2 van 5'}
                </span>
              </div>

              <div>
                <h2 class="font-display text-2xl sm:text-3xl font-semibold text-brand-secondary">
                  {isEn ? 'Organization' : 'Organisatie'}
                </h2>
                <p class="text-brand-dark/70 text-xs sm:text-sm mt-1">
                  {isEn
                    ? 'How satisfied are you with the general organization, training facility and catering?'
                    : 'Hoe tevreden bent u over de cursus in het algemeen, de oefenruimte en de verzorging?'}
                </p>
              </div>

              <div class="space-y-4">
                {step2Questions.map((q) => (
                  <div class="rating-question-card p-4 sm:p-5 rounded-2xl border border-brand-dark/8 bg-brand-cream/25 space-y-3.5" data-question-card={q.id}>
                    <div class="flex flex-wrap items-start justify-between gap-2">
                      <label class="font-display font-semibold text-sm sm:text-base text-brand-secondary leading-snug">
                        {q.label}
                      </label>
                      <span
                        data-rating-badge={q.id}
                        class="text-[11px] font-semibold px-2.5 py-0.5 rounded-lg bg-brand-dark/6 text-brand-dark/55 shrink-0"
                      >
                        {q.optionalHint || (isEn ? 'Choose 1–5' : 'Kies 1 t/m 5')}
                      </span>
                    </div>

                    <input type="hidden" name={q.id} id={`input-${q.id}`} value="" />

                    <div class="grid grid-cols-5 gap-1.5 sm:gap-3" role="radiogroup" aria-label={q.label}>
                      {scaleLabels.map((s) => (
                        <button
                          type="button"
                          data-rating-btn={q.id}
