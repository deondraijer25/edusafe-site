              <div id="eval-success-score-pill" class="eval-content-fade hidden inline-flex items-center gap-2.5 bg-[#0C4EA2]/8 border border-[#0C4EA2]/20 text-brand-secondary px-5 py-2.5 rounded-2xl text-sm sm:text-base font-bold shadow-2xs">
                <i class="fa-solid fa-star text-amber-400 text-lg"></i>
                <span id="eval-success-score-text"></span>
              </div>

              <div class="eval-content-fade pt-3 flex flex-col sm:flex-row flex-wrap items-stretch sm:items-center justify-center gap-3 sm:gap-4">
                <a
                  href={isEn ? '/en/course-dates' : '/cursusdata'}
                  class="w-full sm:w-auto min-h-[48px] font-display font-semibold text-sm bg-[#0C4EA2] hover:bg-[#093D80] text-white px-6 py-3.5 rounded-xl transition-all flex items-center justify-center gap-2"
                >
                  <i class="fa-regular fa-calendar-days text-xs"></i>
                  <span>{isEn ? 'View course schedule' : 'Bekijk onze cursusagenda'}</span>
                </a>
                <a
                  href={isEn ? '/en' : '/'}
                  class="w-full sm:w-auto min-h-[48px] font-display font-semibold text-sm bg-brand-accent hover:bg-brand-accent-hover text-white px-6 py-3.5 rounded-xl shadow-xs transition-all flex items-center justify-center gap-2"
                >
                  <span>{isEn ? 'Back to homepage' : 'Terug naar de homepage'}</span>
                  <i class="fa-solid fa-arrow-right text-xs"></i>
                </a>
              </div>
            </div>
          </div>

        </form>
      </div>

      <!-- Right 4 Columns: Live Summary & Edusafe Kwaliteitskaart -->
      <div class="lg:col-span-4 flex flex-col gap-6 lg:sticky lg:top-28">
        
        <!-- Card 1: Live Summary ("Uw evaluatie") -->
        <div class="bg-white rounded-2xl shadow-lg border border-brand-dark/5 p-5 sm:p-6">
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-brand-dark/8">
            <h3 class="font-display font-semibold text-lg text-brand-secondary flex items-center gap-2.5">
              <span class="w-8 h-8 rounded-lg bg-[#0C4EA2]/10 text-[#0C4EA2] flex items-center justify-center text-xs">
                <i class="fa-solid fa-clipboard-check"></i>
              </span>
              <span>{isEn ? 'Your Evaluation' : 'Uw evaluatie'}</span>
            </h3>
            <span id="eval-progress-pct" class="text-xs font-bold text-[#0C4EA2] bg-[#0C4EA2]/10 px-2.5 py-1 rounded-lg">
              Stap 1 / 5
            </span>
          </div>

          <div class="space-y-3 text-sm">
            <div class="flex items-center justify-between gap-3 py-1">
              <span class="text-xs font-semibold text-brand-dark/50 uppercase tracking-wider">
                {isEn ? 'Course' : 'Cursus'}
              </span>
              <span id="sum-eval-course" class="font-display font-semibold text-brand-secondary text-right text-xs sm:text-sm truncate max-w-[180px]">
                BHV Basis
              </span>
            </div>

            <div class="flex items-center justify-between gap-3 py-2 border-t border-brand-dark/5">
              <span class="text-xs font-semibold text-brand-dark/50 uppercase tracking-wider">
                {isEn ? 'Instructor' : 'Instructeur'}
              </span>
              <span id="sum-eval-instructor" class="font-display font-semibold text-brand-secondary text-right text-xs sm:text-sm truncate max-w-[180px]">
                —
              </span>
            </div>

            <div class="flex items-center justify-between gap-3 py-2 border-t border-brand-dark/5">
              <span class="text-xs font-semibold text-brand-dark/50 uppercase tracking-wider">
                {isEn ? 'Date' : 'Datum'}
              </span>
              <span id="sum-eval-date" class="font-display font-semibold text-brand-secondary text-right text-xs sm:text-sm">
                —
              </span>
            </div>

            <div class="py-2.5 border-t border-brand-dark/5 space-y-2">
              <div class="flex items-center justify-between gap-3">
                <span class="text-xs font-semibold text-brand-dark/50 uppercase tracking-wider">
                  {isEn ? 'Rated questions' : 'Beoordeelde vragen'}
                </span>
                <span id="sum-eval-count" class="font-display font-semibold text-brand-secondary text-xs sm:text-sm">
                  0 / 12
                </span>
              </div>
              <div class="w-full h-2 rounded-full bg-brand-dark/8 overflow-hidden">
                <div id="sum-eval-bar" class="h-full bg-[#0C4EA2] rounded-full transition-all duration-300" style="width: 0%"></div>
              </div>
            </div>

            <div class="flex items-center justify-between gap-3 pt-2 border-t border-brand-dark/5">
              <span class="text-xs font-semibold text-brand-dark/50 uppercase tracking-wider">
                {isEn ? 'Average rating' : 'Gemiddelde score'}
              </span>
              <span id="sum-eval-avg" class="font-display font-bold text-brand-secondary text-right text-xs sm:text-sm flex items-center gap-1.5">
                <i class="fa-solid fa-star text-amber-400 text-xs"></i>
                <span>—</span>
              </span>
            </div>
          </div>
        </div>

        <!-- Card 2: Edusafe Kwaliteitsbelofte -->
        <div class="bg-[#0C4EA2] text-white rounded-2xl p-5 sm:p-6 relative overflow-hidden shadow-lg">
          <div class="absolute -right-10 -bottom-10 text-white/5 pointer-events-none">
            <i class="fa-solid fa-award text-[160px]"></i>
          </div>

          <div class="relative z-10 space-y-3.5">
            <span class="inline-block text-[10px] font-semibold uppercase tracking-wider text-brand-accent">
              {isEn ? 'Quality & Certification' : 'Kwaliteit & Erkenning'}
            </span>
            <h4 class="font-display text-lg sm:text-xl font-semibold text-white leading-snug">
              {isEn
                ? 'Together we keep our safety training at top level'
                : 'Samen houden we onze trainingen op topniveau'}
            </h4>
            <ul class="space-y-2.5 text-xs sm:text-sm text-white/90">
              <li class="flex items-start gap-2.5">
                <i class="fa-solid fa-check text-brand-accent mt-1 shrink-0"></i>
                <span>
                  {isEn
                    ? 'Every evaluation is reviewed personally by our training coordinator and instructors'
                    : 'Elke evaluatie wordt besproken met onze instructeurs en opleidingscoördinator'}
                </span>
              </li>
              <li class="flex items-start gap-2.5">
                <i class="fa-solid fa-check text-brand-accent mt-1 shrink-0"></i>
                <span>
                  {isEn
                    ? 'Helps us continuously improve our training center in The Hague and In-company sessions'
                    : 'Helpt ons de oefenruimte, lunch en praktijkscenario’s continu te verbeteren'}
                </span>
              </li>
              <li class="flex items-start gap-2.5">
                <i class="fa-solid fa-check text-brand-accent mt-1 shrink-0"></i>
                <span>
                  {isEn
                    ? 'Part of our NIBHV, Red Cross / Oranje Kruis & VCA quality assurance'
                    : 'Onderdeel van onze officiële kwaliteitsborging voor certificeringen'}
                </span>
              </li>
            </ul>
          </div>

          <div class="relative z-10 pt-4 mt-4 border-t border-white/15">
            <span class="block text-[11px] text-white/75">
              {isEn ? 'Questions about your certificate or course?' : 'Vragen naar aanleiding van uw cursus of certificaat?'}
            </span>
            <a
              href="tel:0704447795"
              class="inline-flex items-center gap-2 font-display font-semibold text-sm text-white hover:text-brand-accent transition-colors mt-1"
            >
              <i class="fa-solid fa-phone text-brand-accent text-xs"></i>
              <span>070 - 444 77 95</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>
</main>

<style>
  @keyframes evalBadgePop {
    0% {
      opacity: 0;
      transform: scale(0.3) rotate(-12deg);
    }
    65% {
      opacity: 1;
      transform: scale(1.12) rotate(4deg);
    }
    85% {
      transform: scale(0.95) rotate(-2deg);
    }
    100% {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }

  @keyframes evalCheckDraw {
    0% {
      stroke-dashoffset: 48;
    }
    100% {
      stroke-dashoffset: 0;
    }
  }

  @keyframes evalRipple {
    0% {
      transform: scale(0.75);
      opacity: 0.85;
    }
    100% {
      transform: scale(1.55);
      opacity: 0;
    }
  }

  @keyframes evalSparklePop {
    0% {
      opacity: 0;
      transform: scale(0) translateY(10px);
    }
    60% {
      opacity: 1;
      transform: scale(1.2) translateY(-3px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @keyframes evalSparkleFloat {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-5px) rotate(6deg);
    }
  }

  @keyframes evalStarWave {
    0% {
      opacity: 0;
      transform: translateY(18px) scale(0.2) rotate(-25deg);
    }
    65% {
      opacity: 1;
      transform: translateY(-6px) scale(1.25) rotate(8deg);
    }
    85% {
      transform: translateY(2px) scale(0.94) rotate(-3deg);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1) rotate(0deg);
    }
  }

  @keyframes evalContentFadeUp {
    0% {
      opacity: 0;
      transform: translateY(16px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #eval-success-screen.is-celebrating .eval-badge-pop {
    animation: evalBadgePop 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  #eval-success-screen.is-celebrating .eval-check-path {
    stroke-dasharray: 48;
    stroke-dashoffset: 48;
    animation: evalCheckDraw 0.55s cubic-bezier(0.65, 0, 0.35, 1) 0.3s forwards;
  }

  #eval-success-screen.is-celebrating .eval-ripple-ring {
    animation: evalRipple 2s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  #eval-success-screen.is-celebrating .eval-ripple-delay {
    animation-delay: 0.7s;
  }

  #eval-success-screen.is-celebrating .eval-sparkle-1 {
    opacity: 0;
    animation: evalSparklePop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 0.25s forwards,
      evalSparkleFloat 3s ease-in-out 0.8s infinite;
  }

  #eval-success-screen.is-celebrating .eval-sparkle-2 {
    opacity: 0;
    animation: evalSparklePop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 0.38s forwards,
      evalSparkleFloat 3.4s ease-in-out 0.95s infinite;
  }

  #eval-success-screen.is-celebrating .eval-sparkle-3 {
    opacity: 0;
    animation: evalSparklePop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 0.48s forwards,
      evalSparkleFloat 2.8s ease-in-out 1.05s infinite;
  }

  #eval-success-screen.is-celebrating .eval-sparkle-4 {
    opacity: 0;
    animation: evalSparklePop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 0.58s forwards,
      evalSparkleFloat 3.2s ease-in-out 1.15s infinite;
  }

  #eval-success-screen.is-celebrating .eval-wave-star {
    opacity: 0;
    animation: evalStarWave 0.65s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  #eval-success-screen.is-celebrating .eval-content-fade {
    opacity: 0;
    animation: evalContentFadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.45s forwards;
  }
</style>

<script is:inline define:vars={{ isEn }}>
  (function () {
    const state = {
      step: 1,
      maxStepVisited: 1,
      totalApplicableQuestions: 12,
      submitted: false,
      ratings: {},
    };

    const panels = {
      1: document.getElementById('eval-step-1'),
      2: document.getElementById('eval-step-2'),
      3: document.getElementById('eval-step-3'),
      4: document.getElementById('eval-step-4'),
      5: document.getElementById('eval-step-5'),
    };

    const stepIndicators = document.querySelectorAll('.eval-step-indicator');
    const courseInput = document.getElementById('eval-course');
    const nameInput = document.getElementById('eval-name');
    const emailInput = document.getElementById('eval-email');
    const instructorInput = document.getElementById('eval-instructor');
    const dateInput = document.getElementById('eval-date');

    const sumCourse = document.getElementById('sum-eval-course');
    const sumInstructor = document.getElementById('sum-eval-instructor');
    const sumDate = document.getElementById('sum-eval-date');
    const sumCount = document.getElementById('sum-eval-count');
    const sumBar = document.getElementById('sum-eval-bar');
    const sumAvg = document.getElementById('sum-eval-avg');
    const progressPct = document.getElementById('eval-progress-pct');

    // Zet standaarddatum op vandaag en lees eventuele URL-parameters uit (zoals in GHL sticky/query)
    const todayIso = new Date().toISOString().split('T')[0];
    if (dateInput && !dateInput.value) {
      dateInput.value = todayIso;
    }

    try {
      const params = new URLSearchParams(window.location.search);
      const qCourse = params.get('cursus') || params.get('course');
      const qName = params.get('full_name') || params.get('naam') || params.get('name');
      const qEmail = params.get('email');
      const qInstructor = params.get('line_individual_14yss') || params.get('instructeur') || params.get('instructor');
      const qDate = params.get('datum') || params.get('date');

      if (qCourse && courseInput) {
        const match = Array.from(courseInput.options).find(
          (opt) => opt.value.toLowerCase().includes(qCourse.toLowerCase())
        );
        if (match) courseInput.value = match.value;
      }
      if (qName && nameInput) nameInput.value = qName;
      if (qEmail && emailInput) emailInput.value = qEmail;
      if (qInstructor && instructorInput) instructorInput.value = qInstructor;
      if (qDate && dateInput && /^\d{4}-\d{2}-\d{2}$/.test(qDate)) {
        dateInput.value = qDate;
      }
    } catch (e) {
      // Negeer URL parse fouten
    }

    // Pas vraag 7, 8 en 12 slim aan op basis van de gekozen cursus in Stap 1
    function syncCourseSpecificQuestions() {
      const courseVal = (courseInput ? courseInput.value : 'BHV Basis').toLowerCase();
      const q7Label = document.querySelector('[data-question-label="q7"]');
      const q8Label = document.querySelector('[data-question-label="q8"]');
      const lotusSection = document.getElementById('eval-lotus-section');

      const isBHV = courseVal.includes('bhv');
      const isFirstAid =
        courseVal.includes('ehbo') || courseVal.includes('ehak') || courseVal.includes('reanimatie');

      if (isBHV) {
        if (q7Label) {
          q7Label.textContent = isEn
            ? '7. Teaching / explanation of the First Aid module'
            : '7. Lesgeven / uitleg onderdeel Eerste Hulp';
        }
        if (q8Label) {
          q8Label.textContent = isEn
            ? '8. Teaching / explanation of the Fire & Evacuation module'
            : '8. Lesgeven / uitleg onderdeel Brand & Ontruiming';
        }
        lotusSection?.classList.remove('hidden');
        state.totalApplicableQuestions = 12;
      } else if (isFirstAid) {
        if (q7Label) {
          q7Label.textContent = isEn
            ? '7. Teaching / explanation of First Aid & CPR theory'
            : '7. Lesgeven / uitleg theorie Eerste Hulp & Reanimatie';
        }
        if (q8Label) {
          q8Label.textContent = isEn
            ? '8. Guidance during practical exercises & scenarios'
            : '8. Begeleiding tijdens de praktijkoefeningen';
        }
        lotusSection?.classList.remove('hidden');
        state.totalApplicableQuestions = 12;
      } else {
        // VCA, Heftruck, Offshore, Ontruimingsoefening, etc.
        if (q7Label) {
          q7Label.textContent = isEn
            ? '7. Teaching / explanation of the course theory'
            : '7. Lesgeven / uitleg van de theorie';
        }
        if (q8Label) {
          q8Label.textContent = isEn
            ? '8. Guidance during practical exercises (if applicable)'
            : '8. Begeleiding van de praktijkoefeningen (indien van toepassing)';
        }
        lotusSection?.classList.add('hidden');
        if (state.ratings.q12) {
          delete state.ratings.q12;
          const hidden12 = document.getElementById('input-q12');
          if (hidden12) hidden12.value = '';
        }
        state.totalApplicableQuestions = 11;
      }
    }

    function formatDisplayDate(isoStr) {
      if (!isoStr) return '—';
      const parts = isoStr.split('-');
      if (parts.length === 3) {
        return `${parts[2]}-${parts[1]}-${parts[0]}`;
      }
      return isoStr;
    }

    function updateSummary() {
      syncCourseSpecificQuestions();

      if (sumCourse && courseInput) {
        sumCourse.textContent = courseInput.value || 'BHV Basis';
      }
      if (sumInstructor && instructorInput) {
        sumInstructor.textContent = instructorInput.value.trim() || '—';
      }
      if (sumDate && dateInput) {
        sumDate.textContent = formatDisplayDate(dateInput.value);
      }
      if (progressPct && !state.submitted) {
        progressPct.textContent = isEn ? `Step ${state.step} / 5` : `Stap ${state.step} / 5`;
      }

      const values = Object.values(state.ratings).filter((v) => typeof v === 'number' && v >= 1 && v <= 5);
      const count = values.length;
      const totalQ = state.totalApplicableQuestions || 12;

      if (sumCount) {
        sumCount.textContent = `${count} / ${totalQ}`;
      }
      if (sumBar && !state.submitted) {
        sumBar.style.width = `${Math.min(100, Math.round((count / totalQ) * 100))}%`;
      }
      if (sumAvg) {
        if (count > 0) {
          const avg = (values.reduce((acc, v) => acc + v, 0) / count).toFixed(1);
          sumAvg.innerHTML = `<i class="fa-solid fa-star text-amber-400 text-xs"></i><span>${avg} / 5.0</span>`;
        } else {
          sumAvg.innerHTML = `<i class="fa-solid fa-star text-amber-400 text-xs"></i><span>—</span>`;
        }
      }
    }

    [courseInput, nameInput, emailInput, instructorInput, dateInput].forEach((el) => {
      el?.addEventListener('input', updateSummary);
      el?.addEventListener('change', updateSummary);
    });

    function validateStep1() {
      const errorBox = document.getElementById('eval-step1-error');
      const errorText = document.getElementById('eval-step1-error-text');
      const emailVal = emailInput ? emailInput.value.trim() : '';
      const dateVal = dateInput ? dateInput.value.trim() : '';

      const emailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailVal);

      if (!emailValid) {
        if (errorBox && errorText) {
          errorText.textContent = isEn
            ? 'Please enter a valid email address (*).'
            : 'Vul a.u.b. een geldig e-mailadres in (*).';
          errorBox.classList.remove('hidden');
        }
        emailInput?.focus();
        return false;
      }

      if (!dateVal) {
        if (errorBox && errorText) {
          errorText.textContent = isEn
            ? 'Please select the course date (*).'
            : 'Datum is verplicht (*). Kies a.u.b. de cursusdatum.';
          errorBox.classList.remove('hidden');
        }
        dateInput?.focus();
        return false;
      }

      if (errorBox) errorBox.classList.add('hidden');
      return true;
    }

    function goToStep(stepNum) {
      if (stepNum > 1 && !validateStep1()) {
        return;
      }

      state.step = stepNum;
      if (stepNum > state.maxStepVisited) {
        state.maxStepVisited = stepNum;
      }

      Object.keys(panels).forEach((k) => {
        const panel = panels[k];
        if (!panel) return;
        if (Number(k) === stepNum) {
          panel.classList.remove('hidden');
          panel.classList.add('flex');
        } else {
          panel.classList.add('hidden');
          panel.classList.remove('flex');
        }
      });

      stepIndicators.forEach((btn) => {
        const s = Number(btn.getAttribute('data-eval-step-nav'));
        const badge = btn.querySelector('.eval-step-badge');
        const baseStepBtn = 'eval-step-indicator flex items-center justify-center sm:justify-start gap-2 sm:gap-3 p-1.5 sm:p-3 min-h-[44px] rounded-xl text-left transition-all border';

        if (s < stepNum) {
          btn.disabled = false;
          btn.className = `${baseStepBtn} border-emerald-500/30 bg-emerald-500/5 cursor-pointer`;
          if (badge) {
            badge.className =
              'eval-step-badge w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-emerald-600 text-white font-display font-bold text-xs sm:text-sm flex items-center justify-center shrink-0';
            badge.innerHTML = '<i class="fa-solid fa-check text-xs"></i>';
          }
        } else if (s === stepNum) {
          btn.disabled = false;
          btn.className = `${baseStepBtn} border-[#0C4EA2]/35 bg-[#0C4EA2]/6 cursor-pointer`;
          if (badge) {
            badge.className =
              'eval-step-badge w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-[#0C4EA2] text-white font-display font-bold text-xs sm:text-sm flex items-center justify-center shrink-0';
            badge.textContent = String(s);
          }
        } else if (s <= state.maxStepVisited) {
          btn.disabled = false;
          btn.className = `${baseStepBtn} border-brand-dark/12 bg-white hover:border-[#0C4EA2]/30 cursor-pointer`;
          if (badge) {
            badge.className =
              'eval-step-badge w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-brand-dark/10 text-brand-secondary font-display font-bold text-xs sm:text-sm flex items-center justify-center shrink-0';
            badge.textContent = String(s);
          }
        } else {
          btn.disabled = true;
          btn.className = `${baseStepBtn} border-brand-dark/8 bg-brand-cream/40 opacity-60 cursor-not-allowed`;
          if (badge) {
            badge.className =
              'eval-step-badge w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-brand-dark/10 text-brand-secondary font-display font-bold text-xs sm:text-sm flex items-center justify-center shrink-0';
            badge.textContent = String(s);
          }
        }
      });

      updateSummary();

      // Scroll rustig naar het begin van de stappenkaart
      const progressCard = document.getElementById('eval-progress-steps');
      if (progressCard) {
        const rect = progressCard.getBoundingClientRect();
        if (rect.top < 0 || rect.top > window.innerHeight * 0.5) {
          progressCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    }

    // Interactieve 1 t/m 5 Rating Knoppen
    function renderRatingState(qId) {
      const selectedVal = state.ratings[qId] || 0;
      const hiddenInput = document.getElementById(`input-${qId}`);
      const badge = document.querySelector(`[data-rating-badge="${qId}"]`);
      const card = document.querySelector(`[data-question-card="${qId}"]`);
      const buttons = document.querySelectorAll(`[data-rating-btn="${qId}"]`);

      if (hiddenInput) {
        hiddenInput.value = selectedVal ? String(selectedVal) : '';
      }

      let selectedLabel = '';
      buttons.forEach((btn) => {
        const val = Number(btn.getAttribute('data-rating-val'));
        const label = btn.getAttribute('data-rating-label') || '';
        const star = btn.querySelector('.rating-star');

        if (val === selectedVal) {
          selectedLabel = label;
          btn.className =
            'rating-btn group min-h-[48px] flex flex-col items-center justify-center py-2.5 sm:py-3 px-1 sm:px-1.5 rounded-xl border-2 border-[#0C4EA2] bg-[#0C4EA2]/[0.06] shadow-2xs transition-all cursor-pointer';
        } else {
          btn.className =
            'rating-btn group min-h-[48px] flex flex-col items-center justify-center py-2.5 sm:py-3 px-1 sm:px-1.5 rounded-xl border-2 border-brand-dark/10 bg-white hover:border-[#0C4EA2]/50 transition-all cursor-pointer';
        }

        if (star) {
          if (selectedVal > 0 && val <= selectedVal) {
            star.className = 'rating-star fa-solid fa-star text-sm sm:text-base text-amber-400 transition-colors';
          } else {
            star.className =
              'rating-star fa-solid fa-star text-sm sm:text-base text-brand-dark/20 group-hover:text-amber-400 transition-colors';
          }
        }
      });

      if (badge) {
        if (selectedVal > 0) {
          badge.textContent = `${selectedVal} / 5 • ${selectedLabel}`;
          badge.className =
            'text-[11px] font-bold px-2.5 py-0.5 rounded-lg bg-[#0C4EA2]/12 text-[#0C4EA2] shrink-0';
        } else {
          badge.textContent = isEn ? 'Choose 1–5' : 'Kies 1 t/m 5';
          badge.className =
            'text-[11px] font-semibold px-2.5 py-0.5 rounded-lg bg-brand-dark/6 text-brand-dark/55 shrink-0';
        }
      }

      if (card) {
        if (selectedVal > 0) {
          card.classList.add('border-[#0C4EA2]/25', 'bg-[#0C4EA2]/[0.02]');
          card.classList.remove('border-brand-dark/8', 'bg-brand-cream/25');
        } else {
          card.classList.remove('border-[#0C4EA2]/25', 'bg-[#0C4EA2]/[0.02]');
          card.classList.add('border-brand-dark/8', 'bg-brand-cream/25');
        }
      }

      updateSummary();
    }

    document.querySelectorAll('[data-rating-btn]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const qId = btn.getAttribute('data-rating-btn');
        const val = Number(btn.getAttribute('data-rating-val'));
        if (!qId || !val) return;

        // Opnieuw klikken op dezelfde waarde deselecteert (handig bij 'indien van toepassing')
        if (state.ratings[qId] === val) {
          delete state.ratings[qId];
        } else {
          state.ratings[qId] = val;
        }
        renderRatingState(qId);
      });
    });

    // Next & Prev knoppen
    document.querySelectorAll('[data-next-step]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = Number(btn.getAttribute('data-next-step'));
        if (target >= 1 && target <= 5) {
          goToStep(target);
        }
      });
    });

    document.querySelectorAll('[data-prev-step]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = Number(btn.getAttribute('data-prev-step'));
        if (target >= 1 && target <= 5) {
          goToStep(target);
        }
      });
    });

    stepIndicators.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.disabled || state.submitted) return;
        const target = Number(btn.getAttribute('data-eval-step-nav'));
        if (target >= 1 && target <= state.maxStepVisited) {
          goToStep(target);
        }
      });
    });

    function animateScoreCounter(targetStr, el) {
      const target = parseFloat(targetStr);
      if (isNaN(target) || !el) return;
      const duration = 900;
      const startTime = performance.now();

      function tick(now) {
        const progress = Math.min(1, (now - startTime) / duration);
        const eased = 1 - Math.pow(1 - progress, 3);
        const current = (target * eased).toFixed(1);
        el.textContent = isEn
          ? `Your average rating: ${current} / 5.0`
          : `Uw gemiddelde waardering: ${current} / 5.0`;
        if (progress < 1) {
          requestAnimationFrame(tick);
        }
      }
      requestAnimationFrame(tick);
    }

    function markAllStepsCompleted() {
      state.submitted = true;
      stepIndicators.forEach((btn) => {
        const badge = btn.querySelector('.eval-step-badge');
        btn.disabled = true;
        btn.className = 'eval-step-indicator flex items-center justify-center sm:justify-start gap-2 sm:gap-3 p-1.5 sm:p-3 min-h-[44px] rounded-xl text-left transition-all border border-emerald-500/35 bg-emerald-500/8';
        if (badge) {
          badge.className =
            'eval-step-badge w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-emerald-600 text-white font-display font-bold text-xs sm:text-sm flex items-center justify-center shrink-0';
          badge.innerHTML = '<i class="fa-solid fa-check text-xs"></i>';
        }
      });

      if (progressPct) {
        progressPct.className =
          'text-xs font-bold text-emerald-700 bg-emerald-500/12 px-2.5 py-1 rounded-lg inline-flex items-center gap-1';
        progressPct.innerHTML = `<i class="fa-solid fa-check text-[10px]"></i><span>${isEn ? 'Completed' : 'Voltooid'}</span>`;
      }
      if (sumBar) {
        sumBar.style.width = '100%';
        sumBar.classList.remove('bg-[#0C4EA2]');
        sumBar.classList.add('bg-emerald-500');
      }
    }

    // Formulier verzenden naar /api/evaluatie
    const form = document.getElementById('evaluation-wizard-form');
    const submitBtn = document.getElementById('eval-submit-btn');
    const submitLabel = document.getElementById('eval-submit-label');
    const submitError = document.getElementById('eval-submit-error');
    const step5FormContent = document.getElementById('eval-step-5-form-content');
    const successScreen = document.getElementById('eval-success-screen');
    const scorePill = document.getElementById('eval-success-score-pill');
    const scoreText = document.getElementById('eval-success-score-text');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validateStep1()) {
        goToStep(1);
        return;
      }

      if (submitError) submitError.classList.add('hidden');
      if (submitBtn) submitBtn.disabled = true;
      if (submitLabel) {
        submitLabel.textContent = isEn ? 'Submitting...' : 'Bezig met indienen...';
      }

      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      try {
        const res = await fetch('/api/evaluatie', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();

        if (!res.ok || !data.success) {
          throw new Error(
            data.error || (isEn ? 'Could not submit evaluation.' : 'Kon het evaluatieformulier niet versturen.')
          );
        }

        if (step5FormContent) step5FormContent.classList.add('hidden');
        if (successScreen) {
          successScreen.classList.remove('hidden');
          // Activeer de feestelijke animaties
          requestAnimationFrame(() => {
            successScreen.classList.add('is-celebrating');
          });
        }

        markAllStepsCompleted();

        if (data.data?.averageScore && scorePill && scoreText) {
          scorePill.classList.remove('hidden');
          animateScoreCounter(data.data.averageScore, scoreText);
        }
      } catch (err) {
        if (submitError) {
          submitError.textContent = err.message || (isEn ? 'Something went wrong.' : 'Er ging iets mis.');
          submitError.classList.remove('hidden');
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (submitLabel) {
          submitLabel.textContent = isEn ? 'Submit Evaluation' : 'Indienen';
        }
      }
    });

    updateSummary();
  })();
</script>
