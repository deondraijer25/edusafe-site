<style>
  /* Custom scrolling animation for infinite marquee */
  .marquee-row {
    display: flex;
    overflow: hidden;
    user-select: none;
    gap: 1.5rem;
  }
  .marquee-track-left {
    flex-shrink: 0;
    display: flex;
    width: max-content;
    gap: 1.5rem;
    animation: scroll-left 36s linear infinite;
  }
  .marquee-track-right {
    flex-shrink: 0;
    display: flex;
    width: max-content;
    gap: 1.5rem;
    animation: scroll-right 36s linear infinite;
  }
  @keyframes scroll-left {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-100% - 1.5rem)); }
  }
  @keyframes scroll-right {
    from { transform: translateX(calc(-100% - 1.5rem)); }
    to { transform: translateX(0); }
  }
  .marquee-row:hover .marquee-track-left,
  .marquee-row:hover .marquee-track-right {
    animation-play-state: paused;
  }
</style>
