---
---
<!-- Global Slide-Over Contact Drawer -->
<div id="contact-drawer-backdrop" class="fixed inset-0 bg-brand-secondary/60 backdrop-blur-sm z-[100] opacity-0 pointer-events-none transition-opacity duration-300"></div>

<aside 
  id="contact-drawer" 
  class="fixed top-0 right-0 bottom-0 w-full max-w-[480px] bg-white z-[101] shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col justify-between overflow-y-auto"
  aria-hidden="true"
  aria-label="Contact formulier"
>
  <!-- Drawer Header -->
  <div class="p-6 sm:p-8 border-b border-brand-dark/5 flex items-center justify-between bg-brand-cream/40">
    <div>
      <span class="text-xs font-semibold uppercase tracking-wider text-brand-primary block mb-1">Direct contact</span>
      <h3 class="font-display font-semibold text-xl text-brand-secondary">Stel uw vraag of vraag een offerte aan</h3>
    </div>
    
    <button 
      id="close-contact-drawer" 
      class="w-10 h-10 rounded-full bg-white border border-brand-dark/10 flex items-center justify-center text-brand-dark/60 hover:text-brand-secondary hover:bg-brand-cream transition-colors cursor-pointer shrink-0 shadow-sm"
      aria-label="Sluit contactformulier"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
  </div>

  <!-- Drawer Body: Form & Direct Contact Info -->
  <div class="p-6 sm:p-8 flex-1">
    
    <!-- Quick Contact Strip -->
    <div class="grid grid-cols-2 gap-3 mb-6">
      <a href="tel:0704447795" class="flex items-center gap-2.5 p-3 rounded-xl bg-brand-cream border border-brand-dark/5 hover:border-brand-primary/30 transition-all group">
        <div class="w-8 h-8 rounded-lg bg-brand-primary/10 flex items-center justify-center text-brand-primary shrink-0 group-hover:bg-brand-primary group-hover:text-white transition-colors">
          <i class="fa-solid fa-phone text-xs"></i>
        </div>
        <div class="min-w-0">
          <div class="text-[10px] text-brand-dark/50 font-medium uppercase">Bellen</div>
          <div class="text-xs font-semibold text-brand-secondary truncate">070 444 77 95</div>
        </div>
      </a>

      <a href="mailto:info@edusafe.nl" class="flex items-center gap-2.5 p-3 rounded-xl bg-brand-cream border border-brand-dark/5 hover:border-brand-primary/30 transition-all group">
        <div class="w-8 h-8 rounded-lg bg-brand-primary/10 flex items-center justify-center text-brand-primary shrink-0 group-hover:bg-brand-primary group-hover:text-white transition-colors">
          <i class="fa-solid fa-envelope text-xs"></i>
        </div>
        <div class="min-w-0">
          <div class="text-[10px] text-brand-dark/50 font-medium uppercase">Mailen</div>
          <div class="text-xs font-semibold text-brand-secondary truncate">info@edusafe.nl</div>
        </div>
      </a>
    </div>

    <!-- Form -->
    <form id="drawer-lead-form" class="flex flex-col gap-4">
      
      <!-- Name -->
      <div class="flex flex-col gap-1.5">
        <label for="drawer-name" class="text-xs font-semibold text-brand-secondary uppercase tracking-wider">Naam *</label>
        <input 
          type="text" 
          id="drawer-name" 
          name="name" 
          required 
          class="w-full bg-brand-cream border border-brand-dark/10 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:border-brand-primary focus:ring-1 focus:ring-brand-primary transition-all"
          placeholder="Uw volledige naam"
        />
      </div>

      <!-- Email & Phone Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="flex flex-col gap-1.5">
          <label for="drawer-email" class="text-xs font-semibold text-brand-secondary uppercase tracking-wider">E-mail *</label>
          <input 
            type="email" 
            id="drawer-email" 
            name="email" 
            required 
            class="w-full bg-brand-cream border border-brand-dark/10 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:border-brand-primary focus:ring-1 focus:ring-brand-primary transition-all"
            placeholder="naam@voorbeeld.nl"
          />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="drawer-phone" class="text-xs font-semibold text-brand-secondary uppercase tracking-wider">Telefoon *</label>
          <input 
            type="tel" 
            id="drawer-phone" 
            name="phone" 
            required 
            class="w-full bg-brand-cream border border-brand-dark/10 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:border-brand-primary focus:ring-1 focus:ring-brand-primary transition-all"
            placeholder="06 12345678"
          />
        </div>
      </div>

      <!-- Company -->
      <div class="flex flex-col gap-1.5">
        <label for="drawer-company" class="text-xs font-semibold text-brand-secondary uppercase tracking-wider">Bedrijfsnaam (optioneel)</label>
        <input 
          type="text" 
          id="drawer-company" 
          name="company" 
          class="w-full bg-brand-cream border border-brand-dark/10 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:border-brand-primary focus:ring-1 focus:ring-brand-primary transition-all"
          placeholder="Uw bedrijfsnaam"
        />
      </div>

      <!-- Training Selection -->
      <div class="flex flex-col gap-1.5">
        <label for="drawer-training" class="text-xs font-semibold text-brand-secondary uppercase tracking-wider">Onderwerp / Cursus</label>
        <select 
          id="drawer-training" 
          name="training" 
          class="w-full bg-brand-cream border border-brand-dark/10 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:border-brand-primary focus:ring-1 focus:ring-brand-primary transition-all cursor-pointer"
        >
          <option value="bhv">BHV Basis / Herhaling</option>
          <option value="ehbo">EHBO & Reanimatie / AED</option>
          <option value="vca">VCA Basis / VOL</option>
          <option value="heftruck">Heftruckcertificaat</option>
          <option value="incompany">Incompany Training Offerte</option>
          <option value="diensten">Brandveiligheid / RI&E / Noodverlichting</option>
          <option value="overig">Overige vraag</option>
        </select>
      </div>

      <!-- Message -->
      <div class="flex flex-col gap-1.5">
        <label for="drawer-message" class="text-xs font-semibold text-brand-secondary uppercase tracking-wider">Bericht / Toelichting</label>
        <textarea 
          id="drawer-message" 
          name="message" 
          rows="3" 
          class="w-full bg-brand-cream border border-brand-dark/10 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:border-brand-primary focus:ring-1 focus:ring-brand-primary transition-all resize-none"
          placeholder="Vertel ons kort wat u nodig heeft..."
        ></textarea>
      </div>

      <!-- Submit Button -->
      <button 
        type="submit" 
        class="w-full mt-2 font-display font-semibold text-sm bg-brand-accent hover:bg-brand-accent-hover text-white py-3.5 rounded-xl transition-all duration-300 shadow-[0_6px_20px_rgba(255,107,53,0.25)] hover:shadow-[0_8px_25px_rgba(255,107,53,0.4)] cursor-pointer text-center"
      >
        Bericht Verzenden
      </button>
    </form>

    <!-- Success Feedback Placeholder -->
    <div id="drawer-form-success" class="hidden flex flex-col items-center justify-center text-center p-6 bg-emerald-50 border border-emerald-200 rounded-2xl mt-4">
      <div class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600 mb-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
      </div>
      <h5 class="font-display font-semibold text-emerald-900 text-base mb-1">Bericht succesvol verzonden!</h5>
      <p class="text-xs text-emerald-700">Wij nemen binnen 1 werkdag contact met u op.</p>
    </div>

  </div>

  <!-- Drawer Footer -->
  <div class="p-6 border-t border-brand-dark/5 bg-brand-cream/30 text-center text-xs text-brand-dark/50">
    Edusafe &bull; Oude Middenweg 241A, Den Haag
  </div>
</aside>

<script>
  function initContactDrawer() {
    const backdrop = document.getElementById('contact-drawer-backdrop');
    const drawer = document.getElementById('contact-drawer');
    const closeBtn = document.getElementById('close-contact-drawer');
    const openBtns = document.querySelectorAll('[data-open-contact-drawer]');
    const drawerForm = document.getElementById('drawer-lead-form') as HTMLFormElement | null;
    const successMsg = document.getElementById('drawer-form-success');

    if (backdrop && drawer && closeBtn) {
      const openDrawer = (e?: Event) => {
        if (e) e.preventDefault();
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
        backdrop.classList.add('opacity-100', 'pointer-events-auto');
        drawer.classList.remove('translate-x-full');
        drawer.classList.add('translate-x-0');
        drawer.setAttribute('aria-hidden', 'false');
        document.body.classList.add('overflow-hidden');
      };

      const closeDrawer = () => {
        backdrop.classList.remove('opacity-100', 'pointer-events-auto');
        backdrop.classList.add('opacity-0', 'pointer-events-none');
        drawer.classList.remove('translate-x-0');
        drawer.classList.add('translate-x-full');
        drawer.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('overflow-hidden');
      };

      openBtns.forEach(btn => {
        btn.addEventListener('click', openDrawer);
      });

      closeBtn.addEventListener('click', closeDrawer);
      backdrop.addEventListener('click', closeDrawer);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && drawer.classList.contains('translate-x-0')) {
          closeDrawer();
        }
      });

      if (drawerForm && successMsg) {
        drawerForm.addEventListener('submit', (e) => {
          e.preventDefault();
          drawerForm.style.display = 'none';
          successMsg.classList.remove('hidden');
          setTimeout(() => {
            closeDrawer();
            setTimeout(() => {
              drawerForm.reset();
              drawerForm.style.display = 'flex';
              successMsg.classList.add('hidden');
            }, 400);
          }, 2500);
        });
      }
    }
  }

  initContactDrawer();
  document.addEventListener('astro:page-load', initContactDrawer);
</script>
