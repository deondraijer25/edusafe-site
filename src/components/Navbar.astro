        <a href={faqUrl} class="mobile-nav-link flex items-center justify-center px-3 py-2.5 min-h-[42px] rounded-xl bg-brand-cream/60 border border-brand-dark/5 text-xs font-semibold text-brand-secondary hover:border-brand-primary/30 text-center transition-colors">
          {t('nav.faq')}
