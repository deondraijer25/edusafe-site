      <!-- Mobile Direct Tappable Contact Info -->
      <div class="p-3.5 rounded-xl bg-brand-cream/70 border border-brand-dark/5 text-xs text-brand-dark/80 space-y-2.5 mt-1">
        <div class="flex items-center gap-2 font-semibold text-brand-secondary">
          <i class="fa-solid fa-location-dot text-brand-primary text-xs shrink-0"></i>
          <span>{t('topbar.address')}</span>
        </div>
        <div class="grid grid-cols-1 min-[360px]:grid-cols-2 gap-2">
          <a href="tel:0704447795" class="flex items-center justify-center gap-2 px-3 py-2.5 min-h-[42px] rounded-lg bg-white border border-brand-dark/10 font-semibold text-brand-secondary hover:border-brand-primary transition-colors">
            <i class="fa-solid fa-phone text-brand-primary text-[11px]"></i>
            <span>070 - 444 77 95</span>
          </a>
          <a href="mailto:info@edusafe.nl" class="flex items-center justify-center gap-2 px-3 py-2.5 min-h-[42px] rounded-lg bg-white border border-brand-dark/10 font-semibold text-brand-secondary hover:border-brand-primary transition-colors">
            <i class="fa-solid fa-envelope text-brand-primary text-[11px]"></i>
            <span>info@edusafe.nl</span>
          </a>
        </div>
      </div>

      <!-- Primary & Secondary Action Buttons (Clear Visual Hierarchy) -->
      <div class="pt-2 flex flex-col gap-2.5">
        <a 
          href={isEn ? "/en/personal-advice" : "/persoonlijk-advies"}
          class="mobile-nav-link font-display font-semibold text-sm text-center py-3.5 min-h-[48px] rounded-xl bg-brand-accent text-white hover:bg-brand-accent-hover transition-colors shadow-sm cursor-pointer flex items-center justify-center gap-2"
        >
          <span>{t('nav.direct_register')}</span>
          <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
        <a 
          href="https://edusafe.app.clientclub.net/" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="font-display font-semibold text-sm text-center py-3 min-h-[46px] rounded-xl bg-white border border-brand-dark/15 text-brand-secondary hover:border-brand-primary hover:text-brand-primary transition-colors flex items-center justify-center gap-2"
        >
          <i class="fa-regular fa-user text-xs text-brand-primary"></i>
          <span>{t('nav.login')}</span>
        </a>
      </div>
    </nav>
  </div>

</header>

<!-- Mobile Menu Dimming Backdrop (Sibling of <header> so header's backdrop-filter does not clip fixed inset-0) -->
<div
  id="mobile-menu-backdrop"
  class="lg:hidden hidden fixed inset-0 bg-brand-secondary/50 backdrop-blur-2xs z-40 transition-opacity duration-200"
  aria-hidden="true"
></div>

<script>
  function initMobileNavbar() {
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileDropdown = document.getElementById('mobile-dropdown');
    const mobileBackdrop = document.getElementById('mobile-menu-backdrop');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');
    const submenuToggles = document.querySelectorAll('.mobile-submenu-toggle');
    const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

    const closeMobileMenu = () => {
      if (!mobileDropdown || !hamburgerIcon || !closeIcon) return;
      mobileDropdown.classList.add('hidden');
      if (mobileBackdrop) mobileBackdrop.classList.add('hidden');
      hamburgerIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
      if (mobileBtn) mobileBtn.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('overflow-hidden');
    };

    const openMobileMenu = () => {
      if (!mobileDropdown || !hamburgerIcon || !closeIcon) return;
      mobileDropdown.classList.remove('hidden');
      if (mobileBackdrop) mobileBackdrop.classList.remove('hidden');
      hamburgerIcon.classList.add('hidden');
      closeIcon.classList.remove('hidden');
      if (mobileBtn) mobileBtn.setAttribute('aria-expanded', 'true');
      document.body.classList.add('overflow-hidden');
    };

    if (mobileBtn && mobileDropdown && hamburgerIcon && closeIcon) {
      mobileBtn.addEventListener('click', () => {
        const isHidden = mobileDropdown.classList.contains('hidden');
        if (isHidden) {
          openMobileMenu();
        } else {
          closeMobileMenu();
        }
      });

      if (mobileBackdrop) {
        mobileBackdrop.addEventListener('click', closeMobileMenu);
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !mobileDropdown.classList.contains('hidden')) {
          closeMobileMenu();
        }
      });

      window.addEventListener('resize', () => {
        if (window.innerWidth >= 1024 && !mobileDropdown.classList.contains('hidden')) {
          closeMobileMenu();
        }
      });

      mobileNavLinks.forEach(link => {
        link.addEventListener('click', closeMobileMenu);
      });
    }

    submenuToggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        const submenu = toggle.nextElementSibling;
        const arrow = toggle.querySelector('svg');
        if (submenu) {
          submenu.classList.toggle('hidden');
          if (arrow) {
            arrow.classList.toggle('rotate-180');
          }
        }
      });
    });

    // Desktop 2-Column Click Submenu for Cursussen (6 onder elkaar + 2e kolom rechts bij klik met oranje selectie)
    const coursesGroup = document.getElementById('courses-mega-group');
    const step2Views = document.querySelectorAll('[data-course-cat-step2]');
    const openCatBtns = document.querySelectorAll('[data-open-course-cat]');

    const setCategoryButtonState = (btn: Element, isActive: boolean) => {
      const iconBox = btn.querySelector('.cat-icon');
      const titleEl = btn.querySelector('.cat-title');
      const subEl = btn.querySelector('.cat-sub');
      const arrowEl = btn.querySelector('.cat-arrow');

      if (isActive) {
        btn.classList.add('bg-brand-accent', 'border-brand-accent', 'text-white', 'shadow-sm', 'is-active');
        btn.classList.remove('bg-brand-cream/45', 'hover:bg-brand-primary/5', 'border-brand-dark/5', 'hover:border-brand-primary/25');
        if (iconBox) {
          iconBox.classList.add('bg-white', 'text-brand-accent');
          iconBox.classList.remove('bg-brand-primary', 'text-white');
        }
        if (titleEl) {
          titleEl.classList.add('text-white');
          titleEl.classList.remove('text-brand-secondary', 'group-hover/srv:text-brand-primary');
        }
        if (subEl) {
          subEl.classList.add('text-white/85');
          subEl.classList.remove('text-brand-dark/60');
        }
        if (arrowEl) {
          arrowEl.classList.add('text-white', 'translate-x-0.5');
          arrowEl.classList.remove('text-brand-dark/30', 'group-hover/srv:text-brand-primary');
        }
      } else {
        btn.classList.remove('bg-brand-accent', 'border-brand-accent', 'text-white', 'shadow-sm', 'is-active');
        btn.classList.add('bg-brand-cream/45', 'hover:bg-brand-primary/5', 'border-brand-dark/5', 'hover:border-brand-primary/25');
        if (iconBox) {
          iconBox.classList.remove('bg-white', 'text-brand-accent');
          iconBox.classList.add('bg-brand-primary', 'text-white');
        }
        if (titleEl) {
          titleEl.classList.remove('text-white');
          titleEl.classList.add('text-brand-secondary', 'group-hover/srv:text-brand-primary');
        }
        if (subEl) {
          subEl.classList.remove('text-white/85');
          subEl.classList.add('text-brand-dark/60');
        }
        if (arrowEl) {
          arrowEl.classList.remove('text-white', 'translate-x-0.5');
          arrowEl.classList.add('text-brand-dark/30', 'group-hover/srv:text-brand-primary');
        }
      }
    };

    const resetCourseMenu = () => {
      openCatBtns.forEach((btn) => setCategoryButtonState(btn, false));
      step2Views.forEach((view) => {
        view.classList.add('hidden');
        view.classList.remove('flex');
      });
    };

    const toggleCourseCategory = (catId: string) => {
      let alreadyActive = false;
      openCatBtns.forEach((btn) => {
        if (btn.getAttribute('data-open-course-cat') === catId && btn.classList.contains('is-active')) {
          alreadyActive = true;
        }
      });

      if (alreadyActive) {
        resetCourseMenu();
        return;
      }

      openCatBtns.forEach((btn) => {
        const isMatch = btn.getAttribute('data-open-course-cat') === catId;
        setCategoryButtonState(btn, isMatch);
      });

      step2Views.forEach((view) => {
        const isMatch = view.getAttribute('data-course-cat-step2') === catId;
        if (isMatch) {
          view.classList.remove('hidden');
          view.classList.add('flex');
        } else {
          view.classList.add('hidden');
          view.classList.remove('flex');
        }
      });
    };

    openCatBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const catId = btn.getAttribute('data-open-course-cat');
        if (catId) toggleCourseCategory(catId);
      });
    });

    if (coursesGroup) {
      coursesGroup.addEventListener('mouseleave', () => {
        resetCourseMenu();
      });
    }
  }

  initMobileNavbar();
  document.addEventListener('astro:page-load', initMobileNavbar);
</script>
