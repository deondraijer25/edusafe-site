---
import { getLangFromUrl, useTranslations, getOppositeLocaleUrl } from '../i18n/utils';
import { languages } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const oppositeLocale = getOppositeLocaleUrl(Astro.url);

const homeUrl = lang === 'en' ? '/en' : '/';
const coursesUrl = lang === 'en' ? '/en/course-dates' : '/cursusdata';
const elearningUrl = lang === 'en' ? '/en/e-learning' : '/e-learning';
const offshoreUrl = lang === 'en' ? '/en/offshore-training' : '/offshore-cursus';
const aboutUrl = lang === 'en' ? '/en#about-us' : '/#over-ons';
const incompanyUrl = lang === 'en' ? '/en/incompany-training' : '/incompany-training';
---
<header class="w-full sticky top-0 left-0 z-50 bg-white/95 backdrop-blur-md border-b border-brand-dark/5 transition-all duration-300">
  
  <!-- Top Utility / Contact Bar -->
  <div class="w-full bg-brand-cream/80 border-b border-brand-dark/5 text-[13px] text-brand-dark/70 hidden md:block">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 h-10 flex items-center justify-between">
      
      <!-- Left: Prominent Flag Language Selector (Socials removed) -->
      <div class="flex items-center gap-1 bg-white/90 p-0.5 rounded-xl border border-brand-dark/10 shadow-xs">
        <a 
          href={lang === 'nl' ? undefined : (oppositeLocale.url || '/')} 
          class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-semibold transition-all ${lang === 'nl' ? 'bg-brand-accent text-white shadow-xs font-bold' : 'text-brand-dark/60 hover:text-brand-secondary hover:bg-brand-cream/50 cursor-pointer'}`}
          title="Nederlands (NL)"
        >
          <span class="text-sm leading-none">🇳🇱</span>
          <span>Nederlands</span>
        </a>

        <a 
          href={lang === 'en' ? undefined : (oppositeLocale.url || '/en')} 
          class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-semibold transition-all ${lang === 'en' ? 'bg-brand-accent text-white shadow-xs font-bold' : 'text-brand-dark/60 hover:text-brand-secondary hover:bg-brand-cream/50 cursor-pointer'}`}
          title="English (EN)"
        >
          <span class="text-sm leading-none">🇬🇧</span>
          <span>English</span>
        </a>
      </div>

      <!-- Right: Location, Direct Phone & Contact -->
      <div class="flex items-center gap-5 font-medium text-xs">
        <div class="flex items-center gap-1.5 hover:text-brand-dark transition-colors">
          <i class="fa-solid fa-location-dot text-brand-primary text-xs"></i>
          <span>{t('topbar.address')}</span>
        </div>
        
        <div class="h-3 w-px bg-brand-dark/10"></div>

        <a 
          href="tel:0704447795" 
          class="flex items-center gap-1.5 text-brand-secondary hover:text-brand-primary transition-colors font-semibold whitespace-nowrap"
        >
          <i class="fa-solid fa-phone text-brand-primary text-xs"></i>
          <span>070 - 444 77 95</span>
        </a>

        <div class="h-3 w-px bg-brand-dark/10"></div>

        <button 
          type="button"
          data-open-contact-drawer
          class="flex items-center gap-1.5 text-brand-secondary hover:text-brand-primary transition-colors font-semibold cursor-pointer group whitespace-nowrap"
        >
          <i class="fa-regular fa-envelope text-brand-primary text-xs group-hover:scale-110 transition-transform"></i>
          <span>{t('topbar.contact')}</span>
        </button>
      </div>

    </div>
  </div>

  <!-- Main Navigation Bar (Clean, Spacious & No Text Wrap) -->
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 w-full flex items-center justify-between h-[86px] lg:h-[94px] relative">
    
    <!-- Left: Logo (Precisely aligned with hero and content, slightly larger) -->
    <a href={homeUrl} class="flex items-center group shrink-0 mr-4 xl:mr-8 py-1" aria-label="Edusafe Home">
      <img 
        class="h-13 sm:h-16 lg:h-[70px] w-auto object-contain block transform group-hover:scale-[1.02] transition-transform duration-300" 
        src="/assets/images/edusafe_logo.png" 
        alt="Edusafe Logo" 
        height="70"
        width="160"
      />
    </a>

    <!-- Center Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-4 xl:gap-6.5 h-full">
      
      <!-- Cursussen Dropdown / Mega Menu -->
      <div class="group h-full flex items-center">
        <button class="font-display font-semibold text-[14px] xl:text-[15px] tracking-wide text-brand-secondary hover:text-brand-primary transition-colors flex items-center gap-1.5 py-4 focus:outline-none cursor-pointer whitespace-nowrap">
          {t('nav.courses')}
          <svg class="w-3.5 h-3.5 opacity-50 transition-transform duration-300 group-hover:rotate-180 text-brand-secondary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        
        <!-- Mega Menu Dropdown Card (Centered relative to the max-w-[1280px] header container) -->
        <div class="absolute top-[86px] lg:top-[94px] left-1/2 -translate-x-1/2 bg-white border border-brand-dark/8 shadow-2xl rounded-3xl p-7 w-[940px] max-w-[calc(100vw-48px)] transition-all duration-300 transform scale-95 opacity-0 pointer-events-none group-hover:scale-100 group-hover:opacity-100 group-hover:pointer-events-auto flex flex-col text-brand-secondary z-50">
          <div class="absolute -top-6 left-0 w-full h-6 bg-transparent"></div>
          
          <!-- Header -->
          <div class="mb-5 flex items-center justify-between border-b border-brand-dark/5 pb-4">
            <div>
              <h4 class="font-display font-semibold text-lg text-brand-secondary">Cursussen & Opleidingen</h4>
              <p class="text-[12px] text-brand-dark/65 font-medium">Praktijkgerichte en gecertificeerde veiligheidstrainingen.</p>
            </div>
            <a href="/cursusdata" class="text-xs font-semibold text-brand-primary hover:text-brand-secondary flex items-center gap-1">
              Bekijk alle cursusdata <i class="fa-solid fa-arrow-right text-[10px]"></i>
            </a>
          </div>

          <!-- 4 Columns Grid -->
          <div class="grid grid-cols-4 gap-3.5 items-stretch">
            
            <!-- Card 1: BHV -->
            <a href="/bhv-cursus" class="flex flex-col justify-between p-4 rounded-2xl bg-brand-cream/50 border border-brand-dark/5 hover:border-brand-primary/30 hover:bg-brand-primary/5 transition-all group/item duration-300 shadow-sm hover:scale-[1.02] h-[160px] text-left">
              <div>
                <div class="w-8 h-8 rounded-lg bg-brand-primary/10 flex items-center justify-center text-brand-primary mb-3 shrink-0 group-hover/item:bg-brand-primary group-hover/item:text-white transition-colors">
                  <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                </div>
                <span class="font-display font-semibold text-[13.5px] text-brand-secondary mb-1 block leading-tight">BHV Basis & Herhaling</span>
                <span class="text-[11px] text-brand-dark/65 leading-tight block">Brand, ontruiming en eerste hulp conform NIBHV.</span>
              </div>
            </a>

            <!-- Card 2: EHBO -->
            <a href="/ehbo-cursus" class="flex flex-col justify-between p-4 rounded-2xl bg-brand-cream/50 border border-brand-dark/5 hover:border-brand-primary/30 hover:bg-brand-primary/5 transition-all group/item duration-300 shadow-sm hover:scale-[1.02] h-[160px] text-left">
              <div>
                <div class="w-8 h-8 rounded-lg bg-brand-primary/10 flex items-center justify-center text-brand-primary mb-3 shrink-0 group-hover/item:bg-brand-primary group-hover/item:text-white transition-colors">
                  <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                  </svg>
                </div>
                <span class="font-display font-semibold text-[13.5px] text-brand-secondary mb-1 block leading-tight">EHBO</span>
                <span class="text-[11px] text-brand-dark/65 leading-tight block">Erkend door Het Oranje Kruis voor bedrijven & particulier.</span>
              </div>
            </a>

            <!-- Card 3: AED & Reanimatie -->
            <a href="/reanimatie-aed-cursus" class="flex flex-col justify-between p-4 rounded-2xl bg-brand-cream/50 border border-brand-dark/5 hover:border-brand-primary/30 hover:bg-brand-primary/5 transition-all group/item duration-300 shadow-sm hover:scale-[1.02] h-[160px] text-left">
              <div>
                <div class="w-8 h-8 rounded-lg bg-brand-primary/10 flex items-center justify-center text-brand-primary mb-3 shrink-0 group-hover/item:bg-brand-primary group-hover/item:text-white transition-colors">
                  <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                  </svg>
                </div>
                <span class="font-display font-semibold text-[13.5px] text-brand-secondary mb-1 block leading-tight">Reanimatie & AED</span>
                <span class="text-[11px] text-brand-dark/65 leading-tight block">Levensreddend handelen met een defibrillator.</span>
              </div>
            </a>

            <!-- Card 4: VCA -->
            <a href="/vca-cursus" class="flex flex-col justify-between p-4 rounded-2xl bg-brand-cream/50 border border-brand-dark/5 hover:border-brand-primary/30 hover:bg-brand-primary/5 transition-all group/item duration-300 shadow-sm hover:scale-[1.02] h-[160px] text-left">
              <div>
                <div class="w-8 h-8 rounded-lg bg-brand-primary/10 flex items-center justify-center text-brand-primary mb-3 shrink-0 group-hover/item:bg-brand-primary group-hover/item:text-white transition-colors">
                  <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                  </svg>
                </div>
                <span class="font-display font-semibold text-[13.5px] text-brand-secondary mb-1 block leading-tight">VCA Basis & VOL</span>
                <span class="text-[11px] text-brand-dark/65 leading-tight block">Veilig werken in bouw, techniek en industrie.</span>
              </div>
            </a>

            <!-- Card 5: Ontruiming -->
            <a href="/ontruiming-cursus" class="flex flex-col justify-between p-4 rounded-2xl bg-brand-cream/50 border border-brand-dark/5 hover:border-brand-primary/30 hover:bg-brand-primary/5 transition-all group/item duration-300 shadow-sm hover:scale-[1.02] h-[160px] text-left">
              <div>
                <div class="w-8 h-8 rounded-lg bg-brand-primary/10 flex items-center justify-center text-brand-primary mb-3 shrink-0 group-hover/item:bg-brand-primary group-hover/item:text-white transition-colors">
                  <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </div>
                <span class="font-display font-semibold text-[13.5px] text-brand-secondary mb-1 block leading-tight">Brand & Ontruiming</span>
                <span class="text-[11px] text-brand-dark/65 leading-tight block">Ontruimingsoefeningen en noodplannen.</span>
              </div>
            </a>

            <!-- Card 6: Heftruck -->
            <a href="/heftruck-cursus" class="flex flex-col justify-between p-4 rounded-2xl bg-brand-cream/50 border border-brand-dark/5 hover:border-brand-primary/30 hover:bg-brand-primary/5 transition-all group/item duration-300 shadow-sm hover:scale-[1.02] h-[160px] text-left">
              <div>
                <div class="w-8 h-8 rounded-lg bg-brand-primary/10 flex items-center justify-center text-brand-primary mb-3 shrink-0 group-hover/item:bg-brand-primary group-hover/item:text-white transition-colors">
                  <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <span class="font-display font-semibold text-[13.5px] text-brand-secondary mb-1 block leading-tight">Heftruck</span>
                <span class="text-[11px] text-brand-dark/65 leading-tight block">Veilig werken met intern transportmaterieel.</span>
              </div>
            </a>

            <!-- Card 7: Offshore -->
            <a href="/offshore-cursus" class="flex flex-col justify-between p-4 rounded-2xl bg-brand-cream/50 border border-brand-dark/5 hover:border-brand-primary/30 hover:bg-brand-primary/5 transition-all group/item duration-300 shadow-sm hover:scale-[1.02] h-[160px] text-left">
              <div>
                <div class="w-8 h-8 rounded-lg bg-brand-primary/10 flex items-center justify-center text-brand-primary mb-3 shrink-0 group-hover/item:bg-brand-primary group-hover/item:text-white transition-colors">
                  <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 22a10 10 0 100-20 10 10 0 000 20z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V3m0 15v3m-6-9H3m15 0h3m-3-6l-2 2m-8-2l2 2m8 8l-2-2m-8 2l2-2" />
                  </svg>
                </div>
                <span class="font-display font-semibold text-[13.5px] text-brand-secondary mb-1 block leading-tight">Offshore (OPITO)</span>
                <span class="text-[11px] text-brand-dark/65 leading-tight block">BOSIET & HUET veiligheidstrainingen op zee.</span>
              </div>
            </a>

            <!-- Card 8: Incompany Promo Card -->
            <a href="/incompany-training" class="flex flex-col justify-between p-4 rounded-2xl bg-brand-accent/10 border border-brand-accent/30 hover:bg-brand-accent/20 transition-all group/item duration-300 shadow-sm hover:scale-[1.02] h-[160px] text-left">
              <div>
                <div class="w-8 h-8 rounded-lg bg-brand-accent text-white flex items-center justify-center mb-3 shrink-0 shadow-sm">
                  <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                  </svg>
                </div>
                <span class="font-display font-semibold text-[13.5px] text-brand-secondary mb-1 block leading-tight">Incompany Training</span>
                <span class="text-[11px] text-brand-dark/80 leading-tight block">Op maat op uw eigen bedrijfslocatie.</span>
              </div>
              <span class="inline-flex items-center gap-1 font-display font-semibold text-[11px] text-brand-accent mt-auto">
                Offerte Aanvragen <i class="fa-solid fa-arrow-right text-[9px]"></i>
              </span>
            </a>

          </div>
        </div>
      </div>

      <a href={coursesUrl} class="font-display font-semibold text-[14px] xl:text-[15px] tracking-wide text-brand-secondary hover:text-brand-primary transition-colors py-4 whitespace-nowrap">
        {t('nav.course_dates')}
      </a>

      <a href={elearningUrl} class="font-display font-semibold text-[14px] xl:text-[15px] tracking-wide text-brand-secondary hover:text-brand-primary transition-colors py-4 whitespace-nowrap">
        {t('nav.elearning')}
      </a>

      <!-- Diensten Dropdown / Mega Menu -->
      <div class="group h-full flex items-center">
        <button class="font-display font-semibold text-[14px] xl:text-[15px] tracking-wide text-brand-secondary hover:text-brand-primary transition-colors flex items-center gap-1.5 py-4 focus:outline-none cursor-pointer whitespace-nowrap">
          {t('nav.services')}
          <svg class="w-3.5 h-3.5 opacity-50 transition-transform duration-300 group-hover:rotate-180 text-brand-secondary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        
        <!-- Diensten Mega Menu Dropdown Card -->
        <div class="absolute top-[86px] lg:top-[94px] left-1/2 -translate-x-1/2 bg-white border border-brand-dark/8 shadow-2xl rounded-3xl p-7 w-[940px] max-w-[calc(100vw-48px)] transition-all duration-300 transform scale-95 opacity-0 pointer-events-none group-hover:scale-100 group-hover:opacity-100 group-hover:pointer-events-auto flex flex-col text-brand-secondary z-50">
          <div class="absolute -top-6 left-0 w-full h-6 bg-transparent"></div>
          
          <!-- Header -->
          <div class="mb-5 flex items-center justify-between border-b border-brand-dark/5 pb-4">
            <div>
              <h4 class="font-display font-semibold text-lg text-brand-secondary">{t('nav.services')}</h4>
              <p class="text-[12px] text-brand-dark/65 font-medium">{t('nav.services_desc')}</p>
            </div>
            <button type="button" data-open-contact-drawer class="text-xs font-semibold text-brand-primary hover:text-brand-secondary flex items-center gap-1 cursor-pointer">
              Direct advies aanvragen <i class="fa-solid fa-arrow-right text-[10px]"></i>
            </button>
          </div>

          <!-- 4 Columns Grid -->
          <div class="grid grid-cols-4 gap-3.5 items-stretch">
            
            <!-- Card 1: RI&E Audit -->
            <button type="button" data-open-contact-drawer class="flex flex-col justify-between p-4 rounded-2xl bg-brand-cream/50 border border-brand-dark/5 hover:border-brand-primary/30 hover:bg-brand-primary/5 transition-all group/item duration-300 shadow-sm hover:scale-[1.02] h-[160px] text-left cursor-pointer">
              <div>
                <div class="w-8 h-8 rounded-lg bg-brand-primary/10 flex items-center justify-center text-brand-primary mb-3 shrink-0 group-hover/item:bg-brand-primary group-hover/item:text-white transition-colors">
                  <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                  </svg>
                </div>
                <span class="font-display font-semibold text-[13.5px] text-brand-secondary mb-1 block leading-tight">RI&E Audit</span>
                <span class="text-[11px] text-brand-dark/65 leading-tight block">Risico-Inventarisatie en Plan van Aanpak.</span>
              </div>
            </button>

            <!-- Card 2: Brandveiligheid -->
            <button type="button" data-open-contact-drawer class="flex flex-col justify-between p-4 rounded-2xl bg-brand-cream/50 border border-brand-dark/5 hover:border-brand-primary/30 hover:bg-brand-primary/5 transition-all group/item duration-300 shadow-sm hover:scale-[1.02] h-[160px] text-left cursor-pointer">
              <div>
                <div class="w-8 h-8 rounded-lg bg-brand-primary/10 flex items-center justify-center text-brand-primary mb-3 shrink-0 group-hover/item:bg-brand-primary group-hover/item:text-white transition-colors">
                  <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" />
                  </svg>
                </div>
                <span class="font-display font-semibold text-[13.5px] text-brand-secondary mb-1 block leading-tight">Brandveiligheid</span>
                <span class="text-[11px] text-brand-dark/65 leading-tight block">Onderhoud van blusmiddelen en haspels.</span>
              </div>
            </button>

            <!-- Card 3: Noodverlichting -->
            <button type="button" data-open-contact-drawer class="flex flex-col justify-between p-4 rounded-2xl bg-brand-cream/50 border border-brand-dark/5 hover:border-brand-primary/30 hover:bg-brand-primary/5 transition-all group/item duration-300 shadow-sm hover:scale-[1.02] h-[160px] text-left cursor-pointer">
              <div>
                <div class="w-8 h-8 rounded-lg bg-brand-primary/10 flex items-center justify-center text-brand-primary mb-3 shrink-0 group-hover/item:bg-brand-primary group-hover/item:text-white transition-colors">
                  <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                </div>
                <span class="font-display font-semibold text-[13.5px] text-brand-secondary mb-1 block leading-tight">Noodverlichting</span>
