---
import { getLangFromUrl, useTranslations, getOppositeLocaleUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const isEn = lang === 'en';
const t = useTranslations(lang);
const oppositeLocale = getOppositeLocaleUrl(Astro.url);

const homeUrl = isEn ? '/en' : '/';
const coursesUrl = isEn ? '/en/course-dates' : '/cursusdata';
const elearningUrl = isEn ? '/en/e-learning' : '/e-learning';
const offshoreUrl = isEn ? '/en/offshore-training' : '/offshore-cursus';
const incompanyUrl = isEn ? '/en/incompany-training' : '/incompany-training';

// Category URLs
const bhvUrl = isEn ? '/en/bhv-course' : '/bhv-cursus';
const ehboUrl = isEn ? '/en/first-aid-course' : '/ehbo-cursus';
const vcaUrl = isEn ? '/en/vca-course' : '/vca-cursus';
const transportUrl = isEn ? '/en/forklift-course' : '/heftruck-cursus';

// Sub-course & Service prefixes
const courseDetailPrefix = isEn ? '/en/courses' : '/cursussen';
const serviceDetailPrefix = isEn ? '/en/services' : '/diensten';
const evacuationPlansUrl = isEn ? '/en/evacuation-plans' : '/ontruimingsplattegronden';
const rieUrl = isEn ? '/en/risk-assessment-rie' : '/rie-audit';

// About & Legal URLs
const aboutUrl = isEn ? '/en/about-us' : '/over-ons';
const contactUrl = isEn ? '/en/contact' : '/contact';
const faqUrl = isEn ? '/en/faq' : '/faq';
const termsUrl = isEn ? '/en/terms-conditions' : '/algemene-voorwaarden';

const courseMenuCategories = [
  {
    id: 'bhv',
    title: 'BHV',
    step2Title: isEn ? 'BHV Courses' : 'BHV Opleidingen',
    subtitle: isEn ? 'Basic, refresher, team leader & evacuation' : 'Basis, herhaling, ploegleider & ontruiming',
    icon: 'fa-solid fa-shield-halved',
    hubUrl: bhvUrl,
    hubLabel: isEn ? 'Full BHV overview' : 'Volledig BHV-overzicht',
    items: [
      {
        title: isEn ? 'BHV Basic' : 'BHV Basis',
        sub: isEn ? 'Available in Dutch & English' : 'Beschikbaar in NL & EN',
        icon: 'fa-solid fa-shield-halved',
        href: `${courseDetailPrefix}/bhv-basis`
      },
      {
        title: isEn ? 'BHV Refresher' : 'BHV Herhaling',
        sub: isEn ? 'Half-day practical (NL & EN)' : '1 dagdeel praktijk (NL & EN)',
        icon: 'fa-solid fa-rotate',
        href: `${courseDetailPrefix}/bhv-herhaling`
      },
      {
        title: isEn ? 'BHV Team Leader' : 'BHV Ploegleider',
        sub: isEn ? 'Lead a BHV deployment' : 'Stuur een BHV-inzet aan',
        icon: 'fa-solid fa-users-gear',
        href: `${courseDetailPrefix}/bhv-ploegleider`
      },
      {
        title: isEn ? 'Head of BHV' : 'Hoofd BHV',
        sub: isEn ? 'Policy & BHV organization' : 'Beleid & BHV-organisatie',
        icon: 'fa-solid fa-user-tie',
        href: `${courseDetailPrefix}/hoofd-bhv`
      },
      {
        title: isEn ? 'Fire & Evacuation' : 'Brand en ontruiming',
        sub: isEn ? 'Practical firefighting & evacuation' : 'Praktijkmodule blussen & ontruimen',
        icon: 'fa-solid fa-fire-extinguisher',
        href: `${courseDetailPrefix}/brand-en-ontruiming`
      },
      {
        title: isEn ? 'Evacuation Drill' : 'Ontruimingsoefening',
        sub: isEn ? 'On-site drill + official report' : 'Op locatie incl. evaluatierapport',
        icon: 'fa-solid fa-person-running',
        href: `${courseDetailPrefix}/ontruimingsoefening`
      },
      {
        title: isEn ? 'Small Fire Extinguishers' : 'Kleine blusmiddelen',
        sub: isEn ? 'Hands-on extinguishing training' : 'Hands-on blussen op echt vuur',
        icon: 'fa-solid fa-fire',
        href: `${courseDetailPrefix}/kleine-blusmiddelen`
      },
      {
        title: isEn ? 'Two-Way Radio (Porto)' : 'Portotraining',
        sub: isEn ? 'Radio discipline in emergencies' : 'Etherdiscipline bij calamiteiten',
        icon: 'fa-solid fa-walkie-talkie',
        href: `${courseDetailPrefix}/portotraining`
      }
    ]
  },
  {
    id: 'ehbo',
    title: isEn ? 'First Aid & CPR' : 'EHBO & Reanimatie',
    step2Title: isEn ? 'First Aid & CPR' : 'EHBO & Reanimatie',
    subtitle: isEn ? 'First Aid basic, refresher, EHAK & AED' : 'EHBO basis, herhaling, EHAK & AED',
    icon: 'fa-solid fa-heart-pulse',
    hubUrl: ehboUrl,
    hubLabel: isEn ? 'Full First Aid overview' : 'Volledig EHBO-overzicht',
    items: [
      {
        title: isEn ? 'First Aid Basic' : 'EHBO Basis',
        sub: isEn ? 'Official Oranje Kruis diploma' : 'Officieel Het Oranje Kruis diploma',
        icon: 'fa-solid fa-kit-medical',
        href: `${courseDetailPrefix}/ehbo-basis`
      },
      {
        title: isEn ? 'First Aid Refresher' : 'EHBO Herhaling',
        sub: isEn ? 'Keep your diploma valid' : 'Verleng uw EHBO-diploma',
        icon: 'fa-solid fa-rotate',
        href: `${courseDetailPrefix}/ehbo-herhaling`
      },
      {
        title: isEn ? 'Paediatric First Aid (EHAK)' : 'EHAK (Kinder-EHBO)',
        sub: isEn ? 'Certified for childcare (IKK)' : 'Erkend voor kinderopvang (wet IKK)',
        icon: 'fa-solid fa-children',
        href: `${courseDetailPrefix}/ehak`
      },
      {
        title: isEn ? 'AED / CPR Resuscitation' : 'AED / Reanimatie',
        sub: isEn ? 'Act immediately in cardiac arrest' : 'Direct handelen bij hartstilstand',
        icon: 'fa-solid fa-heart-pulse',
        href: `${courseDetailPrefix}/aed-reanimatie`
      }
    ]
  },
  {
    id: 'vca',
    title: 'VCA & VCU',
    step2Title: isEn ? 'VCA & VCU Courses' : 'VCA & VCU Opleidingen',
    subtitle: isEn ? 'VCA Basic, VCA-VOL, VCU-VIL & exam' : 'VCA Basis, VCA-VOL, VCU-VIL & examen',
    icon: 'fa-solid fa-helmet-safety',
    hubUrl: vcaUrl,
    hubLabel: isEn ? 'Full VCA overview' : 'Volledig VCA-overzicht',
    items: [
      {
        title: isEn ? 'VCA Basic (B-VCA)' : 'VCA Basis (B-VCA)',
        sub: isEn ? '1-day course + official exam' : '1-daagse cursus + officieel examen',
        icon: 'fa-solid fa-helmet-safety',
        href: `${courseDetailPrefix}/vca-basis`
      },
      {
        title: 'VCA-VOL',
        sub: isEn ? 'For supervisors & freelancers (ZZP)' : 'Voor leidinggevenden & ZZP’ers',
        icon: 'fa-solid fa-clipboard-user',
        href: `${courseDetailPrefix}/vca-vol`
      },
      {
        title: 'VCU-VIL',
        sub: isEn ? 'For staffing & recruitment agencies' : 'Voor intercedenten & uitzendbureaus',
        icon: 'fa-solid fa-briefcase',
        href: `${courseDetailPrefix}/vcu-vil`
      },
      {
        title: isEn ? 'VCA Exam Only' : 'Los VCA-examen',
        sub: isEn ? 'Take the official exam directly (NL & EN)' : 'Direct examen afleggen (NL & EN)',
        icon: 'fa-solid fa-file-circle-check',
        href: `${courseDetailPrefix}/vca-examen`
      }
    ]
  },
  {
    id: 'transport',
    title: isEn ? 'Transport & Logistics' : 'Transport & Logistiek',
    step2Title: isEn ? 'Transport & Logistics' : 'Transport & Logistiek',
    subtitle: isEn ? 'Forklift, reach truck, MEWP & stacker' : 'Heftruck, reachtruck, hoogwerker & EPT',
    icon: 'fa-solid fa-truck-ramp-box',
    hubUrl: transportUrl,
    hubLabel: isEn ? 'Full Transport overview' : 'Volledig Transport-overzicht',
    items: [
      {
        title: isEn ? 'Forklift (Heftruck)' : 'Heftruck',
        sub: isEn ? 'Basic or refresher certificate' : 'Basis- of herhalingscertificaat',
        icon: 'fa-solid fa-truck-ramp-box',
        href: `${courseDetailPrefix}/heftruck`
      },
      {
        title: isEn ? 'Reach Truck' : 'Reachtruck',
        sub: isEn ? 'Safe working in narrow aisles' : 'Veilig werken in hoge stellingen',
        icon: 'fa-solid fa-boxes-stacked',
        href: `${courseDetailPrefix}/reachtruck`
      },
      {
        title: isEn ? 'Aerial Platform (MEWP)' : 'Hoogwerker',
        sub: isEn ? 'Safe working at height (cat. 1B/3A/3B)' : 'Veilig werken op hoogte (1B/3A/3B)',
        icon: 'fa-solid fa-up-down',
        href: `${courseDetailPrefix}/hoogwerker`
      },
      {
        title: isEn ? 'Pallet Stacker' : 'Stapelaar / EPT',
        sub: isEn ? 'Safe warehouse handling' : 'Veilig intern magazijntransport',
        icon: 'fa-solid fa-dolly',
        href: `${courseDetailPrefix}/stapelaar`
      }
    ]
  },
  {
    id: 'offshore',
    title: 'Offshore',
    step2Title: isEn ? 'Offshore Trainings' : 'Offshore Trainingen',
    subtitle: isEn ? 'BOSIET & OPITO safety trainings' : 'BOSIET & OPITO veiligheidstrainingen',
    icon: 'fa-solid fa-anchor',
    hubUrl: offshoreUrl,
    hubLabel: isEn ? 'Full Offshore overview' : 'Volledig Offshore-overzicht',
    items: [
      {
        title: 'BOSIET',
        sub: isEn ? 'Basic Offshore Safety Induction' : 'Basistraining offshore veiligheid',
        icon: 'fa-solid fa-anchor',
        href: `${courseDetailPrefix}/bosiet`
      },
      {
        title: 'OPITO Training',
        sub: isEn ? 'FOET, HUET & Escape Chute' : 'FOET, HUET & Escape Chute',
        icon: 'fa-solid fa-water',
        href: `${courseDetailPrefix}/opito`
      },
      {
        title: 'E-learning (NL & EN)',
        sub: isEn ? 'Online theory for BHV & VCA' : 'Online theorie voor BHV & VCA',
        icon: 'fa-solid fa-laptop',
        href: elearningUrl
      },
      {
        title: isEn ? 'Incompany Training' : 'Incompany op locatie',
        sub: isEn ? 'Tailored training at your company' : 'Maatwerk bij u op het bedrijf',
        icon: 'fa-solid fa-building',
        href: incompanyUrl
      }
    ]
  }
];
---
<header class="w-full sticky top-0 left-0 z-50 bg-white/95 backdrop-blur-md border-b border-brand-dark/5 transition-all duration-300">
  
  <!-- Top Utility / Contact Bar -->
  <div class="w-full bg-brand-cream/80 border-b border-brand-dark/5 text-[13px] text-brand-dark/70 hidden md:block">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 h-10 flex items-center justify-between">
      
      <!-- Left: Language Selector -->
      <div class="flex items-center gap-1 bg-white/90 p-0.5 rounded-xl border border-brand-dark/10 shadow-xs shrink-0">
        <a 
          href={lang === 'nl' ? undefined : (oppositeLocale.url || '/')} 
          class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-semibold transition-all ${lang === 'nl' ? 'bg-brand-accent text-white shadow-xs font-bold' : 'text-brand-dark/60 hover:text-brand-secondary hover:bg-brand-cream/50 cursor-pointer'}`}
          title="Nederlands (NL)"
        >
          <svg class="w-4 h-3 rounded-[2px] overflow-hidden shadow-2xs shrink-0" viewBox="0 0 640 480" aria-hidden="true">
            <path fill="#21468b" d="M0 0h640v480H0z"/>
            <path fill="#fff" d="M0 0h640v320H0z"/>
            <path fill="#ae1c28" d="M0 0h640v160H0z"/>
          </svg>
          <span>Nederlands</span>
        </a>

        <a 
          href={lang === 'en' ? undefined : (oppositeLocale.url || '/en')} 
          class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-semibold transition-all ${lang === 'en' ? 'bg-brand-accent text-white shadow-xs font-bold' : 'text-brand-dark/60 hover:text-brand-secondary hover:bg-brand-cream/50 cursor-pointer'}`}
          title="English (EN)"
        >
          <svg class="w-4 h-3 rounded-[2px] overflow-hidden shadow-2xs shrink-0" viewBox="0 0 60 30" aria-hidden="true">
            <path d="M0 0v30h60V0z" fill="#012169"/>
            <path d="M0 0l60 30m0-30L0 30" stroke="#fff" stroke-width="6"/>
            <path d="M0 0l60 30m0-30L0 30" stroke="#C8102E" stroke-width="4"/>
            <path d="M30 0v30M0 15h60" stroke="#fff" stroke-width="10"/>
            <path d="M30 0v30M0 15h60" stroke="#C8102E" stroke-width="6"/>
          </svg>
          <span>English</span>
        </a>
      </div>

      <!-- Right: Address with Postcode, Direct Phone & Direct Contact with Opening Hours -->
      <div class="flex items-center gap-4 lg:gap-5 font-medium text-xs">
        <div class="flex items-center gap-1.5 hover:text-brand-dark transition-colors">
          <i class="fa-solid fa-location-dot text-brand-primary text-xs"></i>
          <span>{t('topbar.address')}</span>
        </div>
        
        <div class="h-3 w-px bg-brand-dark/10"></div>

        <a 
          href="tel:0704447795" 
          class="flex items-center gap-1.5 text-brand-secondary hover:text-brand-primary transition-colors font-semibold whitespace-nowrap"
        >
          <i class="fa-solid fa-phone text-brand-primary text-xs"></i>
          <span>070 - 444 77 95</span>
        </a>

        <div class="h-3 w-px bg-brand-dark/10"></div>

        <!-- Direct Contact link + Hover Info Popover -->
        <div class="relative group/topcontact">
          <a 
            href={contactUrl}
            class="flex items-center gap-1.5 text-brand-secondary hover:text-brand-primary transition-colors font-semibold cursor-pointer whitespace-nowrap py-1"
          >
            <i class="fa-regular fa-envelope text-brand-primary text-xs group-hover/topcontact:scale-110 transition-transform"></i>
            <span>{t('topbar.contact')}</span>
          </a>
          <div class="absolute right-0 top-full pt-2 w-80 opacity-0 pointer-events-none group-hover/topcontact:opacity-100 group-hover/topcontact:pointer-events-auto transition-all duration-200 z-[60]">
            <div class="bg-brand-secondary text-white p-4 rounded-2xl shadow-xl border border-white/10 text-xs leading-relaxed">
              <strong class="text-brand-accent block mb-1">{isEn ? "Have a question?" : "Heb je een vraag?"}</strong>
              {isEn
                ? "Our team is available by phone on weekdays from 08:30 to 17:00. We answer emails within 24 hours."
                : "Ons team staat telefonisch op werkdagen van 08:30-17:00 voor u klaar. Mail beantwoorden wij binnen 24 uur."}
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 w-full flex items-center justify-between h-[72px] sm:h-[84px] lg:h-[94px] relative">
    
    <!-- Left: Logo -->
    <a href={homeUrl} class="flex items-center group shrink-0 mr-4 xl:mr-6 py-1" aria-label="Edusafe Home">
      <img 
        class="h-11 sm:h-14 lg:h-[68px] w-auto object-contain block transform group-hover:scale-[1.02] transition-transform duration-300" 
        src="/assets/images/edusafe_logo.png" 
        alt="Edusafe Logo" 
        height="68"
        width="156"
      />
    </a>

    <!-- Center Desktop Navigation Links: Cursussen, Diensten, E-learning, Offshore, Brandveiligheid -->
    <nav class="hidden lg:flex items-center gap-5 xl:gap-7 h-full">
      
      <!-- 1. CURSUSSEN / COURSES: 6 items onder elkaar (identiek aan Diensten) + 2e kolom rechts bij klik met oranje selectie -->
      <div class="group relative h-full flex items-center" id="courses-mega-group">
        <a href={bhvUrl} class="font-display font-semibold text-[14px] xl:text-[15px] tracking-wide text-brand-secondary hover:text-brand-primary transition-colors flex items-center gap-1.5 py-4 focus:outline-none cursor-pointer whitespace-nowrap">
          <span>{isEn ? "Courses" : "Cursussen"}</span>
          <svg class="w-3.5 h-3.5 opacity-50 transition-transform duration-300 group-hover:rotate-180 text-brand-secondary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
        
        <div class="absolute top-[86px] lg:top-[94px] left-0 transition-all duration-300 transform scale-95 opacity-0 pointer-events-none group-hover:scale-100 group-hover:opacity-100 group-hover:pointer-events-auto flex items-start gap-2.5 text-brand-secondary z-50">
          <div class="absolute -top-6 left-0 w-full h-6 bg-transparent"></div>
          
          <!-- KOLOM 1: 6 Categorieën onder elkaar (100% identiek aan Diensten) -->
          <div class="w-[330px] bg-white border border-brand-dark/8 shadow-2xl rounded-2xl p-3.5 flex flex-col shrink-0">
            <div class="flex flex-col gap-1.5">
              {courseMenuCategories.map((cat) => (
                <button
                  type="button"
                  data-open-course-cat={cat.id}
                  class="w-full text-left p-2.5 rounded-xl bg-brand-cream/45 hover:bg-brand-primary/5 border border-brand-dark/5 hover:border-brand-primary/25 transition-all flex items-center justify-between gap-3 group/srv cursor-pointer"
                >
                  <div class="flex items-center gap-3 min-w-0">
                    <div class="cat-icon w-8 h-8 rounded-lg bg-brand-primary text-white flex items-center justify-center text-xs shrink-0 transition-colors">
                      <i class={cat.icon}></i>
                    </div>
                    <div class="min-w-0">
                      <span class="cat-title font-display font-semibold text-[13px] text-brand-secondary group-hover/srv:text-brand-primary transition-colors block leading-tight truncate">
                        {cat.title}
                      </span>
                      <span class="cat-sub font-sans text-[11px] text-brand-dark/60 block mt-0.5 truncate transition-colors">
                        {cat.subtitle}
                      </span>
                    </div>
                  </div>
                  <i class="cat-arrow fa-solid fa-chevron-right text-[10px] text-brand-dark/30 group-hover/srv:text-brand-primary group-hover/srv:translate-x-0.5 transition-all shrink-0"></i>
                </button>
              ))}

              <!-- 6. Incompany op locatie (Direct link) -->
              <a
                href={incompanyUrl}
                class="w-full text-left p-2.5 rounded-xl bg-brand-cream/45 hover:bg-brand-primary/5 border border-brand-dark/5 hover:border-brand-primary/25 transition-all flex items-center justify-between gap-3 group/srv cursor-pointer"
              >
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-8 h-8 rounded-lg bg-brand-primary text-white flex items-center justify-center text-xs shrink-0">
                    <i class="fa-solid fa-building"></i>
                  </div>
                  <div class="min-w-0">
                    <span class="font-display font-semibold text-[13px] text-brand-secondary group-hover/srv:text-brand-primary transition-colors block leading-tight truncate">
                      {isEn ? "Incompany Training" : "Incompany op locatie"}
                    </span>
                    <span class="font-sans text-[11px] text-brand-dark/60 block mt-0.5 truncate">
                      {isEn ? "Tailored training at your company" : "Maatwerk bij u op het bedrijf"}
                    </span>
                  </div>
                </div>
                <i class="fa-solid fa-arrow-right text-[10px] text-brand-dark/30 group-hover/srv:text-brand-primary group-hover/srv:translate-x-0.5 transition-all shrink-0"></i>
              </a>
            </div>

            <div class="mt-2.5 pt-2.5 border-t border-brand-dark/5">
              <a href={coursesUrl} class="w-full font-display font-semibold text-xs bg-brand-accent text-white hover:bg-brand-accent-hover py-2.5 px-3.5 rounded-xl flex items-center justify-center gap-1.5 cursor-pointer transition-colors shadow-xs">
                <span>{isEn ? "View all course dates" : "Alle cursusdata bekijken"}</span>
                <i class="fa-solid fa-arrow-right text-[10px]"></i>
              </a>
            </div>
          </div>

          <!-- KOLOM 2: Opent rechts naast Kolom 1 zodra je op een categorie klikt -->
          {courseMenuCategories.map((cat) => (
            <div data-course-cat-step2={cat.id} class="hidden w-[330px] bg-white border border-brand-dark/8 shadow-2xl rounded-2xl p-3.5 flex-col shrink-0">
              <div class="px-1 pb-2.5 mb-2 border-b border-brand-dark/5 flex items-center justify-between">
                <span class="font-display font-semibold text-[13px] text-brand-secondary">
                  {cat.step2Title}
                </span>
                <span class="text-[11px] font-medium text-brand-dark/45">
                  {cat.items.length} {isEn ? "courses" : "cursussen"}
                </span>
              </div>

              <div class="flex flex-col gap-1.5 max-h-[370px] overflow-y-auto pr-0.5">
                {cat.items.map((item) => (
                  <a
                    href={item.href}
                    class="w-full text-left p-2.5 rounded-xl bg-brand-cream/45 hover:bg-brand-primary/5 border border-brand-dark/5 hover:border-brand-primary/25 transition-all flex items-center justify-between gap-3 group/srv cursor-pointer"
                  >
                    <div class="flex items-center gap-3 min-w-0">
                      <div class="w-8 h-8 rounded-lg bg-brand-primary text-white flex items-center justify-center text-xs shrink-0">
                        <i class={item.icon}></i>
                      </div>
                      <div class="min-w-0">
                        <span class="font-display font-semibold text-[13px] text-brand-secondary group-hover/srv:text-brand-primary transition-colors block leading-tight truncate">
                          {item.title}
                        </span>
                        <span class="font-sans text-[11px] text-brand-dark/60 block mt-0.5 truncate">
                          {item.sub}
                        </span>
                      </div>
                    </div>
                    <i class="fa-solid fa-arrow-right text-[10px] text-brand-dark/30 group-hover/srv:text-brand-primary group-hover/srv:translate-x-0.5 transition-all shrink-0"></i>
                  </a>
                ))}
              </div>

              <div class="mt-2.5 pt-2.5 border-t border-brand-dark/5">
                <a href={cat.hubUrl} class="w-full font-display font-semibold text-xs bg-brand-accent text-white hover:bg-brand-accent-hover py-2.5 px-3.5 rounded-xl flex items-center justify-center gap-1.5 cursor-pointer transition-colors shadow-xs">
                  <span>{cat.hubLabel}</span>
                  <i class="fa-solid fa-arrow-right text-[10px]"></i>
                </a>
              </div>
            </div>
          ))}

        </div>
      </div>

      <!-- 2. DIENSTEN / SERVICES: 6 items onder elkaar (100% identiek aan Cursussen) -->
      <div class="group relative h-full flex items-center">
        <a href={`${serviceDetailPrefix}/keuringen`} class="font-display font-semibold text-[14px] xl:text-[15px] tracking-wide text-brand-secondary hover:text-brand-primary transition-colors flex items-center gap-1.5 py-4 focus:outline-none cursor-pointer whitespace-nowrap">
          <span>{isEn ? "Services" : "Diensten"}</span>
          <svg class="w-3.5 h-3.5 opacity-50 transition-transform duration-300 group-hover:rotate-180 text-brand-secondary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
        
        <div class="absolute top-[86px] lg:top-[94px] left-0 w-[330px] bg-white border border-brand-dark/8 shadow-2xl rounded-2xl p-3.5 transition-all duration-300 transform scale-95 opacity-0 pointer-events-none group-hover:scale-100 group-hover:opacity-100 group-hover:pointer-events-auto flex flex-col text-brand-secondary z-50">
          <div class="absolute -top-6 left-0 w-full h-6 bg-transparent"></div>

          <div class="flex flex-col gap-1.5">
            <!-- 1. Keuringen -->
