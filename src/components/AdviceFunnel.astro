<script is:inline define:vars={{ isEn, initialFallbackEvents }}>
  (function () {
    // Normalize any event record (local fallback or live GHL /api/events)
    function mapToSubjectCard(category, slug, title) {
      const c = String(category || '').toLowerCase();
      const s = String(slug || '').toLowerCase();
      const t = String(title || '').toLowerCase();
      if (
        c.includes('ehbo') ||
        c.includes('first aid') ||
        c.includes('ehak') ||
        c.includes('aed') ||
        s.includes('ehbo') ||
        s.includes('ehak') ||
        s.includes('aed') ||
        t.includes('ehbo') ||
        t.includes('ehak') ||
        t.includes('reanimatie') ||
        t.includes('first aid')
      ) {
        return 'EHBO & Reanimatie';
      }
      if (c.includes('vca') || s.includes('vca') || s.includes('vcu') || t.includes('vca')) {
        return 'VCA Certificering';
      }
      if (
        c.includes('heftruck') ||
        c.includes('transport') ||
        s.includes('heftruck') ||
        s.includes('reachtruck') ||
        s.includes('hoogwerker') ||
        s.includes('stapelaar') ||
        t.includes('heftruck') ||
        t.includes('forklift') ||
        t.includes('hoogwerker')
      ) {
        return 'Intern Transport';
      }
      if (
        c.includes('offshore') ||
        s.includes('bosiet') ||
        s.includes('opito') ||
        t.includes('bosiet') ||
        t.includes('offshore')
      ) {
        return 'Offshore & E-learning';
      }
      return 'BHV Opleidingen';
    }

    function normalizeEvent(raw) {
      const id = String(raw.id || '');
      const title = String(raw.title || '');
      const courseSlug = String(raw.courseSlug || 'bhv-basis');
      const category = String(raw.category || 'BHV');
      const date = String(raw.date || '');
      const time = String(raw.time || '');
      const location = String(
        raw.location || (isEn ? 'Edusafe Main Location The Hague' : 'Edusafe Hoofdlocatie Den Haag')
      );
      const price = String(raw.price || '');
      const isOnRequest =
        !date || /aanvraag|request/i.test(date) || /aanvraag|request/i.test(String(raw.freeSpots || ''));

      const hasExplicitSpotsField = raw.spots !== undefined && raw.spots !== null;
      const hasCapacityLimit = hasExplicitSpotsField
        ? Number(raw.spots) > 0
        : typeof raw.freeSpots === 'string' && /\d+/.test(raw.freeSpots);

      let freeSpotsCount = null;
      if (hasCapacityLimit) {
        if (typeof raw.freeSpots === 'number') {
          freeSpotsCount = raw.freeSpots;
        } else if (typeof raw.freeSpots === 'string') {
          const numMatch = raw.freeSpots.match(/\d+/);
          if (numMatch) freeSpotsCount = parseInt(numMatch[0], 10);
        }
      }

      const isFull =
        String(raw.status || '').toLowerCase() === 'vol' ||
        (hasCapacityLimit && freeSpotsCount !== null && freeSpotsCount <= 0);

      let freeSpotsLabel = '';
      if (isFull) {
        freeSpotsLabel = isEn ? 'Full' : 'Volgeboekt';
      } else if (hasCapacityLimit && freeSpotsCount !== null && freeSpotsCount > 0) {
        freeSpotsLabel = isEn ? `${freeSpotsCount} open` : `${freeSpotsCount} vrij`;
      } else {
        freeSpotsLabel = isEn ? 'Available' : 'Beschikbaar';
      }

      return {
        id,
        title,
        courseSlug,
        category,
        subjectCard: mapToSubjectCard(category, courseSlug, title),
        date,
        time,
        location,
        price,
        isOnRequest,
        freeSpotsCount,
        freeSpotsLabel,
        isFull,
      };
    }

    let allEvents = Array.isArray(initialFallbackEvents)
      ? initialFallbackEvents.map(normalizeEvent).filter((e) => !e.isOnRequest)
      : [];

    const state = {
      step: 1,
      flowMode: 'standard', // 'standard' | 'praktijkdag_shortcut' | 'direct_contact'
      praktijkdagTab: 'BHV Opleidingen',
      customerType: '',
      customerLabel: '',
      selectedSubjects: [], // Array of { value, label, group }
      selectedSubtopics: [], // Array of specific course/service labels
      situationKey: '', // 'open_enrollment' | 'elearning_completed' | 'incompany' | 'corporate_advice' | service keys
      situationValue: '',
      situationLabel: '',
      selectedEventId: '', // Concrete event ID or 'custom_date' or ''
      participantsCount: 1,
      showAllDates: false,
      prefilledItem: null,
    };

    const subtopicsByCategory = {
      'BHV Opleidingen': isEn
        ? ['BHV Basic', 'BHV Refresher', 'BHV Team Leader', 'Evacuation Drill']
        : ['BHV Basis', 'BHV Herhaling', 'Ploegleider BHV', 'Ontruimingsoefening'],
      'EHBO & Reanimatie': isEn
        ? ['First Aid Basic', 'First Aid Refresher', 'CPR & AED', 'Child First Aid (EHAK)']
        : ['EHBO Basis', 'EHBO Herhaling', 'Reanimatie & AED', 'Kinder-EHBO (EHAK)'],
      'VCA Certificering': isEn
        ? ['B-VCA Basic', 'VOL-VCA', 'VCA E-learning', 'Standalone VCA Exam']
        : ['B-VCA Basis', 'VOL-VCA', 'VCA E-learning', 'Los VCA Examen'],
      'Intern Transport': isEn
        ? ['Forklift', 'Reach Truck', 'Aerial Platform', 'EPT / Stacker']
        : ['Heftruck', 'Reachtruck', 'Hoogwerker', 'EPT / Stapelaar'],
      'Offshore & E-learning': isEn
        ? ['BOSIET / OPITO', 'NEN 3140 VOP/VP', 'Confined Spaces', 'Online E-learning']
        : ['BOSIET / OPITO', 'NEN 3140 VOP/VP', 'Besloten Ruimten', 'Online E-learning'],
      'Keuringen & Diensten': isEn
        ? ['NEN 3140 Inspection', 'SCIOS Scope 8/10/12', 'RI&E & Action Plan', 'Fire Extinguishers (REOB)', 'Evacuation Plans', 'Safety Staffing / Fire Watch']
        : ['NEN 3140 Keuring', 'SCIOS Scope 8/10/12', 'RI&E & Plan van Aanpak', 'Blusmiddelen (REOB)', 'Ontruimingsplattegronden', 'Brandwacht / Detachering'],
    };

    const prefillCatalog = {
      // BHV
      'bhv-basis': {
        title: isEn ? 'Emergency Response (BHV) Basic Course' : 'BHV Basiscursus',
        categoryCard: 'BHV Opleidingen',
        categoryLabel: 'BHV',
        group: 'opleiding',
        isCategoryHub: false,
        duration: isEn ? 'E-learning + 1 Practical Day' : 'E-learning + 1 Praktijkdag',
      },
      'bhv-herhaling': {
        title: isEn ? 'Emergency Response (BHV) Refresher' : 'BHV Herhalingscursus',
        categoryCard: 'BHV Opleidingen',
        categoryLabel: 'BHV',
        group: 'opleiding',
        isCategoryHub: false,
        duration: isEn ? '1 Practical Day (or Half Day)' : '1 Praktijkdag (of dagdeel)',
      },
      'bhv-e-learning': {
        title: isEn ? 'BHV Blended (E-learning + Practical)' : 'BHV Blended (E-learning + Praktijkdag)',
        categoryCard: 'BHV Opleidingen',
        categoryLabel: 'BHV',
