---
import { courses as fallbackCoursesNl } from '../data/courses.js';
import { courses_en as fallbackCoursesEn } from '../data/courses_en.js';

interface Props {
  lang?: 'nl' | 'en';
}

const { lang = 'nl' } = Astro.props;
const isEn = lang === 'en';
const initialFallbackEvents = isEn ? fallbackCoursesEn : fallbackCoursesNl;
---

<main class="w-full bg-brand-cream min-h-[calc(100vh-80px)] pt-8 sm:pt-12 md:pt-14 pb-16 relative overflow-hidden flex items-start">
  <section class="w-full max-w-[760px] mx-auto px-4 sm:px-6 relative z-10">
    
    <!-- Wrapper met het herkenbare Edusafe 3/4-cirkel logo-element achter de aanvraagstraat -->
    <div class="relative">
      
      <!-- Edusafe Logo-Cirkel Achtergrond die royaal aan de rechterzijde achter het formulier uitspringt -->
      <div
        aria-hidden="true"
        class="pointer-events-none select-none absolute -right-36 sm:-right-56 md:-right-72 lg:-right-80 top-1/2 -translate-y-1/2 w-[480px] h-[480px] sm:w-[600px] sm:h-[600px] md:w-[680px] md:h-[680px] -z-10"
      >
        <svg viewBox="0 0 680 680" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full drop-shadow-2xl -scale-x-100">
          <defs>
            <linearGradient id="edusafeCircleGrad" x1="40" y1="40" x2="640" y2="640" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#0E56B5" />
              <stop offset="60%" stop-color="#0C4EA2" />
              <stop offset="100%" stop-color="#07326B" />
            </linearGradient>
          </defs>
          <!-- Volle Edusafe-blauwe cirkel die voor ~3/4 rechts naast de kaart uitspringt -->
          <circle cx="330" cy="340" r="305" fill="url(#edusafeCircleGrad)" />
          <!-- Subtiele 3/4e buitenboog (accentueert de 3/4e vorm) -->
          <path
            d="M 555 115 A 328 328 0 1 0 555 565"
            stroke="#0C4EA2"
            stroke-opacity="0.25"
            stroke-width="2.5"
            stroke-linecap="round"
          />
          <!-- Subtiele 3/4e binnenboog op de blauwe cirkel voor extra diepte -->
          <path
            d="M 510 160 A 265 265 0 1 0 510 520"
            stroke="#FFFFFF"
            stroke-opacity="0.16"
            stroke-width="1.5"
            stroke-dasharray="6 8"
            stroke-linecap="round"
          />
        </svg>
      </div>

      <!-- Single Centered Unified Street Card -->
      <div
        id="wizard-card-container"
        class="bg-white rounded-3xl shadow-2xl shadow-[#062856]/15 border border-brand-dark/8 p-4 min-[375px]:p-5 sm:p-8 md:p-10 scroll-mt-24 relative z-10"
      >
        <!-- Integrated Compact Step Progress Bar -->
        <div id="wizard-progress-header" class="mb-6 pb-5 border-b border-brand-dark/8">
          <div class="flex items-center justify-between gap-3 mb-3">
            <a
              href={isEn ? '/en' : '/'}
              class="inline-flex items-center gap-1.5 text-brand-dark/55 hover:text-[#0C4EA2] transition-colors font-semibold text-xs group"
            >
              <i class="fa-solid fa-arrow-left text-[10px] group-hover:-translate-x-0.5 transition-transform"></i>
              <span>{isEn ? 'Back to website' : 'Terug naar website'}</span>
            </a>

            <div class="flex items-center gap-3">
              <button
                type="button"
                id="reset-wizard-btn"
                class="text-xs font-semibold text-brand-dark/50 hover:text-brand-accent transition-colors cursor-pointer hidden"
              >
                <i class="fa-solid fa-rotate-left mr-1 text-[10px]"></i>
                {isEn ? 'Start over' : 'Opnieuw beginnen'}
              </button>
              <span class="text-[11px] font-medium text-brand-dark/50">
                <i class="fa-regular fa-clock mr-1 text-[#0C4EA2]"></i>
                {isEn ? '< 1 min' : '< 1 minuut'}
              </span>
            </div>
          </div>

          <div class="flex items-center justify-between gap-2 mb-2">
            <span id="wizard-step-eyebrow" class="text-[11px] font-bold uppercase tracking-wider text-[#0C4EA2]">
              {isEn ? 'Step 1 of 3 • Subject' : 'Stap 1 van 3 • Onderwerp'}
            </span>
          </div>

          <div class="grid grid-cols-3 gap-2" id="wizard-progress-steps">
            <button
              type="button"
              data-step-nav="1"
              aria-label={isEn ? 'Step 1' : 'Stap 1'}
              class="step-indicator h-2 rounded-full bg-[#0C4EA2] transition-all cursor-pointer"
            ></button>
            <button
              type="button"
              data-step-nav="2"
              disabled
              aria-label={isEn ? 'Step 2' : 'Stap 2'}
              class="step-indicator h-2 rounded-full bg-brand-dark/10 transition-all cursor-not-allowed"
            ></button>
            <button
              type="button"
              data-step-nav="3"
              disabled
              aria-label={isEn ? 'Step 3' : 'Stap 3'}
              class="step-indicator h-2 rounded-full bg-brand-dark/10 transition-all cursor-not-allowed"
            ></button>
          </div>
        </div>

        <!-- Pre-filled Course / Service Context Banner (Shown when arriving via ?course=... or ?service=...) -->
        <div
          id="prefill-context-banner"
          class="hidden mb-6 p-3.5 rounded-2xl bg-[#0C4EA2]/[0.05] border border-[#0C4EA2]/20 items-center justify-between gap-3"
        >
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-8 h-8 rounded-xl bg-[#0C4EA2] text-white flex items-center justify-center text-xs shrink-0">
              <i class="fa-solid fa-check"></i>
            </div>
            <div class="min-w-0">
              <p id="prefill-context-title" class="font-display font-bold text-sm text-brand-secondary leading-snug"></p>
              <p id="prefill-context-sub" class="text-xs text-brand-dark/65 leading-snug"></p>
            </div>
          </div>
          <button
            type="button"
            id="prefill-change-btn"
            class="shrink-0 text-xs font-semibold text-[#0C4EA2] hover:text-brand-secondary underline underline-offset-2 cursor-pointer"
          >
            {isEn ? 'Change' : 'Wijzigen'}
          </button>
        </div>

        <!-- ========================================== -->
        <!-- STEP 1: WAAR KUNNEN WIJ U MEE HELPEN?      -->
        <!-- ========================================== -->
        <div id="wizard-step-1" class="wizard-panel flex flex-col justify-between space-y-6">
          <div class="space-y-5">
            <div>
              <h1 class="heading-card text-brand-secondary">
                {isEn ? 'How can we help you?' : 'Waar kunnen wij u mee helpen?'}
              </h1>
              <p id="step-1-subtitle" class="text-card text-brand-dark/65 mt-1">
                {isEn
                  ? 'Select one or more topics below, or choose a quick option directly.'
                  : 'Kies één of meerdere onderwerpen, of gebruik direct een snelkeuze.'}
              </p>
            </div>

            <!-- 6 Subject Cards + 2 Quick-Action Shortcut Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5" id="step-1-cards-grid">
              <!-- 1. BHV -->
              <button
                type="button"
                data-subject-card="BHV Opleidingen"
                data-subject-label={isEn ? 'BHV Courses' : 'BHV Opleidingen'}
                data-subject-group="opleiding"
                class="subject-card group text-left p-4 rounded-2xl border-2 border-brand-dark/8 hover:border-[#0C4EA2] bg-brand-cream/25 hover:bg-[#0C4EA2]/[0.03] transition-all cursor-pointer flex items-center justify-between gap-3"
              >
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-10 h-10 rounded-xl bg-[#0C4EA2]/10 text-[#0C4EA2] flex items-center justify-center text-sm shrink-0 group-hover:bg-[#0C4EA2] group-hover:text-white group-[.is-selected]:bg-[#0C4EA2] group-[.is-selected]:text-white transition-colors">
                    <i class="fa-solid fa-fire-extinguisher"></i>
                  </div>
                  <div class="min-w-0">
                    <h2 class="heading-tile text-brand-secondary leading-snug">
                      {isEn ? 'BHV Courses' : 'BHV Opleidingen'}
                    </h2>
                    <p class="text-xs text-brand-dark/65 mt-0.5 leading-snug">
                      {isEn ? 'Basic, Refresher & Team Leader' : 'Basis, Herhaling & Ploegleider'}
                    </p>
                  </div>
                </div>
                <span class="cat-check-circle w-5 h-5 rounded-full border-2 border-brand-dark/20 group-hover:border-[#0C4EA2] flex items-center justify-center text-transparent shrink-0 transition-all">
                  <i class="fa-solid fa-check text-[9px]"></i>
                </span>
              </button>

              <!-- 2. EHBO -->
              <button
                type="button"
                data-subject-card="EHBO & Reanimatie"
                data-subject-label={isEn ? 'First Aid & CPR' : 'EHBO & Reanimatie'}
                data-subject-group="opleiding"
                class="subject-card group text-left p-4 rounded-2xl border-2 border-brand-dark/8 hover:border-[#0C4EA2] bg-brand-cream/25 hover:bg-[#0C4EA2]/[0.03] transition-all cursor-pointer flex items-center justify-between gap-3"
              >
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-10 h-10 rounded-xl bg-[#0C4EA2]/10 text-[#0C4EA2] flex items-center justify-center text-sm shrink-0 group-hover:bg-[#0C4EA2] group-hover:text-white group-[.is-selected]:bg-[#0C4EA2] group-[.is-selected]:text-white transition-colors">
                    <i class="fa-solid fa-kit-medical"></i>
                  </div>
                  <div class="min-w-0">
                    <h2 class="heading-tile text-brand-secondary leading-snug">
                      {isEn ? 'First Aid & CPR' : 'EHBO & Reanimatie'}
                    </h2>
                    <p class="text-xs text-brand-dark/65 mt-0.5 leading-snug">
                      {isEn ? 'First Aid, AED & Child First Aid' : 'EHBO, AED & Kinder-EHBO'}
                    </p>
                  </div>
                </div>
                <span class="cat-check-circle w-5 h-5 rounded-full border-2 border-brand-dark/20 group-hover:border-[#0C4EA2] flex items-center justify-center text-transparent shrink-0 transition-all">
                  <i class="fa-solid fa-check text-[9px]"></i>
                </span>
              </button>

              <!-- 3. VCA -->
              <button
                type="button"
                data-subject-card="VCA Certificering"
                data-subject-label={isEn ? 'VCA Certification' : 'VCA Certificering'}
                data-subject-group="opleiding"
                class="subject-card group text-left p-4 rounded-2xl border-2 border-brand-dark/8 hover:border-[#0C4EA2] bg-brand-cream/25 hover:bg-[#0C4EA2]/[0.03] transition-all cursor-pointer flex items-center justify-between gap-3"
              >
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-10 h-10 rounded-xl bg-[#0C4EA2]/10 text-[#0C4EA2] flex items-center justify-center text-sm shrink-0 group-hover:bg-[#0C4EA2] group-hover:text-white group-[.is-selected]:bg-[#0C4EA2] group-[.is-selected]:text-white transition-colors">
                    <i class="fa-solid fa-helmet-safety"></i>
                  </div>
                  <div class="min-w-0">
                    <h2 class="heading-tile text-brand-secondary leading-snug">
                      {isEn ? 'VCA Certification' : 'VCA Certificering'}
                    </h2>
                    <p class="text-xs text-brand-dark/65 mt-0.5 leading-snug">
                      {isEn ? 'B-VCA, VOL-VCA & Exam' : 'B-VCA, VOL-VCA & Examen'}
                    </p>
                  </div>
                </div>
                <span class="cat-check-circle w-5 h-5 rounded-full border-2 border-brand-dark/20 group-hover:border-[#0C4EA2] flex items-center justify-center text-transparent shrink-0 transition-all">
                  <i class="fa-solid fa-check text-[9px]"></i>
                </span>
              </button>

              <!-- 4. Intern Transport -->
              <button
                type="button"
                data-subject-card="Intern Transport"
                data-subject-label={isEn ? 'Internal Transport' : 'Intern Transport'}
                data-subject-group="opleiding"
                class="subject-card group text-left p-4 rounded-2xl border-2 border-brand-dark/8 hover:border-[#0C4EA2] bg-brand-cream/25 hover:bg-[#0C4EA2]/[0.03] transition-all cursor-pointer flex items-center justify-between gap-3"
              >
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-10 h-10 rounded-xl bg-[#0C4EA2]/10 text-[#0C4EA2] flex items-center justify-center text-sm shrink-0 group-hover:bg-[#0C4EA2] group-hover:text-white group-[.is-selected]:bg-[#0C4EA2] group-[.is-selected]:text-white transition-colors">
                    <i class="fa-solid fa-truck-ramp-box"></i>
                  </div>
                  <div class="min-w-0">
                    <h2 class="heading-tile text-brand-secondary leading-snug">
                      {isEn ? 'Internal Transport' : 'Intern Transport'}
                    </h2>
                    <p class="text-xs text-brand-dark/65 mt-0.5 leading-snug">
                      {isEn ? 'Forklift, Reach Truck & Aerial' : 'Heftruck, Reachtruck & Hoogwerker'}
                    </p>
                  </div>
                </div>
                <span class="cat-check-circle w-5 h-5 rounded-full border-2 border-brand-dark/20 group-hover:border-[#0C4EA2] flex items-center justify-center text-transparent shrink-0 transition-all">
                  <i class="fa-solid fa-check text-[9px]"></i>
                </span>
              </button>

              <!-- 5. Offshore & E-learning -->
              <button
                type="button"
                data-subject-card="Offshore & E-learning"
                data-subject-label={isEn ? 'Offshore & E-learning' : 'Offshore & E-learning'}
                data-subject-group="opleiding"
                class="subject-card group text-left p-4 rounded-2xl border-2 border-brand-dark/8 hover:border-[#0C4EA2] bg-brand-cream/25 hover:bg-[#0C4EA2]/[0.03] transition-all cursor-pointer flex items-center justify-between gap-3"
              >
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-10 h-10 rounded-xl bg-[#0C4EA2]/10 text-[#0C4EA2] flex items-center justify-center text-sm shrink-0 group-hover:bg-[#0C4EA2] group-hover:text-white group-[.is-selected]:bg-[#0C4EA2] group-[.is-selected]:text-white transition-colors">
                    <i class="fa-solid fa-water"></i>
                  </div>
                  <div class="min-w-0">
                    <h2 class="heading-tile text-brand-secondary leading-snug">
                      {isEn ? 'Offshore & E-learning' : 'Offshore & E-learning'}
                    </h2>
                    <p class="text-xs text-brand-dark/65 mt-0.5 leading-snug">
                      {isEn ? 'BOSIET, OPITO & Online theory' : 'BOSIET, OPITO & Online theorie'}
                    </p>
                  </div>
                </div>
                <span class="cat-check-circle w-5 h-5 rounded-full border-2 border-brand-dark/20 group-hover:border-[#0C4EA2] flex items-center justify-center text-transparent shrink-0 transition-all">
                  <i class="fa-solid fa-check text-[9px]"></i>
                </span>
              </button>

              <!-- 6. Keuringen & Diensten -->
              <button
                type="button"
                data-subject-card="Keuringen & Diensten"
                data-subject-label={isEn ? 'Inspections & Services' : 'Keuringen & Diensten'}
                data-subject-group="diensten"
                class="subject-card group text-left p-4 rounded-2xl border-2 border-brand-dark/8 hover:border-[#0C4EA2] bg-brand-cream/25 hover:bg-[#0C4EA2]/[0.03] transition-all cursor-pointer flex items-center justify-between gap-3"
              >
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-10 h-10 rounded-xl bg-[#0C4EA2]/10 text-[#0C4EA2] flex items-center justify-center text-sm shrink-0 group-hover:bg-[#0C4EA2] group-hover:text-white group-[.is-selected]:bg-[#0C4EA2] group-[.is-selected]:text-white transition-colors">
                    <i class="fa-solid fa-clipboard-check"></i>
                  </div>
                  <div class="min-w-0">
                    <h2 class="heading-tile text-brand-secondary leading-snug">
                      {isEn ? 'Inspections & Services' : 'Keuringen & Diensten'}
                    </h2>
                    <p class="text-xs text-brand-dark/65 mt-0.5 leading-snug">
                      {isEn ? 'NEN 3140, RI&E & Safety staffing' : 'NEN 3140, RI&E & Veiligheidspersoneel'}
                    </p>
                  </div>
                </div>
                <span class="cat-check-circle w-5 h-5 rounded-full border-2 border-brand-dark/20 group-hover:border-[#0C4EA2] flex items-center justify-center text-transparent shrink-0 transition-all">
                  <i class="fa-solid fa-check text-[9px]"></i>
                </span>
              </button>

              <!-- 7. Snelkeuze A: E-learning afgerond -> Praktijkdag plannen (Helder Edusafe-blauw accent) -->
              <button
                type="button"
                id="praktijkdag-shortcut-btn"
                class="group text-left p-4 rounded-2xl border-2 border-[#0C4EA2]/30 hover:border-[#0C4EA2] bg-[#0C4EA2]/[0.06] hover:bg-[#0C4EA2] transition-all cursor-pointer flex items-center justify-between gap-3 shadow-xs hover:shadow-md hover:shadow-[#0C4EA2]/20"
              >
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-10 h-10 rounded-xl bg-[#0C4EA2] text-white flex items-center justify-center text-sm shrink-0 group-hover:bg-white group-hover:text-[#0C4EA2] transition-colors shadow-xs">
                    <i class="fa-solid fa-graduation-cap"></i>
                  </div>
                  <div class="min-w-0">
                    <h2 class="heading-tile text-brand-secondary group-hover:text-white leading-snug transition-colors">
                      {isEn ? 'E-learning completed?' : 'E-learning afgerond?'}
                    </h2>
                    <p class="text-xs text-brand-dark/75 group-hover:text-white/90 mt-0.5 leading-snug transition-colors">
                      {isEn ? 'Pick a practical day date directly' : 'Kies direct een datum voor uw praktijkdag'}
                    </p>
                  </div>
                </div>
                <span class="w-7 h-7 rounded-full bg-[#0C4EA2] text-white group-hover:bg-white group-hover:text-[#0C4EA2] flex items-center justify-center shrink-0 transition-all shadow-xs">
                  <i class="fa-solid fa-arrow-right text-[10px] group-hover:translate-x-0.5 transition-transform"></i>
                </span>
              </button>

              <!-- 8. Snelkeuze B: Direct contact of algemene vraag (Opvallend Oranje) -->
              <button
                type="button"
                id="direct-contact-card-btn"
                class="group text-left p-4 rounded-2xl border-2 border-brand-accent/40 hover:border-brand-accent bg-brand-accent/[0.08] hover:bg-brand-accent transition-all cursor-pointer flex items-center justify-between gap-3 shadow-xs hover:shadow-md hover:shadow-brand-accent/20"
              >
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-10 h-10 rounded-xl bg-brand-accent text-white flex items-center justify-center text-sm shrink-0 group-hover:bg-white group-hover:text-brand-accent transition-colors shadow-xs">
                    <i class="fa-solid fa-headset"></i>
                  </div>
                  <div class="min-w-0">
                    <h2 class="heading-tile text-brand-secondary group-hover:text-white leading-snug transition-colors">
                      {isEn ? 'Direct contact or question' : 'Direct contact of vraag'}
                    </h2>
                    <p class="text-xs text-brand-dark/75 group-hover:text-white/90 mt-0.5 leading-snug transition-colors">
                      {isEn ? 'Send a message or view phone details' : 'Bericht sturen of onze gegevens bekijken'}
                    </p>
                  </div>
                </div>
                <span class="w-7 h-7 rounded-full bg-brand-accent text-white group-hover:bg-white group-hover:text-brand-accent flex items-center justify-center shrink-0 transition-all shadow-xs">
                  <i class="fa-solid fa-arrow-right text-[10px] group-hover:translate-x-0.5 transition-transform"></i>
                </span>
              </button>
            </div>
          </div>

          <!-- Bottom Navigation Bar -->
          <div class="pt-4 border-t border-brand-dark/8 flex flex-col-reverse sm:flex-row items-stretch sm:items-center justify-between gap-3">
            <span class="inline-flex items-center justify-center sm:justify-start gap-1.5 text-xs text-brand-dark/55 text-center sm:text-left">
              <i class="fa-solid fa-shield-halved text-[#0C4EA2]"></i>
              {isEn ? 'Direct booking or advice within 1 working day' : 'Direct inschrijven of advies binnen 1 werkdag'}
            </span>
            <button
              type="button"
              id="step-1-next-btn"
              disabled
              class="btn-base w-full sm:w-auto justify-center min-h-[48px] bg-brand-accent hover:bg-brand-accent-hover disabled:bg-brand-dark/15 disabled:text-brand-dark/40 disabled:cursor-not-allowed text-white shadow-xs cursor-pointer"
            >
              <span>{isEn ? 'Next step' : 'Volgende stap'}</span>
              <i class="fa-solid fa-arrow-right text-xs"></i>
            </button>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- STEP 2: UW SITUATIE & DIRECTE DATUMKEUZE   -->
        <!-- ========================================== -->
        <div id="wizard-step-2" class="wizard-panel hidden flex-col justify-between space-y-6">
          <div class="space-y-5">
            <div>
              <h2 class="heading-card text-brand-secondary" id="step-2-heading">
                {isEn ? 'What best fits your situation?' : 'Wat past het beste bij uw situatie?'}
              </h2>
              <p class="text-card text-brand-dark/65 mt-1" id="step-2-subtitle">
                {isEn
                  ? 'Choose direct enrollment on an open date, practical day, or tailored in-company proposal.'
                  : 'Kies directe inschrijving op een datum, praktijkdag na E-learning, of een Incompany voorstel.'}
              </p>
            </div>

            <!-- Praktijkdag Snelkeuze Categorie-Tabs (Alleen zichtbaar in Praktijkdag-shortcut modus) -->
            <div id="step-2-praktijkdag-tabs-wrap" class="hidden space-y-2">
              <label class="block text-xs font-semibold uppercase tracking-wider text-brand-secondary">
                {isEn ? 'Choose your completed E-learning course' : 'Kies de opleiding waarvoor u de E-learning heeft afgerond'}
              </label>
              <div id="step-2-praktijkdag-tabs" class="flex flex-wrap gap-2"></div>
            </div>

            <!-- Compacte optionele specificatie-chips per gekozen vakgebied -->
            <div id="step-2-subtopics-wrapper" class="hidden space-y-2">
              <label class="block text-xs font-semibold uppercase tracking-wider text-brand-secondary">
                {isEn
                  ? 'Specific course or service (optional — filters available dates)'
                  : 'Specifieke training of dienst (optioneel — filtert beschikbare data)'}
              </label>
              <div id="step-2-subtopics-grid" class="flex flex-wrap gap-2"></div>
            </div>

            <!-- 4 Compact Situation Cards in 2x2 Grid -->
            <div id="step-2-situation-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 items-stretch"></div>

            <!-- INLINE LIVE GHL CURSUSDATA PICKER (Zichtbaar bij Open inschrijving 1-5p of Praktijkdag na E-learning) -->
            <div
              id="step-2-datepicker-box"
              class="hidden rounded-2xl border border-[#0C4EA2]/20 bg-[#0C4EA2]/[0.03] p-4 sm:p-5 space-y-3.5"
            >
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 pb-3 border-b border-brand-dark/8">
                <div class="flex items-center gap-2">
                  <i class="fa-regular fa-calendar-check text-[#0C4EA2] text-sm"></i>
                  <span id="datepicker-box-title" class="font-display font-bold text-sm text-brand-secondary">
                    {isEn ? 'Choose an available course date (The Hague)' : 'Kies een beschikbare cursusdatum (Den Haag)'}
                  </span>
                </div>

                <!-- Deelnemers teller (1 t/m 5 — alleen bij Nieuwe Open Inschrijving) -->
                <div id="step-2-participants-bar" class="flex items-center justify-between sm:justify-start gap-2">
                  <span class="text-xs font-semibold text-brand-dark/65">
