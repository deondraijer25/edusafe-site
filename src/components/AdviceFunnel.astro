    const praktijkdagTabsConfig = [
      { card: 'BHV Opleidingen', label: isEn ? 'BHV (NL & EN)' : 'BHV (NL & EN)' },
      { card: 'EHBO & Reanimatie', label: isEn ? 'First Aid & Child First Aid' : 'EHBO & Kinder-EHBO' },
      { card: 'VCA Certificering', label: isEn ? 'VCA Exam / Day' : 'VCA Dag / Examen' },
      { card: 'ALL', label: isEn ? 'All practical dates' : 'Alle praktijkdata' },
    ];

    const panels = {
      1: document.getElementById('wizard-step-1'),
      2: document.getElementById('wizard-step-2'),
      3: document.getElementById('wizard-step-3'),
    };

    const stepIndicators = document.querySelectorAll('.step-indicator');
    const stepEyebrow = document.getElementById('wizard-step-eyebrow');
    const resetBtn = document.getElementById('reset-wizard-btn');
    const step1NextBtn = document.getElementById('step-1-next-btn');
    const step2NextBtn = document.getElementById('step-2-next-btn');

    function getStepEyebrowText(stepNum) {
      if (stepNum === 1) {
        return isEn ? 'Step 1 of 3 • Subject' : 'Stap 1 van 3 • Onderwerp';
      }
      if (stepNum === 2) {
        if (state.flowMode === 'praktijkdag_shortcut') {
          return isEn ? 'Step 2 of 3 • Pick Practical Date' : 'Stap 2 van 3 • Kies Praktijkdatum';
        }
        return isEn ? 'Step 2 of 3 • Situation & Date' : 'Stap 2 van 3 • Uw Situatie & Datum';
      }
      const isDirectBooking = isConcreteEventSelected();
      if (isDirectBooking) {
        return isEn ? 'Step 3 of 3 • Confirm Enrollment' : 'Stap 3 van 3 • Bevestig Inschrijving';
      }
      return isEn ? 'Step 3 of 3 • Your Details' : 'Stap 3 van 3 • Uw Gegevens';
    }

    function isConcreteEventSelected() {
      if (state.flowMode === 'direct_contact') return false;
      const isDateFlow =
        state.flowMode === 'praktijkdag_shortcut' ||
        state.situationKey === 'open_enrollment' ||
        state.situationKey === 'elearning_completed';
      return Boolean(
        isDateFlow && state.selectedEventId && state.selectedEventId !== 'custom_date'
      );
    }

    function getSelectedEventObject() {
      if (!isConcreteEventSelected()) return null;
      return allEvents.find((ev) => String(ev.id) === String(state.selectedEventId)) || null;
    }

    function updateSummary() {
      if (resetBtn) {
        if (
          state.selectedSubjects.length > 0 ||
          state.flowMode !== 'standard' ||
          state.selectedEventId
        ) {
          resetBtn.classList.remove('hidden');
        } else {
          resetBtn.classList.add('hidden');
        }
      }
    }

    function scrollToWizardTop() {
      window.scrollTo({
        top: 0,
        behavior: 'smooth',
      });
    }

    function goToStep(stepNum, skipScroll) {
      state.step = stepNum;
      if (stepEyebrow) {
        stepEyebrow.textContent = getStepEyebrowText(stepNum);
      }

      Object.keys(panels).forEach((k) => {
        const panel = panels[k];
        if (!panel) return;
        if (Number(k) === stepNum) {
          panel.classList.remove('hidden');
          panel.classList.add('flex');
        } else {
          panel.classList.add('hidden');
          panel.classList.remove('flex');
        }
      });

      stepIndicators.forEach((btn) => {
        const s = Number(btn.getAttribute('data-step-nav'));
        const isSkippedDirect = state.flowMode === 'direct_contact' && s === 2;

        if (isSkippedDirect) {
          btn.disabled = true;
          btn.className = 'step-indicator h-2 rounded-full bg-[#0C4EA2]/35 transition-all cursor-not-allowed';
        } else if (s < stepNum) {
          btn.disabled = false;
          btn.className = 'step-indicator h-2 rounded-full bg-emerald-500 transition-all cursor-pointer';
        } else if (s === stepNum) {
          btn.disabled = false;
          btn.className = 'step-indicator h-2 rounded-full bg-[#0C4EA2] transition-all cursor-pointer';
        } else {
          btn.disabled = true;
          btn.className = 'step-indicator h-2 rounded-full bg-brand-dark/10 transition-all cursor-not-allowed';
        }
      });

      updateSummary();
      if (!skipScroll) {
        scrollToWizardTop();
      }
    }

    function syncStep1CardStyles() {
      const selectedValues = state.selectedSubjects.map((s) => s.value);
      document.querySelectorAll('.subject-card').forEach((card) => {
        const val = card.getAttribute('data-subject-card') || '';
        const isSelected = selectedValues.includes(val);
        const cc = card.querySelector('.cat-check-circle');
        if (isSelected) {
          card.classList.add('is-selected', 'border-[#0C4EA2]', 'bg-[#0C4EA2]/[0.04]');
          if (cc) {
            cc.className =
              'cat-check-circle w-5 h-5 rounded-full border-2 border-[#0C4EA2] bg-[#0C4EA2] flex items-center justify-center text-white shrink-0 transition-all';
          }
        } else {
          card.classList.remove('is-selected', 'border-[#0C4EA2]', 'bg-[#0C4EA2]/[0.04]');
          if (cc) {
            cc.className =
              'cat-check-circle w-5 h-5 rounded-full border-2 border-brand-dark/20 group-hover:border-[#0C4EA2] flex items-center justify-center text-transparent shrink-0 transition-all';
          }
        }
      });
      if (step1NextBtn) {
        step1NextBtn.disabled = state.selectedSubjects.length === 0;
      }
    }

    function isOnlyDienstenSelected() {
      return (
        state.flowMode === 'standard' &&
        state.selectedSubjects.length > 0 &&
        state.selectedSubjects.every((s) => s.group === 'diensten')
      );
    }

    function getActiveStep2Options() {
      return isOnlyDienstenSelected() ? step2Scenarios.diensten : step2Scenarios.opleiding;
    }

    // Filter live GHL events based on chosen course / subtopics / category
    function getMatchingEventsForCurrentState() {
      if (state.flowMode === 'praktijkdag_shortcut') {
        if (state.praktijkdagTab === 'ALL') return allEvents;
        return allEvents.filter((ev) => ev.subjectCard === state.praktijkdagTab);
      }

      // Check specific prefilled course slug first
      if (state.prefilledItem && !state.prefilledItem.isCategoryHub) {
        const slug = state.prefilledItem.slug;
        const exactMatches = allEvents.filter((ev) => {
          if (ev.courseSlug === slug) return true;
          const t = ev.title.toLowerCase();
          if ((slug === 'bhv-basis' || slug === 'bhv-e-learning') && t.includes('bhv') && t.includes('basis')) return true;
          if (slug === 'bhv-herhaling' && t.includes('bhv') && t.includes('herhaling')) return true;
          if ((slug === 'vca-basis' || slug === 'vca-e-learning') && t.includes('vca') && t.includes('basis')) return true;
          if (slug === 'vca-vol' && t.includes('vca') && t.includes('vol')) return true;
          if ((slug === 'ehak' || slug === 'ehak-kinderen' || slug === 'ehbo-kinderen') && (ev.courseSlug === 'ehak' || t.includes('ehak') || t.includes('kinder'))) return true;
          if ((slug === 'aed-reanimatie' || slug === 'reanimatie-aed') && (ev.courseSlug === 'aed-reanimatie' || t.includes('aed') || t.includes('reanimatie'))) return true;
          if ((slug.startsWith('heftruck') || slug === 'hoogwerker') && ev.courseSlug === 'heftruck') return true;
          return false;
        });
        return exactMatches;
      }

      const activeCards = state.selectedSubjects
        .filter((s) => s.group === 'opleiding')
        .map((s) => s.value);

      let pool = allEvents.filter((ev) => activeCards.includes(ev.subjectCard));

      // Refine by subtopic chips if any were clicked
      if (state.selectedSubtopics.length > 0) {
        const chipFiltered = pool.filter((ev) => {
          const t = ev.title.toLowerCase();
          const s = ev.courseSlug.toLowerCase();
          return state.selectedSubtopics.some((chip) => {
            const c = chip.toLowerCase();
            if (c.includes('basis') || c.includes('basic')) return t.includes('basis') || t.includes('basic') || s.includes('basis');
            if (c.includes('herhaling') || c.includes('refresher')) return t.includes('herhaling') || t.includes('refresher') || s.includes('herhaling');
            if (c.includes('kinder') || c.includes('child') || c.includes('ehak')) return s === 'ehak' || t.includes('ehak') || t.includes('kinder');
            if (c.includes('aed') || c.includes('reanimatie') || c.includes('cpr')) return s === 'aed-reanimatie' || t.includes('aed') || t.includes('reanimatie');
            if (c.includes('vol')) return t.includes('vol') || s.includes('vol');
            if (c.includes('ploegleider') || c.includes('team leader')) return s.includes('ploegleider') || t.includes('ploegleider');
            if (c.includes('ontruiming') || c.includes('evacuation')) return s.includes('ontruiming') || t.includes('ontruiming');
            if (c.includes('heftruck') || c.includes('forklift') || c.includes('hoogwerker') || c.includes('aerial')) return s === 'heftruck';
            return false;
          });
        });
        if (chipFiltered.length > 0) {
          pool = chipFiltered;
        }
      }

      return pool;
    }

    function renderStep2PraktijkdagTabs() {
      const wrap = document.getElementById('step-2-praktijkdag-tabs-wrap');
      const container = document.getElementById('step-2-praktijkdag-tabs');
      if (!wrap || !container) return;

      if (state.flowMode !== 'praktijkdag_shortcut') {
        wrap.classList.add('hidden');
        return;
      }

      wrap.classList.remove('hidden');
      container.innerHTML = praktijkdagTabsConfig
        .map((tab) => {
          const active = state.praktijkdagTab === tab.card;
          return `<button
            type="button"
            data-pday-tab="${tab.card}"
            class="px-3.5 py-2 rounded-xl text-xs font-bold border transition-all cursor-pointer ${
              active
                ? 'bg-[#0C4EA2] text-white border-[#0C4EA2] shadow-xs'
                : 'bg-brand-cream/50 text-brand-secondary border-brand-dark/12 hover:border-[#0C4EA2]'
            }"
          >${tab.label}</button>`;
        })
        .join('');

      container.querySelectorAll('[data-pday-tab]').forEach((btn) => {
        btn.addEventListener('click', () => {
          state.praktijkdagTab = btn.getAttribute('data-pday-tab') || 'BHV Opleidingen';
          state.selectedEventId = '';
          state.showAllDates = false;
          renderStep2();
        });
      });
    }

    function renderStep2Subtopics() {
      const wrap = document.getElementById('step-2-subtopics-wrapper');
      const grid = document.getElementById('step-2-subtopics-grid');
      if (!wrap || !grid) return;

      if (
        state.flowMode === 'praktijkdag_shortcut' ||
        (state.prefilledItem && !state.prefilledItem.isCategoryHub)
      ) {
        wrap.classList.add('hidden');
        return;
      }

      const availableChips = [];
      state.selectedSubjects.forEach((subj) => {
        const list = subtopicsByCategory[subj.value] || [];
        list.forEach((chip) => {
          if (!availableChips.includes(chip)) availableChips.push(chip);
        });
      });

      if (availableChips.length === 0) {
        wrap.classList.add('hidden');
        return;
      }

      wrap.classList.remove('hidden');
      grid.innerHTML = availableChips
        .map((chip) => {
          const isSelected = state.selectedSubtopics.includes(chip);
          return `<button
            type="button"
            data-subtopic-chip="${chip}"
            class="subtopic-chip px-3.5 py-1.5 rounded-full text-xs font-semibold border transition-all cursor-pointer inline-flex items-center gap-1.5 ${
              isSelected
                ? 'bg-[#0C4EA2] text-white border-[#0C4EA2] shadow-xs'
                : 'bg-brand-cream/40 text-brand-secondary border-brand-dark/12 hover:border-[#0C4EA2]'
            }"
          >
            ${isSelected ? '<i class="fa-solid fa-check text-[10px]"></i>' : '<i class="fa-solid fa-plus text-[9px] text-[#0C4EA2]"></i>'}
            <span>${chip}</span>
          </button>`;
        })
        .join('');

      grid.querySelectorAll('.subtopic-chip').forEach((btn) => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-subtopic-chip') || '';
          if (state.selectedSubtopics.includes(val)) {
            state.selectedSubtopics = state.selectedSubtopics.filter((c) => c !== val);
          } else {
            state.selectedSubtopics.push(val);
          }
          state.selectedEventId = '';
          renderStep2Subtopics();
          renderStep2DatePicker();
        });
      });
    }

    function renderStep2DatePicker() {
      const box = document.getElementById('step-2-datepicker-box');
      const titleEl = document.getElementById('datepicker-box-title');
      const partBar = document.getElementById('step-2-participants-bar');
      const listEl = document.getElementById('step-2-dates-list');
      const showMoreBtn = document.getElementById('step-2-show-more-dates');
      if (!box || !listEl) return;

      const isPraktijkdag =
        state.flowMode === 'praktijkdag_shortcut' || state.situationKey === 'elearning_completed';
      const shouldShow =
        !isOnlyDienstenSelected() &&
        (isPraktijkdag || state.situationKey === 'open_enrollment');

      if (!shouldShow) {
        box.classList.add('hidden');
        state.selectedEventId = '';
        if (step2NextBtn) step2NextBtn.disabled = !state.situationValue;
        return;
      }

      box.classList.remove('hidden');

      if (titleEl) {
        titleEl.textContent = isPraktijkdag
          ? isEn
            ? 'Choose your practical day date (The Hague)'
            : 'Kies uw beschikbare praktijkdatum (Den Haag)'
          : isEn
            ? 'Choose an available course date (The Hague)'
            : 'Kies een beschikbare cursusdatum (Den Haag)';
      }

      if (partBar) {
        if (isPraktijkdag) {
          partBar.classList.add('hidden');
          state.participantsCount = 1;
        } else {
          partBar.classList.remove('hidden');
        }
      }

      // Update participant pills active state
      document.querySelectorAll('.part-count-btn').forEach((btn) => {
        const n = Number(btn.getAttribute('data-part-count'));
        if (n === state.participantsCount) {
          btn.className = 'part-count-btn w-9 h-9 sm:w-8 sm:h-8 rounded-lg text-xs font-bold bg-[#0C4EA2] text-white shadow-2xs cursor-pointer transition-all';
        } else {
          btn.className = 'part-count-btn w-9 h-9 sm:w-8 sm:h-8 rounded-lg text-xs font-bold text-brand-secondary hover:bg-brand-cream cursor-pointer transition-all';
        }
      });

      const matching = getMatchingEventsForCurrentState();
      const neededSpots = isPraktijkdag ? 1 : state.participantsCount;

      // Ensure a valid default selection exists
      const validIds = matching
        .filter((ev) => !ev.isFull && (ev.freeSpotsCount === null || ev.freeSpotsCount >= neededSpots))
        .map((ev) => String(ev.id));

      if (!state.selectedEventId || (state.selectedEventId !== 'custom_date' && !validIds.includes(String(state.selectedEventId)))) {
        state.selectedEventId = validIds.length > 0 ? validIds[0] : 'custom_date';
      }

      const maxVisible = state.showAllDates ? matching.length : 4;
      const visibleEvents = matching.slice(0, maxVisible);

      const eventRowsHtml = visibleEvents
        .map((ev) => {
          const notEnoughSpots =
            !ev.isFull && ev.freeSpotsCount !== null && ev.freeSpotsCount < neededSpots;
          const disabled = ev.isFull || notEnoughSpots;
          const isSelected = !disabled && String(state.selectedEventId) === String(ev.id);

          const dateParts = ev.date.split(' ');
          const day = dateParts[0] || '';
          const month = (dateParts[1] || '').substring(0, 3);
          const year = dateParts[2] || '';

          let spotsBadge = '';
          if (ev.isFull) {
            spotsBadge = `<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-red-100 text-red-700">${isEn ? 'Full' : 'Volgeboekt'}</span>`;
          } else if (notEnoughSpots) {
            spotsBadge = `<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-800">${isEn ? `Only ${ev.freeSpotsCount} left` : `Nog ${ev.freeSpotsCount} vrij`}</span>`;
          } else if (ev.freeSpotsLabel) {
            spotsBadge = `<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100/80 text-emerald-700">${ev.freeSpotsLabel}</span>`;
          }

          const rightPriceHtml = isPraktijkdag
            ? `<span class="text-[11px] font-bold text-[#0C4EA2] bg-[#0C4EA2]/10 px-2.5 py-1 rounded-lg">${isEn ? 'Practical day' : 'Praktijkdag'}</span>`
            : ev.price
              ? `<div class="text-right leading-tight">
                  <span class="font-display font-bold text-sm text-brand-secondary block">${ev.price}</span>
                  <span class="text-[10px] text-brand-dark/45">${isEn ? 'excl. VAT' : 'excl. BTW'}</span>
                </div>`
              : '';

          const mobileInlinePriceHtml = isPraktijkdag
            ? `<span class="min-[400px]:hidden text-[11px] font-bold text-[#0C4EA2]">• ${isEn ? 'Practical day' : 'Praktijkdag'}</span>`
            : ev.price
              ? `<span class="min-[400px]:hidden font-display font-bold text-brand-secondary">• ${ev.price} <span class="font-sans font-normal text-[10px] text-brand-dark/50">${isEn ? 'excl. VAT' : 'excl. BTW'}</span></span>`
              : '';

          return `<button
            type="button"
            data-pick-event="${ev.id}"
            ${disabled ? 'disabled' : ''}
            class="w-full text-left p-3 sm:p-3.5 rounded-xl border-2 transition-all flex items-center justify-between gap-3 ${
              disabled
                ? 'bg-white/50 border-brand-dark/6 opacity-55 cursor-not-allowed'
                : isSelected
                  ? 'bg-white border-[#0C4EA2] shadow-sm cursor-pointer'
                  : 'bg-white border-brand-dark/8 hover:border-[#0C4EA2]/50 cursor-pointer'
            }"
          >
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-12 h-12 rounded-xl flex flex-col items-center justify-center shrink-0 leading-none ${
                isSelected ? 'bg-[#0C4EA2] text-white' : 'bg-brand-secondary/90 text-white'
              }">
                <span class="font-display font-bold text-base">${day}</span>
                <span class="text-[10px] uppercase font-semibold opacity-85 mt-0.5">${month}</span>
              </div>
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="font-display font-bold text-xs sm:text-sm text-brand-secondary leading-snug">${ev.title}</span>
                  ${spotsBadge}
                </div>
                <div class="text-[11px] text-brand-dark/65 mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-0.5">
                  <span>${day} ${month} ${year}</span>
                  ${ev.time ? `<span>• ${ev.time}</span>` : ''}
                  <span>• ${isEn ? 'The Hague' : 'Den Haag'}</span>
                  ${mobileInlinePriceHtml}
                </div>
              </div>
            </div>

            <div class="flex items-center gap-3 shrink-0">
              <div class="hidden min-[400px]:block">${rightPriceHtml}</div>
              <span class="w-5 h-5 rounded-full border-2 flex items-center justify-center shrink-0 transition-all ${
                isSelected
                  ? 'border-[#0C4EA2] bg-[#0C4EA2] text-white'
                  : 'border-brand-dark/20 text-transparent'
              }">
                <i class="fa-solid fa-check text-[9px]"></i>
              </span>
            </div>
          </button>`;
        })
        .join('');

      const isCustomSelected = state.selectedEventId === 'custom_date';
      const noOpenDatesNotice =
        matching.length === 0
          ? `<div class="p-3 rounded-xl bg-white/80 border border-brand-dark/8 text-xs text-brand-dark/75">
              <i class="fa-solid fa-circle-info text-[#0C4EA2] mr-1.5"></i>
              ${
                isEn
                  ? 'For this training we schedule the start date in consultation with you.'
                  : 'Voor deze specifieke training plannen wij de startdatum persoonlijk in overleg met u in.'
              }
            </div>`
          : '';

      const customDateRowHtml = `<button
        type="button"
        data-pick-event="custom_date"
        class="w-full text-left p-3 sm:p-3.5 rounded-xl border-2 transition-all flex items-center justify-between gap-3 cursor-pointer ${
          isCustomSelected
            ? 'bg-white border-[#0C4EA2] shadow-sm'
            : 'bg-white/75 border-dashed border-brand-dark/15 hover:border-[#0C4EA2]/50'
        }"
      >
        <div class="flex items-center gap-3 min-w-0">
          <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 text-xs ${
            isCustomSelected ? 'bg-[#0C4EA2] text-white' : 'bg-[#0C4EA2]/10 text-[#0C4EA2]'
          }">
            <i class="fa-regular fa-calendar-plus"></i>
          </div>
          <div class="min-w-0">
            <span class="font-display font-bold text-xs sm:text-sm text-brand-secondary block leading-snug">
              ${
                isPraktijkdag
                  ? isEn
                    ? 'No suitable date listed? Schedule practical day in consultation'
                    : 'Staat uw datum er niet bij? Plan praktijkdag in overleg'
                  : isEn
                    ? 'No suitable date or prefer advice first?'
                    : 'Geen passende datum of liever eerst overleg?'
              }
            </span>
            <span class="text-[11px] text-brand-dark/65 block mt-0.5">
              ${
                isEn
                  ? 'Receive a date proposal or personal advice within 1 working day'
                  : 'Ontvang binnen 1 werkdag een datumvoorstel of vrijblijvend advies'
              }
            </span>
          </div>
        </div>
        <span class="w-5 h-5 rounded-full border-2 flex items-center justify-center shrink-0 transition-all ${
          isCustomSelected
            ? 'border-[#0C4EA2] bg-[#0C4EA2] text-white'
            : 'border-brand-dark/20 text-transparent'
        }">
          <i class="fa-solid fa-check text-[9px]"></i>
        </span>
      </button>`;

      listEl.innerHTML = noOpenDatesNotice + eventRowsHtml + customDateRowHtml;

      if (showMoreBtn) {
        if (!state.showAllDates && matching.length > 4) {
          const extra = matching.length - 4;
          showMoreBtn.textContent = isEn
            ? `Show ${extra} more available ${extra === 1 ? 'date' : 'dates'} ↓`
            : `Toon nog ${extra} beschikbare ${extra === 1 ? 'datum' : 'cursusdata'} ↓`;
          showMoreBtn.classList.remove('hidden');
        } else {
          showMoreBtn.classList.add('hidden');
        }
      }

      listEl.querySelectorAll('[data-pick-event]').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (btn.disabled) return;
          state.selectedEventId = btn.getAttribute('data-pick-event') || '';
          renderStep2DatePicker();
        });
      });

      if (step2NextBtn) {
        step2NextBtn.disabled = !state.selectedEventId;
      }
    }

    function renderStep2() {
      const headingEl = document.getElementById('step-2-heading');
      const subtitleEl = document.getElementById('step-2-subtitle');
      const grid = document.getElementById('step-2-situation-grid');
      if (!grid) return;

      renderStep2PraktijkdagTabs();

      // Special fast mode: Praktijkdag Shortcut
      if (state.flowMode === 'praktijkdag_shortcut') {
        if (headingEl) {
          headingEl.textContent = isEn
            ? 'Schedule your practical day in The Hague'
            : 'Plan direct uw praktijkdag in Den Haag';
        }
        if (subtitleEl) {
          subtitleEl.textContent = isEn
            ? 'Select your completed E-learning course and pick an available practical date below.'
            : 'Kies hieronder uw afgeronde E-learning en selecteer direct een beschikbare praktijkdatum.';
        }
        grid.classList.add('hidden');
        state.situationKey = 'elearning_completed';
        state.situationValue = 'E-learning afgerond — Praktijkdag inplannen';
        state.situationLabel = isEn ? 'Practical day after E-learning' : 'Praktijkdag na E-learning';
        state.customerType = 'Cursist (Praktijkdag na E-learning)';
        renderStep2Subtopics();
        renderStep2DatePicker();
        return;
      }

      grid.classList.remove('hidden');
      const onlyDiensten = isOnlyDienstenSelected();
      if (headingEl) {
        headingEl.textContent = isEn
          ? 'What best fits your situation?'
          : 'Wat past het beste bij uw situatie?';
      }
      if (subtitleEl) {
        subtitleEl.textContent = onlyDiensten
          ? isEn
            ? 'Select the scope or urgency below so our specialist can prepare your proposal.'
            : 'Kies de omvang of gewenste vervolgstap voor uw bedrijfslocatie(s).'
          : isEn
            ? 'Enroll directly on an open date, book your practical day, or request an in-company quote.'
            : 'Schrijf direct in op een cursusdatum, plan uw praktijkdag, of vraag een Incompany offerte aan.';
      }

      const options = getActiveStep2Options();
      const hasMultipleSubjects = state.selectedSubjects.length > 1;

      if (!state.situationKey || !options.some((o) => o.key === state.situationKey)) {
        const defaultOpt =
          !onlyDiensten && hasMultipleSubjects
            ? options.find((o) => o.key === 'incompany') || options[0]
            : options[0];
        state.situationKey = defaultOpt.key;
        state.situationValue = defaultOpt.value;
        state.situationLabel = defaultOpt.summaryLabel || defaultOpt.label;
        state.customerType = defaultOpt.customerType;
        state.customerLabel = defaultOpt.customerType;
      }

      grid.innerHTML = options
        .map((opt) => {
          const isSelected = state.situationKey === opt.key;
          return `<button
            type="button"
            data-situation-key="${opt.key}"
            data-situation-val="${opt.value}"
            data-situation-label="${opt.summaryLabel || opt.label}"
            data-customer-type="${opt.customerType}"
            class="situation-card group text-left p-4 sm:p-5 rounded-2xl border-2 transition-all cursor-pointer flex items-center justify-between gap-3.5 h-full ${
              isSelected
                ? 'is-selected border-[#0C4EA2] bg-[#0C4EA2]/[0.04]'
                : 'border-brand-dark/8 hover:border-[#0C4EA2] bg-brand-cream/25 hover:bg-[#0C4EA2]/[0.03]'
            }"
          >
            <div class="flex items-center gap-3.5 min-w-0">
              <div class="w-11 h-11 rounded-xl flex items-center justify-center text-base shrink-0 transition-colors ${
                isSelected
                  ? 'bg-[#0C4EA2] text-white'
                  : 'bg-[#0C4EA2]/10 text-[#0C4EA2] group-hover:bg-[#0C4EA2] group-hover:text-white'
              }">
                <i class="fa-solid ${opt.icon}"></i>
              </div>
              <div class="min-w-0">
                <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-[#0C4EA2] mb-0.5">${opt.badge || ''}</span>
                <h3 class="heading-tile text-brand-secondary leading-tight">${opt.label}</h3>
                <p class="text-xs text-brand-dark/65 mt-1 leading-snug">${opt.sub || ''}</p>
              </div>
            </div>
            <span class="w-5 h-5 rounded-full border-2 flex items-center justify-center shrink-0 transition-all ${
              isSelected
                ? 'border-[#0C4EA2] bg-[#0C4EA2] text-white'
                : 'border-brand-dark/20 group-hover:border-[#0C4EA2] text-transparent'
            }">
              <i class="fa-solid fa-check text-[9px]"></i>
            </span>
          </button>`;
        })
        .join('');

      grid.querySelectorAll('.situation-card').forEach((btn) => {
        btn.addEventListener('click', () => {
          state.situationKey = btn.getAttribute('data-situation-key') || '';
          state.situationValue = btn.getAttribute('data-situation-val') || '';
          state.situationLabel = btn.getAttribute('data-situation-label') || '';
          state.customerType = btn.getAttribute('data-customer-type') || 'Zakelijk';
          state.customerLabel = state.customerType;
          state.showAllDates = false;
          renderStep2();
          updateSummary();
        });
      });

      renderStep2Subtopics();
      renderStep2DatePicker();
    }

    // Bind Step 2 participant count buttons & Show More button
    document.querySelectorAll('.part-count-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const count = Number(btn.getAttribute('data-part-count')) || 1;
        state.participantsCount = count;
        renderStep2DatePicker();
      });
    });

    document.getElementById('step-2-show-more-dates')?.addEventListener('click', () => {
      state.showAllDates = true;
      renderStep2DatePicker();
    });

    const form = document.getElementById('advice-funnel-form');
    const errorBox = document.getElementById('advice-error-msg');
    const submitBtn = document.getElementById('advice-submit-btn');
    const submitLabel = document.getElementById('advice-submit-label');
    const submitIcon = document.getElementById('advice-submit-icon');
    const formWrapper = document.getElementById('advice-form-wrapper');
    const successScreen = document.getElementById('advice-success-screen');

    function resetStep3FormView() {
      if (formWrapper) formWrapper.classList.remove('hidden');
      if (successScreen) successScreen.classList.add('hidden');
      if (errorBox) errorBox.classList.add('hidden');
    }

    function renderStep3Advice() {
      resetStep3FormView();

      const chipEl = document.getElementById('step-3-selection-chip');
      const badgeEl = document.getElementById('step-3-badge');
      const summaryTextEl = document.getElementById('step-3-summary-text');
      const preadviceTextEl = document.getElementById('step-3-preadvice-text');
      const quickControlsEl = document.getElementById('step-3-event-quick-controls');
      const elearningToggle = document.getElementById('step-3-elearning-done-toggle');
      const partMiniWrap = document.getElementById('step-3-participants-mini');
      const partSelect = document.getElementById('step-3-participants-select');
      const directStripEl = document.getElementById('step-3-direct-strip');
      const formHeadingEl = document.getElementById('advice-form-heading');
      const formSubEl = document.getElementById('advice-form-sub');
      const notesLabelEl = document.getElementById('adv-notes-label');
      const notesInputEl = document.getElementById('adv-notes');
      const termsWrapper = document.getElementById('advice-terms-wrapper');
      const termsCheckbox = document.getElementById('adv-terms-agree');
      const companyWrapper = document.getElementById('field-company-wrapper');
      const companyInput = document.getElementById('adv-company');
      const companyReqStar = document.getElementById('company-req-star');
      const step3PrevBtn = document.getElementById('step-3-prev-btn');
      const step3BackLink = document.getElementById('step-3-back-link');

      const inCustomer = document.getElementById('input-customerType');
      const inCategory = document.getElementById('input-category');
      const inTopics = document.getElementById('input-topics');
      const inPrimary = document.getElementById('input-detailPrimary');
      const inSecondary = document.getElementById('input-detailSecondary');

      const directEvent = getSelectedEventObject();
      const isPraktijkdag =
        state.flowMode === 'praktijkdag_shortcut' || state.situationKey === 'elearning_completed';

      if (stepEyebrow && state.step === 3) {
        stepEyebrow.textContent = getStepEyebrowText(3);
      }

      const backTarget = state.flowMode === 'direct_contact' ? '1' : '2';
      if (step3PrevBtn) step3PrevBtn.setAttribute('data-prev-step', backTarget);
      if (step3BackLink) step3BackLink.setAttribute('data-prev-step', backTarget);

      // CASE 1: DIRECT CONCRETE EVENT BOOKING (Open Enrollment OR Praktijkdag after E-learning)
      if (directEvent) {
        if (chipEl) chipEl.classList.remove('hidden');
        if (directStripEl) {
          directStripEl.classList.add('hidden');
          directStripEl.classList.remove('grid');
        }
        if (quickControlsEl) {
          quickControlsEl.classList.remove('hidden');
          quickControlsEl.classList.add('flex');
        }
        if (elearningToggle) {
          elearningToggle.checked = isPraktijkdag;
        }
        if (partMiniWrap && partSelect) {
          if (isPraktijkdag) {
            partMiniWrap.classList.add('hidden');
            state.participantsCount = 1;
          } else {
            partMiniWrap.classList.remove('hidden');
            partSelect.value = String(state.participantsCount);
          }
        }

        if (badgeEl) {
          badgeEl.textContent = isPraktijkdag
            ? isEn
              ? 'Practical Day (E-learning Completed)'
              : 'Praktijkdag na E-learning'
            : isEn
              ? `Direct Course Enrollment • ${state.participantsCount} ${state.participantsCount === 1 ? 'person' : 'persons'}`
              : `Directe Cursusinschrijving • ${state.participantsCount} ${state.participantsCount === 1 ? 'deelnemer' : 'deelnemers'}`;
        }

        if (summaryTextEl) {
          summaryTextEl.textContent = `${directEvent.title} — ${directEvent.date}`;
        }

        if (preadviceTextEl) {
          const metaParts = [
            directEvent.time ? `🕒 ${directEvent.time}` : '',
            `📍 ${directEvent.location}`,
            !isPraktijkdag && directEvent.price
              ? `💶 ${directEvent.price} ${isEn ? 'excl. VAT p.p.' : 'excl. BTW p.p.'}`
              : '',
          ].filter(Boolean);
          preadviceTextEl.textContent = metaParts.join('  •  ');
        }

        const requireComp = !isPraktijkdag && state.participantsCount > 1;
        if (companyWrapper && companyInput) {
          companyWrapper.classList.remove('hidden');
          if (requireComp) {
            companyInput.setAttribute('required', 'required');
            if (companyReqStar) companyReqStar.classList.remove('hidden');
          } else {
            companyInput.removeAttribute('required');
            if (companyReqStar) companyReqStar.classList.add('hidden');
          }
        }

        if (termsWrapper && termsCheckbox) {
          termsWrapper.classList.remove('hidden');
          termsWrapper.classList.add('flex');
          termsCheckbox.setAttribute('required', 'required');
        }

        if (formHeadingEl) {
          formHeadingEl.textContent = isPraktijkdag
            ? isEn
              ? 'Confirm your practical day'
              : 'Bevestig uw praktijkdag'
            : isEn
              ? 'Complete your course registration'
              : 'Bevestig uw inschrijving';
        }
        if (formSubEl) {
          formSubEl.textContent = isPraktijkdag
            ? isEn
              ? 'Please use the same email address as your E-learning account so we can link your certificate.'
              : 'Gebruik bij voorkeur hetzelfde e-mailadres als van uw E-learning, zodat wij uw dossier direct koppelen.'
            : isEn
              ? 'Your spot will be reserved immediately and you will receive a confirmation by email.'
              : 'Uw plek wordt direct gereserveerd en u ontvangt een bevestiging per e-mail.';
        }
        if (notesLabelEl) {
          notesLabelEl.textContent =
            !isPraktijkdag && state.participantsCount > 1
              ? isEn
                ? 'Names of extra participants or dietary wishes (optional)'
                : 'Namen extra deelnemers of dieetwensen lunch (optioneel)'
              : isEn
                ? 'Dietary wishes or remarks (optional)'
                : 'Dieetwensen voor de lunch of opmerkingen (optioneel)';
        }
        if (notesInputEl) {
          notesInputEl.placeholder =
            !isPraktijkdag && state.participantsCount > 1
              ? isEn
                ? 'e.g. names of colleagues joining on this date...'
                : 'Bijv. namen van collega’s die meedoen of dieetwensen...'
              : isEn
                ? 'Any remarks or dietary requirements for lunch...'
                : 'Eventuele opmerkingen of dieetwensen voor de lunch...';
        }
        if (submitLabel) {
          submitLabel.textContent = isPraktijkdag
            ? isEn
              ? 'Confirm practical day'
              : 'Praktijkdag bevestigen'
            : isEn
              ? 'Confirm enrollment'
              : 'Inschrijving bevestigen';
        }
        if (submitIcon) {
          submitIcon.className = 'fa-solid fa-calendar-check text-xs';
        }
        return;
      }

      // CASE 2: ADVICE / INCOMPANY QUOTE / CUSTOM DATE / SERVICES / DIRECT CONTACT
      if (quickControlsEl) {
        quickControlsEl.classList.add('hidden');
        quickControlsEl.classList.remove('flex');
      }
      if (termsWrapper && termsCheckbox) {
        termsWrapper.classList.add('hidden');
        termsWrapper.classList.remove('flex');
        termsCheckbox.removeAttribute('required');
      }
      if (submitIcon) {
        submitIcon.className = 'fa-solid fa-paper-plane text-xs';
      }

      const subjectSummary =
        state.flowMode === 'direct_contact'
          ? 'Direct contact'
          : state.flowMode === 'praktijkdag_shortcut'
            ? `${state.praktijkdagTab === 'ALL' ? 'E-learning' : state.praktijkdagTab} (Praktijkdag in overleg)`
            : state.selectedSubjects.map((s) => s.label).join(', ');

      const topicsSummary =
        state.selectedSubtopics.length > 0
          ? `${subjectSummary} (${state.selectedSubtopics.join(', ')})`
          : subjectSummary;

      const activeOptions = getActiveStep2Options();
      const matchedOpt = activeOptions.find((o) => o.key === state.situationKey);
      const isCompanyRequired =
        state.flowMode === 'standard' && matchedOpt ? Boolean(matchedOpt.requireCompany) : false;

      const effectivePrimary =
        state.selectedEventId === 'custom_date'
          ? isPraktijkdag
            ? isEn
              ? 'Practical day (date in consultation)'
              : 'Praktijkdag na E-learning (datum in overleg)'
            : isEn
              ? `${state.participantsCount} ${state.participantsCount === 1 ? 'participant' : 'participants'} (date in consultation)`
              : `${state.participantsCount} ${state.participantsCount === 1 ? 'deelnemer' : 'deelnemers'} (datum in overleg)`
          : state.situationLabel;

      if (inCustomer) {
        inCustomer.value =
          state.flowMode === 'direct_contact'
            ? 'Direct contact'
            : state.customerType || 'Zakelijk';
      }
      if (inCategory) inCategory.value = subjectSummary;
      if (inTopics) inTopics.value = topicsSummary;
      if (inPrimary) inPrimary.value = effectivePrimary;
      if (inSecondary) inSecondary.value = state.situationValue || effectivePrimary;

      if (companyWrapper && companyInput) {
        companyWrapper.classList.remove('hidden');
        if (isCompanyRequired) {
          companyInput.setAttribute('required', 'required');
          if (companyReqStar) companyReqStar.classList.remove('hidden');
        } else {
          companyInput.removeAttribute('required');
          if (companyReqStar) companyReqStar.classList.add('hidden');
        }
      }

      if (state.flowMode === 'direct_contact') {
        if (chipEl) chipEl.classList.add('hidden');
        if (directStripEl) {
          directStripEl.classList.remove('hidden');
          directStripEl.classList.add('grid');
        }
        if (formHeadingEl) {
          formHeadingEl.textContent = isEn ? 'Send us a direct message' : 'Stuur ons direct een bericht';
        }
        if (formSubEl) {
          formSubEl.textContent = isEn
            ? 'Leave your details and question below. We respond within 1 working day.'
            : 'Laat hieronder uw gegevens en vraag achter. Wij reageren binnen 1 werkdag.';
        }
        if (notesLabelEl) {
          notesLabelEl.textContent = isEn ? 'Your question or message' : 'Uw vraag of bericht';
        }
        if (notesInputEl) {
          notesInputEl.placeholder = isEn
            ? 'How can our advisors help you?'
            : 'Waar kunnen onze adviseurs u mee helpen?';
        }
        if (submitLabel) {
          submitLabel.textContent = isEn ? 'Send message' : 'Bericht versturen';
        }
      } else {
        if (chipEl) chipEl.classList.remove('hidden');
        if (directStripEl) {
          directStripEl.classList.add('hidden');
          directStripEl.classList.remove('grid');
        }
        if (badgeEl) {
          badgeEl.textContent = isEn ? 'Tailored Request & Advice' : 'Aanvraag & Persoonlijk Voorstel';
        }
        if (summaryTextEl) {
          const parts = [topicsSummary, effectivePrimary].filter(Boolean);
          summaryTextEl.textContent = parts.join(' • ');
        }
        if (preadviceTextEl) {
          if (isOnlyDienstenSelected()) {
            preadviceTextEl.textContent = isEn
              ? 'Our specialist will review your location requirements and send a tailored proposal within 1 working day.'
              : 'Onze specialist bekijkt uw aanvraag en stuurt binnen 1 werkdag een passend voorstel voor uw locatie(s).';
          } else if (state.situationKey === 'incompany' || state.situationKey === 'corporate_advice') {
            preadviceTextEl.textContent = isEn
              ? 'From 6 participants we provide in-company group training at your location on a date of your choice.'
              : 'Vanaf 6 deelnemers verzorgen wij de training voordelig Incompany bij u op bedrijfslocatie op een datum naar keuze.';
          } else {
            preadviceTextEl.textContent = isEn
              ? 'Our planning team will contact you within 1 working day with suitable date options.'
              : 'Onze planning neemt binnen 1 werkdag contact met u op om samen een geschikte datum in te plannen.';
          }
        }
        if (formHeadingEl) {
          formHeadingEl.textContent = isEn
            ? 'Where may we send your proposal or advice?'
            : 'Waar mogen wij het voorstel of advies naartoe sturen?';
        }
        if (formSubEl) {
          formSubEl.textContent = isEn
            ? 'Our advisor will respond within 1 working day — completely non-binding.'
            : 'Onze adviseur reageert binnen 1 werkdag — geheel vrijblijvend.';
        }
        if (notesLabelEl) {
          notesLabelEl.textContent = isEn
            ? 'Preferred period, location or question (optional)'
            : 'Gewenste periode, locatie of toelichting (optioneel)';
        }
        if (notesInputEl) {
          notesInputEl.placeholder = isEn
            ? 'Briefly let us know if you have specific wishes or preferred dates...'
            : 'Bijv. voorkeursdagen, aantal deelnemers of specifieke vraag...';
        }
        if (submitLabel) {
          submitLabel.textContent = isEn ? 'Send request' : 'Aanvraag versturen';
        }
      }
    }

    // Step 3 inline quick-controls listeners (for direct date bookings / ?event=ID arrivals)
    document.getElementById('step-3-elearning-done-toggle')?.addEventListener('change', (e) => {
      const checked = Boolean(e.target && e.target.checked);
      if (checked) {
        state.situationKey = 'elearning_completed';
        state.participantsCount = 1;
      } else {
        if (state.flowMode === 'praktijkdag_shortcut') {
          state.flowMode = 'standard';
        }
        state.situationKey = 'open_enrollment';
      }
      renderStep3Advice();
    });

    document.getElementById('step-3-participants-select')?.addEventListener('change', (e) => {
      const val = Number(e.target && e.target.value) || 1;
      const ev = getSelectedEventObject();
      if (ev && ev.freeSpotsCount !== null && val > ev.freeSpotsCount) {
        state.participantsCount = Math.max(1, ev.freeSpotsCount);
      } else {
        state.participantsCount = val;
      }
      renderStep3Advice();
    });

    // Step 1: Select subject card(s)
    document.querySelectorAll('.subject-card').forEach((card) => {
      card.addEventListener('click', () => {
        const val = card.getAttribute('data-subject-card') || '';
        const label = card.getAttribute('data-subject-label') || val;
        const group = card.getAttribute('data-subject-group') || 'opleiding';

        state.flowMode = 'standard';
        state.customerType = '';
        state.customerLabel = '';
        state.prefilledItem = null;
        state.selectedEventId = '';
        const prefillBanner = document.getElementById('prefill-context-banner');
        if (prefillBanner) prefillBanner.classList.add('hidden');

        const exists = state.selectedSubjects.some((s) => s.value === val);
        if (exists) {
          state.selectedSubjects = state.selectedSubjects.filter((s) => s.value !== val);
        } else {
          state.selectedSubjects.push({ value: val, label, group });
        }

        state.situationKey = '';
        state.situationValue = '';
        state.situationLabel = '';
        syncStep1CardStyles();
        updateSummary();
      });
    });

    // Step 1 Shortcut A: E-learning afgerond -> Praktijkdag plannen
    document.getElementById('praktijkdag-shortcut-btn')?.addEventListener('click', () => {
      state.flowMode = 'praktijkdag_shortcut';
      state.praktijkdagTab = 'BHV Opleidingen';
      state.selectedSubjects = [];
      state.selectedSubtopics = [];
      state.selectedEventId = '';
      state.participantsCount = 1;
      state.prefilledItem = null;
      const prefillBanner = document.getElementById('prefill-context-banner');
      if (prefillBanner) prefillBanner.classList.add('hidden');
      syncStep1CardStyles();
      renderStep2();
      goToStep(2);
    });

    // Step 1 Shortcut B: Direct contact (Oranje kaart)
    document.getElementById('direct-contact-card-btn')?.addEventListener('click', () => {
      state.flowMode = 'direct_contact';
      state.customerType = 'Direct contact';
      state.customerLabel = 'Direct contact';
      state.selectedSubjects = [];
      state.selectedSubtopics = [];
      state.situationKey = '';
      state.situationValue = '';
      state.situationLabel = '';
      state.selectedEventId = '';
      const prefillBanner = document.getElementById('prefill-context-banner');
      if (prefillBanner) prefillBanner.classList.add('hidden');
      syncStep1CardStyles();
      renderStep3Advice();
      goToStep(3);
    });

    step1NextBtn?.addEventListener('click', () => {
      if (state.selectedSubjects.length === 0) return;
      state.flowMode = 'standard';
      renderStep2();
      goToStep(2);
    });

    step2NextBtn?.addEventListener('click', () => {
      if (!state.situationValue && state.flowMode !== 'praktijkdag_shortcut') return;
      renderStep3Advice();
      goToStep(3);
    });

    document.querySelectorAll('[data-prev-step]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = Number(btn.getAttribute('data-prev-step'));
        if (target >= 1) {
          if (target === 1) {
            syncStep1CardStyles();
          } else if (target === 2) {
            // Ensure subjects exist if user entered directly via ?event=ID and clicked "Wijzigen"
            const ev = getSelectedEventObject();
            if (ev && state.selectedSubjects.length === 0 && state.flowMode === 'standard') {
              state.selectedSubjects = [
                { value: ev.subjectCard, label: ev.subjectCard, group: 'opleiding' },
              ];
            }
            renderStep2();
          }
          goToStep(target);
        }
      });
    });

    stepIndicators.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.disabled) return;
        const target = Number(btn.getAttribute('data-step-nav'));
        if (target >= 1 && target <= state.step) {
          if (target === 1) {
            syncStep1CardStyles();
          } else if (target === 2) {
            const ev = getSelectedEventObject();
            if (ev && state.selectedSubjects.length === 0 && state.flowMode === 'standard') {
              state.selectedSubjects = [
                { value: ev.subjectCard, label: ev.subjectCard, group: 'opleiding' },
              ];
            }
            renderStep2();
          }
          goToStep(target);
        }
      });
    });

    document.getElementById('prefill-change-btn')?.addEventListener('click', () => {
      state.flowMode = 'standard';
      syncStep1CardStyles();
      goToStep(1);
    });

    resetBtn?.addEventListener('click', () => {
      state.step = 1;
      state.flowMode = 'standard';
      state.customerType = '';
      state.customerLabel = '';
      state.selectedSubjects = [];
      state.selectedSubtopics = [];
      state.situationKey = '';
      state.situationValue = '';
      state.situationLabel = '';
      state.selectedEventId = '';
      state.participantsCount = 1;
      state.showAllDates = false;
      state.prefilledItem = null;
      const prefillBanner = document.getElementById('prefill-context-banner');
      if (prefillBanner) prefillBanner.classList.add('hidden');
      resetStep3FormView();
      form?.reset();
      if (step1NextBtn) step1NextBtn.disabled = true;
      if (step2NextBtn) step2NextBtn.disabled = true;
      syncStep1CardStyles();
      goToStep(1);
    });

    function selectEventFromUrl(eventIdParam, isPraktijkdagIntent) {
      const matched = allEvents.find((ev) => String(ev.id) === String(eventIdParam));
      if (!matched || matched.isFull) return false;

      state.flowMode = 'standard';
      state.selectedSubjects = [
        { value: matched.subjectCard, label: matched.subjectCard, group: 'opleiding' },
      ];
      state.situationKey = isPraktijkdagIntent ? 'elearning_completed' : 'open_enrollment';
      state.situationValue = isPraktijkdagIntent
        ? 'E-learning afgerond — Praktijkdag inplannen'
        : 'Open inschrijving Den Haag (1-5 deelnemers)';
      state.situationLabel = isPraktijkdagIntent
        ? isEn
          ? 'Practical day after E-learning'
          : 'Praktijkdag na E-learning'
        : isEn
          ? 'Open enrollment (1–5 participants)'
          : 'Open inschrijving (1–5 deelnemers)';
      state.customerType = isPraktijkdagIntent
        ? 'Cursist (Praktijkdag na E-learning)'
        : 'ZZP / MKB (1-5 deelnemers)';
      state.selectedEventId = String(matched.id);

      syncStep1CardStyles();
      renderStep3Advice();
      goToStep(3, true);
      return true;
    }

    function applyUrlPrefill() {
      const params = new URLSearchParams(window.location.search);
      const eventParam = (params.get('event') || '').trim();
      const intentParam = (params.get('intent') || '').toLowerCase().trim();
      const courseKey = (params.get('course') || '').toLowerCase().trim();
      const serviceKey = (params.get('service') || '').toLowerCase().trim();
      const categoryKey = (params.get('category') || '').toLowerCase().trim();
      const modeParam = (params.get('mode') || '').toLowerCase().trim();

      const isPraktijkdagIntent = intentParam === 'praktijkdag' || modeParam === 'praktijkdag';

      // 1. Direct arrival from /cursusdata or /inschrijven/[id] with ?event=<id>
      if (eventParam) {
        if (selectEventFromUrl(eventParam, isPraktijkdagIntent)) {
          return;
        }
      }

      // 2. Arrival with ?intent=praktijkdag (e.g. from /e-learning or /cursusdata)
      if (isPraktijkdagIntent && !courseKey && !serviceKey) {
        state.flowMode = 'praktijkdag_shortcut';
        if (categoryKey && prefillCatalog[categoryKey]) {
          state.praktijkdagTab = prefillCatalog[categoryKey].categoryCard;
        } else {
          state.praktijkdagTab = 'BHV Opleidingen';
        }
        renderStep2();
        goToStep(2, true);
        return;
      }

      // 3. Arrival from a specific course / category / service page
      const lookupKey = courseKey || serviceKey || categoryKey;
      const item = lookupKey ? prefillCatalog[lookupKey] : null;

      if (item) {
        state.prefilledItem = { slug: lookupKey, ...item };
        state.selectedSubjects = [
          {
            value: item.categoryCard,
            label: `${item.categoryLabel} — ${item.title}`,
            group: item.group,
          },
        ];

        const bannerEl = document.getElementById('prefill-context-banner');
        const titleEl = document.getElementById('prefill-context-title');
        const subEl = document.getElementById('prefill-context-sub');

        if (bannerEl && titleEl && subEl) {
          titleEl.textContent = item.title;
          subEl.textContent = item.duration;
          bannerEl.classList.remove('hidden');
          bannerEl.classList.add('flex');
        }
      }

      if (modeParam === 'incompany') {
        state.situationKey = 'incompany';
        state.situationValue = '6-15 medewerkers (Incompany op bedrijfslocatie)';
        state.situationLabel = isEn ? '6 – 15 employees (In-company)' : '6 – 15 medewerkers (Incompany)';
        state.customerType = 'MKB / Incompany (6-15 medewerkers)';
        state.customerLabel = state.customerType;
      } else if (isPraktijkdagIntent) {
        state.situationKey = 'elearning_completed';
        state.situationValue = 'E-learning afgerond — Praktijkdag inplannen';
        state.situationLabel = isEn ? 'Practical day after E-learning' : 'Praktijkdag na E-learning';
        state.customerType = 'Cursist (Praktijkdag na E-learning)';
        state.customerLabel = state.customerType;
      }

      syncStep1CardStyles();
      updateSummary();

      if (state.selectedSubjects.length > 0) {
        renderStep2();
        goToStep(2, true);
      }
    }

    // Hydrate live GoHighLevel events in the background and refresh if needed
    async function hydrateLiveGhlEvents() {
      try {
        const res = await fetch('/api/events');
        if (!res.ok) return;
        const json = await res.json();
        if (!json.success || !Array.isArray(json.data) || json.data.length === 0) return;

        const liveNormalized = json.data.map(normalizeEvent).filter((e) => !e.isOnRequest);
        if (liveNormalized.length > 0) {
          allEvents = liveNormalized;

          // Check if user arrived with a live GHL ?event=<recordId> that wasn't in static fallback
          const params = new URLSearchParams(window.location.search);
          const eventParam = (params.get('event') || '').trim();
          const intentParam = (params.get('intent') || '').toLowerCase().trim();
          if (eventParam && state.step === 1) {
            if (selectEventFromUrl(eventParam, intentParam === 'praktijkdag')) {
              return;
            }
          }

          if (state.step === 2) {
            renderStep2DatePicker();
          } else if (state.step === 3 && isConcreteEventSelected()) {
            renderStep3Advice();
          }
        }
      } catch (err) {
        // Fallback schedule stays active smoothly
      }
    }

    applyUrlPrefill();
    hydrateLiveGhlEvents();

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorBox) errorBox.classList.add('hidden');

      const formData = new FormData(form);
      const rawEntries = Object.fromEntries(formData.entries());
      const directEvent = getSelectedEventObject();
      const isPraktijkdag =
        state.flowMode === 'praktijkdag_shortcut' || state.situationKey === 'elearning_completed';

      if (submitBtn) submitBtn.disabled = true;
      if (submitLabel) {
        submitLabel.textContent = isEn ? 'Processing...' : 'Bezig met verwerken...';
      }

      try {
        let res;
        if (directEvent) {
          // Route A: Direct Course Enrollment or Practical Day Booking -> POST /api/inschrijven
          res = await fetch('/api/inschrijven', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              eventId: directEvent.id,
              name: rawEntries.name,
              company: rawEntries.company,
              email: rawEntries.email,
              phone: rawEntries.phone,
              notes: rawEntries.notes,
              participantsCount: isPraktijkdag ? 1 : state.participantsCount,
              registrationType: isPraktijkdag ? 'elearning_completed' : 'new',
            }),
          });
        } else {
          // Route B: Incompany Quote, Advice, Services, Custom Date or Direct Contact -> POST /api/advies
          res = await fetch('/api/advies', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(rawEntries),
          });
        }

        const data = await res.json();
        if (!res.ok || !data.success) {
          throw new Error(
            data.error || (isEn ? 'Could not complete your request.' : 'Kon uw aanvraag niet verwerken.')
          );
        }

        const successTitleEl = document.getElementById('advice-success-title');
        const successBodyEl = document.getElementById('advice-success-body');

        if (directEvent) {
          if (successTitleEl) {
            successTitleEl.textContent = isPraktijkdag
              ? isEn
                ? 'Your practical day is scheduled!'
                : 'Uw praktijkdag is ingepland!'
              : isEn
                ? 'Enrollment confirmed!'
                : 'Inschrijving ontvangen!';
          }
          if (successBodyEl) {
            successBodyEl.textContent = isEn
              ? `We have reserved your spot for ${directEvent.title} on ${directEvent.date}. You will receive a confirmation by email.`
              : `Wij hebben uw plek voor ${directEvent.title} op ${directEvent.date} gereserveerd. U ontvangt een bevestiging per e-mail.`;
          }
        } else if (state.flowMode === 'direct_contact') {
          if (successTitleEl) {
            successTitleEl.textContent = isEn
              ? 'Thank you! Your message has been received.'
              : 'Bedankt! Uw bericht is ontvangen.';
          }
          if (successBodyEl) {
            successBodyEl.textContent = isEn
              ? 'Our team in The Hague will contact you within 1 working day.'
              : 'Ons team neemt binnen 1 werkdag persoonlijk contact met u op.';
          }
        } else {
          if (successTitleEl) {
            successTitleEl.textContent = isEn
              ? 'Thank you! We have received your request.'
              : 'Bedankt! Uw aanvraag is ontvangen.';
          }
          if (successBodyEl) {
            successBodyEl.textContent = isEn
              ? 'Our advisor has received your wishes and will contact you within 1 working day.'
              : 'Onze adviseur heeft uw wensen ontvangen en neemt binnen 1 werkdag persoonlijk contact met u op.';
          }
        }

        if (formWrapper) formWrapper.classList.add('hidden');
        if (successScreen) successScreen.classList.remove('hidden');
        scrollToWizardTop();
      } catch (err) {
        if (errorBox) {
          errorBox.textContent =
            err.message || (isEn ? 'Something went wrong.' : 'Er ging iets mis.');
          errorBox.classList.remove('hidden');
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (submitLabel) {
          if (directEvent) {
            submitLabel.textContent = isPraktijkdag
              ? isEn
                ? 'Confirm practical day'
                : 'Praktijkdag bevestigen'
              : isEn
                ? 'Confirm enrollment'
                : 'Inschrijving bevestigen';
          } else {
            submitLabel.textContent =
              state.flowMode === 'direct_contact'
                ? isEn
                  ? 'Send message'
                  : 'Bericht versturen'
                : isEn
                  ? 'Send request'
                  : 'Aanvraag versturen';
          }
        }
      }
    });
  })();
</script>
