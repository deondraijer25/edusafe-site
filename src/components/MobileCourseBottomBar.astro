---
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const isEn = lang === 'en';

interface Props {
  defaultCourse: {
    id: string;
    title: string;
    tagline?: string;
    price: string;
    duration: string;
    inclusions: string[];
    registerLink: string;
  };
  courseSlug?: string;
  itemType?: 'course' | 'service';
  serviceSlug?: string;
  advisorText?: string;
  advisorPhone?: string;
}

const {
  defaultCourse,
  courseSlug,
  itemType = 'course',
  serviceSlug,
  advisorText = isEn ? "Personal advice or custom dates?" : "Persoonlijk advies of data afstemmen?",
  advisorPhone = "070 - 444 77 95"
} = Astro.props;

const isService = itemType === 'service';
const activeSlug = courseSlug || defaultCourse.id;
const activeServiceSlug = serviceSlug || activeSlug;
const adviceBase = isEn ? '/en/personal-advice' : '/persoonlijk-advies';
const prefillPrimaryUrl = isService
  ? `${adviceBase}?type=zakelijk&service=${encodeURIComponent(activeServiceSlug)}`
  : `${adviceBase}?course=${encodeURIComponent(activeSlug)}`;
const prefillIncompanyUrl = `${adviceBase}?type=zakelijk&course=${encodeURIComponent(activeSlug)}&mode=incompany`;
---

<!-- Mobile Bottom Summary Bar & Slide-Up Sheet (Visible only on mobile/tablet < lg) -->
<div class="block lg:hidden">
  
  <!-- Backdrop Overlay (z-[60] so sticky header z-50 is also dimmed when sheet opens) -->
  <div 
    id="mobile-drawer-backdrop" 
    class="fixed inset-0 bg-brand-secondary/60 backdrop-blur-xs z-[60] transition-opacity duration-300 opacity-0 pointer-events-none"
    aria-hidden="true"
  ></div>

  <!-- Slide-Up Details Sheet -->
  <div 
    id="mobile-drawer-panel" 
    class="fixed bottom-0 left-0 right-0 z-[61] bg-white rounded-t-[28px] max-h-[85dvh] overflow-y-auto overscroll-contain shadow-2xl transition-transform duration-300 ease-out transform translate-y-full p-5 sm:p-6 pb-[calc(1.5rem+env(safe-area-inset-bottom,0px))] border-t border-brand-dark/10"
  >
    <!-- Drag Handle & Close Header -->
    <div class="flex items-center justify-between pb-3 mb-3 border-b border-brand-dark/5">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-brand-accent animate-pulse"></span>
        <span class="text-[10px] font-semibold text-brand-primary uppercase tracking-wider">
          {isEn ? "Overview & Rates" : "Overzicht & Tarieven"}
        </span>
      </div>
      <button 
        type="button" 
        id="close-mobile-drawer"
        class="w-11 h-11 -mr-1.5 rounded-full bg-brand-cream text-brand-dark/70 hover:text-brand-dark flex items-center justify-center transition-colors cursor-pointer"
        aria-label={isEn ? "Close overview" : "Sluit overzicht"}
      >
        <i class="fa-solid fa-chevron-down text-xs"></i>
      </button>
    </div>

    <!-- Title & Pricing -->
    <div class="space-y-3">
      <div>
        <span id="mobile-drawer-tagline" class="text-[9px] font-semibold uppercase text-brand-dark/40 tracking-wider block mb-0.5">
          {defaultCourse.tagline || (isService ? (isEn ? "Selected service" : "Geselecteerde dienst") : (isEn ? "Selected training" : "Geselecteerde training"))}
        </span>
        <h3 id="mobile-drawer-title" class="font-display text-xl font-semibold text-brand-secondary leading-snug">{defaultCourse.title}</h3>
      </div>

      <div class="p-3.5 rounded-2xl bg-brand-cream/60 border border-brand-dark/5 flex items-center justify-between gap-3">
        <div>
          <span class="text-[9px] font-semibold uppercase text-brand-dark/40 leading-none block mb-1">
            {isService ? (isEn ? "Indication / Rate" : "Tarief / Indicatie") : (isEn ? "Course Rate" : "Cursustarief")}
          </span>
          <div class="flex items-baseline gap-1.5 flex-wrap">
            <span id="mobile-drawer-price" class="font-display text-2xl sm:text-3xl font-semibold text-brand-secondary">{defaultCourse.price}</span>
            <span class="text-[11px] text-brand-dark/50 font-medium">{isEn ? "excl. VAT" : "excl. BTW"}</span>
          </div>
        </div>

        <div class="text-right">
          <span class="text-[9px] font-semibold uppercase text-brand-dark/40 leading-none block mb-1">
            {isService ? (isEn ? "Execution" : "Uitvoering") : (isEn ? "Duration" : "Duur")}
          </span>
          <span id="mobile-drawer-duration" class="font-semibold text-brand-secondary text-xs">{defaultCourse.duration}</span>
        </div>
      </div>

      <!-- Inclusions -->
      <div class="pt-2">
        <span class="text-[10px] font-semibold uppercase text-brand-dark/50 tracking-wider block mb-2">
          {isEn ? "Included at Edusafe:" : "Inclusief bij Edusafe:"}
        </span>
        <ul id="mobile-drawer-inclusions" class="space-y-1.5">
          {defaultCourse.inclusions.map(inc => (
            <li class="flex items-center gap-2 text-xs text-brand-dark/80 font-medium">
              <i class="fa-solid fa-circle-check text-emerald-500 text-xs shrink-0"></i>
              <span>{inc}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Action Buttons -->
      <div class="pt-3 space-y-2">
        <a 
          id="mobile-drawer-cta"
          href={prefillPrimaryUrl}
          class="font-display font-semibold text-sm py-3.5 px-5 rounded-xl text-center bg-brand-accent text-white hover:bg-brand-accent-hover transition-all w-full block shadow-sm cursor-pointer min-h-[48px]"
        >
          {isService
            ? (isEn ? "Request Quote / Advice →" : "Offerte / Advies aanvragen →")
            : (isEn ? "Start Course Request →" : "Cursus aanvragen / Starten →")}
        </a>

        {!isService && (
          <a 
            id="mobile-drawer-incompany"
            href={prefillIncompanyUrl}
            class="font-display font-semibold text-xs py-3 px-4 rounded-xl text-center bg-brand-secondary hover:bg-brand-primary text-white shadow-xs transition-all w-full block cursor-pointer min-h-[44px]"
          >
            {isEn ? "In-company Quote (6+ pers.)" : "Incompany offerte (vanaf 6 pers.)"}
          </a>
        )}
      </div>

      <!-- Guarantee Tag -->
      <div class="pt-2 flex items-center justify-center gap-1.5 text-xs font-semibold text-emerald-600 text-center">
        <i class="fa-solid fa-shield-check text-sm shrink-0"></i>
        <span>
          {isService
            ? (isEn ? "Certified execution according to NEN & Arbowet" : "Vakkundige uitvoering conform NEN-norm & Arbowet")
            : (isEn ? "Practice-oriented certification (NL & EN)" : "Praktijkgerichte certificering (NL & EN)")}
        </span>
      </div>

      <!-- Direct Phone Call Box -->
      <div class="p-3 rounded-xl bg-brand-cream border border-brand-dark/5 text-center mt-2">
        <span class="text-[10px] font-semibold uppercase tracking-wider text-brand-dark/50 block mb-0.5">{advisorText}</span>
        <a href={`tel:${advisorPhone.replace(/\s+/g, '')}`} class="font-display font-semibold text-xs sm:text-sm text-brand-primary inline-flex items-center justify-center gap-1.5 min-h-[36px]">
          <i class="fa-solid fa-phone text-xs"></i>
          <span>{isEn ? `Call directly: ${advisorPhone}` : `Bel direct: ${advisorPhone}`}</span>
        </a>
      </div>

    </div>
  </div>

  <!-- Collapsed Sticky Bottom Bar (Always fixed at bottom of screen on mobile) -->
  <aside 
    id="mobile-sticky-bottom-bar"
    class="fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t border-brand-dark/10 shadow-[0_-6px_25px_rgba(0,0,0,0.1)] px-4 py-2.5 pb-[calc(0.65rem+env(safe-area-inset-bottom,0px))]"
  >
    <div class="max-w-[1280px] mx-auto flex items-center justify-between gap-2.5">
      
      <!-- Tap to Expand Left Column -->
      <button 
        type="button"
        id="open-mobile-drawer"
        class="flex-1 text-left flex flex-col justify-center cursor-pointer group focus:outline-none min-w-0 pr-1 min-h-[44px]"
        aria-label={isService ? (isEn ? "Open service summary and rates" : "Open dienstoverzicht en tarieven") : (isEn ? "Open course summary and rates" : "Open cursusamenvatting en tarieven")}
      >
        <div class="flex items-center gap-1.5 mb-0.5">
          <span id="mobile-bar-title" class="font-display font-semibold text-brand-secondary text-xs sm:text-sm truncate block leading-tight">
            {defaultCourse.title}
          </span>
          <span class="text-[10px] text-brand-primary flex items-center gap-1 shrink-0 font-medium">
            <i class="fa-solid fa-chevron-up text-[9px] group-hover:-translate-y-0.5 transition-transform animate-bounce"></i>
          </span>
        </div>
        <div class="flex items-baseline gap-1 min-w-0">
          <span id="mobile-bar-price" class="font-display font-semibold text-brand-primary text-xs sm:text-sm leading-tight truncate">
            {defaultCourse.price}
          </span>
          <span class="text-[9px] text-brand-dark/50 shrink-0">excl.</span>
          <span class="text-[9px] text-brand-dark/40 ml-1 underline decoration-brand-dark/20 whitespace-nowrap shrink-0">
            {isEn ? "View details" : "Bekijk details"}
          </span>
        </div>
      </button>

      <!-- Right CTA Buttons (Phone call + Aanvragen) -->
      <div class="flex items-center gap-2 shrink-0">
        <a 
          href={`tel:${advisorPhone.replace(/\s+/g, '')}`} 
          class="w-11 h-11 rounded-xl bg-brand-cream border border-brand-dark/10 flex items-center justify-center text-brand-primary hover:bg-brand-primary hover:text-white transition-colors shrink-0"
          title={isEn ? "Call Directly" : "Direct Bellen"}
          aria-label={isEn ? "Call advisor" : "Bel adviseur"}
        >
          <i class="fa-solid fa-phone text-xs"></i>
        </a>

        <a 
          id="mobile-bar-cta"
          href={prefillPrimaryUrl}
          class="font-display font-semibold text-xs px-3.5 sm:px-4 min-h-[44px] rounded-xl bg-brand-accent text-white hover:bg-brand-accent-hover transition-colors shadow-sm inline-flex items-center justify-center gap-1.5"
        >
          <span>{isService ? (isEn ? "Quote" : "Offerte") : (isEn ? "Start Request" : "Aanvragen")}</span>
          <i class="fa-solid fa-arrow-right text-[9px]"></i>
        </a>
      </div>

    </div>
  </aside>

</div>

<script define:vars={{ adviceBase, isService, activeServiceSlug }}>
  function setupMobileDrawer() {
    const openBtn = document.getElementById('open-mobile-drawer');
    const closeBtn = document.getElementById('close-mobile-drawer');
    const backdrop = document.getElementById('mobile-drawer-backdrop');
    const panel = document.getElementById('mobile-drawer-panel');

    function openDrawer() {
      if (backdrop && panel) {
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
        backdrop.classList.add('opacity-100', 'pointer-events-auto');
        panel.classList.remove('translate-y-full');
        panel.classList.add('translate-y-0');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeDrawer() {
      if (backdrop && panel) {
        backdrop.classList.remove('opacity-100', 'pointer-events-auto');
        backdrop.classList.add('opacity-0', 'pointer-events-none');
        panel.classList.remove('translate-y-0');
        panel.classList.add('translate-y-full');
        document.body.style.overflow = '';
      }
    }

    if (openBtn) openBtn.addEventListener('click', openDrawer);
    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    if (backdrop) backdrop.addEventListener('click', closeDrawer);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel && panel.classList.contains('translate-y-0')) {
        closeDrawer();
      }
    });

    // Global synchronizer function accessible by course switcher scripts
    window.syncMobileCourseDrawer = function(course) {
      if (!course) return;
      
      const barTitle = document.getElementById('mobile-bar-title');
      const barPrice = document.getElementById('mobile-bar-price');
      const barCta = document.getElementById('mobile-bar-cta');

      const drawerTitle = document.getElementById('mobile-drawer-title');
      const drawerTagline = document.getElementById('mobile-drawer-tagline');
      const drawerPrice = document.getElementById('mobile-drawer-price');
      const drawerDuration = document.getElementById('mobile-drawer-duration');
      const drawerInclusions = document.getElementById('mobile-drawer-inclusions');
      const drawerCta = document.getElementById('mobile-drawer-cta');
      const drawerIncompany = document.getElementById('mobile-drawer-incompany');

      const dynamicPrimaryUrl = isService
        ? `${adviceBase}?type=zakelijk&service=${encodeURIComponent(activeServiceSlug || course.id || '')}`
        : `${adviceBase}?course=${encodeURIComponent(course.id || '')}`;
      const dynamicIncompanyUrl = `${adviceBase}?type=zakelijk&course=${encodeURIComponent(course.id || '')}&mode=incompany`;

      if (barTitle) barTitle.textContent = course.title;
      if (barPrice) barPrice.textContent = course.price;
      if (barCta) barCta.setAttribute('href', dynamicPrimaryUrl);

      if (drawerTitle) drawerTitle.textContent = course.title;
      if (drawerTagline) drawerTagline.textContent = course.tagline || '';
      if (drawerPrice) drawerPrice.textContent = course.price;
      if (drawerDuration) drawerDuration.textContent = course.duration;
      if (drawerCta) drawerCta.setAttribute('href', dynamicPrimaryUrl);
      if (drawerIncompany) drawerIncompany.setAttribute('href', dynamicIncompanyUrl);

      if (drawerInclusions && course.inclusions) {
        drawerInclusions.innerHTML = course.inclusions.map((inc) => `
          <li class="flex items-center gap-2 text-xs text-brand-dark/80 font-medium">
            <i class="fa-solid fa-circle-check text-emerald-500 text-xs shrink-0"></i>
            <span>${inc}</span>
          </li>
        `).join('');
      }
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMobileDrawer);
  } else {
    setupMobileDrawer();
  }
</script>
